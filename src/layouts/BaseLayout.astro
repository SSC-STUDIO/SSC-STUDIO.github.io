---
import SiteHead from '../components/SiteHead.astro'
import SiteFoot from '../components/SiteFoot.astro'
import SiteScrollbar from '../components/SiteScrollbar.astro'
import SiteIntro from '../components/SiteIntro.astro'
import CopyEmail from '../components/CopyEmail.astro'
import { ClientRouter } from 'astro:transitions'

import '../styles/global.scss'

interface Props {
  title: string
  description?: string
  bodyClass?: string
}

const {
  title,
  description = '个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。',
  bodyClass,
} = Astro.props

const isSubpage = Astro.url.pathname !== '/'
const ogImage = '/images/about-cover.svg'
const ogUrl = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<!doctype html>
<html
  lang="zh-CN"
  class:list={[
    !isSubpage && 'is-scroll-blocked',
    !isSubpage && 'is-intro-active',
  ]}
>
  <head>
    <meta charset="utf-8" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <meta name="robots" content="index, follow" />

    <link rel="manifest" href="/icons/site.webmanifest" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="陈润森 · Chen Runsen"
      href="/rss.xml"
    />
    <link
      rel="icon"
      type="image/png"
      href="/icons/favicon-48x48.png"
      sizes="48x48"
    />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="shortcut icon" href="/icons/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="陈润森" />

    <meta name="theme-color" content="#f4ead8" />
    <meta name="msapplication-navbutton-color" content="#f4ead8" />
    <meta name="apple-mobile-web-app-status-bar-style" content="#f4ead8" />

    <ClientRouter />

    <!-- Apply theme before first paint; persist across ClientRouter swaps -->
    <script is:inline>
      (function () {
        var storageKey = 'site-theme'

        function apply(root) {
          if (!root) return
          var stored = null
          try {
            stored = localStorage.getItem(storageKey)
          } catch (e) {}

          var dark =
            stored === 'dark' ||
            (stored !== 'light' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)

          root.classList.toggle('theme-contrasted', dark)
          root.dataset.theme = stored || (dark ? 'dark' : 'light')

          var color = dark ? '#0e1412' : '#f4ead8'
          var metas = root.querySelectorAll
            ? root.querySelectorAll(
                'meta[name="theme-color"], meta[name="msapplication-navbutton-color"], meta[name="apple-mobile-web-app-status-bar-style"]'
              )
            : []
          if (!metas.length && root === document.documentElement) {
            metas = document.querySelectorAll(
              'meta[name="theme-color"], meta[name="msapplication-navbutton-color"], meta[name="apple-mobile-web-app-status-bar-style"]'
            )
          }
          for (var i = 0; i < metas.length; i++) {
            metas[i].setAttribute('content', color)
          }
        }

        apply(document.documentElement)

        document.addEventListener('astro:before-swap', function (event) {
          var next = event.newDocument.documentElement
          apply(next)
          // SPA 回首页不要带回 SSR 的开场锁；intro 只在首次硬加载播
          next.classList.remove('is-scroll-blocked', 'is-intro-active')
        })
      })()
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;700&family=Noto+Serif+SC:wght@200;400;700;900&display=swap"
      rel="stylesheet"
    />

    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:site_name" content="陈润森" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

  </head>

  <body class:list={[isSubpage && 'is-subpage', bodyClass]}>
    <div
      class:list={[
        'site-wrapper js-site-wrapper',
        !isSubpage && 'is-preparing',
      ]}
    >
      <SiteHead />

      <slot />

      <SiteFoot />
    </div><!-- .site-wrapper -->

    {!isSubpage && <SiteIntro />}

    <div class="site-mount js-mount"></div>
    <div class="site-contrast-mask js-contrast-mask"></div>

    <SiteScrollbar />

    <CopyEmail />
  </body>

  <script>
    import Emitter from '../utils/Emitter'
    import Ticker from '../utils/Ticker'
    import { watchIdleAnimations } from '../utils/idle-anim'
    import { initInkReveal } from '../motion/ink-reveal'
    import { initSealPress } from '../motion/seal-press'
    import { initLeafFlip } from '../motion/leaf-flip'
    import { initHandscroll } from '../motion/handscroll'
    import { markReady } from '../motion/core'

    import Lenis from 'lenis'

    import { gsap } from 'gsap'
    import { ScrollTrigger } from 'gsap/ScrollTrigger'
    gsap.registerPlugin(ScrollTrigger)

    declare global {
      interface Window {
        safeWidth: number
        safeHeight: number
        maxScrollTop: number
        scrollProgress: number
        lenis: any
        __site: any
      }
    }

    const INTRO_SEEN_KEY = 'site-intro-seen'

    class Site {
      timeouts: any = {
        resizeThrottle: null,
      }

      windowWidth: number
      windowHeight: number
      clientWidth: number
      clientHeight: number

      isScrolling: boolean = false

      lenis: any

      booted: boolean = false

      /** 离屏动画暂停器的清理函数（每次换页重绑前先清掉） */
      stopIdleAnimations: (() => void) | null = null

      /** 原创动效各模块的清理函数（每次换页重绑前先清掉） */
      stopMotion: Array<() => void> = []

      /**
       * Constructor
       */
      constructor() {
        // OS class
        let os = 'unknown'
        if (navigator.userAgent.indexOf('Win') !== -1) {
          os = 'windows'
        } else if (navigator.userAgent.indexOf('Android') !== -1) {
          os = 'android'
        } else if (navigator.userAgent.indexOf('Mac') !== -1) {
          os = 'mac'
        } else if (navigator.userAgent.indexOf('Linux') !== -1) {
          os = 'linux'
        }
        document.documentElement.classList.add(`is-${os}`)

        // Browser class
        let browser = 'unknown'
        if (navigator.userAgent.indexOf('Firefox') !== -1) {
          browser = 'firefox'
        } else if (navigator.userAgent.indexOf('Chrome') !== -1) {
          browser = 'chrome'
        } else if (navigator.userAgent.indexOf('Safari') !== -1) {
          browser = 'safari'
        }
        document.documentElement.classList.add(`is-${browser}`)

        // Subpages are visible as soon as the shell script runs
        if (document.body.classList.contains('is-subpage')) {
          document.documentElement.classList.add('is-subpage-ready')
        }

        this.booted = false

        this.bindGlobalEvents()
      }

      /**
       * Initialization — one-time boot (SPA 下重复触发会被门闩跳过)
       */
      init() {
        if (this.booted) return
        this.booted = true

        this.initLenis()

        Ticker.init()

        this.onResize()

        this.pageSetup()
      }

      /**
       * Per-page setup — 每次（含 SPA 换页后）都要执行
       */
      pageSetup() {
        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches
        const introSeen = sessionStorage.getItem(INTRO_SEEN_KEY) === '1'
        const hasIntro = !!document.querySelector('.js-intro')
        const playIntro = !reducedMotion && !introSeen && hasIntro

        // SPA 换页时 <html> 的属性不会被替换，按页维护
        document.documentElement.classList.toggle(
          'is-scroll-blocked',
          playIntro
        )
        document.documentElement.classList.toggle('is-intro-active', playIntro)

        this.bindPageObservers()
        this.bindIdleAnimations()
        this.initMotion()

        try {
          const stored = localStorage.getItem('site-theme')
          const dark =
            stored === 'dark' ||
            (stored !== 'light' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches)
          document.documentElement.classList.toggle('theme-contrasted', dark)
          document.documentElement.dataset.theme =
            stored || (dark ? 'dark' : 'light')
        } catch (e) {}

        if (!playIntro) {
          Ticker.nextTick(this.forceReveal, this)
        } else {
          Ticker.nextTick(this.intro, this)
          // Safety net: never leave the site hidden behind a stuck intro
          setTimeout(() => this.forceReveal(), 3000)
        }

        this.initReveal()
        this.onScroll()
      }

      /**
       * Bind global events — 只绑一次（构造时）
       */
      bindGlobalEvents() {
        window.addEventListener('resize', this.resizeThrottle.bind(this))
        window.addEventListener('scroll', this.onScroll.bind(this), {
          passive: true,
        })
        window.addEventListener('mousemove', this.onMouseMove.bind(this), {
          passive: true,
        })

        Emitter.on('updateViewport', this.onResize, this, true)

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) gsap.ticker.sleep()
          else gsap.ticker.wake()
        })

        // Site loaded event
        if (document.readyState === 'complete') {
          this.siteLoaded()
        } else {
          window.addEventListener('load', this.siteLoaded.bind(this), {
            once: true,
          })
        }
      }

      /**
       * Bind per-page observers — 每次换页重绑（旧元素随 swap 销毁）
       */
      bindPageObservers() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              entry.target.dispatchEvent(
                new CustomEvent('intersect', {
                  detail: { isIntersecting: entry.isIntersecting },
                })
              )

              if (entry.isIntersecting) {
                entry.target.classList.add('is-in-view')
                entry.target.classList.remove(
                  'is-out-of-view',
                  'is-out-of-view-top',
                  'is-out-of-view-bottom'
                )
              } else {
                entry.target.classList.remove('is-in-view')
                entry.target.classList.add('is-out-of-view')

                entry.target.classList.toggle(
                  'is-out-of-view-top',
                  entry.boundingClientRect.top < 0
                )
                entry.target.classList.toggle(
                  'is-out-of-view-bottom',
                  entry.boundingClientRect.top > 0
                )
              }
            })
          },
          {
            threshold: 0,
          }
        )

        document.querySelectorAll('[data-intersect]').forEach((el) => {
          observer.observe(el)
        })
      }

      /**
       * 装饰性无限动画：离屏暂停、回屏恢复。
       * 首页这类长页上同时有十几处漂移/呼吸动画，
       * 滚过之后不该继续占用每帧的合成预算。
       */
      bindIdleAnimations() {
        if (this.stopIdleAnimations) {
          this.stopIdleAnimations()
          this.stopIdleAnimations = null
        }

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return
        }

        this.stopIdleAnimations = watchIdleAnimations()
      }

      /**
       * Init lenis
       */
      initLenis() {
        const lenis = new Lenis()

        lenis.on('scroll', ScrollTrigger.update)

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000)
        })

        gsap.ticker.lagSmoothing(0)

        window.lenis = lenis
        this.lenis = lenis
      }

      /**
       * Set loaded class
       */
      siteLoaded() {
        document.documentElement.classList.add('is-loaded')

        Emitter.emit('siteLoaded')
        Emitter.emit('updateViewport')

        // 新核心的就绪闩（迁移期与 Emitter 并行，迁移完成后 Emitter 退役）
        markReady()

        this.initReveal()
      }

      /**
       * 原创动效：洇墨显影 / 印章钤印 / 册页翻页 / 长卷平移
       * 每次换页重建（旧元素随 swap 销毁）
       */
      initMotion() {
        // 清理上一页的监听
        this.stopMotion?.forEach((stop) => stop())
        this.stopMotion = []

        const stops = [
          initInkReveal(),
          initSealPress(),
          initLeafFlip(),
          initHandscroll(),
        ]

        this.stopMotion = stops
      }

      /**
       * Reveal [data-reveal] elements on scroll
       */
      initReveal() {
        this.initMotion()
      }

      /**
       * Resize throttle
       */
      resizeThrottle() {
        clearTimeout(this.timeouts.resizeThrottle)

        this.timeouts.resizeThrottle = setTimeout(() => {
          Ticker.nextTick(this.onResize, this)
        }, 200)
      }

      /**
       * Resize handler
       */
      onResize() {
        const newWidth = window.innerWidth
        let widthChanged = false
        if (this.windowWidth !== newWidth) {
          if (this.windowWidth !== undefined) {
            widthChanged = true
          }

          this.windowWidth = newWidth
          this.clientWidth = document.body.clientWidth
        }

        const newHeight = window.innerHeight
        let heightChanged = false
        if (this.windowHeight !== newHeight) {
          if (this.windowHeight !== undefined) {
            heightChanged = true
          }

          this.windowHeight = newHeight
          this.clientHeight = document.body.clientHeight
        }

        window.safeWidth = newWidth
        window.safeHeight = newHeight

        window.maxScrollTop = Math.max(
          0,
          document.body.scrollHeight - window.safeHeight
        )

        this.setScrollProgress()

        Emitter.emit('resize', widthChanged, heightChanged)
      }

      /**
       * Scroll handler
       */
      onScroll() {
        this.setScrollProgress()

        Ticker.nextTick(() => {
          Emitter.emit('scroll', window.scrollY)
        })
      }

      /**
       * Set scroll progress
       */
      setScrollProgress() {
        window.scrollProgress = window.scrollY / window.maxScrollTop
      }

      /**
       * Mouse move handler
       */
      onMouseMove(e) {
        Emitter.emit('mousemove', e.clientX, e.clientY)
      }

      /**
       * Force reveal (skip intro)
       */
      forceReveal() {
        const wrapper: HTMLElement = document.querySelector('.js-site-wrapper')
        const intro: HTMLElement = document.querySelector('.js-intro')
        const mount: HTMLElement = document.querySelector('.js-mount')
        const hero: HTMLElement = document.querySelector('.s-hero')
        const head: HTMLElement = document.querySelector('.site-head')

        document.documentElement.classList.add('is-site-ready')
        document.documentElement.classList.remove(
          'is-scroll-blocked',
          'is-intro-active'
        )

        if (wrapper) {
          wrapper.style.opacity = '1'
          wrapper.classList.remove('is-preparing')
        }
        if (head) {
          head.style.opacity = '1'
        }
        if (hero) {
          hero.style.opacity = '1'
        }
        if (mount) {
          mount.style.opacity = '1'
        }
        intro?.remove()

        document.dispatchEvent(new CustomEvent('intro'))
        Emitter.emit('updateViewport')
      }

      /**
       * Intro
       */
      intro() {
        // Selectors
        const wrapper: HTMLElement = document.querySelector('.js-site-wrapper')
        const intro: HTMLElement = document.querySelector('.js-intro')

        if (!wrapper || !intro) {
          this.forceReveal()
          return
        }

        if (sessionStorage.getItem(INTRO_SEEN_KEY) === '1') {
          this.forceReveal()
          return
        }

        try {
          const mount: HTMLElement = document.querySelector('.js-mount')
          const status: HTMLElement = intro.querySelector('.js-intro-status')
          const logoLinesV: NodeList =
            intro.querySelectorAll('.js-logo-line-v')
          const logoLinesH: NodeList =
            intro.querySelectorAll('.js-logo-line-h')
          const borderTop: HTMLElement = intro.querySelector('.js-border-top')
          const borderLeft: HTMLElement =
            intro.querySelector('.js-border-left')
          const borderRight: HTMLElement =
            intro.querySelector('.js-border-right')
          const head: HTMLElement = document.querySelector('.site-head')
          const hero: HTMLElement = document.querySelector('.s-hero')

          const revealAt = 0.92

          // Timeline
          const tl = gsap.timeline()

          if (status) {
            tl.fromTo(
              status,
              { autoAlpha: 0, y: 6 },
              { autoAlpha: 1, y: 0, duration: 0.28, ease: 'power2.out' },
              0.06
            )
            tl.to(
              status,
              { autoAlpha: 0, y: -4, duration: 0.22, ease: 'power2.in' },
              0.58
            )
          }

          tl.fromTo(
            logoLinesV,
            {
              scaleY: 0,
            },
            {
              scaleY: 1,
              duration: 0.48,
              ease: 'power4.inOut',
              stagger: 0.06,
            },
            0
          )

          tl.fromTo(
            logoLinesH,
            {
              scaleX: 0,
            },
            {
              scaleX: 1,
              duration: 0.26,
              ease: 'power4.inOut',
            },
            0.3
          )

          tl.set(logoLinesV, {
            transformOrigin: '50% 0',
          })

          tl.fromTo(
            logoLinesV,
            {
              scaleY: 1,
            },
            {
              scaleY: 0,
              duration: 0.34,
              ease: 'power4.in',
              immediateRender: false,
              stagger: 0.05,
            },
            0.62
          )

          tl.fromTo(
            logoLinesH,
            {
              scaleY: 1,
            },
            {
              scaleY: 0,
              duration: 0.24,
              ease: 'power4.in',
              immediateRender: false,
              stagger: 0.05,
            },
            0.68
          )

          tl.call(
            () => {
              document.documentElement.classList.add('is-site-ready')

              gsap.set(wrapper, { opacity: 1 })
              wrapper.classList.remove('is-preparing')

              gsap.to(intro, {
                autoAlpha: 0,
                duration: 0.45,
                ease: 'power2.inOut',
              })

              const targets = [head, hero, mount].filter(Boolean)
              if (targets.length) {
                gsap.fromTo(
                  targets,
                  { opacity: 0 },
                  { opacity: 1, duration: 0.52, ease: 'power2.out' }
                )
              }

              document.dispatchEvent(new CustomEvent('intro'))
            },
            null,
            revealAt
          )

          tl.from(
            borderTop,
            {
              scaleY: 0,
              duration: 0.62,
              ease: 'power3.inOut',
            },
            revealAt
          )

          tl.from(
            [borderLeft, borderRight],
            {
              scaleX: 0,
              duration: 0.62,
              ease: 'power3.inOut',
            },
            revealAt
          )

          tl.call(
            () => {
              sessionStorage.setItem(INTRO_SEEN_KEY, '1')

              intro.remove()

              document.documentElement.classList.remove(
                'is-scroll-blocked',
                'is-intro-active'
              )

              Ticker.nextTick(() => {
                Emitter.emit('updateViewport')
              })
            },
            null,
            revealAt + 0.78
          )
        } catch (error) {
          console.error('Site intro failed:', error)
          this.forceReveal()
        }
      }
    }

    // SPA 单例：模块脚本在 ClientRouter 下只执行一次
    const site = (window.__site ||= new Site())

    // astro:page-load 在首次加载与每次 SPA 换页后都会触发
    document.addEventListener('astro:page-load', () => {
      site.init()
      site.pageSetup()
    })
  </script>
</html>
