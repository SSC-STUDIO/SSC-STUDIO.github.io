---
/**
 * SenMark — 原创「森」字标
 * 三「木」成「森」的构成主义线条图形，纯 SVG、currentColor 自适应主题。
 * intro 场景可用 draw 变体做描边绘制动画。
 */
type Props = {
  /** 边长 px，默认 40 */
  size?: number;
  /** draw = 描边绘制动画；grow = 生长动画（intro 用） */
  variant?: 'static' | 'draw' | 'grow';
  class?: string;
};

const { size = 40, variant = 'static', class: className } = Astro.props;

// 三「木」十二笔：每「木」= 横 / 竖 / 左撇 / 右捺
const strokes = [
  // 上木（中）
  'M96 62H184',
  'M140 24V128',
  'M138 68L100 116',
  'M142 68L180 116',
  // 左下木
  'M40 190H128',
  'M84 146V262',
  'M82 196L46 250',
  'M86 196L122 250',
  // 右下木
  'M152 190H240',
  'M196 146V262',
  'M194 196L158 250',
  'M198 196L234 250',
];
---

<svg
  class:list={['sen-mark', `sen-mark--${variant}`, className]}
  width={size}
  height={size}
  viewBox="0 0 280 280"
  fill="none"
  role="img"
  aria-label="森"
>
  {
    strokes.map((d) => (
      <path d={d} pathLength="1" stroke="currentColor" stroke-width="13" stroke-linecap="round" />
    ))
  }
</svg>

<style>
  .sen-mark {
    display: block;
  }

  .sen-mark--draw path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: senDraw 500ms cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }

  /* 横竖先落，撇捺随后：按笔顺 stagger，配合 intro 0.92s 的揭幕节奏 */
  .sen-mark--draw path:nth-child(4n + 1) {
    animation-delay: 40ms;
  }
  .sen-mark--draw path:nth-child(4n + 2) {
    animation-delay: 140ms;
  }
  .sen-mark--draw path:nth-child(4n + 3) {
    animation-delay: 260ms;
  }
  .sen-mark--draw path:nth-child(4n + 4) {
    animation-delay: 360ms;
  }

  @keyframes senDraw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* ── grow：整棵「森」从上到下生长 ──
     主干(上木竖)向下长 → 上木横/撇捺分枝 → 下方两木破土 → 各自开枝 */
  .sen-mark--grow path {
    transform: scale(0);
    transform-box: fill-box;
    animation: senGrowStem 320ms cubic-bezier(0.34, 1.3, 0.5, 1) forwards;
  }

  /* 上木主干：从顶端向下长 */
  .sen-mark--grow path:nth-child(2) {
    animation-delay: 0ms;
    animation-duration: 340ms;
    transform-origin: 50% 0%;
  }

  /* 上木横枝：从中心向两端展开 */
  .sen-mark--grow path:nth-child(1) {
    animation-delay: 280ms;
    animation-duration: 240ms;
    transform-origin: 50% 50%;
  }

  /* 上木左/右分枝：从主干连接点斜出 */
  .sen-mark--grow path:nth-child(3) {
    animation-delay: 480ms;
    animation-duration: 220ms;
    transform-origin: 100% 0%;
  }

  .sen-mark--grow path:nth-child(4) {
    animation-delay: 480ms;
    animation-duration: 220ms;
    transform-origin: 0% 0%;
  }

  /* 左下木主干：破土向下 */
  .sen-mark--grow path:nth-child(6) {
    animation-delay: 660ms;
    animation-duration: 280ms;
    transform-origin: 50% 0%;
  }

  /* 右下木主干：稍后破土 */
  .sen-mark--grow path:nth-child(10) {
    animation-delay: 760ms;
    animation-duration: 280ms;
    transform-origin: 50% 0%;
  }

  /* 两木横枝 */
  .sen-mark--grow path:nth-child(5) {
    animation-delay: 900ms;
    animation-duration: 200ms;
    transform-origin: 50% 50%;
  }

  .sen-mark--grow path:nth-child(9) {
    animation-delay: 980ms;
    animation-duration: 200ms;
    transform-origin: 50% 50%;
  }

  /* 两木开枝散叶 */
  .sen-mark--grow path:nth-child(7) {
    animation-delay: 1060ms;
    animation-duration: 200ms;
    transform-origin: 100% 0%;
  }

  .sen-mark--grow path:nth-child(8) {
    animation-delay: 1060ms;
    animation-duration: 200ms;
    transform-origin: 0% 0%;
  }

  .sen-mark--grow path:nth-child(11) {
    animation-delay: 1120ms;
    animation-duration: 200ms;
    transform-origin: 100% 0%;
  }

  .sen-mark--grow path:nth-child(12) {
    animation-delay: 1120ms;
    animation-duration: 200ms;
    transform-origin: 0% 0%;
  }

  @keyframes senGrowStem {
    0% {
      opacity: 0;
      transform: scale(0);
    }
    40% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sen-mark--draw path {
      animation: none;
      stroke-dashoffset: 0;
    }

    .sen-mark--grow path {
      animation: none;
      transform: none;
    }
  }
</style>
