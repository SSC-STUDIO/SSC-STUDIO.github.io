---
/**
 * SenMark — 原创「森」字标
 * 三「木」成「森」的构成主义线条图形，纯 SVG、currentColor 自适应主题。
 * intro 场景可用 draw 变体做描边绘制动画。
 */
type Props = {
  /** 边长 px，默认 40 */
  size?: number;
  /** draw = 描边绘制动画；grow = 生长动画（intro 用） */
  variant?: 'static' | 'draw' | 'grow';
  class?: string;
};

const { size = 40, variant = 'static', class: className } = Astro.props;

// 三「木」十二笔：每「木」= 横 / 竖 / 左撇 / 右捺
const strokes = [
  // 上木（中）
  'M96 62H184',
  'M140 24V128',
  'M138 68L100 116',
  'M142 68L180 116',
  // 左下木
  'M40 190H128',
  'M84 146V262',
  'M82 196L46 250',
  'M86 196L122 250',
  // 右下木
  'M152 190H240',
  'M196 146V262',
  'M194 196L158 250',
  'M198 196L234 250',
];
---

<svg
  class:list={['sen-mark', `sen-mark--${variant}`, className]}
  width={size}
  height={size}
  viewBox="0 0 280 280"
  fill="none"
  role="img"
  aria-label="森"
>
  {
    strokes.map((d) => (
      <path d={d} pathLength="1" stroke="currentColor" stroke-width="13" stroke-linecap="round" />
    ))
  }
</svg>

<style>
  .sen-mark {
    display: block;
  }

  .sen-mark--draw path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: senDraw 500ms cubic-bezier(0.6, 0, 0.2, 1) forwards;
  }

  /* 横竖先落，撇捺随后：按笔顺 stagger，配合 intro 0.92s 的揭幕节奏 */
  .sen-mark--draw path:nth-child(4n + 1) {
    animation-delay: 40ms;
  }
  .sen-mark--draw path:nth-child(4n + 2) {
    animation-delay: 140ms;
  }
  .sen-mark--draw path:nth-child(4n + 3) {
    animation-delay: 260ms;
  }
  .sen-mark--draw path:nth-child(4n + 4) {
    animation-delay: 360ms;
  }

  @keyframes senDraw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* ── grow：三木错峰按笔顺描出，不用整笔 scale ──
     每木：竖干先落 → 横枝 → 撇捺开枝。上木成「木」，左下错峰成「林」，右下再成「森」。 */
  .sen-mark--grow path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0;
    animation: senGrowStroke 280ms cubic-bezier(0.4, 0.02, 0.2, 1) forwards;
  }

  /* 上木：竖 → 横 → 撇捺 */
  .sen-mark--grow path:nth-child(2) {
    animation-delay: 0ms;
    animation-duration: 300ms;
  }
  .sen-mark--grow path:nth-child(1) {
    animation-delay: 160ms;
    animation-duration: 200ms;
  }
  .sen-mark--grow path:nth-child(3) {
    animation-delay: 300ms;
    animation-duration: 180ms;
  }
  .sen-mark--grow path:nth-child(4) {
    animation-delay: 340ms;
    animation-duration: 180ms;
  }

  /* 左下木：上木将成时破土 */
  .sen-mark--grow path:nth-child(6) {
    animation-delay: 380ms;
    animation-duration: 260ms;
  }
  .sen-mark--grow path:nth-child(5) {
    animation-delay: 540ms;
    animation-duration: 180ms;
  }
  .sen-mark--grow path:nth-child(7) {
    animation-delay: 660ms;
    animation-duration: 170ms;
  }
  .sen-mark--grow path:nth-child(8) {
    animation-delay: 700ms;
    animation-duration: 170ms;
  }

  /* 右下木：再错一峰，三木成森 */
  .sen-mark--grow path:nth-child(10) {
    animation-delay: 560ms;
    animation-duration: 260ms;
  }
  .sen-mark--grow path:nth-child(9) {
    animation-delay: 720ms;
    animation-duration: 180ms;
  }
  .sen-mark--grow path:nth-child(11) {
    animation-delay: 840ms;
    animation-duration: 170ms;
  }
  .sen-mark--grow path:nth-child(12) {
    animation-delay: 880ms;
    animation-duration: 170ms;
  }

  @keyframes senGrowStroke {
    0% {
      opacity: 0;
      stroke-dashoffset: 1;
    }
    16% {
      opacity: 1;
    }
    100% {
      opacity: 1;
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sen-mark--draw path {
      animation: none;
      stroke-dashoffset: 0;
    }

    .sen-mark--grow path {
      animation: none;
      opacity: 1;
      stroke-dashoffset: 0;
      transform: none;
    }
  }
</style>
