---
/**
 * InkRail — 云头界栏
 *
 * 页面各段之间的一条「界栏」：两端如意云头收口，
 * 中间朱丝栏串起几枚汉字，字会偶尔被点上一笔朱墨（呼吸式，
 * 用随机间隔的定时器而非每帧掷骰，离屏即停）。
 */
const {
  class: className,
  style = 'primary',
  strings = ['木', '林', '森', '光'],
} = Astro.props
---

<ink-rail class:list={['style--' + style, className]} data-intersect>
  <svg
    class="rail__cloud rail__cloud--head"
    viewBox="0 0 30 14"
    aria-hidden="true"
  >
    <path
      d="M1 12.5 C4 7 9 4.5 14.5 5.2 C19.5 5.8 22 8.6 21.2 10.8 C20.5 12.6 18 12.8 17.2 11.3 C16.5 10 17.6 8.6 19 8.8"
    ></path>
    <path
      class="rail__cloud-tail"
      d="M5.5 12.5 C10 10.8 16 10.6 21 11.6 C24 12.2 27 11.8 29 10.4"
    ></path>
  </svg>

  <span class="rail__glyphs">
    {
      strings.map((glyph) => (
        <>
          <span class="rail__glyph js-glyph">{glyph}</span>
          <span class="rail__rule" aria-hidden="true" />
        </>
      ))
    }
  </span>

  <svg
    class="rail__cloud rail__cloud--tail-end"
    viewBox="0 0 30 14"
    aria-hidden="true"
  >
    <path
      d="M1 12.5 C4 7 9 4.5 14.5 5.2 C19.5 5.8 22 8.6 21.2 10.8 C20.5 12.6 18 12.8 17.2 11.3 C16.5 10 17.6 8.6 19 8.8"
    ></path>
    <path
      class="rail__cloud-tail"
      d="M5.5 12.5 C10 10.8 16 10.6 21 11.6 C24 12.2 27 11.8 29 10.4"
    ></path>
  </svg>
</ink-rail><!-- .ink-rail -->

<script>
  import { prefersReducedMotion } from '../motion/core'

  /** 点墨持续时长（与 CSS 过渡对齐） */
  const DAB_MS = 320

  class InkRail extends HTMLElement {
    glyphs: HTMLElement[] = []
    timer = 0

    connectedCallback() {
      this.glyphs = Array.from(
        this.querySelectorAll<HTMLElement>('.js-glyph')
      )

      this.addEventListener('intersect', this.onIntersect as EventListener, {
        passive: true,
      })
    }

    disconnectedCallback() {
      this.stop()
    }

    onIntersect = (e: CustomEvent) => {
      if (e.detail?.isIntersecting) this.start()
      else this.stop()
    }

    /** 随机间隔点墨：比每帧掷骰便宜，节奏也更像人在落笔 */
    start() {
      if (this.timer || !this.glyphs.length || prefersReducedMotion()) return

      const dab = () => {
        const glyph =
          this.glyphs[Math.floor(Math.random() * this.glyphs.length)]

        glyph.classList.add('is-ink')
        window.setTimeout(() => glyph.classList.remove('is-ink'), DAB_MS)

        this.timer = window.setTimeout(dab, 1200 + Math.random() * 1600)
      }

      this.timer = window.setTimeout(dab, 500 + Math.random() * 900)
    }

    stop() {
      window.clearTimeout(this.timer)
      this.timer = 0
    }
  }

  if (!customElements.get('ink-rail')) {
    customElements.define('ink-rail', InkRail)
  }
</script>

<style lang="scss">
  ink-rail {
    @include flex(row, center, space-between);

    position: relative;

    padding: 0 1.05rem;
    width: 100%;
    height: 2.35rem;

    @include ink-rule(top);
    box-shadow:
      inset 0 1.5px 0 color-mix(in srgb, var(--color-secondary) 48%, transparent),
      inset 0 4px 0 color-mix(in srgb, var(--color-accent) 58%, transparent),
      inset 0 -1.5px 0 color-mix(in srgb, var(--color-secondary) 48%, transparent),
      inset 0 -4px 0 color-mix(in srgb, var(--color-accent) 58%, transparent);

    font: 700 13px / 1 font-family(editorial);
    letter-spacing: 0.28em;

    .rail__cloud {
      flex-shrink: 0;

      width: 1.75rem;
      height: 0.85rem;

      color: color-mix(in srgb, #{color(secondary)} 62%, transparent);

      path {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.3;
        stroke-linecap: round;
      }

      .rail__cloud-tail {
        opacity: 0.55;
      }

      /* 尾端云头镜像，首尾相顾 */
      &--tail-end {
        transform: scaleX(-1);
      }
    }

    .rail__glyphs {
      @include flex(row, center, space-between);

      flex: 1 1 auto;
      min-width: 0;
      padding: 0 0.85rem;
    }

    .rail__glyph {
      position: relative;

      flex: 0 0 auto;

      color: color(secondary);
      transition:
        opacity 0.28s ease,
        transform 0.28s ease,
        color 0.28s ease;

      &.is-ink {
        color: color(accent);
        transform: translateY(-1px);
      }
    }

    .rail__rule {
      flex: 1 1 auto;

      height: 5px;
      margin: 0 0.65rem;
      min-width: 1.25rem;

      background-image:
        /* 淡紫间点：朱砂墨线之间的一缕云气 */
        radial-gradient(
          circle,
          color-mix(in srgb, #{color(mist)} 65%, transparent) 0.55px,
          transparent 0.7px
        ),
        radial-gradient(
          circle,
          color-mix(in srgb, #{color(accent)} 70%, transparent) 0.7px,
          transparent 0.85px
        ),
        radial-gradient(
          circle,
          color-mix(in srgb, #{color(secondary)} 45%, transparent) 0.45px,
          transparent 0.6px
        ),
        linear-gradient(
          color-mix(in srgb, #{color(accent)} 55%, transparent),
          color-mix(in srgb, #{color(accent)} 55%, transparent)
        );
      background-repeat: repeat-x, repeat-x, repeat-x, repeat-x;
      background-size: 13px 5px, 7px 5px, 11px 5px, 100% 1.2px;
      background-position: 2px 3px, 0 50%, 4px 1px, 0 50%;
      opacity: 0.9;

      &:last-child {
        display: none;
      }

      @include mq(phone) {
        &:nth-child(2n) {
          min-width: 0.5rem;
          margin: 0 0.35rem;
        }
      }
    }

    &.style--secondary {
      background: color(secondary);

      color: color(primary);

      .rail__cloud {
        color: color-mix(in srgb, #{color(primary)} 72%, transparent);
      }

      .rail__glyph {
        color: color(primary);

        &.is-ink {
          color: color(accent);
        }
      }

      .rail__rule {
        background-image:
          radial-gradient(circle, color-mix(in srgb, #{color(primary)} 70%, transparent) 0.7px, transparent 0.85px),
          radial-gradient(circle, color-mix(in srgb, #{color(accent)} 50%, transparent) 0.45px, transparent 0.6px),
          linear-gradient(color-mix(in srgb, #{color(primary)} 55%, transparent), color-mix(in srgb, #{color(primary)} 55%, transparent));
      }
    }

    &.style--accent {
      background: color(accent-muted);

      .rail__glyph.is-ink {
        color: color(accent-strong);
      }
    }
  }
</style>
