---
/**
 * InkMountains — 水墨远山
 *
 * 默认：静态 SVG，不进 rAF。
 * dimensional：纸雕模式——三层山各自拆成独立纸片，按远近 translateZ
 * 排进真实透视空间，指针轻移时整座「纸雕盒」微微侧转，层间纵深立现。
 * 点空白山脚会把近层纸片往前顶一下，像按进纸雕盒。
 * 触屏 / reduced-motion / 无 JS 下与静态版视觉一致，零白屏风险。
 */
type Props = {
  compact?: boolean
  /** 纸雕纵深模式（首页区块启用；默认关闭，内页不受影响） */
  dimensional?: boolean
}

const { compact = false, dimensional = false } = Astro.props

const FAR =
  'M0 420 V268 L90 238 C170 214 210 250 290 228 C380 202 430 248 520 216 C610 186 680 240 760 208 C850 176 910 232 1000 206 C1100 176 1160 236 1240 214 L1440 248 V420 Z'
const MID =
  'M0 420 V318 L70 292 C150 268 200 308 280 286 C370 260 430 310 520 284 C610 258 670 308 760 282 C850 256 920 306 1010 288 C1110 266 1180 312 1270 294 L1440 318 V420 Z'
const NEAR =
  'M0 420 V368 L120 348 C210 332 250 360 340 346 C430 332 490 362 580 348 C670 334 730 364 820 350 C920 334 980 366 1080 352 C1180 338 1260 368 1440 358 V420 Z'

const MOSS = [
  [210, 286, 1.6],
  [402, 302, 1.2],
  [618, 276, 1.8],
  [894, 298, 1.3],
  [1128, 312, 1.5],
]
---

{
  dimensional ? (
    <div
      class:list={[
        'ink-mountains',
        'ink-mountains--dimensional',
        compact && 'ink-mountains--compact',
      ]}
      aria-hidden="true"
    >
      <ink-peaks class="ink-mountains__stage">
        <svg
          class="ink-mountains__layer ink-mountains__layer--far"
          viewBox="0 0 1440 420"
          preserveAspectRatio="xMidYMax slice"
        >
          <path class="ink-mountains__far" d={FAR} />
        </svg>
        <svg
          class="ink-mountains__layer ink-mountains__layer--mid"
          viewBox="0 0 1440 420"
          preserveAspectRatio="xMidYMax slice"
        >
          <path class="ink-mountains__mid" d={MID} />
        </svg>
        <svg
          class="ink-mountains__layer ink-mountains__layer--near"
          viewBox="0 0 1440 420"
          preserveAspectRatio="xMidYMax slice"
        >
          <path class="ink-mountains__near" d={NEAR} />
          <g class="ink-mountains__moss">
            {MOSS.map(([cx, cy, r]) => (
              <circle cx={cx} cy={cy} r={r} />
            ))}
          </g>
        </svg>
      </ink-peaks>
    </div>
  ) : (
    <div
      class:list={['ink-mountains', compact && 'ink-mountains--compact']}
      aria-hidden="true"
    >
      <svg viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice">
        <path class="ink-mountains__far" d={FAR} />
        <path class="ink-mountains__mid" d={MID} />
        <path class="ink-mountains__near" d={NEAR} />
        <g class="ink-mountains__moss">
          {MOSS.map(([cx, cy, r]) => (
            <circle cx={cx} cy={cy} r={r} />
          ))}
        </g>
      </svg>
    </div>
  )
}

<script>
  import { onPointer, prefersReducedMotion, type Cleanup } from '../motion/core'

  /** 纸雕山盒：指针驱动的轻微侧转，层间 translateZ 产生纵深视差 */
  const SKIP =
    'a,button,input,textarea,select,label,[role="button"],.a-object,.s__button,.s__cta,ink-seal3d,ink-sen3d,.js-stamp,.studio-card,.p-card,scroll-leaf,.p-honor-cert,.p-about-photo,.p-prose,.p-hero__title,.p-hero__summary,.s__inner'

  class InkPeaks extends HTMLElement {
    rx = 0
    ry = 0
    trx = 0
    try_ = 0
    pop = 0
    popAim = 0
    raf = 0
    popTimer = 0
    stops: Cleanup[] = []
    host: Element | null = null

    connectedCallback() {
      this.host =
        this.closest('section, header, .p-hero, .s-cta, .s-my-way, .s-about, .s-work') ||
        this.parentElement
      this.host?.addEventListener('click', this.onHostClick)

      if (
        prefersReducedMotion() ||
        window.matchMedia('(pointer: coarse)').matches
      ) {
        return
      }

      this.stops.push(
        onPointer(({ x, y }) => {
          const nx = x / window.innerWidth - 0.5
          const ny = y / window.innerHeight - 0.5
          this.try_ = nx * 6.5
          this.trx = ny * -2.6
          this.wake()
        })
      )
    }

    disconnectedCallback() {
      cancelAnimationFrame(this.raf)
      this.raf = 0
      window.clearTimeout(this.popTimer)
      this.host?.removeEventListener('click', this.onHostClick)
      this.host = null
      this.stops.forEach((stop) => stop())
      this.stops = []
    }

    onHostClick = (e: Event) => {
      if (prefersReducedMotion()) return
      const target = e.target as Element | null
      if (!target || target.closest(SKIP)) return

      const rect = this.getBoundingClientRect()
      const ev = e as PointerEvent
      if (
        ev.clientX < rect.left ||
        ev.clientX > rect.right ||
        ev.clientY < rect.top ||
        ev.clientY > rect.bottom
      ) {
        return
      }

      this.popAim = 1
      this.wake()
      window.clearTimeout(this.popTimer)
      this.popTimer = window.setTimeout(() => {
        this.popAim = 0
        this.wake()
      }, 480)
    }

    wake() {
      if (this.raf) return
      this.raf = requestAnimationFrame(() => this.tick())
    }

    tick() {
      this.rx += (this.trx - this.rx) * 0.06
      this.ry += (this.try_ - this.ry) * 0.06
      this.pop += (this.popAim - this.pop) * 0.16

      this.style.setProperty('--peak-rx', this.rx.toFixed(3) + 'deg')
      this.style.setProperty('--peak-ry', this.ry.toFixed(3) + 'deg')
      this.style.setProperty('--peak-pop', this.pop.toFixed(3))

      const settled =
        Math.abs(this.trx - this.rx) < 0.01 &&
        Math.abs(this.try_ - this.ry) < 0.01 &&
        Math.abs(this.popAim - this.pop) < 0.008
      this.raf = settled ? 0 : requestAnimationFrame(() => this.tick())
    }
  }

  if (!customElements.get('ink-peaks')) {
    customElements.define('ink-peaks', InkPeaks)
  }
</script>

<style lang="scss">
  .ink-mountains {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;

    height: min(42vh, 22rem);

    pointer-events: none;

    svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    path {
      fill: color(secondary);
    }

    &__far {
      opacity: 0.08;
    }

    &__mid {
      opacity: 0.14;
    }

    &__near {
      opacity: 0.22;
    }

    &__moss circle {
      fill: color(secondary);
      opacity: 0.35;
    }

    &--compact {
      height: min(22vh, 11rem);
      opacity: 0.9;
    }

    /* ── 纸雕纵深模式 ──
       远层 translateZ 会按 perspective-origin 往消失点收缩；
       再叠 rotateY / 卷首 --hero-px 平移时，右（左）缘会提前收住，
       和画心黑框之间露出一条直缝。放大补偿与左右出血必须同一套
       原点（底边中点），并且略大于「刚好补回」——侧转后仍要盖住。
       overflow 只裁远山自己，不动卷首印章与底边花边。 */
    &--dimensional {
      overflow: hidden;

      perspective: 800px;
      perspective-origin: 50% 100%;
    }

    &__stage {
      position: absolute;
      inset: 0 -10%;

      display: block;

      transform-origin: 50% 100%;
      transform-style: preserve-3d;
      transform: rotateX(var(--peak-rx, 0deg)) rotateY(var(--peak-ry, 0deg))
        scale(1.08);

      will-change: transform;
    }

    &__layer {
      position: absolute;
      top: 0;
      right: -8%;
      bottom: 0;
      left: -8%;

      width: auto;
      height: auto;

      transform-origin: 50% 100%;

      /* 远层退深并放大补偿；系数略大于 800/(800-|z|)，给侧转留余量。
         --peak-pop 是点按后的近推 */
      &--far {
        transform: translateZ(calc(-120px + var(--peak-pop, 0) * 28px))
          scale(calc(1.22 + var(--peak-pop, 0) * 0.03));
      }

      &--mid {
        transform: translateZ(calc(-58px + var(--peak-pop, 0) * 46px))
          scale(calc(1.14 + var(--peak-pop, 0) * 0.045));
      }

      &--near {
        transform: translateZ(calc(var(--peak-pop, 0) * 36px))
          scale(calc(1.06 + var(--peak-pop, 0) * 0.07));
      }
    }
  }

  :global(.theme-contrasted) .ink-mountains {
    .ink-mountains__far {
      opacity: 0.16;
    }

    .ink-mountains__mid {
      opacity: 0.24;
    }

    .ink-mountains__near {
      opacity: 0.34;
    }
  }
</style>
