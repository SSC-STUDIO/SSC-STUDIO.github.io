---
/**
 * InkMountains — 水墨远山（静态 SVG，不进 rAF）
 */
type Props = {
  compact?: boolean
}

const { compact = false } = Astro.props
---

<div class:list={['ink-mountains', compact && 'ink-mountains--compact']} aria-hidden="true">
  <svg viewBox="0 0 1440 420" preserveAspectRatio="xMidYMax slice">
    <path
      class="ink-mountains__far"
      d="M0 420 V268 L90 238 C170 214 210 250 290 228 C380 202 430 248 520 216 C610 186 680 240 760 208 C850 176 910 232 1000 206 C1100 176 1160 236 1240 214 L1440 248 V420 Z"
    ></path>
    <path
      class="ink-mountains__mid"
      d="M0 420 V318 L70 292 C150 268 200 308 280 286 C370 260 430 310 520 284 C610 258 670 308 760 282 C850 256 920 306 1010 288 C1110 266 1180 312 1270 294 L1440 318 V420 Z"
    ></path>
    <path
      class="ink-mountains__near"
      d="M0 420 V368 L120 348 C210 332 250 360 340 346 C430 332 490 362 580 348 C670 334 730 364 820 350 C920 334 980 366 1080 352 C1180 338 1260 368 1440 358 V420 Z"
    ></path>
    <g class="ink-mountains__moss">
      <circle cx="210" cy="286" r="1.6"></circle>
      <circle cx="402" cy="302" r="1.2"></circle>
      <circle cx="618" cy="276" r="1.8"></circle>
      <circle cx="894" cy="298" r="1.3"></circle>
      <circle cx="1128" cy="312" r="1.5"></circle>
    </g>
  </svg>
</div>

<style lang="scss">
  .ink-mountains {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;

    height: min(42vh, 22rem);

    pointer-events: none;

    svg {
      display: block;
      width: 100%;
      height: 100%;
    }

    path {
      fill: color(secondary);
    }

    &__far {
      opacity: 0.08;
    }

    &__mid {
      opacity: 0.14;
    }

    &__near {
      opacity: 0.22;
    }

    &__moss circle {
      fill: color(secondary);
      opacity: 0.35;
    }

    &--compact {
      height: min(22vh, 11rem);
      opacity: 0.9;
    }
  }

  :global(.theme-contrasted) .ink-mountains {
    .ink-mountains__far {
      opacity: 0.16;
    }

    .ink-mountains__mid {
      opacity: 0.24;
    }

    .ink-mountains__near {
      opacity: 0.34;
    }
  }
</style>
