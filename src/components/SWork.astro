---
import ScrollLeaf from './ScrollLeaf.astro'
import InkMountains from './InkMountains.astro'
import InkMeander from './InkMeander.astro'
import InkScroll from './InkScroll.astro'
import SealChar from './SealChar.astro'
import { projects } from '@/data/projects'

const works = projects.map((project) => ({
  name: project.name,
  title: project.title,
  href: project.href,
  img: project.cover,
  summary: project.summary,
  stack: project.tags,
  key: project.homeKey,
}))

const total = String(works.length).padStart(2, '0')

// 册页汉字编号：壹 贰 叁 …… 用于卡片卷号与索引
const cnNumerals = ['壹', '贰', '叁', '肆', '伍', '陆', '柒', '捌']
---

<section id="work" class="s-work" data-intersect>
  <InkMountains compact dimensional />
  <div class="s__outer">
    <div class="s__inner js-container">
      <h2 class="s__title">
        <span class="s__title__inner js-title">
          <span class="s__title__letter js-letter">作</span>
          <span class="s__title__letter js-letter">品</span>
        </span>
      </h2>

      <div class="s__scene js-scene">
        {
          works.map((work, index) => (
            <ScrollLeaf
              cssClass="s__scene__work s__scene__work--image js-work"
              href={work.href}
              img={work.img}
              title={work.title}
              summary={work.summary}
              stack={work.stack}
              key={`卷 · ${cnNumerals[index] ?? index + 1}`}
            />
          ))
        }
      </div><!-- .s__scene -->

      <aside class="s__index" aria-label="作品索引">
        <div class="s__index__head" aria-hidden="true">
          <span class="s__index__head-note">格物八件</span>
          <span class="s__index__head-note s__index__head-note--sub">
            册页选集
          </span>
          <InkMeander
            height={9}
            width="min(10.5rem, 15vw)"
            class="s__index__head-band"
          />
        </div>

        {
          works.map((work, index) => (
          <a class="s__index__item" href={work.href}>
            <SealChar char={cnNumerals[index]} class="s__index__seal" />
            <span class="s__index__body">
              <span class="s__index__title">{work.name}</span>
              <span class="s__index__summary">{work.summary}</span>
            </span>
          </a>
          ))
        }
      </aside>

      <canvas class="s__canvas js-canvas" aria-hidden="true"></canvas>
    </div><!-- .s__inner -->

    <div class="s__mask-outer">
      <InkScroll class="s__roller s__roller--top" />
      <div class="s__mask js-mask">
        <svg class="s__mask__svg js-mask-svg">
          <path class="s__mask__path-inner js-mask-path-inner" d=""></path>
          <path class="s__mask__path-outer js-mask-path-outer" d=""></path>
          <path class="s__mask__path-lines js-mask-path-lines" d=""></path>
        </svg>
      </div><!-- .s__mask -->
      <InkScroll class="s__roller s__roller--bottom" flip />
    </div><!-- .s__mask-outer -->

    <div class="s__ruler js-ruler"></div>
  </div><!-- .s__outer -->
</section>

<script>
  import {
    whenReady,
    nextFrame,
    onFrame,
    onResize,
    onThemeFlip,
    onPointer,
    prefersReducedMotion,
    type Cleanup,
  } from '../motion/core'

  import { gsap } from 'gsap'
  import { SlowMo } from 'gsap/EasePack'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger, SlowMo)

  class Section {
    el: HTMLElement
    container: HTMLElement
    ruler: HTMLElement
    scene: HTMLElement
    canvas: HTMLCanvasElement
    ctx: CanvasRenderingContext2D
    title: HTMLElement

    mask: {
      width: number
      height: number
      maxScale: number
      lines: any[]
      el: HTMLElement
      svg: HTMLElement
      pathOuter: HTMLElement
      pathInner: HTMLElement
      pathLines: HTMLElement
    }

    bounding: {
      left: number
      top: number
      width: number
      height: number
    }
    letters: any[]
    works: any[]
    points: any[]
    pointFill: string
    pointSize: number

    tl: gsap.core.Timeline
    animationProgress: number
    pointsProgress: number
    last: {
      animationProgress: number
      pointsProgress: number
    }
    scrollProgress: number
    smoothScrollProgress: number
    state: 0
    speed: number
    isPaused: boolean
    loadIsStarted: boolean
    lastWidth: number
    lastHeight: number
    dpr = 1
    stops: Cleanup[] = []
    unframe: Cleanup | null = null
    destroyed = false
    pressTimer = 0

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-work')

      if (!this.el) {
        return
      }

      this.container = this.el.querySelector('.js-container')
      this.ruler = this.el.querySelector('.js-ruler')
      this.scene = this.container.querySelector('.js-scene')
      this.canvas = this.container.querySelector('.js-canvas')
      this.ctx = this.canvas.getContext('2d')
      this.title = this.container.querySelector('.js-title')

      // Properties
      this.mask = {
        width: 0,
        height: 0,
        maxScale: 1,
        lines: [],
        el: this.el.querySelector('.js-mask'),
        svg: this.el.querySelector('.js-mask-svg'),
        pathOuter: this.el.querySelector('.js-mask-path-outer'),
        pathInner: this.el.querySelector('.js-mask-path-inner'),
        pathLines: this.el.querySelector('.js-mask-path-lines'),
      }

      this.letters = []
      this.title.querySelectorAll('.js-letter').forEach((_letter) => {
        const letter = {
          el: _letter,
          ghosts: [],
        }

        this.letters.push(letter)
      })

      this.works = []
      this.container.querySelectorAll('.js-work').forEach((_work) => {
        const work = {
          el: _work,
        }

        this.works.push(work)
      })

      this.points = []
      this.pointFill = 'rgba(247, 248, 246, 0.88)'
      this.pointSize = 2
      this.dpr = 1

      this.scrollProgress = 0
      this.smoothScrollProgress = 0
      this.animationProgress = 0
      this.pointsProgress = 1
      this.last = {
        animationProgress: 0,
        pointsProgress: 0,
      }

      this.isPaused = true
      this.loadIsStarted = false
      this.lastWidth = window.innerWidth
      this.lastHeight = window.innerHeight

      whenReady(() => nextFrame(() => this.init()))
    }

    /**
     * Init
     */
    init() {
      if (this.destroyed || !this.el) return

      this.setCtxStyle()
      this.setSize()
      this.setMask()
      this.setPoints()
      this.setLetters()
      this.setWorks()
      this.setTimeline()

      this.bindEvents()
      this.bindFeel()
      this.syncVisibility()
      this.last.pointsProgress = -1
      this.drawPoints()
    }

    /**
     * SPA 换页收尾：帧循环、订阅、滚动时间线（含 ScrollTrigger）全部销毁，
     * 否则 ScrollTrigger 会逐次累积并在死 DOM 上计算
     */
    destroy() {
      this.destroyed = true
      this.stopFrame()
      this.stops.forEach((stop) => stop())
      this.stops = []
      window.clearTimeout(this.pressTimer)
      this.pressTimer = 0
      this.killTimeline()

      this.letters.forEach((letter) => {
        letter.ghosts?.forEach((ghost) => ghost.el?.remove())
        letter.ghosts = []
      })
      this.scene
        ?.querySelectorAll('.s__scene__letter')
        .forEach((node) => node.remove())

      this.works.forEach((work) => {
        const el = work.el as HTMLElement | undefined
        el?.classList.remove('is-cover-live', 'is-pressing')
      })

      this.el?.classList.remove('is-blank-press')
      this.el?.style.removeProperty('--mask-nudge-x')
      this.el?.style.removeProperty('--mask-nudge-y')
      this.el?.style.removeProperty('--scroll-progress')

      if (this.ctx && this.canvas) {
        this.ctx.setTransform(1, 0, 0, 1, 0, 0)
        this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height)
      }

      this.points = []
    }

    killTimeline() {
      if (!this.tl) return
      this.tl.scrollTrigger?.kill()
      this.tl.kill()
      this.tl = null
    }

    /**
     * Bind events
     */
    bindEvents() {
      this.stops.push(
        onThemeFlip(() => {
          if (!this.destroyed) this.setCtxStyle()
        })
      )
      this.stops.push(
        onResize(({ width, height }) => {
          const widthChanged = width !== this.lastWidth
          const heightChanged = height !== this.lastHeight
          this.lastWidth = width
          this.lastHeight = height
          this.onResize(widthChanged, heightChanged)
        })
      )

      this.el.addEventListener('intersect', this.onIntersect, {
        passive: true,
      })
      this.stops.push(() =>
        this.el.removeEventListener('intersect', this.onIntersect)
      )

      if (typeof ResizeObserver === 'function') {
        const ro = new ResizeObserver(() => {
          if (!this.destroyed) ScrollTrigger.refresh()
        })
        ro.observe(this.el)
        this.stops.push(() => ro.disconnect())
      }
    }

    /**
     * 册页微感：封面窗内游移、指针受光、点按回弹；
     * 点空白则震一下遮罩格线与远山。reduced-motion 整段跳过。
     */
    bindFeel() {
      if (prefersReducedMotion()) return

      const fine = window.matchMedia(
        '(hover: hover) and (pointer: fine)'
      ).matches

      if (fine) {
        this.stops.push(
          onPointer(({ x, y }) => {
            if (this.destroyed || this.isPaused || !this.el) return
            const nx = (x / window.innerWidth - 0.5) * 2
            const ny = (y / window.innerHeight - 0.5) * 2
            this.el.style.setProperty('--mask-nudge-x', (nx * 10).toFixed(2))
            this.el.style.setProperty('--mask-nudge-y', (ny * 6).toFixed(2))
          })
        )

        this.works.forEach((work) => {
          const el = work.el as HTMLElement
          const onEnter = () => el.classList.add('is-cover-live')
          const onMove = (e: PointerEvent) => {
            const rect = el.getBoundingClientRect()
            if (!rect.width || !rect.height) return
            const px = (e.clientX - rect.left) / rect.width - 0.5
            const py = (e.clientY - rect.top) / rect.height - 0.5
            el.style.setProperty('--leaf-sheen', (0.5 - px).toFixed(3))
            el.style.setProperty('--cover-pan', (px * -14).toFixed(1) + 'px')
            el.style.setProperty(
              '--cover-tilt-x',
              (py * -1.6).toFixed(2) + 'deg'
            )
            el.style.setProperty(
              '--cover-tilt-y',
              (px * 3.2).toFixed(2) + 'deg'
            )
          }
          const onLeave = () => {
            el.classList.remove('is-cover-live')
            el.style.setProperty('--leaf-sheen', '0.5')
            el.style.setProperty('--cover-pan', '0px')
            el.style.setProperty('--cover-tilt-x', '0deg')
            el.style.setProperty('--cover-tilt-y', '0deg')
          }

          el.addEventListener('pointerenter', onEnter, { passive: true })
          el.addEventListener('pointermove', onMove, { passive: true })
          el.addEventListener('pointerleave', onLeave, { passive: true })
          this.stops.push(() => {
            el.removeEventListener('pointerenter', onEnter)
            el.removeEventListener('pointermove', onMove)
            el.removeEventListener('pointerleave', onLeave)
          })
        })
      }

      const onPress = (e: Event) => this.onPress(e)
      this.el.addEventListener('pointerdown', onPress)
      this.stops.push(() => this.el.removeEventListener('pointerdown', onPress))
    }

    /**
     * 点册页 / 索引：落印一顿再走主链；
     * 点空白（遮罩、纸底、远山）：格线与山脚轻轻一震。
     */
    onPress = (e: Event) => {
      if (this.destroyed || prefersReducedMotion() || !this.el) return
      const target = e.target as Element | null
      if (!target) return

      const card = target.closest('scroll-leaf, .s__index__item')
      if (card) {
        card.classList.add('is-pressing')
        window.clearTimeout(this.pressTimer)
        this.pressTimer = window.setTimeout(() => {
          card.classList.remove('is-pressing')
        }, 280)
        return
      }

      this.el.classList.remove('is-blank-press')
      void this.el.offsetWidth
      this.el.classList.add('is-blank-press')
      window.clearTimeout(this.pressTimer)
      this.pressTimer = window.setTimeout(() => {
        this.el?.classList.remove('is-blank-press')
      }, 520)
    }

    startFrame() {
      if (this.unframe) return
      this.unframe = onFrame(() => this.tick())
    }

    stopFrame() {
      this.unframe?.()
      this.unframe = null
    }

    /**
     * Resize handler
     */
    onResize(widthChanged, heightChanged = false) {
      if (this.destroyed || !this.el) return

      if (widthChanged) {
        this.setCtxStyle()
        this.setSize()
        this.setMask()
        this.setPoints()
        this.setLetters()
        this.setWorks()
        this.setTimeline()
        return
      }

      if (heightChanged) {
        this.setSize()
        this.setMask()
        this.setPoints()
        this.last.pointsProgress = -1
        this.drawPoints()
        if (this.tl?.scrollTrigger) ScrollTrigger.refresh()
      }
    }

    /**
     * Intersect handler
     */
    onIntersect = (e: CustomEvent) => {
      if (this.destroyed || !this.el) return

      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) this.stopFrame()
      else this.startFrame()

      if (!this.loadIsStarted) {
        this.loadIsStarted = true
      }
    }

    /**
     * pageSetup 的 IntersectionObserver 可能先于本段 bind 就派过一次，
     * 用 is-in-view 把漏掉的入屏补上，否则格点永远不画、封面不飞。
     */
    syncVisibility() {
      if (this.destroyed || !this.el) return
      const marked = this.el.classList.contains('is-in-view')
      const rect = this.el.getBoundingClientRect()
      const inView =
        marked || (rect.bottom > 0 && rect.top < (window.safeHeight || window.innerHeight))
      this.isPaused = !inView
      if (this.isPaused) this.stopFrame()
      else this.startFrame()
    }

    /**
     * 格点填色：内底始终是墨青，点必须是疏朗白方点。
     * canvas fillStyle 不吃 color-mix，一律写成 rgba。
     */
    setCtxStyle() {
      if (!this.el) return
      const dark = document.documentElement.classList.contains(
        'theme-contrasted'
      )

      this.pointFill = dark
        ? 'rgba(247, 248, 246, 0.92)'
        : 'rgba(247, 241, 230, 0.78)'

      this.last.pointsProgress = -1
      if (this.bounding && this.points.length) this.drawPoints()
    }

    /**
     * Set size
     */
    setSize() {
      this.el.style.setProperty('--height', this.works.length * 55 + 'lvh')

      const bounding = this.container.getBoundingClientRect()
      const width = window.safeWidth || window.innerWidth
      const height = window.safeHeight || window.innerHeight
      const dpr = Math.min(window.devicePixelRatio || 1, 2)

      this.dpr = dpr
      this.bounding = {
        left: bounding.left,
        top: bounding.top,
        width,
        height,
      }

      this.canvas.width = Math.round(width * dpr)
      this.canvas.height = Math.round(height * dpr)
      this.canvas.style.width = width + 'px'
      this.canvas.style.height = height + 'px'
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      this.ctx.imageSmoothingEnabled = false

      this.speed = Math.hypot(width, height) * 4
    }

    /**
     * Set mask
     */
    setMask() {
      const { mask } = this

      const width = mask.el.clientWidth
      const height = mask.el.clientHeight

      mask.width = width
      mask.height = height

      mask.svg.style.width = mask.width + 'px'
      mask.svg.style.height = mask.height + 'px'

      const elBounding = this.el.getBoundingClientRect()
      const rulerBounding = this.ruler.getBoundingClientRect()
      const rulerWidth = rulerBounding.width
      const rulerHeight = rulerBounding.height
      const offsetX = rulerBounding.left - elBounding.left
      const offsetY = rulerBounding.top - elBounding.top

      // Shape
      const dOuter = `M -1 0 L ${width + 2} 0 L ${width + 2} ${height} L -1 ${height} Z`

      // Mask outer
      const corners = {
        tl: { x: offsetX, y: offsetY },
        tr: { x: offsetX + rulerWidth, y: offsetY },
        br: { x: offsetX + rulerWidth, y: offsetY + rulerHeight },
        bl: { x: offsetX, y: offsetY + rulerHeight },
      }

      let size = (corners.tr.x - corners.tl.x) / 2

      mask.maxScale = window.safeWidth / size

      let dInner = `M ${corners.tl.x} ${corners.tl.y + size} A ${size} ${size} 0 0 1 ${corners.tr.x} ${corners.tr.y + size} L ${corners.br.x} ${corners.br.y - size} A ${size} ${size} 0 0 1 ${corners.bl.x} ${corners.bl.y - size} Z`
      const linesClip = `${dOuter} ${dInner}`

      mask.pathOuter.setAttribute('d', `${dOuter} ${dInner}`)

      // Mask inner
      const thickness = window.safeWidth > 767 ? 16 : 8
      corners.tl.x += thickness
      corners.tl.y += thickness

      corners.tr.x -= thickness
      corners.tr.y += thickness

      corners.br.x -= thickness
      corners.br.y -= thickness

      corners.bl.x += thickness
      corners.bl.y -= thickness

      size = (corners.tr.x - corners.tl.x) / 2

      dInner = `M ${corners.tl.x} ${corners.tl.y + size} A ${size} ${size} 0 0 1 ${corners.tr.x} ${corners.tr.y + size} L ${corners.br.x} ${corners.br.y - size} A ${size} ${size} 0 0 1 ${corners.bl.x} ${corners.bl.y - size} Z`

      mask.pathInner.setAttribute('d', `${dOuter} ${dInner}`)

      // Lines
      mask.lines = []

      const vLines = window.safeWidth > 767 ? 10 : 6
      const gapX = width / vLines
      const gapY = height * 0.1
      const hLines = Math.ceil(height / gapY)

      for (let i = 1; i < vLines; i++) {
        const x = gapX * i

        mask.lines.push({
          p1: { x, y: 0 },
          p2: { x, y: height },
        })
      }

      for (let i = 0; i < hLines; i++) {
        const y = gapY * i

        mask.lines.push({
          p1: { x: 0, y },
          p2: { x: width, y },
        })
      }

      let dLines = ''

      mask.lines.forEach((line) => {
        dLines += `M ${line.p1.x} ${line.p1.y} L ${line.p2.x} ${line.p2.y} `
      })

      mask.pathLines.setAttribute('d', dLines)
      mask.pathLines.style.clipPath = `path(evenodd, '${linesClip}')`
    }

    /**
     * Set letters
     */
    setLetters() {
      const { letters, scene } = this

      scene
        ?.querySelectorAll('.s__scene__letter')
        .forEach((node) => node.remove())

      letters.forEach((letter, j) => {
        letter.ghosts.forEach((ghost) => {
          ghost.el.remove()
        })
        letter.ghosts = []

        // Get letter position and size
        const bounding = letter.el.getBoundingClientRect()

        letter.width = bounding.width
        letter.height = bounding.height
        letter.top = bounding.top - this.bounding.top
        letter.left = bounding.left

        letter.freq = 1 + Math.random()

        const multiplier = window.safeWidth > 767 ? 0.5 : 0.35

        // Create ghost letters
        letter.total =
          Math.round((this.bounding.width / letter.width) * multiplier) + 2

        for (let i = 0; i < letter.total; i++) {
          const el = document.createElement('span')
          el.classList.add('s__scene__letter')
          el.classList.add('js-letter')

          el.innerText = letter.el.innerText
          el.dataset.letter = letter.el.innerText

          scene.appendChild(el)

          const ghost = {
            el,
            x: letter.left,
            y: letter.top,
            z: Math.random() * 100,
            i: i - letter.total * 0.5,
            p: (i / letter.total - 0.5) * 2,
            ap: Math.abs(i / letter.total - 0.5) * 2,
            mx: 0,
            my: 0,
          }

          el.style.top = ghost.y + 'px'
          el.style.left = ghost.x + 'px'

          el.style.zIndex = String(j !== 1 && j !== 2 && (j + letters.length + i) % 5 === 0 ? 3 : 1)

          el.style.setProperty('--ix', String(ghost.i))
          el.style.setProperty(
            '--iy',
            String(((j + 1) / (letters.length + 1) - 0.5) * 2)
          )

          el.style.setProperty('--ap', String(ghost.ap))
          el.style.setProperty('--p', String(ghost.p))

          letter.ghosts.push(ghost)
        }
      })
    }

    /**
     * Set works
     */
    setWorks() {
      const { works } = this

      works.forEach((work, i) => {
        const el = work.el

        const unit = ((i * 47 + 13) % 100) / 100
        el.style.setProperty('--size', String(0.55 + unit * 0.4))
        el.style.setProperty(
          '--y',
          String((0.42 + ((i * 31) % 45) / 100) * (i % 2 ? -1 : 1))
        )

        /* 封面裱进窗框：只包图片，不碰签条与题识，主链仍是 <a href> */
        const img = el.querySelector('.js-image') as HTMLImageElement | null
        if (img) {
          img.loading = 'eager'
          img.decoding = 'async'
          if (!img.closest('.leaf__figure')) {
            const figure = document.createElement('span')
            figure.className = 'leaf__figure'
            img.parentNode?.insertBefore(figure, img)
            figure.appendChild(img)
          }
          img.decode?.().catch(() => {})
        }
      })
    }

    /**
     * Set timeline
     */
    setTimeline() {
      if (this.destroyed || !this.el) return

      /* reduced-motion：不绑 scrub，册页停在画心并露出封面 */
      if (prefersReducedMotion()) {
        this.killTimeline()
        this.works.forEach((work) => {
          work.el.setAttribute('progress', '0')
        })
        this.pointsProgress = 1
        this.last.pointsProgress = -1
        this.drawPoints()
        return
      }

      const { el, container, works, scene, mask } = this

      const worksEl = works.map((work) => work.el)

      this.killTimeline()

      const tl = (this.tl = gsap.timeline({
        scrollTrigger: {
          trigger: el,
          start: 'top 25%',
          end: 'bottom 75%',
          scrub: 1,
        },
        onUpdate: () => {
          scene.style.setProperty('--state', String(this.state))
        },
      }))

      tl.fromTo(
        mask.el,
        {
          scale: 1,
        },
        {
          scale: mask.maxScale,
          duration: 0.75,
          ease: 'power4.in',
        },
        0
      )

      tl.fromTo(
        scene,
        {
          scale: 0.75,
        },
        {
          scale: 1,
          duration: 0.75,
          ease: 'power3.in',
        },
        0
      )

      tl.fromTo(
        container,
        {
          clipPath: 'inset(0 1rem)',
        },
        {
          clipPath: 'inset(0 0rem)',
          duration: 0.75,
          ease: 'power3.in',
        },
        0
      )

      tl.fromTo(
        this,
        {
          pointsProgress: 0,
        },
        {
          pointsProgress: 1,
          duration: 1,
          ease: 'power4.inOut',
        },
        0
      )

      tl.fromTo(
        this,
        {
          state: 0,
        },
        {
          state: 1,
          duration: 0.75,
          ease: 'power4.in',
        },
        0
      )

      tl.fromTo(
        worksEl,
        {
          attr: {
            progress: 1,
          },
        },
        {
          attr: {
            progress: -1,
          },
          ease: 'slow(0.15, 0.6)',
          stagger: 0.25,
        },
        0.75
      )

      tl.fromTo(
        this,
        {
          animationProgress: 0,
        },
        {
          animationProgress: 10000,
          duration: tl.totalDuration(),
          ease: 'power1.out',
        },
        0.75
      )

      tl.fromTo(
        this,
        {
          state: 1,
        },
        {
          state: 0,
          duration: 0.75,
          ease: 'power4.inOut',
          immediateRender: false,
        },
        '-=1'
      )

      tl.fromTo(
        mask.el,
        {
          scale: mask.maxScale,
        },
        {
          scale: 1,
          duration: 0.75,
          ease: 'power4.inOut',
          immediateRender: false,
        },
        '-=1'
      )

      tl.fromTo(
        scene,
        {
          scale: 1,
        },
        {
          scale: 0.75,
          duration: 0.75,
          ease: 'power3.inOut',
          immediateRender: false,
        },
        '-=1'
      )

      tl.fromTo(
        container,
        {
          clipPath: 'inset(0 0rem)',
        },
        {
          clipPath: 'inset(0 1rem)',
          duration: 0.75,
          ease: 'power3.inOut',
          immediateRender: false,
        },
        '-=1'
      )

      tl.fromTo(
        this,
        {
          pointsProgress: 1,
        },
        {
          pointsProgress: 0,
          duration: 1,
          ease: 'power4.inOut',
        },
        '-=1'
      )
    }

    /**
     * Move letters
     */
    moveLetters() {
      const { speed, letters, animationProgress } = this

      letters.forEach((letter, i) => {
        const letterSpeed = speed * letter.freq
        letter.ghosts.forEach((ghost, index) => {
          let progress =
            (((animationProgress % letterSpeed) / letterSpeed +
              index / letter.total) %
              1) /
              0.7 -
            0.15

          ghost.el.style.setProperty('--progress', String(progress))
        })
      })
    }

    /**
     * Set points
     */
    setPoints() {
      const { bounding } = this

      this.points = []

      /* 制图点阵：2px 实心白方点，间距疏（约 52–56px），正交对齐 */
      const wide = (window.safeWidth || window.innerWidth) > 767
      const gap = wide ? 52 : 56
      this.pointSize = 2
      const cols = Math.ceil((bounding.width * 1.2) / gap)
      const rows = Math.ceil((bounding.height * 1.2) / gap)

      const offsetX = (bounding.width - cols * gap) * 0.5
      const offsetY = (bounding.height - rows * gap) * 0.5

      const hWidth = bounding.width * 0.5
      const hHeight = bounding.height * 0.5

      for (let i = 0; i < cols; i++) {
        for (let j = 0; j < rows; j++) {
          const x = i * gap + offsetX
          const y = j * gap + offsetY

          const dx = hWidth - x
          const dy = hHeight - y

          this.points.push({
            x,
            y,
            dx,
            dy,
            m: Math.random(),
            flowX: 0,
          })
        }
      }
    }

    /**
     * Move points
     */
    movePoints() {
      const { points, animationProgress } = this

      points.forEach((p) => {
        // Flow
        p.flowX = (animationProgress * -0.05) % 24
      })
    }

    /**
     * Draw points
     */
    drawPoints() {
      const { bounding, ctx, points, animationProgress, pointsProgress, last } =
        this

      if (this.destroyed || !ctx || !bounding) return

      const rAnimationProgress = Math.round(animationProgress * 100) / 100
      const rPointsProgress = Math.round(pointsProgress * 100) / 100

      if (
        rPointsProgress === last.pointsProgress &&
        rAnimationProgress === last.animationProgress
      )
        return

      const dpr = this.dpr || 1
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.imageSmoothingEnabled = false
      ctx.clearRect(0, 0, bounding.width, bounding.height)

      ctx.fillStyle = this.pointFill
      const size = this.pointSize

      points.forEach((point) => {
        const rawX =
          point.x + point.dx * (1 - pointsProgress) * 0.2 + point.flowX
        const rawY = point.y + point.dy * (1 - pointsProgress) * 0.2
        const x = Math.round(rawX * dpr) / dpr
        const y = Math.round(rawY * dpr) / dpr

        ctx.fillRect(x, y, size, size)
      })

      last.pointsProgress = rPointsProgress
      last.animationProgress = rAnimationProgress
    }

    /**
     * Tick
     */
    tick() {
      if (this.destroyed || !this.el) return

      // Calculate scroll progress
      this.scrollProgress =
        Math.max(
          Math.min(1, ScrollTrigger.positionInViewport(this.el, 'top')),
          0
        ) *
          -1 +
        (1 -
          Math.max(
            Math.min(1, ScrollTrigger.positionInViewport(this.el, 'bottom')),
            0
          ))
      this.smoothScrollProgress +=
        (this.scrollProgress - this.smoothScrollProgress) * 0.1

      this.el.style.setProperty(
        '--scroll-progress',
        String(this.scrollProgress)
      )

      // Movement
      this.movePoints()
      this.moveLetters()

      // Draw
      this.drawPoints()
    }
  }

  /* ClientRouter 下模块脚本只执行一次：每次换页对新 DOM 重建，先收旧实例 */
  const mountWork = () => {
    const prev = (window as any).__sWork
    try {
      prev?.destroy?.()
    } catch (e) {}
    ;(window as any).__sWork = document.querySelector('.s-work')
      ? new Section()
      : null
  }

  document.addEventListener('astro:page-load', mountWork)
  document.addEventListener('astro:before-swap', () => {
    try {
      ;(window as any).__sWork?.destroy?.()
    } catch (e) {}
    ;(window as any).__sWork = null
  })
</script>

