---
/**
 * StudioClock — 「工作室的灯」
 * 显示来访者本地时间与时段（晨光/白昼/暮色/夜灯），
 * 在 <html> 上设置 data-daypart，联动全站灯色。
 */
---

<span class="studio-clock" role="status" aria-live="polite" aria-label="本地时间">
  <span class="studio-clock__lamp" aria-hidden="true"></span>
  <span class="studio-clock__time">--:--</span>
  <span class="studio-clock__part">亮灯</span>
</span>

<script>
  import {
    formatClockTime,
    getDaypart,
    startDaypartTicker,
  } from '../utils/daypart'

  function paintClock() {
    const clock = document.querySelector('.studio-clock')
    if (!clock) return

    const now = new Date()
    const part = getDaypart(now)
    const time = formatClockTime(now)
    const timeEl = clock.querySelector('.studio-clock__time')
    const partEl = clock.querySelector('.studio-clock__part')

    if (timeEl) timeEl.textContent = time
    if (partEl) partEl.textContent = part.label
    clock.setAttribute('aria-label', `本地时间 ${time} · ${part.label}`)
  }

  startDaypartTicker(paintClock)
  document.addEventListener('astro:page-load', paintClock)
</script>
