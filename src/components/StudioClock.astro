---
/**
 * StudioClock — 「工作室的灯」
 * 显示来访者本地时间与时段（晨光/白昼/暮色/夜灯），
 * 在 <html> 上设置 data-daypart，联动全站灯色。
 */
---

<span class="studio-clock" role="status" aria-label="本地时间">
  <span class="studio-clock__lamp" aria-hidden="true"></span>
  <span class="studio-clock__time">--:--</span>
  <span class="studio-clock__part">亮灯</span>
</span>

<script>
  (function () {
    function daypart(hour) {
      if (hour >= 5 && hour < 8) return { key: 'dawn', label: '晨光' };
      if (hour >= 8 && hour < 17) return { key: 'day', label: '白昼' };
      if (hour >= 17 && hour < 20) return { key: 'dusk', label: '暮色' };
      return { key: 'night', label: '夜灯' };
    }

    /* 每次都重新取元素：ClientRouter 换页后旧节点已销毁，
       捕获式引用会让新时钟永远停在 SSR 占位文案上 */
    function sync() {
      var now = new Date();
      var part = daypart(now.getHours());
      document.documentElement.setAttribute('data-daypart', part.key);

      var clock = document.querySelector('.studio-clock');
      if (!clock) return;
      clock.querySelector('.studio-clock__time').textContent =
        String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
      clock.querySelector('.studio-clock__part').textContent = part.label;
    }

    sync();
    var delay = 60000 - (Date.now() % 60000);
    setTimeout(function () {
      sync();
      setInterval(sync, 60000);
    }, delay);

    document.addEventListener('astro:page-load', sync);
  })();
</script>
