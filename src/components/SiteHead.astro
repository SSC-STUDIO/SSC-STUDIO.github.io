---
import SenMark from './SenMark.astro'
import { headerLinks, homeChapters, siteIndex, type HeaderLink } from '../data/nav'
import { isNavCurrent, normalizePath } from '../utils/nav-current'

const isSubpage = Astro.url.pathname !== '/'

// 当前页路径（去尾斜杠），用于导航 aria-current 标记
const currentPath = normalizePath(Astro.url.pathname)
const currentHash = Astro.url.hash

const menu: HeaderLink[] = isSubpage
  ? [{ href: '/', label: '首页', tier: 1 }, ...headerLinks]
  : headerLinks

const groupNumerals = ['壹', '贰', '叁', '肆', '伍', '陆']

const consoleLines = [
  '班级记忆现场 · 41 人',
  '正在同步 benchmark 分数…',
  '编译好奇心为可运行代码…',
  'monorepo 热更新中…',
  'Python → TypeScript 进化链加载完成',
  '创客项目队列：智造 · 模型 · 编程',
  '信息学竞赛模块就绪',
  'AI 实验沙箱待命',
  '班级画廊索引重建中…',
  '把作品写进可展示的光里',
]
---

<header
  class:list={['site-head', isSubpage && 'is-ready']}
  data-intersect
  data-subpage={isSubpage ? 'true' : undefined}
>
  <div class="site-head__container">
    <div class="sb-logo">
      <a href="/">
        <SenMark size={44} />

        <span class="u-sr-only">陈润森</span>
      </a>
    </div><!-- .sb-logo -->

    <div class="sb-console" role="presentation">
      <div
        class="sb-console__inner js-console"
        data-lines={JSON.stringify(consoleLines)}
      >
      </div><!-- .sb-console__inner -->
    </div><!-- .sb-console -->

    <nav class="sb-menu" aria-label="主导航">
      <ul class="sb__list">
        {
          menu.map((item) => (
            <li class={`sb__item sb__item--tier-${item.tier} js-menu-item`}>
              <a
                href={item.href}
                class="js-menu-link"
                aria-current={
                  isNavCurrent(item.href, currentPath, currentHash)
                    ? 'page'
                    : undefined
                }
              >
                <span class="sb__text">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav><!-- .sb-menu -->

    <button
      class="sb-index js-index-open"
      type="button"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="site-index"
    >
      <span class="sb-index__glyph" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="sb-index__text">目录</span>
    </button><!-- .sb-index -->

    <ul class="sb-socials">
      <li class="sb__item">
        <a href="https://github.com/SSC-STUDIO" target="_blank" rel="noopener">
          <span class="sb__icon sb__icon--github" aria-hidden="true">
            <span class="sb__icon__label">GH</span>
          </span>

          <span class="u-sr-only">GitHub @SSC-STUDIO</span>
        </a>
      </li>

      <li class="sb__item">
        <a href="mailto:3992237161@qq.com" data-copy-email>
          <span class="sb__icon sb__icon--mail" aria-hidden="true">
            <span class="sb__icon__label">@</span>
          </span>

          <span class="u-sr-only">Email 3992237161@qq.com</span>
        </a>
      </li>
    </ul><!-- .sb-socials -->

    <button class="sb-contrast js-contrast" type="button">
      <span
        class="sb__icon"
        style="--path: path('M10.0996 20C8.71628 20 7.41628 19.7373 6.19961 19.212C4.98294 18.6867 3.92461 17.9743 3.02461 17.075C2.12461 16.1757 1.41228 15.1173 0.887611 13.9C0.362944 12.6827 0.100277 11.3827 0.0996106 10C0.098944 8.61733 0.361611 7.31733 0.887611 6.1C1.41361 4.88267 2.12594 3.82433 3.02461 2.925C3.92328 2.02567 4.98161 1.31333 6.19961 0.788C7.41761 0.262667 8.71761 0 10.0996 0C11.4816 0 12.7816 0.262667 13.9996 0.788C15.2176 1.31333 16.2759 2.02567 17.1746 2.925C18.0733 3.82433 18.7859 4.88267 19.3126 6.1C19.8393 7.31733 20.1016 8.61733 20.0996 10C20.0976 11.3827 19.8349 12.6827 19.3116 13.9C18.7883 15.1173 18.0759 16.1757 17.1746 17.075C16.2733 17.9743 15.2149 18.687 13.9996 19.213C12.7843 19.739 11.4843 20.0013 10.0996 20ZM11.0996 17.925C13.0829 17.675 14.7456 16.804 16.0876 15.312C17.4296 13.82 18.1003 12.0493 18.0996 10C18.0989 7.95067 17.4279 6.18 16.0866 4.688C14.7453 3.196 13.0829 2.325 11.0996 2.075V17.925Z');"
      >
      </span>

      <span class="u-sr-only">切换深色模式</span>
    </button><!-- .sb-contrast -->

    <aside class="sb-availability">
      <p>
        <span class="sb__line">
          <span class="sb__text">在中国做长期实验。</span>
        </span>

        <span class="sb__line">
          <span class="sb__text">欢迎合作 →</span>

          <a href="mailto:3992237161@qq.com" class="sb__link" data-copy-email>写信</a>
        </span>
      </p>
    </aside><!-- .sb-availability -->

    <a href="/contact"
      class="sb-qr-code js-qr-code"
      title="Contact me!"
    >
      <img src="/images/qr-code.svg" alt="网站二维码" width="72" height="72" />
    </a><!-- .sb-qr-code -->
  </div><!-- .site-head__container -->

  <dialog
    class="site-index js-site-index"
    id="site-index"
    aria-labelledby="site-index-title"
    data-lenis-prevent
  >
    <div class="site-index__scroll">
      <div class="site-index__sheet">
        <div class="site-index__head">
          <p class="site-index__kicker">总目 · Index</p>
          <h2 class="site-index__title" id="site-index-title">全站目录</h2>
          <button class="site-index__close js-index-close" type="button">
            <span class="site-index__close-mark" aria-hidden="true"></span>
            <span class="site-index__close-text">收起</span>
          </button>
        </div>

        {
          !isSubpage && (
            <nav class="site-index__chapters" aria-label="首页章节">
              <span class="site-index__chapters-label">本页</span>
              {homeChapters.map((chapter) => (
                <a class="site-index__chapter js-index-chapter" href={chapter.href}>
                  {chapter.label}
                </a>
              ))}
            </nav>
          )
        }

        <div class="site-index__groups">
          {
            siteIndex.map((group, groupIndex) => (
              <section
                class="site-index__group"
                aria-labelledby={`site-index-group-${groupIndex}`}
                style={`--group-i:${groupIndex}`}
              >
                <h3 class="site-index__group-title" id={`site-index-group-${groupIndex}`}>
                  <span class="site-index__numeral" aria-hidden="true">
                    {groupNumerals[groupIndex]}
                  </span>
                  {group.title}
                </h3>
                <ul class="site-index__list">
                  {group.items.map((item) => (
                    <li>
                      <a
                        class="site-index__link js-index-link"
                        href={item.href}
                        data-astro-reload={item.standalone ? '' : undefined}
                        aria-current={
                          isNavCurrent(item.href, currentPath, currentHash)
                            ? 'page'
                            : undefined
                        }
                      >
                        <span class="site-index__label">{item.label}</span>
                        <span class="site-index__note">{item.note}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>

        <p class="site-index__foot">
          按 Esc 或点空白处收起 · 陈润森 · Chen Runsen
        </p>
      </div>
      <span class="site-index__rod" aria-hidden="true"></span>
    </div>
  </dialog>
</header>

<script>
  import {
    onFrame,
    signalThemeFlip,
    type Cleanup,
  } from '../motion/core'
  import { isNavCurrent } from '../utils/nav-current'

  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'

  const STORAGE_KEY = 'site-theme'
  const THEME_COLORS = {
    light: '#f4ead8',
    dark: '#0e1412',
  }

  /**
   * Get persisted theme ("light" | "dark" | null)
   */
  function getStoredTheme(): 'light' | 'dark' | null {
    try {
      const stored = localStorage.getItem(STORAGE_KEY)
      if (stored === 'light' || stored === 'dark') {
        return stored
      }
    } catch (e) {}
    return null
  }

  /**
   * Resolve current theme (stored, else system preference)
   */
  function resolveTheme(): 'light' | 'dark' {
    const stored = getStoredTheme()
    if (stored) {
      return stored
    }
    return window.matchMedia('(prefers-color-scheme: dark)').matches
      ? 'dark'
      : 'light'
  }

  /**
   * Apply theme on the root element and persist it
   */
  function applyTheme(theme: 'light' | 'dark', persist: boolean = true) {
    const root = document.documentElement
    const isDark = theme === 'dark'

    // 主题切换动画：450ms 颜色过渡，结束后移除
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (!reduced) {
      root.classList.add('theme-animating')
      window.setTimeout(() => root.classList.remove('theme-animating'), 500)
    }

    root.classList.toggle('theme-contrasted', isDark)
    root.dataset.theme = theme

    if (persist) {
      try {
        localStorage.setItem(STORAGE_KEY, theme)
      } catch (e) {}
    }

    updateThemeMetas(theme)
  }

  /**
   * Sync theme-color metas with the current theme
   */
  function updateThemeMetas(theme: 'light' | 'dark' = resolveTheme()) {
    const color = THEME_COLORS[theme]
    document
      .querySelectorAll(
        'meta[name="theme-color"], meta[name="msapplication-navbutton-color"], meta[name="apple-mobile-web-app-status-bar-style"]'
      )
      .forEach((meta) => {
        meta.setAttribute('content', color)
      })
  }

  const INDEX_CLOSE_MS = 280

  function easeScroll(t: number) {
    return t < 0.5 ? 16 * t * t * t * t * t : 1 + 16 * --t * t * t * t * t
  }

  class Section {
    el: HTMLElement
    contrastButton: HTMLElement
    console: HTMLElement
    contrastMask: HTMLElement
    links: NodeListOf<HTMLElement>
    index: HTMLDialogElement | null = null
    indexOpenButton: HTMLElement | null = null
    indexLinks: HTMLAnchorElement[] = []
    indexCloseTimer = 0

    isSubPage: boolean

    messages: string[]
    message: string
    messageLineBreak: boolean
    lastMessage: string
    lastTypeTime: number
    writeDelay: number
    canWrite: boolean
    isPaused: boolean
    unframe: Cleanup | null = null

    /**
     * Constructor
     */
    abort: AbortController

    constructor() {
      this.message = ''
      this.messageLineBreak = false
      this.lastMessage = ''
      this.lastTypeTime = 0
      this.writeDelay = 0
      this.canWrite = false
      this.isPaused = true
      this.rebind()
    }

    rebind() {
      this.stopFrame()
      this.abort?.abort()
      this.abort = new AbortController()

      this.el = document.querySelector('.site-head')
      this.contrastButton = document.querySelector('.js-contrast')
      this.console = document.querySelector('.js-console')
      this.contrastMask = document.querySelector('.js-contrast-mask')
      if (!this.el) return

      this.links = this.el.querySelectorAll('.js-menu-link')
      this.index = this.el.querySelector('.js-site-index')
      this.indexOpenButton = this.el.querySelector('.js-index-open')
      this.indexLinks = Array.from(
        this.el.querySelectorAll<HTMLAnchorElement>('.js-index-link')
      )
      this.isSubPage = this.el.dataset.subpage === 'true'
      this.messages = JSON.parse(this.console?.dataset.lines ?? '[]')

      this.bindEvents()
      applyTheme(resolveTheme(), false)
      this.syncNav()
      this.syncContrastPressed()

      const introSeen =
        typeof sessionStorage !== 'undefined' &&
        sessionStorage.getItem('site-intro-seen') === '1'
      const siteReady =
        document.documentElement.classList.contains('is-site-ready')
      if (this.isSubPage || introSeen || siteReady) {
        this.el.classList.add('is-ready')
        this.canWrite = true
      } else {
        document.addEventListener('intro', this.intro.bind(this), {
          once: true,
          signal: this.abort.signal,
        })
      }

      this.scrollToHash()
    }

    bindEvents() {
      const { signal } = this.abort

      this.contrastButton?.addEventListener(
        'click',
        this.toggleContrast.bind(this),
        { passive: true, signal }
      )

      this.links.forEach((link) => {
        link.addEventListener('click', this.onNavClick.bind(this), {
          signal,
        })
      })

      this.el.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
        signal,
      })

      window.addEventListener('hashchange', this.syncNav.bind(this), {
        signal,
      })

      this.bindIndex(signal)
    }

    /**
     * 全站目录：原生 <dialog> 负责焦点圈定与 Esc，这里补动画、滚动锁和换页收尾
     */
    bindIndex(signal: AbortSignal) {
      const dialog = this.index
      if (!dialog) return

      this.indexOpenButton?.addEventListener('click', () => this.openIndex(), {
        signal,
      })

      dialog
        .querySelector('.js-index-close')
        ?.addEventListener('click', () => this.closeIndex(), { signal })

      dialog.addEventListener(
        'cancel',
        (event) => {
          event.preventDefault()
          this.closeIndex()
        },
        { signal }
      )

      // 弹层铺满视口，纸面之外点到的就是 dialog 自身
      dialog.addEventListener(
        'click',
        (event) => {
          if (event.target === dialog) this.closeIndex()
        },
        { signal }
      )

      dialog.addEventListener('close', () => this.onIndexClosed(), { signal })

      this.indexLinks.forEach((link) => {
        link.addEventListener(
          'click',
          (event) => {
            if (
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            ) {
              return
            }
            this.closeIndex(true)
          },
          { signal }
        )
      })

      dialog.querySelectorAll<HTMLAnchorElement>('.js-index-chapter').forEach((link) => {
        link.addEventListener('click', (event) => this.onIndexChapter(event), {
          signal,
        })
      })
    }

    openIndex() {
      const dialog = this.index
      if (!dialog || dialog.open) return

      clearTimeout(this.indexCloseTimer)
      dialog.classList.remove('is-closing')
      this.syncIndex()

      dialog.showModal()
      this.indexOpenButton?.setAttribute('aria-expanded', 'true')
      document.documentElement.classList.add('is-index-open')
      window.lenis?.stop()
    }

    /**
     * immediate：点目录里的链接、换页前，不等收卷动画
     */
    closeIndex(immediate = false) {
      const dialog = this.index
      if (!dialog?.open) return

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      if (immediate || reduced) {
        clearTimeout(this.indexCloseTimer)
        dialog.classList.remove('is-closing')
        dialog.close()
        this.onIndexClosed()
        return
      }

      if (dialog.classList.contains('is-closing')) return
      dialog.classList.add('is-closing')
      this.indexCloseTimer = window.setTimeout(() => {
        dialog.classList.remove('is-closing')
        if (dialog.open) dialog.close()
      }, INDEX_CLOSE_MS)
    }

    onIndexClosed() {
      clearTimeout(this.indexCloseTimer)
      this.index?.classList.remove('is-closing')
      this.indexOpenButton?.setAttribute('aria-expanded', 'false')
      document.documentElement.classList.remove('is-index-open')
      window.lenis?.start()
    }

    onIndexChapter(event: MouseEvent) {
      const href = (event.currentTarget as HTMLAnchorElement).getAttribute('href') ?? ''
      const target = href.startsWith('#') ? document.querySelector(href) : null
      if (!target) return

      event.preventDefault()
      this.closeIndex(true)
      history.replaceState(null, '', href)
      this.syncNav()

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      requestAnimationFrame(() => {
        if (window.lenis) {
          window.lenis.scrollTo(target, {
            duration: reduced ? 0 : 1.5,
            easing: easeScroll,
          })
          return
        }
        target.scrollIntoView({
          behavior: reduced ? 'auto' : 'smooth',
          block: 'start',
        })
      })
    }

    syncIndex() {
      const path = location.pathname
      const hash = location.hash

      this.indexLinks.forEach((link) => {
        const href = link.getAttribute('href') ?? ''
        if (isNavCurrent(href, path, hash)) {
          link.setAttribute('aria-current', 'page')
        } else {
          link.removeAttribute('aria-current')
        }
      })
    }

    /**
     * Intersect handler
     */
    startFrame() {
      if (this.unframe) return
      this.unframe = onFrame((time) => this.updateConsole(time))
    }

    stopFrame() {
      this.unframe?.()
      this.unframe = null
    }

    onIntersect(e) {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) this.stopFrame()
      else this.startFrame()
    }

    /**
     * Intro (homepage: site intro played)
     */
    intro() {
      this.canWrite = true
      this.el?.classList.add('is-ready')
      this.playQrReveal()
    }

    /**
     * SPA / 硬载都按 location 重标当前项（SSR 看不到 hash）
     */
    syncNav() {
      if (!this.links) return
      const path = location.pathname
      const hash = location.hash

      this.links.forEach((link) => {
        const href = link.getAttribute('href') ?? ''
        if (isNavCurrent(href, path, hash)) {
          link.setAttribute('aria-current', 'page')
        } else {
          link.removeAttribute('aria-current')
        }
      })
    }

    syncContrastPressed() {
      this.contrastButton?.setAttribute(
        'aria-pressed',
        resolveTheme() === 'dark' ? 'true' : 'false'
      )
    }

    /**
     * 从子页点 /#about 回来时，ClientRouter 常常停在卷首，这里补一次滚动
     */
    scrollToHash() {
      const hash = location.hash
      if (!hash || hash === '#') return

      const target = document.querySelector(hash)
      if (!target) return

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      requestAnimationFrame(() => {
        if (window.lenis) {
          window.lenis.scrollTo(target, {
            duration: reduced ? 0 : 1.2,
            easing: (t) =>
              t < 0.5 ? 16 * t * t * t * t * t : 1 + 16 * --t * t * t * t * t,
          })
          return
        }
        target.scrollIntoView({
          behavior: reduced ? 'auto' : 'smooth',
          block: 'start',
        })
      })
    }

    /**
     * Subpage ready (no intro, reveal immediately)
     */
    subpageReady() {
      this.canWrite = true
      this.playQrReveal()
    }

    /**
     * QR code background reveal
     */
    playQrReveal() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return

      const qrCode = this.el.querySelector('.js-qr-code')
      if (!qrCode) return

      gsap.fromTo(
        qrCode,
        {
          '--bg-p': '0%',
        },
        {
          '--bg-p': '100%',
          duration: 0.9,
          ease: 'expo.out',
        }
      )
    }

    /**
     * Nav click handler (smooth-scroll same-page anchors only)
     */
    onNavClick(e) {
      const href = e.currentTarget.getAttribute('href') ?? ''
      const hash = href.startsWith('#')
        ? href
        : href.startsWith('/#')
          ? href.slice(1)
          : ''

      if (!hash) return

      const target = document.querySelector(hash)
      if (!target) return

      /* 已在首页：拦截整页跳转，只平滑滚到章节 */
      if (location.pathname === '/' || location.pathname === '') {
        e.preventDefault()
        history.replaceState(null, '', hash)
        this.syncNav()

        if (window.lenis) {
          window.lenis.scrollTo(hash, {
            duration: 1.5,
            easing: (t) =>
              t < 0.5 ? 16 * t * t * t * t * t : 1 + 16 * --t * t * t * t * t,
          })
          return
        }

        target.scrollIntoView({ behavior: 'smooth', block: 'start' })
      }
    }

    /**
     * Toggle contrast
     */
    toggleContrast() {
      const mask = this.contrastMask
      if (!mask) {
        const next = resolveTheme() === 'dark' ? 'light' : 'dark'
        applyTheme(next)
        this.syncContrastPressed()
        signalThemeFlip(next)
        return
      }

      /* 快速连点防护：先终止在途的旧补间，防止遮罩停在半途盖住页面 */
      gsap.killTweensOf(mask)

      let fromX = '0'
      let toX = '-100%'

      if (document.documentElement.classList.contains('theme-contrasted')) {
        fromX = '-100%'
        toX = '0'
      }

      gsap.fromTo(
        mask,
        {
          x: fromX,
        },
        {
          x: toX,
          duration: 1,
          ease: 'expo.inOut',
          onComplete: () => {
            /* 复位不可失败：先按 CSS 基态回位，再清行内样式 */
            mask.style.transform = 'translate3d(-100%, 0, 0)'
            gsap.set(mask, { clearProps: 'transform' })

            const theme = toX === '0' ? 'light' : 'dark'

            try {
              applyTheme(theme)
            } catch (error) {
              console.error('[theme] applyTheme failed:', error)
            }

            /* 翻色后布局度量可能变化，刷新 ScrollTrigger 防止 pin 错位 */
            ScrollTrigger.refresh()
            signalThemeFlip(theme)
            this.syncContrastPressed()
          },
        }
      )

      if (toX !== '0') {
        document.documentElement.classList.add('theme-contrasted')
        document.documentElement.dataset.theme = 'dark'
      }
    }

    /**
     * Update console
     */
    updateConsole(time) {
      if (
        !this.console ||
        !this.canWrite ||
        time - this.lastTypeTime < this.writeDelay
      ) {
        return
      }

      if (this.message === '') {
        this.message = this.getRandomMessage()
        this.writeDelay = 2000
      } else {
        if (this.message === this.lastMessage || this.messageLineBreak) {
          this.console.textContent += '\n'
        }

        const char = this.message.charAt(0)
        this.message = this.message.substring(1)

        if (char === ',') {
          this.writeDelay = 100
        } else if (char === ' ') {
          this.writeDelay = 100
        } else if (char === '') {
          this.writeDelay = 200
        } else if (char === '…') {
          this.writeDelay = 400
        } else if (char === '.') {
          this.writeDelay = 400
        } else {
          this.writeDelay = 20
        }

        this.console.textContent += char

        if (char === '…') {
          this.messageLineBreak = true
        } else {
          this.messageLineBreak = false
        }
      }

      this.console.textContent = this.console.textContent
        .split('\n')
        .slice(-5)
        .join('\n')

      this.lastTypeTime = time
    }

    /**
     * Get random message
     */
    getRandomMessage() {
      if (!this.messages.length) return ''
      if (this.messages.length === 1) {
        this.lastMessage = this.messages[0]
        return this.lastMessage
      }

      let message = this.messages[0]
      do {
        message =
          this.messages[Math.floor(Math.random() * this.messages.length)]
      } while (message === this.lastMessage)

      this.lastMessage = message
      return message
    }
  }

