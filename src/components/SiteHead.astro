      left: 0;
      z-index: 2;

      height: 12px;
      margin-top: -6px;

      background:
        linear-gradient(color(accent), color(accent)) left center / 26px 100%
          no-repeat,
        linear-gradient(color(accent), color(accent)) right center / 26px 100%
          no-repeat,
        linear-gradient(
            180deg,
            color-mix(in srgb, #000 24%, color(surface)),
            color(surface) 34%,
