---
import SenMark from './SenMark.astro'

const isSubpage = Astro.url.pathname !== '/'

const menu = isSubpage
  ? [
      { href: '/', text: 'Home' },
      { href: '/#about', text: 'About' },
      { href: '/#work', text: 'Work' },
      { href: '/contact', text: 'Contact' },
    ]
  : [
      { href: '#about', text: 'About' },
      { href: '#work', text: 'Work' },
      { href: '#contact', text: 'Contact' },
    ]

const consoleLines = [
  '班级记忆现场 · 41 人',
  '正在同步 benchmark 分数…',
  '编译好奇心为可运行代码…',
  'monorepo 热更新中…',
  'Python → TypeScript 进化链加载完成',
  '创客项目队列：智造 · 模型 · 编程',
  '信息学竞赛模块就绪',
  'AI 实验沙箱待命',
  '班级画廊索引重建中…',
  '把作品写进可展示的光里',
]
---

<header
  class:list={['site-head', isSubpage && 'is-ready']}
  data-intersect
  data-subpage={isSubpage ? 'true' : undefined}
>
