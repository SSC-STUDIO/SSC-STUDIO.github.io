        inset 0 -1.5px 0 color-mix(in srgb, var(--color-secondary) 48%, transparent),
        inset 0 -4px 0 color-mix(in srgb, var(--color-accent) 58%, transparent),
        0 1.6rem 3rem -1.4rem rgba(15, 28, 24, 0.5);

      animation: site-index-unroll 0.6s ease(out-expo) both;

      @include mq(phone) {
        min-height: 100svh;
        padding-bottom: 2.25rem;
      }

