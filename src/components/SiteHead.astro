  /* ── 全站目录：一幅从顶栏放下的短卷 ── */
  .site-index {
    position: fixed;
    inset: 0;

    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;

    background: transparent;
