          <span class="sb__text">Building experiments from China.</span>
        </span>

        <span class="sb__line">
          <span class="sb__text">Open to collaborations →</span>

          <a href="mailto:3992237161@qq.com" class="sb__link">Get in touch</a>
        </span>
      </p>
    </aside><!-- .sb-availability -->

    <a
      href="mailto:3992237161@qq.com"
      class="sb-qr-code js-qr-code"
      title="Contact me!"
