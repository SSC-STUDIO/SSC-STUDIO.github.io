---
import InkRidges from './InkRidges.astro'
import InkRail from './InkRail.astro'
import SealMark from './SealMark.astro'
import SenMark from './SenMark.astro'
import StudioCard from './StudioCard.astro'
import StudioClock from './StudioClock.astro'
import InkMist from './InkMist.astro'
import InkBamboo from './InkBamboo.astro'
import InkFish from './InkFish.astro'
import InkMoon from './InkMoon.astro'
import DateSeal from './DateSeal.astro'
---

<div class="s-hero" data-intersect>
  <InkMist class="s__mist" />
  <InkBamboo class="s__bamboo" size={280} flip />
  <InkMoon class="s__moon" size={190} />
  <InkFish class="s__fish" size={200} />
  <DateSeal class="s__seal" />
  <InkRidges class="s__waves" />

  <StudioClock />

  <StudioCard />

  <aside class="s__titling" aria-hidden="true">
    <span class="s__titling__name">润森</span>
    <span class="s__titling__note">造物</span>
  </aside>

  <div class="s__content js-content">
    <InkRail
      class="s__separator js-separator"
      style="primary"
      strings={['木', '林', '森']}
    />

    <p class="s__subtitle">
      把少年时的好奇，写进可运行的光里 · AI / 游戏 / 交互 / 长期作品
    </p>

    <h1 class="s__title">
      <span class="s__title__word js-word">CHEN</span>
      <span class="s__title__asset js-star" aria-hidden="true">
        <SenMark size={72} />
      </span>
      <span class="s__title__word s__title__word--seal js-word">RUNSEN</span>
      <SealMark variant="hero" />
    </h1>

    <InkRail
      class="s__separator js-separator"
      style="accent"
      strings={['好奇', '造物', '长期']}
    />
  </div>

  <div class="s__border js-border"></div>
</div><!-- .s-hero -->

<script>
  import {
    whenReady,
    nextFrame,
    onFrame,
    onResize,
    onPointer,
    prefersReducedMotion,
    type Cleanup,
  } from '../motion/core'

  import { gsap } from 'gsap'

  /**
   * Split the title words into chars (replaces GSAP SplitText)
   */
  function splitWords(container: HTMLElement) {
    const words = container.querySelectorAll('.js-word')
    const chars: HTMLElement[] = []

    words.forEach((word: HTMLElement) => {
      const text = word.textContent.trim()

      word.textContent = ''
      word.classList.add('word')

      ;[...text].forEach((letter) => {
        const char = document.createElement('span')
        char.classList.add('char', `char--${letter}`)

        const inner = document.createElement('span')
        inner.classList.add('char__inner')
        inner.dataset.letter = letter.toUpperCase()
        inner.innerHTML = letter

        char.appendChild(inner)
        word.appendChild(char)
        chars.push(char)
      })
    })

    return {
      chars,
      revert() {
        words.forEach((word: HTMLElement) => {
          word.textContent = word.textContent
        })
      },
    }
  }

  class Section {
    el: HTMLElement
    words: NodeListOf<HTMLElement>

    isPaused: boolean
    isWaiting: boolean
    split: { chars: HTMLElement[]; revert: () => void } | null
    introPlayed: boolean
    stops: Cleanup[] = []
    unframe: Cleanup | null = null

    /** 指针视差：归一化目标值与平滑值（-1 ~ 1，视口中心为 0） */
    par = { x: 0, y: 0, sx: 0, sy: 0, active: false }

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-hero')
      if (!this.el) return

      this.words = this.el.querySelectorAll('.js-word')

      // Properties
      this.isPaused = true
      this.isWaiting = true
      this.split = null
      this.introPlayed = false

      // Init
      this.splitWords()

      document.addEventListener('intro', this.onIntro, {
        once: true,
      })

      whenReady(() => {
        nextFrame(() => {
          this.init()
          this.ensureIntro()
        })
      })
    }

    /**
     * Intro handler
     */
    onIntro = () => {
      this.intro()
    }

    /**
     * Make sure the intro plays even without an intro overlay
     */
    ensureIntro() {
      if (this.introPlayed) return
      if (document.querySelector('.js-intro')) return

      this.intro()
    }

    /**
     * Init
     */
    init() {
      this.splitWords()

      this.bindEvents()
    }

    destroy() {
      this.stops.forEach((stop) => stop())
      this.stops = []
      this.stopFrame()
    }

    startFrame() {
      if (this.unframe) return
      this.unframe = onFrame(() => this.tick())
    }

    stopFrame() {
      this.unframe?.()
      this.unframe = null
    }

    /**
     * Bind events
     */
    bindEvents() {
      this.stops.push(onResize(() => this.onResize()))

      /* 背景装饰的指针视差：只在非 reduced-motion 下开启 */
      if (!prefersReducedMotion()) {
        this.stops.push(
          onPointer(({ x, y }) => {
            this.par.x = (x / window.innerWidth) * 2 - 1
            this.par.y = (y / window.innerHeight) * 2 - 1
            this.par.active = true
          })
        )
      }

      this.el.addEventListener('intersect', this.onIntersect, {
        passive: true,
      })

      this.startFrame()
    }

    /**
     * Intersect handler
     */
    onIntersect = (e: CustomEvent) => {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) this.stopFrame()
      else this.startFrame()
    }

    /**
     * Resize handler
     */
    onResize() {
      this.splitWords()
    }

    /**
     * Intro
     */
    intro() {
      if (this.introPlayed) return
      this.introPlayed = true

      if (!this.split || this.split.chars.length === 0) {
        this.splitWords()
      }

      const waves = this.el.querySelector('ink-ridges')
      const content = this.el.querySelector('.js-content')

      if (!waves || !content) {
        waves?.dispatchEvent(new CustomEvent('introend'))
        return
      }

      const border = this.el.querySelector('.js-border')
      const chars = content.querySelectorAll('.char__inner')
      const separators = content.querySelectorAll('.js-separator')
      const star = content.querySelector('.js-star')

      /* reduced-motion：跳过整段时间线，直接落终态 */
      if (prefersReducedMotion()) {
        waves.dispatchEvent(new CustomEvent('introend'))
        this.isWaiting = false

        return
      }

      try {
        const tl = gsap.timeline()

        /* 竖向线场显影自理（InkRidges 收到信号后自行淡入） */
        tl.call(
          () => {
            waves.dispatchEvent(new CustomEvent('introend'))
          },
          null,
          0.35
        )

        tl.to(
          border,
          {
            scaleY: 0.025,
            y: -content.clientHeight,
            duration: 1,
            ease: 'expo.inOut',
          },
          0
        )

        tl.fromTo(
          content,
          {
            opacity: 0,
            y: '3%',
          },
          {
            opacity: 1,
            y: '0%',
            duration: 1,
            ease: 'expo.inOut',
          },
          0
        )

        tl.to(
          border,
          {
            scaleY: 1,
            y: 0,
            duration: 1,
            ease: 'expo.inOut',
          },
          0.85
        )

        tl.from(
          star,
          {
            rotate: 90,
            duration: 2,
            ease: 'expo.out',
          },
          0.5
        )

        /* 背景装饰错峰入场：雾-月-鱼-竹自远及近浮现，拉开纵深 */
        const decos = this.el.querySelectorAll(
          '.s__mist, .s__moon, .s__fish, .s__bamboo'
        )
        if (decos.length) {
          tl.from(
            decos,
            {
              opacity: 0,
              y: 14,
              duration: 1.4,
              ease: 'expo.out',
              stagger: 0.16,
              clearProps: 'transform',
            },
            0.55
          )
        }

        tl.fromTo(
          chars,
          {
            y: '110%',
          },
          {
            y: '0%',
            duration: 1.6,
            ease: 'expo.inOut',
            stagger: 0.02,
          },
          0.15
        )

        tl.from(
          separators,
          {
            y: (index) => (index % 2 === 0 ? '-100%' : '100%'),
            duration: 1.2,
            ease: 'expo.inOut',
          },
          0.35
        )

        tl.call(() => {
          this.isWaiting = false
        })
      } catch (e) {
        console.error('SHero intro failed:', e)
        waves?.dispatchEvent(new CustomEvent('introend'))
      } finally {
        /* 非破坏性兜底：无论动画成功或中断，确保 .s__content 终态可见，
           避免 clipPath 之类的破坏性属性把首屏锁在隐藏态 */
        try {
          gsap.set(content, { clearProps: 'opacity,transform' })
        } catch (e) {}
      }
    }

    /**
     * Split words
     */
    splitWords() {
      const content = this.el.querySelector('.js-content')

      if (this.split) {
        this.split.revert()
      }

      this.split = splitWords(content)
    }

    /**
     * Animate char
     */
    animateChar() {
      if (this.isWaiting || !this.split || Math.random() > 0.01) return

      const char =
        this.split.chars[Math.floor(Math.random() * this.split.chars.length)]

      if (
        char.classList.contains('to-right') ||
        char.classList.contains('to-left')
      )
        return

      /* 只做水平滚动：字形贴边裁剪 + 对侧克隆补位，
         垂直方向在 0.82 行高下必然裁字头或叠邻行，砍掉 */
      const className = 'to-' + (Math.random() < 0.5 ? 'left' : 'right')

      char.classList.add(className)

      setTimeout(() => {
        char.classList.remove(className)
      }, 2000)
    }

    /**
     * 视差平滑：把指针位置滤波后写到 CSS 变量，
     * 装饰层用独立 translate 属性各取系数（纯合成层，不触发布局）
     */
    tickParallax() {
      const { par } = this
      if (!par.active) return

      par.sx += (par.x - par.sx) * 0.06
      par.sy += (par.y - par.sy) * 0.06

      this.el.style.setProperty('--par-x', par.sx.toFixed(4))
      this.el.style.setProperty('--par-y', par.sy.toFixed(4))
    }

    /**
     * Tick
     */
    tick() {
      this.animateChar()
      this.tickParallax()
    }
  }

  const mountHero = () => {
    const prev = (window as any).__sHero
    const hasHero = !!document.querySelector('.s-hero')

    if (!hasHero) {
      /* 子页 / 其他无首屏页面：彻底清掉前一个实例及其残留引用，
         避免 stale 状态污染当前页 */
      try {
        prev?.destroy?.()
      } catch (e) {}
      ;(window as any).__sHero = null
      return
    }

    try {
      prev?.destroy?.()
    } catch (e) {}
    ;(window as any).__sHero = new Section()
  }

  document.addEventListener('astro:page-load', mountHero)
  document.addEventListener('astro:before-swap', () => {
    /* SPA 切页前主动收尾：阻止首屏动画在已离场的 DOM 上继续改写样式 */
    const prev = (window as any).__sHero
    if (!prev) return
    try {
      prev.destroy?.()
      const content = prev.el?.querySelector?.('.js-content')
      const border = prev.el?.querySelector?.('.js-border')
      const chars = prev.el?.querySelectorAll?.('.char__inner')
      try {
        gsap.set([content, border], { clearProps: 'all' })
      } catch (e) {}
      if (chars) {
        try {
          gsap.set(chars, { clearProps: 'all' })
        } catch (e) {}
      }
    } catch (e) {}
  })
</script>

<style lang="scss">
  .s-hero {
    @include flex(column, stretch, stretch);
    @include ink-cloud-ground;

    position: relative;
    z-index: 4;

    /* 锁死首屏高度：画布不得把大标题挤出视口 */
    height: calc(100svh - 7rem - 1px);
    min-height: calc(100svh - 7rem - 1px);

    padding-top: env(safe-area-inset-top, 0);

    opacity: 0;
    overflow: hidden;

    @include mq(phone) {
      height: calc(100svh - 4.5rem - 1px);
      min-height: calc(100svh - 4.5rem - 1px);
    }

    @include mq(sm-height) {
      height: calc(100svh - 4.5rem - 1px);
      min-height: calc(100svh - 4.5rem - 1px);
      align-items: center;
    }

    .s__titling {
      @include flex(row, flex-start, flex-start);

      position: absolute;
      top: 38%;
      right: clamp(0.55rem, 2.2vw, 1.75rem);
      z-index: 5;

      gap: 0.85em;

      writing-mode: vertical-rl;
      text-orientation: mixed;

      color: color(songyan);
      font: 600 0.82rem / 1.15 font-family(songti);
      letter-spacing: 0.46em;

      pointer-events: none;

      &__name {
        padding-bottom: 0.35em;

        border-bottom: 1.5px solid
          color-mix(in srgb, #{color(zhusha)} 62%, transparent);
      }

      &__note {
        color: color(zhuqing);
        font-weight: 400;
        letter-spacing: 0.58em;
        opacity: 0.72;
      }

      @include mq(tablet) {
        top: 32%;
        font-size: 0.74rem;
      }

      @include mq(phone) {
        display: none;
      }
    }

    .s__waves {
      position: relative;
      z-index: 2;

      width: 100%;
      min-height: 0;

      flex: 1 1 0%;
    }

    /* 指针视差：自远及近位移递增（雾 < 月 < 鱼 < 竹），
       用独立 translate 属性叠加，不干扰各装饰自带的 transform 动画 */
    .s__mist {
      z-index: 1;

      translate: calc(var(--par-x, 0) * -5px) calc(var(--par-y, 0) * -3px);
    }

    .s__bamboo {
      right: clamp(0.5rem, 3vw, 3rem);
      bottom: -2rem;
      z-index: 1;

      opacity: 0.85;

      translate: calc(var(--par-x, 0) * 18px) calc(var(--par-y, 0) * 10px);
    }

    /* 望月窗：左侧开窗，与右侧竹影对望 */
    .s__moon {
      top: 42%;
      left: clamp(0.5rem, 3vw, 3.5rem);
      z-index: 1;

      opacity: 0.9;

      translate: calc(var(--par-x, 0) * 8px) calc(var(--par-y, 0) * 5px);

      @include mq(tablet) {
        top: auto;
        bottom: 8rem;
        left: -2.5rem;

        opacity: 0.5;
      }

      @include mq(phone) {
        display: none;
      }
    }

    /* 游鱼：贴着水波缓游 */
    .s__fish {
      bottom: clamp(3rem, 9vh, 7rem);
      left: clamp(6rem, 22vw, 20rem);
      z-index: 2;

      opacity: 0.9;

      translate: calc(var(--par-x, 0) * 13px) calc(var(--par-y, 0) * 7px);

      @include mq(tablet-sm) {
        left: 2rem;
        opacity: 0.6;
      }

      @include mq(phone) {
        display: none;
      }
    }

    /* 日戳：与右上角时钟成对角 */
    .s__seal {
      top: 84px;
      left: clamp(16px, 4vw, 48px);
      z-index: 6;

      @include mq(phone) {
        top: 64px;
        left: 1rem;
      }
    }

    .s__border {
      position: absolute;
      top: 100%;
      left: 0;

      width: 100%;
      height: 40 * 1rem;

      background: color(secondary);
      transform-origin: 50% 0;

      @include mq(phone) {
        height: 40 * 0.5rem;
      }
    }

    .s__content {
      position: relative;
      z-index: 3;

      flex-shrink: 0;

      overflow: hidden;
      transform-origin: 50% 100%;

      &:before {
        position: absolute;
        top: 0;
        left: 0;

        width: 100%;
        height: 1px;

        background: color(secondary);

        content: '';
      }
    }

    .s__title,
    .s__separator,
    .s__subtitle {
      flex-grow: 0;
      flex-shrink: 0;
    }

    .s__subtitle {
      position: relative;

      margin: 0;
      padding: 0.75rem 1.5rem 0;

      color: color(secondary);
      font: 200 1.15rem / 1.45 font-family(editorial);
      text-align: center;
      text-wrap: balance;

      /* 题签界栏：副题两侧悬臂朱丝，卷首题记之仪 */
      @include ink-column-rule(
        $color: color-mix(in srgb, var(--color-accent) 52%, transparent),
        $width: 1.4em,
        $offset: 0.5em
      );

      @include mq(phone) {
        padding: 0.5rem 1rem 0;

        font-size: 1rem;
      }
    }

    .s__title {
      @include flex(row, center, center);

      position: relative;

      margin: 0;
      padding: 0.2rem 0.5rem 0.45rem;
      gap: 0.04em;

      cursor: default;

      font: 700 min(18vw, 12rem) / 0.82 font-family(bigger);
      letter-spacing: 0.02em;
      text-transform: none;

      @include mq(tablet) {
        padding: 0.2rem 0.75rem 0.4rem;
        flex-wrap: wrap;
        font-size: min(22vw, 8rem);
      }

      @include mq(phone) {
        font-size: min(16vw, 4.5rem);
        letter-spacing: 0;
      }

      @include mq(sm-height) {
        padding-top: 0.1rem;
        padding-bottom: 0.25rem;
        font-size: min(14vw, 5.5rem);
      }

      &__word {
        position: relative;

        display: inline-flex;
        align-items: flex-end;
        height: auto;
      }

      &__asset {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 0.12em 0.08em;
        width: 0.18em;
        height: 0.18em;
        color: color(secondary);

        :global(svg) {
          display: block;
          width: 100%;
          height: 100%;
        }
      }

      :global(.seal-mark--hero) {
        position: absolute;
        right: 0.02em;
        bottom: 0.08em;
        z-index: 2;

        width: clamp(36px, 6vw, 64px);
        height: auto;
        margin: 0;
      }

      @keyframes s-hero-move-to-left {
        0% {
          transform: translate3d(0, 0, 0);
        }

        100% {
          transform: translate3d(100%, 0, 0);
        }
      }

      @keyframes s-hero-move-to-right {
        0% {
          transform: translate3d(0, 0, 0);
        }

        100% {
          transform: translate3d(-100%, 0, 0);
        }
      }

      /* 滚动字母：水平贴边裁剪（防叠邻字），垂直放宽保住字形上下缘 */
      :global(.char) {
        display: inline-block;

        clip-path: inset(-0.35em 0);

        color: color(secondary);
      }

      :global(.char__inner) {
        position: relative;
        top: 0;

        display: inline-block;

        color: color(secondary);

        will-change: transform;

        /* 克隆字形：随本体一起滑动，从对侧补进原位 */
        &:before {
          position: absolute;
          top: 0;

          display: none;

          content: attr(data-letter);
        }
      }

      :global(.char--t) {
        margin-left: 0;
      }

      :global(.to-right .char__inner) {
        animation: s-hero-move-to-right 1s ease(in-out-quint) 1 forwards;

        &:before {
          left: 100%;

          display: block;
        }
      }

      :global(.to-left .char__inner) {
        animation: s-hero-move-to-left 1s ease(in-out-quint) 1 forwards;

        &:before {
          right: 100%;

          display: block;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        :global(.to-right .char__inner),
        :global(.to-left .char__inner) {
          animation: none;

          &:before {
            display: none;
          }
        }
      }
    }
  }
</style>
