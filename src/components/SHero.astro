---
import InkRidges from './InkRidges.astro'
import InkRail from './InkRail.astro'
import SealMark from './SealMark.astro'
import SenMark from './SenMark.astro'
import StudioCard from './StudioCard.astro'
import StudioClock from './StudioClock.astro'
import InkMist from './InkMist.astro'
import InkBubbles from './InkBubbles.astro'
import InkBamboo from './InkBamboo.astro'
import InkFish from './InkFish.astro'
import InkMoon from './InkMoon.astro'
import DateSeal from './DateSeal.astro'
---

<div class="s-hero" data-intersect>
  <InkMist class="s__mist" />
  <InkBubbles
    class="s__bubbles"
    skip=".s__title,.js-star,.seal-mark,[data-date-seal],.s__moon,.s__fish,.s__bamboo,.s__titling"
  />
  <InkBamboo class="s__bamboo" size={280} flip />
  <InkMoon class="s__moon" size={190} />
  <InkFish class="s__fish" size={200} />
  <DateSeal class="s__seal" />
  <InkRidges class="s__waves" />

  <StudioClock />

  <StudioCard />

  <aside class="s__titling" aria-hidden="true">
    <span class="s__titling__name">润森</span>
    <span class="s__titling__note">造物</span>
  </aside>

  <div class="s__content js-content">
    <InkRail
      class="s__separator js-separator"
      style="primary"
      strings={['木', '林', '森']}
    />

    <p class="s__subtitle">
      把少年时的好奇，写进可运行的光里 · AI / 游戏 / 交互 / 长期作品
    </p>

    <h1 class="s__title" aria-label="CHEN RUNSEN">
      <span class="s__title__word js-word">CHEN</span>
      <span class="s__title__asset js-star js-sen-press" aria-hidden="true">
        <SenMark size={72} />
      </span>
      <span class="s__title__word s__title__word--seal js-word">RUNSEN</span>
      <SealMark variant="hero" />
    </h1>

    <InkRail
      class="s__separator js-separator"
      style="accent"
      strings={['好奇', '造物', '长期']}
    />
  </div>

  <div class="s__border js-border"></div>
</div><!-- .s-hero -->

<script>
  import {
    whenReady,
    nextFrame,
    onFrame,
    onResize,
    onPointer,
    prefersReducedMotion,
    type Cleanup,
  } from '../motion/core'

  import { gsap } from 'gsap'

  /**
   * 把题名拆成字（替代 GSAP SplitText）。
   * 原文先记下，revert 时还原——无 JS / 拆字失败时 h1 里仍是可读的 CHEN RUNSEN。
   * --char-i 对齐内页卷首：落定后墨光按字序错峰游走。
   */
  function splitWords(container: HTMLElement) {
    const words = container.querySelectorAll<HTMLElement>('.js-word')
    const chars: HTMLElement[] = []
    const originals: { el: HTMLElement; text: string }[] = []
    let index = 0

    words.forEach((word) => {
      const text = (word.textContent || '').trim()
      originals.push({ el: word, text })

      word.textContent = ''
      word.classList.add('word')

      ;[...text].forEach((letter) => {
        const char = document.createElement('span')
        char.classList.add('char', `char--${letter}`)
        char.style.setProperty('--char-i', String(Math.min(index, 14)))

        const inner = document.createElement('span')
        inner.classList.add('char__inner')
        inner.dataset.letter = letter.toUpperCase()
        inner.textContent = letter

        char.appendChild(inner)
        word.appendChild(char)
        chars.push(char)
        index += 1
      })
    })

    return {
      chars,
      revert() {
        originals.forEach(({ el, text }) => {
          el.textContent = text
          el.classList.remove('word')
        })
      },
    }
  }

  class Section {
    el: HTMLElement
    words: NodeListOf<HTMLElement>

    isPaused: boolean
    isWaiting: boolean
    split: { chars: HTMLElement[]; revert: () => void } | null
    introPlayed: boolean
    stops: Cleanup[] = []
    unframe: Cleanup | null = null
    charTimers: number[] = []
    idleTimer = 0
    tl: gsap.core.Timeline | null = null
    destroyed = false

    /** 指针视差：归一化目标值与平滑值（-1 ~ 1，视口中心为 0） */
    par = { x: 0, y: 0, sx: 0, sy: 0, active: false }

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-hero')
      if (!this.el) return

      this.words = this.el.querySelectorAll('.js-word')

      // Properties
      this.isPaused = true
      this.isWaiting = true
      this.split = null
      this.introPlayed = false

      // Init
      this.splitWords()

      document.addEventListener('intro', this.onIntro, {
        once: true,
      })

      whenReady(() => {
        nextFrame(() => {
          this.init()
          this.ensureIntro()
        })
      })
    }

    /**
     * Intro handler
     */
    onIntro = () => {
      this.intro()
    }

    /**
     * Make sure the intro plays even without an intro overlay
     */
    ensureIntro() {
      if (this.introPlayed) return
      if (document.querySelector('.js-intro')) return

      this.intro()
    }

    /**
     * Init
     */
    init() {
      this.splitWords()

      this.bindEvents()
    }

    destroy() {
      this.destroyed = true
      this.stops.forEach((stop) => stop())
      this.stops = []
      this.stopFrame()
      this.stopIdle()
      this.charTimers.forEach((id) => clearTimeout(id))
      this.charTimers = []
      this.tl?.kill()
      this.tl = null
      this.el?.removeEventListener('intersect', this.onIntersect)
      this.el?.style.removeProperty('--par-x')
      this.el?.style.removeProperty('--par-y')
    }

    /**
     * 闲时走字：对齐 InkRail「随机间隔定时器，不每帧掷骰」。
     * 离屏 / reduced-motion / 换页即停。
     */
    startIdle() {
      if (this.idleTimer || prefersReducedMotion() || this.destroyed) return

      const loop = () => {
        if (this.destroyed || this.isPaused || this.isWaiting) {
          this.idleTimer = 0
          if (!this.destroyed && !this.isPaused) {
            this.idleTimer = window.setTimeout(loop, 1600)
          }
          return
        }

        this.animateChar()
        this.idleTimer = window.setTimeout(loop, 2400 + Math.random() * 2800)
      }

      this.idleTimer = window.setTimeout(loop, 3200)
    }

    stopIdle() {
      window.clearTimeout(this.idleTimer)
      this.idleTimer = 0
    }

    startFrame() {
      if (this.unframe) return
      this.unframe = onFrame(() => this.tick())
    }

    stopFrame() {
      this.unframe?.()
      this.unframe = null
    }

    /**
     * Bind events
     */
    bindEvents() {
      this.stops.push(onResize(() => this.onResize()))

      /* 视差对齐内页卷首：只跟精细指针，静止后停帧 */
      if (
        !prefersReducedMotion() &&
        window.matchMedia('(hover: hover) and (pointer: fine)').matches
      ) {
        this.stops.push(
          onPointer(({ x, y }) => {
            if (this.destroyed || this.isPaused) return
            this.par.x = (x / window.innerWidth) * 2 - 1
            this.par.y = (y / window.innerHeight) * 2 - 1
            this.par.active = true
            this.startFrame()
          })
        )
      }

      this.el.addEventListener('intersect', this.onIntersect, {
        passive: true,
      })
      this.stops.push(() =>
        this.el.removeEventListener('intersect', this.onIntersect)
      )

      this.el.addEventListener('click', this.onHeroClick)
      this.stops.push(() => this.el.removeEventListener('click', this.onHeroClick))

      this.startIdle()
    }

    /**
     * Intersect handler
     */
    onIntersect = (e: CustomEvent) => {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) {
        this.stopFrame()
        this.stopIdle()
      } else {
        this.startIdle()
      }
    }

    /**
     * 首屏点击分发：森标重生、印章/日戳钤下、点字走墨。
     * 对齐立体印玺「点而钤之」、内页卷首落章涟漪。
     */
    onHeroClick = (e: Event) => {
      if (this.destroyed) return

      const t = e.target as Element | null
      if (!t) return

      if (t.closest('.js-sen-press, .sen-mark')) {
        if (!prefersReducedMotion()) this.pressSen()
        return
      }

      if (t.closest('.seal-mark--hero')) {
        if (!prefersReducedMotion()) this.pressSeal()
        return
      }

      if (t.closest('[data-date-seal]')) {
        if (!prefersReducedMotion()) this.pressDate()
        return
      }

      if (t.closest('.s__moon')) {
        if (!prefersReducedMotion()) this.stir('.s__moon', 900)
        return
      }

      if (t.closest('.s__fish')) {
        if (!prefersReducedMotion()) this.stir('.s__fish', 1100)
        return
      }

      if (t.closest('.s__bamboo')) {
        if (!prefersReducedMotion()) this.stir('.s__bamboo', 800)
        return
      }

      if (t.closest('.s__titling')) {
        if (!prefersReducedMotion()) this.stir('.s__titling', 640)
        return
      }

      if (!t.closest('.s__title')) return
      if (this.isWaiting || prefersReducedMotion()) return

      const char = t.closest('.char') as HTMLElement | null
      if (char && this.el.contains(char)) {
        this.nudgeChar(char)
        return
      }

      this.rippleChars()
    }

    /** 点森标：重放生长，三木再破土一次 */
    pressSen() {
      const sen = this.el.querySelector('.js-sen-press .sen-mark')
      if (!sen) return

      sen.classList.remove('sen-mark--grow')
      void (sen as HTMLElement).offsetWidth
      sen.classList.add('sen-mark--grow')

      const timer = window.setTimeout(() => {
        sen.classList.remove('sen-mark--grow')
      }, 1800)
      this.charTimers.push(timer)
    }

    /** 点朱砂印：下压再弹，涟漪洇开 */
    pressSeal() {
      const seal = this.el.querySelector('.seal-mark--hero')
      if (!seal) return

      seal.classList.remove('is-chopped')
      void (seal as HTMLElement).offsetWidth
      seal.classList.add('is-chopped')

      const timer = window.setTimeout(() => {
        seal.classList.remove('is-chopped')
      }, 1100)
      this.charTimers.push(timer)
    }

    /** 点月 / 鱼 / 竹 / 题签：加一记短促搅动，不改共享装饰默认态 */
    stir(selector: string, ms: number) {
      const el = this.el.querySelector(selector)
      if (!el) return

      el.classList.remove('is-stirred')
      void (el as HTMLElement).offsetWidth
      el.classList.add('is-stirred')

      const timer = window.setTimeout(() => {
        el.classList.remove('is-stirred')
      }, ms)
      this.charTimers.push(timer)
    }

    /** 点日戳：如随手重钤一方 */
    pressDate() {
      const seal = this.el.querySelector('[data-date-seal]')
      if (!seal) return

      seal.classList.remove('is-chopped')
      void (seal as HTMLElement).offsetWidth
      seal.classList.add('is-chopped')

      const timer = window.setTimeout(() => {
        seal.classList.remove('is-chopped')
      }, 800)
      this.charTimers.push(timer)
    }

    /**
     * Resize handler
     */
    onResize() {
      this.splitWords()
    }

    /**
     * Intro
     */
    intro() {
      if (this.destroyed || this.introPlayed) return
      this.introPlayed = true

      if (!this.split || this.split.chars.length === 0) {
        this.splitWords()
      }

      const waves = this.el.querySelector('ink-ridges')
      const content = this.el.querySelector('.js-content')

      if (!waves || !content) {
        waves?.dispatchEvent(new CustomEvent('introend'))
        return
      }

      const border = this.el.querySelector('.js-border')
      const chars = content.querySelectorAll('.char__inner')
      const separators = content.querySelectorAll('.js-separator')
      const star = content.querySelector('.js-star')

      /* reduced-motion：跳过整段时间线，直接落终态 */
      if (prefersReducedMotion()) {
        waves.dispatchEvent(new CustomEvent('introend'))
        this.isWaiting = false

        return
      }

      try {
        const tl = (this.tl = gsap.timeline())

        /* 竖向线场显影自理（InkRidges 收到信号后自行淡入） */
        tl.call(
          () => {
            waves.dispatchEvent(new CustomEvent('introend'))
          },
          null,
          0.35
        )

        tl.to(
          border,
          {
            scaleY: 0.025,
            y: -content.clientHeight,
            duration: 1,
            ease: 'expo.inOut',
          },
          0
        )

        tl.fromTo(
          content,
          {
            opacity: 0,
            y: '3%',
          },
          {
            opacity: 1,
            y: '0%',
            duration: 1,
            ease: 'expo.inOut',
          },
          0
        )

        tl.to(
          border,
          {
            scaleY: 1,
            y: 0,
            duration: 1,
            ease: 'expo.inOut',
          },
          0.85
        )

        tl.from(
          star,
          {
            rotate: 90,
            duration: 2,
            ease: 'expo.out',
          },
          0.5
        )

        /* 背景装饰错峰入场：雾-月-鱼-竹自远及近浮现，拉开纵深 */
        const decos = this.el.querySelectorAll(
          '.s__mist, .s__moon, .s__fish, .s__bamboo'
        )
        if (decos.length) {
          tl.from(
            decos,
            {
              opacity: 0,
              y: 14,
              duration: 1.4,
              ease: 'expo.out',
              stagger: 0.16,
              clearProps: 'transform',
            },
            0.55
          )
        }

        tl.fromTo(
          chars,
          {
            y: '110%',
          },
          {
            y: '0%',
            duration: 1.6,
            ease: 'expo.inOut',
            stagger: 0.02,
          },
          0.15
        )

        tl.from(
          separators,
          {
            y: (index) => (index % 2 === 0 ? '-100%' : '100%'),
            duration: 1.2,
            ease: 'expo.inOut',
          },
          0.35
        )

        tl.call(() => {
          this.isWaiting = false
        })
      } catch (e) {
        console.error('SHero intro failed:', e)
        waves?.dispatchEvent(new CustomEvent('introend'))
      } finally {
        /* 非破坏性兜底：无论动画成功或中断，确保 .s__content 终态可见，
           避免 clipPath 之类的破坏性属性把首屏锁在隐藏态 */
        try {
          gsap.set(content, { clearProps: 'opacity,transform' })
        } catch (e) {}
      }
    }

    /**
     * Split words
     */
    splitWords() {
      const content = this.el.querySelector('.js-content')

      if (this.split) {
        this.split.revert()
      }

      this.split = splitWords(content)
    }

    /**
     * 单字水平走墨：贴边裁剪 + 对侧克隆补位。
     */
    nudgeChar(char: HTMLElement | undefined) {
      if (!char || this.destroyed || this.isWaiting) return
      if (
        char.classList.contains('to-right') ||
        char.classList.contains('to-left')
      )
        return

      const className = 'to-' + (Math.random() < 0.5 ? 'left' : 'right')
      char.classList.add(className)

      const timer = window.setTimeout(() => {
        char.classList.remove(className)
      }, 2000)
      this.charTimers.push(timer)
    }

    /** 闲时随机抽一枚 */
    animateChar() {
      if (!this.split?.chars.length) return
      const char =
        this.split.chars[Math.floor(Math.random() * this.split.chars.length)]
      this.nudgeChar(char)
    }

    /** 点题名空隙：从落点附近带过三四枚，像一笔带过 */
    rippleChars() {
      if (!this.split?.chars.length) return

      const pool = this.split.chars.filter(
        (char) =>
          !char.classList.contains('to-right') &&
          !char.classList.contains('to-left')
      )
      const count = Math.min(3 + Math.floor(Math.random() * 2), pool.length)
      const start = Math.floor(Math.random() * Math.max(1, pool.length - count + 1))

      for (let i = 0; i < count; i++) {
        const timer = window.setTimeout(() => {
          this.nudgeChar(pool[start + i])
        }, i * 70)
        this.charTimers.push(timer)
      }
    }

    /**
     * 视差平滑：把指针位置滤波后写到 CSS 变量，
     * 装饰层用独立 translate 属性各取系数（纯合成层，不触发布局）
     */
    tickParallax() {
      const { par } = this
      const dx = par.x - par.sx
      const dy = par.y - par.sy

      if (Math.abs(dx) < 0.0008 && Math.abs(dy) < 0.0008) {
        par.sx = par.x
        par.sy = par.y
        par.active = false
        return false
      }

      par.sx += dx * 0.06
      par.sy += dy * 0.06
      this.el.style.setProperty('--par-x', par.sx.toFixed(4))
      this.el.style.setProperty('--par-y', par.sy.toFixed(4))
      return true
    }

    /**
     * Tick
     */
    tick() {
      if (this.destroyed) return
      if (!this.tickParallax()) this.stopFrame()
    }
  }

  const mountHero = () => {
    const prev = (window as any).__sHero
    const hasHero = !!document.querySelector('.s-hero')

    if (!hasHero) {
      /* 子页 / 其他无首屏页面：彻底清掉前一个实例及其残留引用，
         避免 stale 状态污染当前页 */
      try {
        prev?.destroy?.()
      } catch (e) {}
      ;(window as any).__sHero = null
      return
    }

    try {
      prev?.destroy?.()
    } catch (e) {}
    ;(window as any).__sHero = new Section()
  }

  document.addEventListener('astro:page-load', mountHero)
  document.addEventListener('astro:before-swap', () => {
    /* SPA 切页前主动收尾：阻止首屏动画在已离场的 DOM 上继续改写样式 */
    const prev = (window as any).__sHero
    if (!prev) return
    try {
      prev.destroy?.()
      const content = prev.el?.querySelector?.('.js-content')
      const border = prev.el?.querySelector?.('.js-border')
      const chars = prev.el?.querySelectorAll?.('.char__inner')
      try {
        gsap.set([content, border], { clearProps: 'all' })
      } catch (e) {}
      if (chars) {
        try {
          gsap.set(chars, { clearProps: 'all' })
        } catch (e) {}
      }
    } catch (e) {}
  })
</script>

<style lang="scss">
  .s-hero {
    @include flex(column, stretch, stretch);
    /* 云气地纹的静态圆环已并入 InkBubbles 动画层——
       避免「死泡」与「活泡」混排的违和感 */

    position: relative;
    z-index: 4;

    /* 锁死首屏高度：画布不得把大标题挤出视口 */
    height: calc(100svh - 7rem - 1px);
    min-height: calc(100svh - 7rem - 1px);

    padding-top: env(safe-area-inset-top, 0);

    /* 默认可见：无 JS / 模块失败时不能整屏透明。
       开场锁只在 html.is-intro-active / .is-preparing 下再藏。 */
    opacity: 1;
    overflow: hidden;

    :global(html.is-intro-active) &,
    :global(.is-preparing) & {
      opacity: 0;
    }

    @include mq(phone) {
      height: calc(100svh - 4.5rem - 1px);
      min-height: calc(100svh - 4.5rem - 1px);
    }

    @include mq(sm-height) {
      height: calc(100svh - 4.5rem - 1px);
      min-height: calc(100svh - 4.5rem - 1px);
      align-items: center;
    }

    .s__titling {
      @include flex(row, flex-start, flex-start);

      position: absolute;
      top: 38%;
      right: clamp(0.55rem, 2.2vw, 1.75rem);
      z-index: 5;

      gap: 0.85em;

      writing-mode: vertical-rl;
      text-orientation: mixed;

      color: color(songyan);
      font: 600 0.82rem / 1.15 font-family(songti);
      letter-spacing: 0.46em;

      cursor: pointer;
      pointer-events: auto;

      translate: calc(var(--par-x, 0) * -6px) calc(var(--par-y, 0) * -4px);
      animation: s-hero-titling-breath 8s ease-in-out infinite;

      &.is-stirred {
        animation: s-hero-titling-dab 640ms ease;
      }

      &__name {
        padding-bottom: 0.35em;

        border-bottom: 1.5px solid
          color-mix(in srgb, #{color(zhusha)} 62%, transparent);
      }

      &__note {
        color: color(zhuqing);
        font-weight: 400;
        letter-spacing: 0.58em;
        opacity: 0.72;
      }

      @include mq(tablet) {
        top: 32%;
        font-size: 0.74rem;
      }

      @include mq(phone) {
        display: none;
      }
    }

    @keyframes s-hero-titling-breath {
      0%,
      100% {
        opacity: 0.78;
      }
      50% {
        opacity: 1;
      }
    }

    @keyframes s-hero-titling-dab {
      0%,
      100% {
        color: color(songyan);
      }
      40% {
        color: color(zhusha);
      }
    }

    .s__waves {
      position: relative;
      z-index: 2;

      width: 100%;
      min-height: 0;

      flex: 1 1 0%;
    }

    /* 指针视差：自远及近位移递增（雾 < 月 < 鱼 < 竹），
       用独立 translate 属性叠加，不干扰各装饰自带的 transform 动画 */
    .s__mist {
      z-index: 1;

      translate: calc(var(--par-x, 0) * -5px) calc(var(--par-y, 0) * -3px);
    }

    /* 墨圈泡泡：与静态底纹同一族圆环，缓缓上浮 */
    .s__bubbles {
      z-index: 1;
    }

    .s__bamboo {
      right: clamp(0.5rem, 3vw, 3rem);
      bottom: -2rem;
      z-index: 1;

      opacity: 0.85;
      cursor: pointer;
      pointer-events: auto;

      translate: calc(var(--par-x, 0) * 18px) calc(var(--par-y, 0) * 10px);

