---
import AWaves from './AWaves.astro'
import ASeparator from './ASeparator.astro'
import SealMark from './SealMark.astro'
import SenMark from './SenMark.astro'
import StudioCard from './StudioCard.astro'
import StudioClock from './StudioClock.astro'
import InkMountains from './InkMountains.astro'
---

<div class="s-hero" data-intersect>
  <InkMountains />
  <AWaves class="s__waves" />

  <StudioClock />

  <StudioCard />

  <div class="s__content js-content">
    <ASeparator
      class="s__separator js-separator"
      style="primary"
      strings={['木', '林', '森']}
    />

    <p class="s__subtitle">
      把少年时的好奇，写进可运行的光里 · AI / 游戏 / 交互 / 长期作品
    </p>

    <h1 class="s__title">
      <span class="s__title__word js-word">CHEN</span>
      <span class="s__title__asset js-star" aria-hidden="true">
        <SenMark size={72} />
      </span>
      <span class="s__title__word s__title__word--seal js-word">RUNSEN</span>
      <SealMark variant="hero" />
    </h1>

    <ASeparator
      class="s__separator js-separator"
      style="accent"
      strings={['好奇', '造物', '长期']}
    />
  </div>

  <div class="s__border js-border"></div>
</div><!-- .s-hero -->

<script>
  import Emitter from '../utils/Emitter'
  import Ticker from '../utils/Ticker'
  import { prefersReducedMotion } from '../utils/motion'

  import { gsap } from 'gsap'

  /**
   * Split the title words into chars (replaces GSAP SplitText)
   */
  function splitWords(container: HTMLElement) {
    const words = container.querySelectorAll('.js-word')
    const chars: HTMLElement[] = []

    words.forEach((word: HTMLElement) => {
      const text = word.textContent.trim()

      word.textContent = ''
      word.classList.add('word')

      ;[...text].forEach((letter) => {
        const char = document.createElement('span')
        char.classList.add('char', `char--${letter}`)

        const inner = document.createElement('span')
        inner.classList.add('char__inner')
        inner.dataset.letter = letter.toUpperCase()
        inner.innerHTML = letter

        char.appendChild(inner)
        word.appendChild(char)
        chars.push(char)
      })
    })

    return {
      chars,
      revert() {
        words.forEach((word: HTMLElement) => {
          word.textContent = word.textContent
        })
      },
    }
  }

  /**
   * Prepare SVG paths for the draw animation (replaces DrawSVGPlugin)
   */
  function preparePaths(paths) {
    paths.forEach((path) => {
      if (typeof path.getTotalLength !== 'function') return

      const length = path.getTotalLength()

      path.style.strokeDasharray = `${length}`
      path.style.strokeDashoffset = `${length}`
    })
  }

  /**
   * Draw SVG paths in
   */
  function drawPaths(paths, gsap, vars: gsap.TweenVars = {}) {
    preparePaths(paths)

    return gsap.fromTo(
      paths,
      {
        strokeDashoffset: (index, path) =>
          typeof path.getTotalLength === 'function'
            ? path.getTotalLength()
            : 1000,
      },
      {
        strokeDashoffset: 0,
        duration: 3,
        ease: 'expo.out',
        stagger: {
          amount: 0.5,
          from: 'edges',
          ease: 'power3.inOut',
        },
        ...vars,
      }
    )
  }

  class Section {
    el: HTMLElement
    words: NodeListOf<HTMLElement>

    isPaused: boolean
    isWaiting: boolean
    split: { chars: HTMLElement[]; revert: () => void } | null
    introPlayed: boolean

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-hero')
      if (!this.el) return

      this.words = this.el.querySelectorAll('.js-word')

      // Properties
      this.isPaused = true
      this.isWaiting = true
      this.split = null
      this.introPlayed = false

      // Init
      this.splitWords()

      document.addEventListener('intro', this.onIntro.bind(this), {
        once: true,
      })

      if (document.readyState === 'complete') {
        Ticker.nextTick(this.init, this)
        Ticker.nextTick(this.ensureIntro, this)
      } else {
        Emitter.once(
          'siteLoaded',
          () => {
            Ticker.nextTick(this.init, this)
            Ticker.nextTick(this.ensureIntro, this)
          },
          this
        )
      }
    }

    /**
     * Intro handler
     */
    onIntro() {
      this.intro()
    }

    /**
     * Make sure the intro plays even without an intro overlay
     */
    ensureIntro() {
      if (this.introPlayed) return
      if (document.querySelector('.js-intro')) return

      this.intro()
    }

    /**
     * Init
     */
    init() {
      this.splitWords()

      this.bindEvents()
    }

    destroy() {
      Emitter.off('resize', this.onResize, this)
      Emitter.off('tick', this.tick, this)
    }

    /**
     * Bind events
     */
    bindEvents() {
      Emitter.on('resize', this.onResize, this)

      this.el.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
      })

      Emitter.on('tick', this.tick, this)
    }

    /**
     * Intersect handler
     */
    onIntersect(e) {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) {
        Emitter.off('tick', this.tick, this)
      } else {
        Emitter.on('tick', this.tick, this)
      }
    }

    /**
     * Resize handler
     */
    onResize() {
      this.splitWords()
    }

    /**
     * Intro
     */
    intro() {
      if (this.introPlayed) return
      this.introPlayed = true

      if (!this.split || this.split.chars.length === 0) {
        this.splitWords()
      }

      const waves = this.el.querySelector('sen-waves')
      const content = this.el.querySelector('.js-content')

      if (!waves || !content) {
        waves?.dispatchEvent(new CustomEvent('introend'))
        return
      }

      const lines = waves.querySelectorAll('.js-line')
      const border = this.el.querySelector('.js-border')
      const chars = content.querySelectorAll('.char__inner')
      const separators = content.querySelectorAll('.js-separator')
      const star = content.querySelector('.js-star')

      /* reduced-motion：跳过整段时间线，直接落终态 */
      if (prefersReducedMotion()) {
        lines.forEach((line: SVGPathElement) => {
          line.style.strokeDasharray = ''
          line.style.strokeDashoffset = ''
        })

        waves.dispatchEvent(new CustomEvent('introend'))
        this.isWaiting = false

        return
      }

      try {
        const tl = gsap.timeline()

        drawPaths(lines, gsap, {
          duration: 2.5,
          ease: 'expo.out',
        })

        tl.add(() => {}, 0.5)

        tl.call(
          () => {
            waves.dispatchEvent(new CustomEvent('introend'))
          },
          null,
          '-=1'
        )

        gsap.set(waves, {
          y: 0,
        })

        tl.to(
          border,
          {
            scaleY: 0.025,
            y: -content.clientHeight,
            duration: 1,
            ease: 'expo.inOut',
          },
          0
        )

        tl.fromTo(
          content,
          {
            opacity: 0,
            y: '3%',
          },
          {
            opacity: 1,
            y: '0%',
            duration: 1,
            ease: 'expo.inOut',
          },
          0
        )

        tl.to(
          border,
          {
            scaleY: 1,
            y: 0,
            duration: 1,
            ease: 'expo.inOut',
          },
          0.85
        )

        tl.from(
          star,
          {
            rotate: 90,
            duration: 2,
            ease: 'expo.out',
          },
          0.5
        )

        tl.fromTo(
          chars,
          {
            y: '110%',
          },
          {
            y: '0%',
            duration: 1.6,
            ease: 'expo.inOut',
            stagger: 0.02,
          },
          0.15
        )

        tl.from(
          separators,
          {
            y: (index) => (index % 2 === 0 ? '-100%' : '100%'),
            duration: 1.2,
            ease: 'expo.inOut',
          },
          0.35
        )

        tl.call(() => {
          this.isWaiting = false
        })
      } catch (e) {
        console.error('SHero intro failed:', e)
        waves?.dispatchEvent(new CustomEvent('introend'))
      } finally {
        /* 非破坏性兜底：无论动画成功或中断，确保 .s__content 终态可见，
           避免 clipPath 之类的破坏性属性把首屏锁在隐藏态 */
        try {
          gsap.set(content, { clearProps: 'opacity,transform' })
        } catch (e) {}
      }
    }

    /**
     * Split words
     */
    splitWords() {
      const content = this.el.querySelector('.js-content')

      if (this.split) {
        this.split.revert()
      }

      this.split = splitWords(content)
    }

    /**
     * Animate char
     */
    animateChar() {
      if (this.isWaiting || !this.split || Math.random() > 0.01) return

      const char =
        this.split.chars[Math.floor(Math.random() * this.split.chars.length)]

      if (
        char.classList.contains('to-top') ||
        char.classList.contains('to-right') ||
        char.classList.contains('to-bottom') ||
        char.classList.contains('to-left')
      )
        return

      const direction = Math.floor(Math.random() * 4)

      const className = 'to-' + ['bottom', 'left', 'top', 'right'][direction]

      char.classList.add(className)

      setTimeout(() => {
        char.classList.remove(className)
      }, 2000)
    }

    /**
     * Tick
     */
    tick() {
      this.animateChar()
    }
  }

  const mountHero = () => {
    const prev = (window as any).__sHero
    const hasHero = !!document.querySelector('.s-hero')

    if (!hasHero) {
      /* 子页 / 其他无首屏页面：彻底清掉前一个实例及其残留引用，
         避免 stale 状态污染当前页 */
      try {
        prev?.destroy?.()
      } catch (e) {}
      ;(window as any).__sHero = null
      return
    }

    try {
      prev?.destroy?.()
    } catch (e) {}
    ;(window as any).__sHero = new Section()
  }

  document.addEventListener('astro:page-load', mountHero)
  document.addEventListener('astro:before-swap', () => {
    /* SPA 切页前主动收尾：阻止首屏动画在已离场的 DOM 上继续改写样式 */
    const prev = (window as any).__sHero
    if (!prev) return
    try {
      prev.destroy?.()
      const content = prev.el?.querySelector?.('.js-content')
      const border = prev.el?.querySelector?.('.js-border')
      const chars = prev.el?.querySelectorAll?.('.char__inner')
      try {
        gsap.set([content, border], { clearProps: 'all' })
      } catch (e) {}
      if (chars) {
        try {
          gsap.set(chars, { clearProps: 'all' })
        } catch (e) {}
      }
    } catch (e) {}
  })
</script>

<style lang="scss">
  .s-hero {
    @include flex(column, stretch, stretch);
    @include ink-cloud-ground;

    position: relative;
    z-index: 4;

    min-height: calc(100svh - 7rem - 1px);

    padding-top: env(safe-area-inset-top, 0);

    opacity: 0;
    overflow: hidden;

    @include mq(phone) {
      min-height: calc(100svh - 4.5rem - 1px);
    }

    @include mq(sm-height) {
      min-height: calc(100svh - 4.5rem - 1px);
      align-items: center;
    }

    .s__waves {
      position: relative;
      z-index: 2;

      width: 100%;
      height: 100%;

      flex-grow: 1;
      flex-shrink: 1;
    }

    .s__border {
      position: absolute;
      top: 100%;
      left: 0;

      width: 100%;
      height: 40 * 1rem;

      background: color(secondary);
      transform-origin: 50% 0;

      @include mq(phone) {
        height: 40 * 0.5rem;
      }
    }

    .s__content {
      position: relative;
      z-index: 3;

      overflow: hidden;
      transform-origin: 50% 100%;

      &:before {
        position: absolute;
        top: 0;
        left: 0;

        width: 100%;
        height: 1px;

        background: color(secondary);

        content: '';
      }
    }

    .s__title,
    .s__separator,
    .s__subtitle {
      flex-grow: 0;
      flex-shrink: 0;
    }

    .s__subtitle {
      position: relative;

      margin: 0;
      padding: 0.75rem 1.5rem 0;

      color: color(secondary);
      font: 200 1.15rem / 1.45 font-family(editorial);
      text-align: center;
      text-wrap: balance;

      /* 题签界栏：副题两侧悬臂朱丝，卷首题记之仪 */
      @include ink-column-rule(
        $color: color-mix(in srgb, var(--color-accent) 52%, transparent),
        $width: 1.4em,
        $offset: 0.5em
      );

      @include mq(phone) {
        padding: 0.5rem 1rem 0;

        font-size: 1rem;
      }
    }

    .s__title {
      @include flex(row, center, center);

      position: relative;

      margin: 0;
      padding: 0.2rem 0.5rem 0.45rem;
      gap: 0.04em;

      cursor: default;

      font: 700 min(18vw, 12rem) / 0.82 font-family(bigger);
      letter-spacing: 0.02em;
      text-transform: none;

      @include mq(tablet) {
        padding: 0.2rem 0.75rem 0.4rem;
        flex-wrap: wrap;
        font-size: min(22vw, 8rem);
      }

      @include mq(phone) {
        font-size: min(16vw, 4.5rem);
        letter-spacing: 0;
      }

      @include mq(sm-height) {
        padding-top: 0.1rem;
        padding-bottom: 0.25rem;
        font-size: min(14vw, 5.5rem);
      }

      &__word {
        position: relative;

        display: inline-flex;
        align-items: flex-end;
        height: auto;
      }

      &__asset {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 0.12em 0.08em;
        width: 0.18em;
        height: 0.18em;
        color: color(secondary);

        :global(svg) {
          display: block;
          width: 100%;
          height: 100%;
        }
      }

      :global(.seal-mark--hero) {
        position: absolute;
        right: 0.02em;
        bottom: 0.08em;
        z-index: 2;

        width: clamp(36px, 6vw, 64px);
        height: auto;
        margin: 0;
      }

      @keyframes s-hero-move-to-left {
        0% {
          transform: translate3d(0, 0, 0);
        }

        100% {
          transform: translate3d(100%, 0, 0);
        }
      }

      @keyframes s-hero-move-to-right {
        0% {
          transform: translate3d(0, 0, 0);
        }

        100% {
          transform: translate3d(-100%, 0, 0);
        }
      }

      @keyframes s-hero-move-to-top {
        0% {
          transform: translate3d(0, 0, 0);
        }

        100% {
          transform: translate3d(0, -100%, 0);
        }
      }

      @keyframes s-hero-move-to-bottom {
        0% {
          transform: translate3d(0, 0, 0);
        }

        100% {
          transform: translate3d(0, 100%, 0);
        }
      }

      :global(.char) {
        display: inline-block;

        clip-path: none;

        color: color(secondary);
      }

      :global(.char__inner) {
        position: relative;
        top: 0;

        display: inline-block;

        color: color(secondary);

        will-change: transform;

        &:before,
        &:after {
          display: none;
          content: none;
        }
      }

      :global(.char--t) {
        margin-left: 0;
      }

      :global(.to-top .char__inner) {
        animation: s-hero-move-to-top 1s ease(in-out-quint) 1 forwards;
      }

      :global(.to-right .char__inner) {
        animation: s-hero-move-to-right 1s ease(in-out-quint) 1 forwards;
      }

      :global(.to-bottom .char__inner) {
        animation: s-hero-move-to-bottom 1s ease(in-out-quint) 1 forwards;
      }

      :global(.to-left .char__inner) {
        animation: s-hero-move-to-left 1s ease(in-out-quint) 1 forwards;
      }
    }
  }
</style>
