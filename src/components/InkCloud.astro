---
/**
 * InkCloud - 原创「卷云纹」条带（云气纹 · 圆弧卷曲）
 * 与 InkMeander(回纹/雷) 相对：云取圆弧，雷取方折。
 * currentColor 取色，随主题自动适配；opacity 由使用方覆盖。
 */
type Props = {
  height?: number
  width?: string
  class?: string
}

import { uid } from '../utils/uid'

const { height = 14, width = '100%', class: className } = Astro.props

const patternId = uid('ink-cloud')
const scale = height / 28
---

<svg
  class:list={['ink-cloud', className]}
  style={`height:${height}px;width:${width}`}
  aria-hidden="true"
>
  <defs>
    <pattern
      id={patternId}
      width="56"
      height="28"
      patternUnits="userSpaceOnUse"
      patternTransform={`scale(${scale})`}
    >
      <!-- 如意云头：三叠弧内卷 -->
      <path
        d="M6 23c7.2 0 11.5-4.1 11.5-9.4 0-3.5-2.7-6.2-6.2-6.2s-6.2 2.7-6.2 6.2c0 2.6 2.1 4.6 4.7 4.6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.7"
        stroke-linecap="round"
      ></path>
      <!-- 次卷 + 云尾拖线 -->
      <path
        d="M32 21h19M36.5 21c0-4.4 3.3-7.5 7.5-7.5s7.5 3.1 7.5 7.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
      ></path>
      <!-- 云气散点 -->
      <circle cx="27.5" cy="12" r="0.9" fill="currentColor"></circle>
    </pattern>
  </defs>

  <rect width="100%" height="100%" fill={`url(#${patternId})`}></rect>
</svg>

<style>
  .ink-cloud {
    display: block;

    color: var(--color-indigo, var(--color-secondary));
    opacity: 0.55;
  }

  /* 云雾漂移：缓起缓落，横移不过半朵云 */
  .ink-cloud--drift {
    animation: cloudDrift 16s ease-in-out infinite;
  }

  @keyframes cloudDrift {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-10px, -3px, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-cloud--drift {
      animation: none;
    }
  }
</style>