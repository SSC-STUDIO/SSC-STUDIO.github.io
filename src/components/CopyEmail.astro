---
/**
 * CopyEmail — 全站邮箱复制交互
 * 委托处理所有带 data-copy-email 的链接：点击复制地址 + 浮出「已复制」提示；
 * 无 JS 时按 mailto 正常降级。
 */
---

<script is:inline>
  ;(function () {
    if (window.__copyEmailBound) return
    window.__copyEmailBound = true

    var EMAIL = '3992237161@qq.com'
    var toast = null
    var toastTimer = 0

    function showToast(anchor) {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      if (!toast) {
        toast = document.createElement('span')
        toast.className = 'copy-toast'
        toast.textContent = '已复制到剪贴板'
        toast.setAttribute('role', 'status')
        document.body.appendChild(toast)
      }
      var r = anchor.getBoundingClientRect()
      toast.style.left = Math.max(8, r.left + r.width / 2) + 'px'
      toast.style.top = Math.max(8, r.top - 10) + 'px'
      toast.classList.remove('is-visible')
      // 强制重排以重播动画
      void toast.offsetWidth
      toast.classList.add('is-visible')
      clearTimeout(toastTimer)
      toastTimer = setTimeout(function () {
        toast.classList.remove('is-visible')
      }, reduced ? 2400 : 1500)
    }

    document.addEventListener(
      'click',
      function (e) {
        var link = e.target.closest
          ? e.target.closest('[data-copy-email]')
          : null
        if (!link) return
        e.preventDefault()

        var done = function () {
          showToast(link)
        }
        var fallback = function () {
          var ta = document.createElement('textarea')
          ta.value = EMAIL
          ta.style.position = 'fixed'
          ta.style.opacity = '0'
          document.body.appendChild(ta)
          ta.select()
          try {
            document.execCommand('copy')
          } catch (err) {}
          ta.remove()
          done()
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(EMAIL).then(done, fallback)
        } else {
          fallback()
        }
      },
      { passive: false }
    )
  })()
</script>
