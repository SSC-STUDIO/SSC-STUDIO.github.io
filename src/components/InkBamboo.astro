---
/**
 * InkBamboo — 竹影（竖竿分节 + 侧枝点叶）
 * 「宁可食无肉，不可居无竹」意象：竹影微摇，风过之声可闻。
 * 点叶笔法：短弧线三两成组。currentColor 取色，低透明度装饰。
 */
type Props = {
  size?: number
  flip?: boolean
  class?: string
}

const { size = 200, flip = false, class: className } = Astro.props
---

<div
  class:list={['ink-bamboo', flip && 'ink-bamboo--flip', className]}
  style={`width:${size * 0.5}px;height:${size}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 100 200">
    {/* 主竿：三节 */}
    <path
      class="ink-bamboo__stalk"
      d="M50 200 L50 138 M50 130 L50 72 M50 64 L50 8"
      fill="none"
    ></path>
    {/* 节环 */}
    <path class="ink-bamboo__node" d="M42 134 Q50 130 58 134 M42 66 Q50 62 58 66"></path>
    {/* 侧枝 */}
    <path class="ink-bamboo__branch" d="M50 120 Q66 108 78 96 M50 56 Q36 46 26 34"></path>
    {/* 点叶簇（下侧枝） */}
    <g class="ink-bamboo__leaves">
      <path d="M78 96 q10 -6 18 -4 q-8 6 -18 4"></path>
      <path d="M78 96 q8 4 14 10 q-10 -2 -14 -10"></path>
      <path d="M78 96 q-2 10 2 16 q-6 -8 -2 -16"></path>
    </g>
    {/* 点叶簇（上侧枝） */}
    <g class="ink-bamboo__leaves">
      <path d="M26 34 q-10 -6 -18 -4 q8 6 18 4"></path>
      <path d="M26 34 q-8 4 -14 10 q10 -2 14 -10"></path>
      <path d="M26 34 q2 10 -2 16 q6 -8 2 -16"></path>
    </g>
  </svg>
</div>

<style lang="scss">
  .ink-bamboo {
    position: absolute;
    pointer-events: none;

    svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    transform-origin: bottom center;
    animation: bambooSway 12s ease-in-out infinite;
  }

  .ink-bamboo--flip {
    transform: scaleX(-1);
    transform-origin: center;
  }

  .ink-bamboo__stalk {
    stroke: color(secondary);
    stroke-width: 3;
    stroke-linecap: round;
    opacity: 0.28;
  }

  .ink-bamboo__node,
  .ink-bamboo__branch {
    fill: none;
    stroke: color(secondary);
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.22;
  }

  .ink-bamboo__leaves path {
    fill: color(secondary);
    opacity: 0.16;
  }

  @keyframes bambooSway {
    0%,
    100% {
      transform: rotate(0deg) scaleX(var(--bamboo-flip, 1));
    }
    50% {
      transform: rotate(1.2deg) scaleX(var(--bamboo-flip, 1));
    }
  }

  .ink-bamboo--flip {
    --bamboo-flip: -1;
  }

  :global(.theme-contrasted) {
    .ink-bamboo__stalk {
      opacity: 0.42;
    }

    .ink-bamboo__node,
    .ink-bamboo__branch {
      opacity: 0.34;
    }

    .ink-bamboo__leaves path {
      opacity: 0.26;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-bamboo {
      animation: none;
    }
  }
</style>
