---
/**
 * Site intro (homepage preloader layer)
 * Revealed/animated by the Site class in BaseLayout, removed after first visit
 * (sessionStorage "site-intro-seen").
 */
import SenMark from './SenMark.astro'
---

<div class="site-intro js-intro">
  <p class="site-intro__status js-intro-status" aria-hidden="true">
    Chen Runsen
  </p>

  <div class="sb-logo js-intro-logo">
    <SenMark size={56} variant="draw" />
  </div><!-- .sb-logo -->

  <div class="site-intro__border site-intro__border--top js-border-top"></div>
  <div class="site-intro__border site-intro__border--left js-border-left">
  </div>
  <div class="site-intro__border site-intro__border--right js-border-right">
  </div>
</div><!-- .site-intro -->
