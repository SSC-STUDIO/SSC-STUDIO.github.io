---
/**
 * InkGentlemen - 「四君子」条饰（梅兰竹菊简化线稿）
 * 梅取枝、兰取叶、竹取节、菊取瓣；一为内容过渡的分隔装饰。
 * currentColor 取色；opacity 由使用方覆盖。
 */
type Props = {
  height?: number
  width?: string
  class?: string
}

const { height = 22, width = 'min(20rem, 70vw)', class: className } =
  Astro.props
---

<svg
  class:list={['ink-gentlemen', className]}
  style={`height:${height}px;width:${width}`}
  viewBox="0 0 120 28"
  aria-hidden="true"
>
  <g
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- 梅：折枝攒花 -->
    <path d="M4 25c6-6 10-12 17-17"></path>
    <path d="M13 17c2-1 4-1 6 0"></path>
    <circle cx="25" cy="7" r="1.9"></circle>
    <circle cx="21" cy="5" r="1.9"></circle>
    <circle cx="21" cy="9.5" r="1.9"></circle>
    <circle cx="29" cy="5" r="1.9"></circle>
    <circle cx="29" cy="9.5" r="1.9"></circle>
    <circle cx="25" cy="7" r="0.6" fill="currentColor" stroke="none"></circle>
    <!-- 兰：叶分三箭，花吐一茎 -->
    <path d="M38 25c-1-9 1-16 8-21"></path>
    <path d="M38 25c3-7 8-12 16-14"></path>
    <path d="M38 25c5-3 11-4 17-3"></path>
    <path d="M46 4c-1-1-3-1-3.5 0.5"></path>
    <path d="M46 4c1-1 2.5-1 3 0.5"></path>
    <!-- 竹：两节三叶 -->
    <path d="M74 25V6"></path>
    <path d="M71 12h6"></path>
    <path d="M71 19h6"></path>
    <path d="M74 7c3-2.5 7-2.5 10-0.5-3 2.5-7 2.5-10 0.5Z"></path>
    <path d="M74 13c-3-2-6.5-2-9.5-0.5 3 2.5 6.5 2 9.5 0.5Z"></path>
    <!-- 菊：攒瓣为轮 -->
    <circle cx="104" cy="14" r="2"></circle>
    <path d="M104 12c-0.5-2-0.2-4 1.5-5.5"></path>
    <path d="M104 12c0.5-2 0.2-4-1.5-5.5"></path>
    <path d="M102 14c-2-0.5-4-0.2-5.5 1.5"></path>
    <path d="M102 14c-2 0.5-4 0.2-5.5-1.5"></path>
    <path d="M106 14c2-0.5 4-0.2 5.5 1.5"></path>
    <path d="M106 14c2 0.5 4 0.2 5.5-1.5"></path>
    <path d="M104 16c-0.5 2-0.2 4 1.5 5.5"></path>
    <path d="M104 16c0.5 2 0.2 4-1.5 5.5"></path>
  </g>
</svg>

<style>
  .ink-gentlemen {
    display: block;

    color: var(--color-mist, var(--color-secondary));
    opacity: 0.7;
  }
</style>
