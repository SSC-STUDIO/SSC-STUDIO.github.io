---
/**
 * SiteInkIntro — 研墨开卷（首页入场层）
 *
 * 纸面落墨、森字「木→林→森」错峰长出、落款钤印、卷帘上收。
 * 编排在 src/motion/ink-intro.ts，只在首次硬加载播放；
 * 看过一次（sessionStorage）或减少动态时整层直接撤走。
 */
import SenMark from './SenMark.astro'
import SealMark from './SealMark.astro'
---

<div class="ink-intro js-intro" aria-hidden="true">
  <div class="ink-intro__sheet js-intro-sheet">
    <div class="ink-intro__blot js-intro-blot"></div>

    <div class="ink-intro__bleed js-intro-bleed">
      <i class="ink-intro__speck ink-intro__speck--mu"></i>
      <i class="ink-intro__speck ink-intro__speck--lin"></i>
      <i class="ink-intro__speck ink-intro__speck--sen"></i>
    </div>

    <div class="ink-intro__mark js-intro-mark">
      <SenMark size={280} variant="grow" class="js-intro-sen" />
    </div>

    <p class="ink-intro__stage js-intro-stage">
      <span data-glyph="mu">木</span>
      <span data-glyph="lin">林</span>
      <span data-glyph="sen">森</span>
    </p>

    <div class="ink-intro__seal js-intro-seal">
      <SealMark size={44} variant="hero" />
    </div>

    <p class="ink-intro__name js-intro-name">陈润森</p>
  </div>

  <div class="ink-intro__rod js-intro-rod"></div>
</div><!-- .ink-intro -->

<style lang="scss">
  .ink-intro {
    position: fixed;
    inset: 0;
    z-index: 80;

    /* 默认露出：宣纸必须在首帧就在。SPA 摘掉 is-intro-active 后再藏。 */
    visibility: visible;
    pointer-events: auto;

    :global(html:not(.is-intro-active)) & {
      visibility: hidden;
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      display: none !important;
    }

    /* 卷帘（sheet）与轴杆（rod）分离：clip-path 只裁纸面，杆不受裁切 */

    &__sheet {
      position: absolute;
      inset: 0;

      /* 开卷永远是白日宣纸，不跟翻色；纤维点让纸面不像站点同色空底 */
      background:
        radial-gradient(1.2px 0.9px at 18% 22%, rgba(28, 42, 34, 0.07), transparent 2px),
        radial-gradient(1.4px 1px at 72% 38%, rgba(109, 81, 56, 0.08), transparent 2px),
        radial-gradient(1px 1.2px at 41% 71%, rgba(194, 58, 43, 0.07), transparent 2px),
        radial-gradient(1.1px 1px at 86% 64%, rgba(28, 42, 34, 0.05), transparent 2px),
        radial-gradient(
          90% 70% at 50% 115%,
          rgba(194, 58, 43, 0.12) 0%,
          transparent 62%
        ),
        linear-gradient(
          180deg,
          #f7eedc 0%,
          #f3e6cc 68%,
          #ead9b8 100%
        );

      will-change: clip-path;
    }

    /* 墨团：径向渐变淡出边缘 + 不规则圆角，像一滴墨洇开 */
    &__blot {
      --blot-size: min(62vmin, 460px);

      position: absolute;
      top: 50%;
      left: 50%;

      width: var(--blot-size);
      height: var(--blot-size);

      z-index: 1;

      background: radial-gradient(
        closest-side,
        rgba(20, 28, 22, 0.58) 0%,
        rgba(28, 42, 34, 0.36) 38%,
        rgba(61, 90, 102, 0.2) 66%,
        transparent 100%
      );
      border-radius: 58% 42% 55% 45% / 48% 56% 44% 52%;
      mix-blend-mode: multiply;

      translate: -50% -50%;
      opacity: 0;

      will-change: transform, opacity;

      :global(html.is-intro-active) & {
        animation: ink-intro-blot 440ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      &::after {
        position: absolute;
        top: 8%;
        right: -4%;

        width: 18%;
        height: 14%;

        background: radial-gradient(
          closest-side,
          rgba(28, 42, 34, 0.72) 0%,
          transparent 88%
        );
        border-radius: 62% 38% 54% 46% / 52% 60% 40% 48%;

        content: '';
      }
    }

    /* 三木落点的副墨：跟着 木 / 林 / 森 错峰洇开 */
    &__bleed {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 2;

      width: min(58vmin, 420px);
      height: min(58vmin, 420px);

      pointer-events: none;
      translate: -50% -52%;
    }

    &__speck {
      position: absolute;

      border-radius: 62% 38% 54% 46% / 48% 58% 42% 52%;
      background: radial-gradient(
        closest-side,
        rgba(28, 42, 34, 0.4) 0%,
        transparent 78%
      );
      mix-blend-mode: multiply;
      opacity: 0;

      will-change: transform, opacity;

      :global(html.is-intro-active) & {
        animation: ink-intro-speck 560ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      &--mu {
        top: 8%;
        left: 38%;
        width: 28%;
        height: 24%;

        :global(html.is-intro-active) & {
          animation-delay: 80ms;
        }
      }

      &--lin {
        top: 52%;
        left: 8%;
        width: 26%;
        height: 28%;
        border-radius: 48% 52% 40% 60% / 56% 38% 62% 44%;

        :global(html.is-intro-active) & {
          animation-delay: 420ms;
        }
      }

      &--sen {
        top: 50%;
        right: 6%;
        width: 26%;
        height: 28%;
        border-radius: 40% 60% 55% 45% / 50% 42% 58% 48%;

        :global(html.is-intro-active) & {
          animation-delay: 720ms;
        }
      }
    }

    &__mark {
      position: absolute;
      top: 48%;
      left: 50%;
      z-index: 3;

      overflow: visible;
      color: #141c16;

      translate: -50% -54%;
      opacity: 1;

      :global(.sen-mark) {
        width: min(58vmin, 340px);
        height: min(58vmin, 340px);
        overflow: visible;
      }

      :global(.sen-mark path) {
        stroke-width: 16;
      }
    }

    /* 木 / 林 / 森 叙事字，随三木错峰亮起 */
    &__stage {
      position: absolute;
      top: calc(50% + min(22vmin, 8.4rem));
      left: 50%;
      z-index: 3;

      display: flex;
      gap: 1.15em;
      margin: 0;

      color: rgba(20, 28, 22, 0.78);
      font: 400 1.15rem / 1 font-family(editorial);
      letter-spacing: 0.36em;

      translate: -50% 0;
      pointer-events: none;

      @include mq(phone) {
        top: calc(50% + min(24vmin, 7.2rem));
        font-size: 0.95rem;
      }

      span {
        opacity: 0;
      }

      :global(html.is-intro-active) & span {
        animation: ink-intro-stage 320ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      :global(html.is-intro-active) & [data-glyph='mu'] {
        animation-delay: 220ms;
      }

      :global(html.is-intro-active) & [data-glyph='lin'] {
        animation-delay: 620ms;
      }

      :global(html.is-intro-active) & [data-glyph='sen'] {
        animation-delay: 980ms;
      }
    }

    /* 小印：森成之后钤在右下，不抢森标 */
    &__seal {
      position: absolute;
      top: calc(50% + min(12vmin, 4.8rem));
      left: calc(50% + min(18vmin, 7.6rem));
      z-index: 4;

      opacity: 0;

      will-change: transform, opacity;

      @include mq(phone) {
        top: calc(50% + min(14vmin, 4.2rem));
        left: calc(50% + min(16vmin, 5.8rem));
      }
    }

    /* 竖排落款，如画上题名 */
    &__name {
      position: absolute;
      top: calc(50% + min(16vmin, 6.2rem));
      left: calc(50% + min(22vmin, 9.2rem));
      z-index: 4;

      margin: 0;

      color: #141c16;
      font: 400 0.88rem / 1 font-family(editorial);
      letter-spacing: 0.42em;
      writing-mode: vertical-rl;

      opacity: 0;

      will-change: transform, opacity;

      @include mq(phone) {
        top: calc(50% + min(18vmin, 5.4rem));
        left: calc(50% + min(20vmin, 7.2rem));

        font-size: 0.74rem;
      }
    }

    /* 轴杆：温木色圆杆，两端朱砂轴头，随卷边上行 */
    &__rod {
      position: absolute;
      bottom: -0.15rem;
      left: 50%;
      z-index: 5;

      width: calc(100% + 1.4rem);
      height: 0.8rem;

      background: linear-gradient(180deg, #6d5138 0%, #4a3524 55%, #2f2116 100%);
      border-radius: 0.4rem;
      box-shadow: 0 -14px 34px rgba(15, 22, 18, 0.24);

      translate: -50% 0;

      will-change: transform;

      &::before,
      &::after {
        position: absolute;
        top: -2px;

        width: 1.05rem;
        height: calc(100% + 4px);

        background: linear-gradient(180deg, #d84a3a 0%, #a42e22 100%);
        border-radius: 0.3rem;

        content: '';
      }

      &::before {
        left: -0.2rem;
      }

      &::after {
        right: -0.2rem;
      }

      @include mq(phone) {
        height: 0.6rem;

        &::before,
        &::after {
          width: 0.8rem;
        }
      }
    }
  }

  @keyframes ink-intro-blot {
    from {
      opacity: 0;
      transform: scale(0.16) rotate(-8deg);
    }
    to {
      opacity: 0.95;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes ink-intro-speck {
    0% {
      opacity: 0;
      transform: scale(0.2);
    }
    55% {
      opacity: 0.78;
      transform: scale(1);
    }
    100% {
      opacity: 0.42;
      transform: scale(1.12);
    }
  }

  @keyframes ink-intro-stage {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
