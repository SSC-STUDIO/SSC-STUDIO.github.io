---
import InkMountains from './InkMountains.astro'
import InkMist from './InkMist.astro'
import SealMark from './SealMark.astro'
import InkCloud from './InkCloud.astro'
import InkLattice from './InkLattice.astro'
import InkBubbles from './InkBubbles.astro'
import InkSeal3D from './InkSeal3D.astro'

const lines = [['一', '起', '做'], ['点', '东', '西']]
---

<section class="s-cta" data-intersect>
  <InkMountains dimensional />
  <InkMist class="s__mist" />
  <InkBubbles class="s__bubbles" />
  <InkCloud height={13} width="min(30rem, 72vw)" class="s__cloud" />
  <InkLattice size={168} class="s__lattice" />

  <div class="s__fireflies" aria-hidden="true">
    {
      Array(3)
        .fill(0)
        .map(() => (
          <svg
            class="s__firefly"
            width="49"
            height="49"
            viewBox="0 0 49 49"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <circle class="ff-halo" cx="24.5" cy="24.5" r="10" />
            <circle class="ff-core" cx="24.5" cy="24.5" r="2.8" />
          </svg>
        ))
    }
  </div>
  <div id="contact" class="s__inner js-container">
    <div class="s__hover js-hover">
      <a href="/contact" class="s__button js-button" aria-label="写信给我 — 联系陈润森">
        <div class="s__button__inner">
          <div class="s__button__text js-button-text">
            信
          </div><!-- .s__button__text -->
        </div><!-- .s__button__inner -->
        <span class="s__button__hint" aria-hidden="true">写信给我</span>
      </a><!-- .s__button -->

      <div class="s__cta js-cta">
        {
          lines.map((line, i) => (
            <div
              class:list={[
                's__cta__line',
                's__cta__line--' + (i === 0 ? 'top' : 'bottom'),
              ]}
            >
              <div class="s__cta__text">
                {line.map((char) => (
                  <span class="s__cta__char">
                    {['', '', '', ''].map(() => (
                      <span class="s__cta__char__slice" set:html={char} />
                    ))}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
        <a href="mailto:3992237161@qq.com" class="s__cta__link" data-copy-email>
          <span class="s__cta__chip">3992237161@qq.com</span>
        </a>

        <a
          href="https://github.com/SSC-STUDIO"
          class="s__cta__link s__cta__link--github"
          target="_blank"
          rel="noopener"
        >
          <span class="s__cta__chip">@SSC-STUDIO</span>
        </a>

        <div class="s__cta__stars">
          {
            Array(4)
              .fill(0)
              .map(() => (
                <svg
                  class="s__cta__star"
                  width="49"
                  height="49"
                  viewBox="0 0 49 49"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <circle
                    class="ff-halo"
                    cx="24.5"
                    cy="24.5"
                    r="10"
                  ></circle>
                  <circle
                    class="ff-core"
                    cx="24.5"
                    cy="24.5"
                    r="2.8"
                  ></circle>
                </svg>
              ))
          }
        </div>

        <div class="a-dots"></div>
      </div><!-- .s__cta -->
    </div><!-- .s__hover -->
  </div><!-- .s__inner -->

  <span class="s__couplet s__couplet--east" aria-hidden="true">以好奇为灯</span>
  <span class="s__couplet s__couplet--west" aria-hidden="true">以长期为舟</span>

  <InkSeal3D class="s__seal3d" />

  <div class="s__grid js-grid">
    <svg class="s__grid__svg js-grid-svg">
      <path class="s__grid__path js-grid-path" d=""></path>
    </svg>
  </div><!-- .s__grid -->

  <SealMark variant="watermark" size={46} />
</section>

<script>
  import {
    whenReady,
    onFrame,
    onResize,
    prefersReducedMotion,
    type Cleanup,
  } from '../motion/core'

  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  class Section {
    el: HTMLElement
    container: HTMLElement
    hover: HTMLElement
    button: HTMLElement
    cta: HTMLElement

    bounding: DOMRect

    ctaMaxSize: number

    grid: {
      bounding: DOMRect
      width: number
      height: number
      vLines: number
      hLines: number
      gapX: number
      gapY: number
      lines: any[]
      points: any[]
      el: HTMLElement
      svg: HTMLElement
      path: HTMLElement
    }

    wave: {
      progress: number
      op: number
      speed: number
      strength: number
      state: string
      timeout: number
    }

    buttonIsHovered: boolean
    isPaused: boolean
    tl: gsap.core.Timeline
    stops: Cleanup[] = []
    unframe: Cleanup | null = null
    destroyed = false

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-cta')

      if (!this.el) {
        return
      }

      this.container = this.el.querySelector('.js-container')
      this.hover = this.el.querySelector('.js-hover')
      this.button = this.el.querySelector('.js-button')
      this.cta = this.el.querySelector('.js-cta')

      // Properties
      this.grid = {
        bounding: new DOMRect(),
        width: 0,
        height: 0,
        vLines: 0,
        hLines: 0,
        gapX: 0,
        gapY: 0,
        lines: [],
        points: [],
        el: this.el.querySelector('.js-grid'),
        svg: this.el.querySelector('.js-grid-svg'),
        path: this.el.querySelector('.js-grid-path'),
      }

      this.wave = {
        progress: 0,
        op: 0,
        speed: window.safeWidth > 767 ? 15 : 10,
        strength: window.safeWidth > 767 ? 1 : 0.35,
        state: 'paused',
        timeout: 0,
      }

      this.buttonIsHovered = false
      this.isPaused = true

      whenReady(() => this.init())
    }

    /**
     * Init
     */
    init() {
      if (this.destroyed || !this.el) return

      this.setSize()
      this.setGrid()

      this.createPulseTimeline()

      this.bindEvents()
    }

    /**
     * SPA 换页收尾：帧循环、订阅、脉冲时间线与波纹定时器全部收掉
     */
    destroy() {
      this.destroyed = true
      this.stopFrame()
      this.stops.forEach((stop) => stop())
      this.stops = []

      if (this.wave) clearTimeout(this.wave.timeout)
      this.tl?.kill()
      this.tl = null
    }

    /**
     * Bind events
     */
    bindEvents() {
      this.stops.push(onResize(() => this.onResize()))

      const hover = (e: Event) => this.onHover(e)
      const out = (e: Event) => this.onOut(e)
      const empty = (e: Event) => this.onEmptyClick(e)

      // 整个 CTA 区域（含大圆）都可触发，而不是只有 96px 的按钮格
      this.container.addEventListener('pointerenter', hover)
      this.container.addEventListener('pointerleave', out)
      this.el.addEventListener('click', empty)
      this.el.addEventListener('intersect', this.onIntersect, {
        passive: true,
      })

      this.stops.push(() => {
        this.container.removeEventListener('pointerenter', hover)
        this.container.removeEventListener('pointerleave', out)
        this.el.removeEventListener('click', empty)
        this.el.removeEventListener('intersect', this.onIntersect)
      })
    }

    startFrame() {
      if (this.unframe) return
      this.unframe = onFrame((time) => this.tick(time))
    }

    stopFrame() {
      this.unframe?.()
      this.unframe = null
    }

    /**
     * Resize handler
     */
    onResize() {
      this.setSize()
      this.setGrid()
    }

    /**
     * Intersect handler
     */
    onIntersect = (e: CustomEvent) => {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) this.stopFrame()
      else this.startFrame()
    }

    /**
     * Hover handler
     */
    onHover(e) {
      if (this.buttonIsHovered) return

      this.buttonIsHovered = true
      this.hover.classList.add('is-active')

      this.tl?.pause()

      clearTimeout(this.wave.timeout)
      this.wave.timeout = setTimeout(() => {
        this.waveShock()
      }, 600)

      gsap.to(this.wave, {
        op: 1,
        delay: 0.3,
        duration: 1.2,
        ease: 'expo.inOut',
        overwrite: true,
      })

      e.stopPropagation()
    }

    /**
     * Out handler
     *
     * 老版在这里对 <a> 写 window.location.href，ClientRouter 下会整页硬跳，
     * 把已经挂好的动效全拆掉。链接交给默认行为 / SPA 导航。
     */
    onOut(_e) {
      if (!this.buttonIsHovered) return

      clearTimeout(this.wave.timeout)

      this.buttonIsHovered = false
      this.hover.classList.remove('is-active')

      this.tl?.play(0)

      gsap.to(this.wave, {
        op: 0,
        duration: 0.7,
        ease: 'expo.inOut',
        overwrite: true,
      })
    }

    /**
     * 点大圆与印玺之外的空白（远山、网格）：激起一圈纸面震波
     */
    onEmptyClick(e: Event) {
      if (prefersReducedMotion()) return
      const target = e.target as Element | null
      if (!target) return
      if (target.closest('a, button, ink-seal3d, .s__button, .s__cta')) return
      this.waveShock()
    }

    /**
     * Set size
     */
    setSize() {
      this.grid.bounding = this.grid.el.getBoundingClientRect()
      this.bounding = this.container.getBoundingClientRect()

      this.ctaMaxSize = Math.min(this.bounding.width, this.bounding.height) - 32
      this.cta.style.setProperty('--size', this.ctaMaxSize + 'px')
    }

    /**
     * Set grid
     */
    setGrid() {
      const { grid } = this

      const width = this.grid.bounding.width
      const height = this.grid.bounding.height

      grid.width = width
      grid.height = height

      grid.svg.style.width = width + 'px'
      grid.svg.style.height = height + 'px'

      // Points
      grid.points = []

      grid.vLines = window.safeWidth > 767 ? 12 : 8
      grid.gapX = width / grid.vLines

      grid.gapY = this.bounding.height / 8
      grid.hLines = Math.floor(height / grid.gapY)

      const offsetY = height - grid.gapY * grid.hLines

      const center = {
        x: width / 2,
        y: height - this.bounding.height / 2,
      }

      for (let i = 0; i <= grid.vLines; i++) {
        const row = []

        for (let j = 0; j <= grid.hLines; j++) {
          const point = {
            x: grid.gapX * i,
            y: grid.gapY * j + (j !== 0 ? offsetY : 0),
            ax: 0, // Acceleration
            ay: 0,
            vx: 0, // Velocity
            vy: 0,
            wx: 0, // Wave
            wy: 0,
            mx: 0, // Movement
            my: 0,
            ox: 0, // Offset
            oy: 0,
            dx: 0, // Distance
            dy: 0,
            dist: 0,
          }

          const dx = point.x - center.x
          const dy = point.y - center.y
          const angle = Math.atan2(dy, dx)

          point.dist = Math.hypot(dx, dy)
          if (point.dist === 0) {
            point.dx = 0
            point.dy = 0
          } else {
            point.dx = Math.cos(angle) * (width / 2 / point.dist) * 5
            point.dy = Math.sin(angle) * (width / 2 / point.dist) * 5
          }

          row.push(point)
        }

        grid.points.push(row)
      }
    }

    /**
     * Create pulse timeline
     */
    createPulseTimeline() {
      /* reduced-motion：不建无限脉冲时间线，按钮文字保持静止 */
      if (prefersReducedMotion()) {
        return
      }

      const text = this.container.querySelector('.js-button-text')

      this.tl = gsap.timeline({
        repeat: -1,
        repeatDelay: 0.5,
      })

      this.tl.call(() => {
        this.wave.state = 'pulse'
      })

      this.tl.fromTo(
        text,
        {
          scale: 0.85,
        },
        {
          scale: 1.05,
          duration: 2.7,
          ease: 'power2.in',
        }
      )

      this.tl.call(this.wavePulse.bind(this), [])

      this.tl.to(text, {
        scale: 0.85,
        duration: 0.15,
        ease: 'power4.out',
      })
    }

    /**
     * Move points
     */
    movePoints(time) {
      const { grid, wave } = this

      grid.points.forEach((col, x) => {
        col.forEach((point, y) => {
          if (y === 0 || point.dist === 0) return

          const d = Math.abs(point.dist - wave.progress)
          const l = 30

          if (d < l) {
            const s = 1 - d / l
            const a = Math.atan2(point.dy, point.dx)
            const f = Math.cos(d * 0.01) * s

            point.vx += Math.cos(a) * f * l * 0.5 * wave.strength
            point.vy += Math.sin(a) * f * l * 0.5 * wave.strength
          }

          point.vx += (0 - point.wx) * 0.001 // String tension
          point.vy += (0 - point.wy) * 0.001

          point.vx *= 0.9 // Friction or duration
          point.vy *= 0.9

          point.wx += point.vx * 3 // Strength
          point.wy += point.vy * 3

          point.wx *= 0.9
          point.wy *= 0.9

          point.mx = point.wx * 0.1
          point.my = point.wy * 0.1

          point.ox = point.dx / Math.hypot(window.safeHeight, window.safeWidth)
          point.oy = point.dy / Math.hypot(window.safeHeight, window.safeWidth)

          point.ox = this.easeOut(point.ox)
          point.oy = this.easeOut(point.oy)

          point.ox *= grid.gapX * 75 * (point.dist / this.ctaMaxSize)
          point.oy *= grid.gapY * 75 * (point.dist / this.ctaMaxSize)
        })
      })
    }

    /**
     * Ease out
     */
    easeOut(t) {
      return t === 1 ? 1 : 1 - Math.pow(2, -10 * t)
    }

    /**
     * Draw lines
     */
    drawLines() {
      const { grid } = this

      let d = ''

      // Vertical lines
      grid.points.forEach((col) => {
        col.forEach((point, i) => {
          const p = this.movedPoint(point)

          if (i === 0) {
            d += `M ${p.x} ${p.y} `
          } else {
            d += `L ${p.x} ${p.y} `
          }
        })
      })

      // Horizontal lines
      for (let y = 0; y < grid.hLines; y++) {
        grid.points.forEach((col, x) => {
          const point = col[y]
          const p = this.movedPoint(point)

          if (x === 0) {
            d += `M ${p.x} ${p.y} `
          } else {
            d += `L ${p.x} ${p.y} `
          }
        })
      }

      grid.path.setAttribute('d', d)
    }

    /**
     * Get point coordinates with movement added
     */
    movedPoint(point) {
      return {
        x: point.x + point.mx + point.ox * this.wave.op,
        y: point.y + point.my + point.oy * this.wave.op,
      }
    }

    /**
     * Wave pulse
     */
    wavePulse() {
      if (this.buttonIsHovered) return

      const { wave } = this

      wave.progress = 0
      wave.state = 'pulse'
      wave.speed = window.safeWidth > 767 ? 15 : 10
      wave.strength = window.safeWidth > 767 ? 1 : 0.35
    }

    /**
     * Wave shock
     */
    waveShock() {
      const { wave } = this

      if (wave.state === 'shock') return

      wave.progress = 0
      wave.state = 'shock'
      wave.speed = 30
      wave.strength = 5
      if (!this.isPaused) this.startFrame()
    }

    /**
     * Tick
     */
    tick(time) {
      const { wave } = this

      if (wave.progress < this.grid.height) {
        if (wave.state !== 'paused') {
          wave.progress += wave.speed
        }
      }

      this.movePoints(time)
      this.drawLines()
    }
  }

  /* ClientRouter 下模块脚本只执行一次：每次换页对新 DOM 重建，先收旧实例 */
  const mountCTA = () => {
    const prev = (window as any).__sCTA
    try {
      prev?.destroy?.()
    } catch (e) {}
    ;(window as any).__sCTA = document.querySelector('.s-cta')
      ? new Section()
      : null
  }

  document.addEventListener('astro:page-load', mountCTA)
  document.addEventListener('astro:before-swap', () => {
    try {
      ;(window as any).__sCTA?.destroy?.()
    } catch (e) {}
    ;(window as any).__sCTA = null
  })
</script>

<style lang="scss">
  .s-cta {
    position: relative;
    z-index: 2;
    overflow: hidden;

    padding: 55rem 0 0;

    @include mq(desktop-lg) {
      padding-top: 48rem;
    }

    @include mq(desktop-md) {
      padding-top: 41.25rem;
    }

    @include mq(desktop-sm) {
      padding-top: 34.375rem;
    }

    @include mq(tablet) {
      padding-top: 36rem;
    }

    @include mq(tablet-sm) {
      padding-top: 30rem;
    }

    @include mq(phone) {
      padding-top: 21.6rem;
    }

    /* 山脚雾霭：压住远山脚线，垫在卷云之下 */
    .s__mist {
      z-index: 1;
    }

    /* 墨圈泡泡：与前几卷同族的上浮墨圈，垫在信物层之下 */
    .s__bubbles {
      z-index: 1;
    }

    /* 信笺云头：区块上端一抹卷云，随风缓漂 */
    .s__cloud {
      position: absolute;
      top: clamp(1.5rem, 4vw, 3.5rem);
      left: 50%;
      z-index: 2;

      transform: translateX(-50%);
      animation: s-cta-cloud-drift 19s ease-in-out infinite alternate;
      will-change: transform;
    }

    @keyframes s-cta-cloud-drift {
      from {
        transform: translateX(-53%);
      }

      to {
        transform: translateX(-47%);
      }
    }

    /* 常显流萤：hover 圆环里的流萤只在展开时可见，
       这三枚在留白处长明，给静场一点游动的光 */
    .s__fireflies {
      position: absolute;
      inset: 0;
      z-index: 2;

      pointer-events: none;
    }

    @keyframes s-cta-ff-roam {
      0% {
        transform: translate3d(0, 0, 0);
      }

      30% {
        transform: translate3d(1.6rem, -2.6rem, 0);
      }

      62% {
        transform: translate3d(-1.1rem, -4.4rem, 0);
      }

      100% {
        transform: translate3d(0.4rem, -0.8rem, 0);
      }
    }

    .s__firefly {
      position: absolute;

      width: 0.9rem;
      height: auto;

      overflow: visible;

      animation: s-cta-ff-roam 13s ease-in-out infinite alternate;
      will-change: transform;

      .ff-halo {
        fill: color-mix(
          in srgb,
          var(--daypart-lamp, var(--color-accent)) 30%,
          transparent
        );

        animation: s-ff-pulse 3.2s ease-in-out infinite;
      }

      .ff-core {
        fill: var(--daypart-lamp, var(--color-accent));
      }

      &:nth-child(1) {
        top: 24%;
        left: 16%;

        animation-duration: 12s;
      }

      &:nth-child(2) {
        top: 14%;
        right: 21%;
        width: 0.7rem;

        animation-duration: 16s;
        animation-delay: -6s;

        .ff-halo {
          animation-delay: -1.4s;
        }
      }

      &:nth-child(3) {
        top: 55%;
        left: 9%;
        width: 0.62rem;

        animation-duration: 14s;
        animation-delay: -10s;

        .ff-halo {
          animation-delay: -2.2s;
        }
      }

      @include mq(phone) {
        &:nth-child(3) {
          display: none;
        }
      }
    }

    /* 立体印玺：信末左下钤印处，与右下窗棂对角 */
    .s__seal3d {
      position: absolute;
      bottom: clamp(2.4rem, 7vh, 5rem);
      left: clamp(1.25rem, 6vw, 6rem);
      z-index: 3;

      @include mq(tablet-sm) {
        display: none;
      }
    }

    /* 冰裂窗棂水印：右下角隅 */
    .s__lattice {
      position: absolute;
      right: clamp(0.75rem, 3vw, 2.5rem);
      bottom: clamp(0.9rem, 2.6vh, 2.25rem);
      z-index: 1;

      opacity: 0.55;

      @include mq(phone) {
        display: none;
      }
    }

    .s__inner {
      @include flex(column, center, center);

      position: relative;
      z-index: 3;

      height: calc(100vh - 8rem - 2px);

      @include mq(phone) {
        height: calc(100vh - 4.375rem);
      }
    }

    .s__button {
      position: relative;
      z-index: 5;

      display: block;
      width: 6rem;
      height: 6rem;

      cursor: pointer;

      color: #fff6ea;
      font: 700 2.4rem / 6rem font-family(bigger);
      letter-spacing: 0.08em;
      text-align: center;
      text-decoration: none;
      text-indent: 0;
      text-transform: none;

      /* 呼吸铃环：火漆印外一圈虚线朱丝 */
      &::before {
        position: absolute;
        inset: -0.55rem;

        border: 1px dashed
          color-mix(in srgb, var(--color-accent) 76%, transparent);
        border-radius: 50%;
        content: '';
        pointer-events: none;

        animation: s-button-ring 2.8s ease-in-out infinite;
      }

      @keyframes s-button-ring {
        0%,
        100% {
          opacity: 0.35;
          transform: scale(0.96);
        }
        50% {
          opacity: 1;
          transform: scale(1.05);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        &::before {
          animation: none;
        }
      }

      /* 封条绢带 —— 火漆左上斜贴的「亲启」小签 */
      &::after {
        position: absolute;
        top: -0.9rem;
        left: 50%;
        z-index: 3;

        padding: 0.62em 0.24em;

        background: linear-gradient(
          180deg,
          color(paper-warm),
          color-mix(in srgb, color(paper-warm) 86%, #000)
        );
        box-shadow:
          inset 0 0 0 1px color-mix(in srgb, color(secondary) 50%, transparent),
          inset 0 0 0 2.5px color(paper-warm),
          1px 1.5px 4px rgba(12, 10, 8, 0.26);

        color: color(secondary);
