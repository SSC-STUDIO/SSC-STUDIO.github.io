---
import InkMountains from './InkMountains.astro'
import InkMist from './InkMist.astro'
import SealMark from './SealMark.astro'
import InkCloud from './InkCloud.astro'
import InkLattice from './InkLattice.astro'
import InkBubbles from './InkBubbles.astro'
import InkSeal3D from './InkSeal3D.astro'

const lines = [['一', '起', '做'], ['点', '东', '西']]
---

<section class="s-cta" data-intersect>
  <InkMountains dimensional />
  <InkMist class="s__mist" />
  <InkBubbles class="s__bubbles" />
  <div class="s__cloud-hit js-cloud" aria-hidden="true">
    <InkCloud height={13} width="min(30rem, 72vw)" class="s__cloud" />
  </div>
  <InkLattice size={168} class="s__lattice" />

  <div class="s__fireflies" aria-hidden="true">
    {
      Array(4)
        .fill(0)
        .map(() => (
          <span class="s__firefly">
            <svg
              class="s__firefly__glow"
              width="49"
              height="49"
              viewBox="0 0 49 49"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <circle class="ff-halo" cx="24.5" cy="24.5" r="10" />
              <circle class="ff-core" cx="24.5" cy="24.5" r="2.8" />
            </svg>
          </span>
        ))
    }
  </div>
  <div class="s__blots js-blots" aria-hidden="true"></div>
  <div id="contact" class="s__inner js-container">
    <div class="s__hover js-hover">
      <div class="s__envelope" aria-hidden="true">
        <i class="s__envelope__pocket"></i>
        <i class="s__envelope__sheet"></i>
        <i class="s__envelope__wing s__envelope__wing--left"></i>
        <i class="s__envelope__wing s__envelope__wing--right"></i>
        <i class="s__envelope__flap"></i>
      </div>
      <a href="/contact" class="s__button js-button" aria-label="写信给我 — 联系陈润森">
        <div class="s__button__inner">
          <div class="s__button__text js-button-text">
            信
          </div><!-- .s__button__text -->
        </div><!-- .s__button__inner -->
        <span class="s__button__hint" aria-hidden="true">写信给我</span>
      </a><!-- .s__button -->

      <div class="s__cta js-cta">
        {
          lines.map((line, i) => (
            <div
              class:list={[
                's__cta__line',
                's__cta__line--' + (i === 0 ? 'top' : 'bottom'),
              ]}
            >
              <div class="s__cta__text">
                {line.map((char) => (
                  <span class="s__cta__char">
                    {char}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
        <a href="mailto:3992237161@qq.com" class="s__cta__link" data-copy-email>
          <span class="s__cta__chip">3992237161@qq.com</span>
        </a>

        <a
          href="https://github.com/SSC-STUDIO"
          class="s__cta__link s__cta__link--github"
          target="_blank"
          rel="noopener"
        >
          <span class="s__cta__chip">@SSC-STUDIO</span>
        </a>

        <div class="s__cta__stars">
          {
            Array(4)
              .fill(0)
              .map(() => (
                <svg
                  class="s__cta__star"
                  width="49"
                  height="49"
                  viewBox="0 0 49 49"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  aria-hidden="true"
                >
                  <circle
                    class="ff-halo"
                    cx="24.5"
                    cy="24.5"
                    r="10"
                  ></circle>
                  <circle
                    class="ff-core"
                    cx="24.5"
                    cy="24.5"
                    r="2.8"
                  ></circle>
                </svg>
              ))
          }
        </div>

        <div class="a-dots"></div>
      </div><!-- .s__cta -->
    </div><!-- .s__hover -->
  </div><!-- .s__inner -->

  <span class="s__couplet s__couplet--east" aria-hidden="true">以好奇为灯</span>
  <span class="s__couplet s__couplet--west" aria-hidden="true">以长期为舟</span>

  <InkSeal3D class="s__seal3d" />

  <div class="s__grid js-grid">
    <svg class="s__grid__svg js-grid-svg">
      <path class="s__grid__path js-grid-path" d=""></path>
    </svg>
  </div><!-- .s__grid -->

  <SealMark variant="watermark" size={46} />
</section>

<script>
  import {
    whenReady,
    onFrame,
    onResize,
    onPointer,
    prefersReducedMotion,
    type Cleanup,
  } from '../motion/core'

  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  class Section {
    el: HTMLElement
    container: HTMLElement
    hover: HTMLElement
    button: HTMLElement
    cta: HTMLElement

    bounding: DOMRect

    ctaMaxSize: number

    grid: {
      bounding: DOMRect
      width: number
      height: number
      vLines: number
      hLines: number
      gapX: number
      gapY: number
      lines: any[]
      points: any[]
      el: HTMLElement
      svg: HTMLElement
      path: HTMLElement
    }

    wave: {
      progress: number
      op: number
      speed: number
      strength: number
      state: string
      timeout: number
    }

    buttonIsHovered: boolean
    tapUnsealed: boolean
    isPaused: boolean
    tl: gsap.core.Timeline
    stops: Cleanup[] = []
    unframe: Cleanup | null = null
    destroyed = false
    timers: number[] = []
    blotsEl: HTMLElement | null = null
    cloudHit: HTMLElement | null = null
    flies: NodeListOf<HTMLElement> | null = null
    couplets: NodeListOf<HTMLElement> | null = null

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-cta')

      if (!this.el) {
        return
      }

      this.container = this.el.querySelector('.js-container')
      this.hover = this.el.querySelector('.js-hover')
      this.button = this.el.querySelector('.js-button')
      this.cta = this.el.querySelector('.js-cta')

      // Properties
      this.grid = {
        bounding: new DOMRect(),
        width: 0,
        height: 0,
        vLines: 0,
        hLines: 0,
        gapX: 0,
        gapY: 0,
        lines: [],
        points: [],
        el: this.el.querySelector('.js-grid'),
        svg: this.el.querySelector('.js-grid-svg'),
        path: this.el.querySelector('.js-grid-path'),
      }

      this.wave = {
        progress: 0,
        op: 0,
        speed: window.safeWidth > 767 ? 15 : 10,
        strength: window.safeWidth > 767 ? 1 : 0.35,
        state: 'paused',
        timeout: 0,
      }

      this.buttonIsHovered = false
      this.tapUnsealed = false
      this.isPaused = true
      this.blotsEl = this.el.querySelector('.js-blots')
      this.cloudHit = this.el.querySelector('.js-cloud')
      this.flies = this.el.querySelectorAll('.s__firefly')
      this.couplets = this.el.querySelectorAll('.s__couplet')

      whenReady(() => this.init())
    }

    later(fn: () => void, ms: number) {
      const id = window.setTimeout(() => {
        this.timers = this.timers.filter((t) => t !== id)
        if (!this.destroyed) fn()
      }, ms)
      this.timers.push(id)
      return id
    }

    /**
     * Init
     */
    init() {
      if (this.destroyed || !this.el) return

      this.setSize()
      this.setGrid()

      this.createPulseTimeline()

      this.bindEvents()
    }

    /**
     * SPA 换页收尾：帧循环、订阅、脉冲时间线与波纹定时器全部收掉
     */
    destroy() {
      this.destroyed = true
      this.stopFrame()
      this.stops.forEach((stop) => stop())
      this.stops = []
      this.timers.forEach((id) => clearTimeout(id))
      this.timers = []

      if (this.wave) clearTimeout(this.wave.timeout)
      this.tl?.kill()
      this.tl = null
      this.blotsEl?.replaceChildren()
      this.el?.style.removeProperty('--ff-breeze-x')
      this.el?.style.removeProperty('--ff-breeze-y')
    }

    /**
     * Bind events
     */
    bindEvents() {
      this.stops.push(onResize(() => this.onResize()))

      const hover = (e: Event) => this.onHover(e)
      const out = (e: Event) => this.onOut(e)
      const empty = (e: Event) => this.onEmptyClick(e)
      const wax = (e: Event) => this.onWaxClick(e)

      // 只在信笺簇上启封：整卷 100vh 一进就展开，信封来不及被看见
      this.hover.addEventListener('pointerenter', hover)
      this.hover.addEventListener('pointerleave', out)
      this.button.addEventListener('click', wax, true)
      this.el.addEventListener('click', empty)
      this.el.addEventListener('intersect', this.onIntersect, {
        passive: true,
      })

      this.stops.push(() => {
        this.hover.removeEventListener('pointerenter', hover)
        this.hover.removeEventListener('pointerleave', out)
        this.button.removeEventListener('click', wax, true)
        this.el.removeEventListener('click', empty)
        this.el.removeEventListener('intersect', this.onIntersect)
      })

      this.syncVisibility()

      if (!prefersReducedMotion()) this.bindMicroFeel()
    }

    /**
     * 触屏没有 hover：第一下落在火漆上只启封，第二下才跟链走。
     * 绝不写 location.href，避免 ClientRouter 被整页硬跳拆掉。
     */
    onWaxClick(e: Event) {
      if (!this.isCoarsePointer()) return
      if (this.tapUnsealed) return
      e.preventDefault()
      e.stopPropagation()
      e.stopImmediatePropagation()
      this.tapUnsealed = true
      if (!this.buttonIsHovered) this.onHover(e)
    }

    isCoarsePointer() {
      return window.matchMedia('(hover: none)').matches
    }

    /**
     * 交叉观察可能早于监听就派过一次：用几何 / is-in-view 对齐暂停态
     */
    syncVisibility() {
      if (!this.el) return
      const rect = this.el.getBoundingClientRect()
      const visible =
        this.el.classList.contains('is-in-view') ||
        (rect.bottom > 40 && rect.top < window.innerHeight - 40)
      this.isPaused = !visible
      if (this.isPaused) this.stopFrame()
      else this.startFrame()
    }

    /**
     * 流萤随风、楹联点亮、卷云轻散、火漆一按：仅常态动效开着时挂上
     */
    bindMicroFeel() {
      const press = () => this.button.classList.add('is-pressed')
      const release = () => this.button.classList.remove('is-pressed')

      this.button.addEventListener('pointerdown', press)
      this.button.addEventListener('pointerup', release)
      this.button.addEventListener('pointerleave', release)
      this.button.addEventListener('pointercancel', release)

      const onCouplet = (e: Event) => this.onCoupletClick(e)
      this.couplets?.forEach((el) => el.addEventListener('click', onCouplet))

      const onCloud = (e: Event) => this.onCloudClick(e)
      this.cloudHit?.addEventListener('click', onCloud)

      this.stops.push(
        onPointer(({ x, y }) => {
          if (this.isPaused || this.destroyed) return
          const rect = this.el.getBoundingClientRect()
          if (y < rect.top - 40 || y > rect.bottom + 40) return
          const nx = ((x - rect.left) / rect.width - 0.5) * 14
          const ny = ((y - rect.top) / rect.height - 0.5) * 10
          this.el.style.setProperty('--ff-breeze-x', nx.toFixed(1) + 'px')
          this.el.style.setProperty('--ff-breeze-y', ny.toFixed(1) + 'px')
        })
      )

      this.stops.push(() => {
        this.button.removeEventListener('pointerdown', press)
        this.button.removeEventListener('pointerup', release)
        this.button.removeEventListener('pointerleave', release)
        this.button.removeEventListener('pointercancel', release)
        this.couplets?.forEach((el) =>
          el.removeEventListener('click', onCouplet)
        )
        this.cloudHit?.removeEventListener('click', onCloud)
        this.button.classList.remove('is-pressed')
      })
    }

    startFrame() {
      if (this.unframe) return
      this.unframe = onFrame((time) => this.tick(time))
    }

    stopFrame() {
      this.unframe?.()
      this.unframe = null
    }

    /**
     * Resize handler
     */
    onResize() {
      this.setSize()
      this.setGrid()
    }

    /**
     * Intersect handler
     */
    onIntersect = (e: CustomEvent) => {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) this.stopFrame()
      else this.startFrame()
    }

    /**
     * Hover handler
     */
    onHover(e) {
      if (this.buttonIsHovered) return

      this.buttonIsHovered = true
      this.hover.classList.add('is-active')

      this.tl?.pause()

      clearTimeout(this.wave.timeout)
      this.wave.timeout = this.later(() => {
        this.waveShock()
      }, 600)

      gsap.to(this.wave, {
        op: 1,
        delay: 0.3,
        duration: 1.2,
        ease: 'expo.inOut',
        overwrite: true,
      })

      e.stopPropagation()
    }

    /**
     * Out handler
     *
     * 老版在这里对 <a> 写 window.location.href，ClientRouter 下会整页硬跳，
     * 把已经挂好的动效全拆掉。链接交给默认行为 / SPA 导航。
     */
    onOut(_e?: Event) {
      // 触屏靠点空白收信；pointerleave 在点按后会误触，不能据此关信或跳转
      if (this.isCoarsePointer() && _e?.type === 'pointerleave') return
      if (!this.buttonIsHovered) return

      clearTimeout(this.wave.timeout)

      this.buttonIsHovered = false
      this.tapUnsealed = false
      this.hover.classList.remove('is-active')

      this.tl?.play(0)

      gsap.to(this.wave, {
        op: 0,
        duration: 0.7,
        ease: 'expo.inOut',
        overwrite: true,
      })
    }

    /**
     * 点大圆与印玺之外的空白（远山、网格）：从落点荡开纸面震波
     */
    onEmptyClick(e: Event) {
      if (prefersReducedMotion()) return
      const target = e.target as Element | null
      if (!target) return

      // 钤印时纸面跟着一震；印玺自己的 click 仍负责下压
      if (target.closest('ink-seal3d')) {
        const ev = e as MouseEvent
        this.stirAt(ev.clientX, ev.clientY)
        return
      }

      // 只避开真链与火漆。大圆底纹、远山、网格都可以荡开震波
      if (target.closest('a, button, .s__button')) return

      if (this.buttonIsHovered && this.isCoarsePointer()) {
        this.onOut(e)
      }

      const ev = e as MouseEvent
      this.stirAt(ev.clientX, ev.clientY)
    }

    onCoupletClick(e: Event) {
      e.stopPropagation()
      const ev = e as MouseEvent
      this.stirAt(ev.clientX, ev.clientY)
    }

    onCloudClick(e: Event) {
      e.stopPropagation()
      const ev = e as MouseEvent
      this.stirAt(ev.clientX, ev.clientY)
    }

    /**
     * 落点一记：网格震波 + 墨晕 + 流萤惊散 + 云气轻散 + 楹联被风拂过
     */
    stirAt(clientX: number, clientY: number) {
      if (this.destroyed || prefersReducedMotion()) return

      const gridRect = this.grid.el.getBoundingClientRect()
      this.waveShock(clientX - gridRect.left, clientY - gridRect.top)

      const sec = this.el.getBoundingClientRect()
      this.spawnBlot(clientX - sec.left, clientY - sec.top)
      this.scatterFireflies(clientX, clientY)
      this.puffCloud()
      this.stirCouplets()
    }

    spawnBlot(x: number, y: number) {
      if (!this.blotsEl) return
      const blot = document.createElement('span')
      blot.className = 's__blot'
      blot.style.left = x + 'px'
      blot.style.top = y + 'px'
      this.blotsEl.appendChild(blot)
      blot.addEventListener('animationend', () => blot.remove(), { once: true })
    }

    scatterFireflies(cx: number, cy: number) {
      this.flies?.forEach((fly) => {
        const r = fly.getBoundingClientRect()
        const dx = r.left + r.width / 2 - cx
        const dy = r.top + r.height / 2 - cy
        const dist = Math.hypot(dx, dy) || 1
        const kick = Math.min(52, 2600 / dist)
        fly.style.setProperty('--ff-kick-x', (dx / dist) * kick + 'px')
        fly.style.setProperty('--ff-kick-y', (dy / dist) * kick + 'px')
        fly.classList.add('is-startled')
      })
      this.later(() => {
        this.flies?.forEach((fly) => {
          fly.style.setProperty('--ff-kick-x', '0px')
          fly.style.setProperty('--ff-kick-y', '0px')
          fly.classList.remove('is-startled')
        })
      }, 880)
    }

    puffCloud() {
      if (!this.cloudHit) return
      this.cloudHit.classList.remove('is-puffed')
      void this.cloudHit.offsetWidth
      this.cloudHit.classList.add('is-puffed')
      this.later(() => this.cloudHit?.classList.remove('is-puffed'), 1100)
    }

    stirCouplets() {
      this.couplets?.forEach((el) => el.classList.add('is-stirred'))
      this.later(
        () => this.couplets?.forEach((el) => el.classList.remove('is-stirred')),
        1200
      )
    }

    defaultWaveOrigin() {
      return {
        x: this.grid.width / 2,
        y: this.grid.height - this.bounding.height / 2,
      }
    }

    setWaveOrigin(cx: number, cy: number) {
      const { grid } = this
      const width = grid.width

      grid.points.forEach((row) => {
        row.forEach((point) => {
          const dx = point.x - cx
          const dy = point.y - cy
          const angle = Math.atan2(dy, dx)
          point.dist = Math.hypot(dx, dy)
          if (point.dist === 0) {
            point.dx = 0
            point.dy = 0
          } else {
            point.dx = Math.cos(angle) * (width / 2 / point.dist) * 5
            point.dy = Math.sin(angle) * (width / 2 / point.dist) * 5
          }
        })
      })
    }

    /**
     * Set size
     */
    setSize() {
      this.grid.bounding = this.grid.el.getBoundingClientRect()
      this.bounding = this.container.getBoundingClientRect()

      this.ctaMaxSize = Math.max(240, Math.min(this.bounding.width, this.bounding.height) - 32)
      this.container.style.setProperty('--cta-size', this.ctaMaxSize + 'px')
      this.cta.style.setProperty('--size', this.ctaMaxSize + 'px')
    }

    /**
     * Set grid
     */
    setGrid() {
      const { grid } = this

      const width = this.grid.bounding.width
      const height = this.grid.bounding.height

      grid.width = width
      grid.height = height

      grid.svg.style.width = width + 'px'
      grid.svg.style.height = height + 'px'

      // Points
      grid.points = []

      grid.vLines = window.safeWidth > 767 ? 12 : 8
      grid.gapX = width / grid.vLines

      grid.gapY = this.bounding.height / 8
      grid.hLines = Math.floor(height / grid.gapY)

      const offsetY = height - grid.gapY * grid.hLines

      for (let i = 0; i <= grid.vLines; i++) {
        const row = []

        for (let j = 0; j <= grid.hLines; j++) {
          row.push({
            x: grid.gapX * i,
            y: grid.gapY * j + (j !== 0 ? offsetY : 0),
            ax: 0, // Acceleration
            ay: 0,
            vx: 0, // Velocity
            vy: 0,
            wx: 0, // Wave
            wy: 0,
            mx: 0, // Movement
            my: 0,
            ox: 0, // Offset
            oy: 0,
            dx: 0, // Distance
            dy: 0,
            dist: 0,
          })
        }

        grid.points.push(row)
      }

      const origin = this.defaultWaveOrigin()
      this.setWaveOrigin(origin.x, origin.y)
    }

    /**
     * Create pulse timeline
     */
    createPulseTimeline() {
      /* reduced-motion：不建无限脉冲时间线，按钮文字保持静止 */
      if (prefersReducedMotion()) {
        return
      }

      const text = this.container.querySelector('.js-button-text')

      this.tl = gsap.timeline({
        repeat: -1,
        repeatDelay: 0.5,
      })

      this.tl.call(() => {
        this.wave.state = 'pulse'
      })

      this.tl.fromTo(
        text,
        {
          scale: 0.85,
        },
        {
          scale: 1.05,
          duration: 2.7,
          ease: 'power2.in',
        }
      )

      this.tl.call(this.wavePulse.bind(this), [])

      this.tl.to(text, {
        scale: 0.85,
        duration: 0.15,
        ease: 'power4.out',
      })
    }

    /**
     * Move points
     */
    movePoints(time) {
      const { grid, wave } = this

      grid.points.forEach((col, x) => {
        col.forEach((point, y) => {
          if (y === 0 || point.dist === 0) return

          const d = Math.abs(point.dist - wave.progress)
          const l = 30

          if (d < l) {
            const s = 1 - d / l
            const a = Math.atan2(point.dy, point.dx)
            const f = Math.cos(d * 0.01) * s

            point.vx += Math.cos(a) * f * l * 0.5 * wave.strength
            point.vy += Math.sin(a) * f * l * 0.5 * wave.strength
          }

          point.vx += (0 - point.wx) * 0.001 // String tension
          point.vy += (0 - point.wy) * 0.001

          point.vx *= 0.9 // Friction or duration
          point.vy *= 0.9

          point.wx += point.vx * 3 // Strength
          point.wy += point.vy * 3

          point.wx *= 0.9
          point.wy *= 0.9

          point.mx = point.wx * 0.1
          point.my = point.wy * 0.1

          point.ox = point.dx / Math.hypot(window.safeHeight, window.safeWidth)
          point.oy = point.dy / Math.hypot(window.safeHeight, window.safeWidth)

          point.ox = this.easeOut(point.ox)
          point.oy = this.easeOut(point.oy)

          point.ox *= grid.gapX * 75 * (point.dist / this.ctaMaxSize)
          point.oy *= grid.gapY * 75 * (point.dist / this.ctaMaxSize)
        })
      })
    }

    /**
     * Ease out
     */
    easeOut(t) {
      return t === 1 ? 1 : 1 - Math.pow(2, -10 * t)
    }

    /**
     * Draw lines
     */
    drawLines() {
      const { grid } = this

      let d = ''

      // Vertical lines
      grid.points.forEach((col) => {
        col.forEach((point, i) => {
          const p = this.movedPoint(point)

          if (i === 0) {
            d += `M ${p.x} ${p.y} `
          } else {
            d += `L ${p.x} ${p.y} `
          }
        })
      })

      // Horizontal lines
      for (let y = 0; y < grid.hLines; y++) {
        grid.points.forEach((col, x) => {
          const point = col[y]
          const p = this.movedPoint(point)

          if (x === 0) {
            d += `M ${p.x} ${p.y} `
          } else {
            d += `L ${p.x} ${p.y} `
          }
        })
      }

      grid.path.setAttribute('d', d)
    }

    /**
     * Get point coordinates with movement added
     */
    movedPoint(point) {
      return {
        x: point.x + point.mx + point.ox * this.wave.op,
        y: point.y + point.my + point.oy * this.wave.op,
      }
    }

    /**
     * Wave pulse
     */
    wavePulse() {
      if (this.buttonIsHovered) return

      const { wave } = this
      const origin = this.defaultWaveOrigin()
      this.setWaveOrigin(origin.x, origin.y)

      wave.progress = 0
      wave.state = 'pulse'
      wave.speed = window.safeWidth > 767 ? 15 : 10
      wave.strength = window.safeWidth > 767 ? 1 : 0.35
    }

    /**
     * Wave shock —— 有坐标则从落点荡开，否则从火漆圆心
     */
    waveShock(ox?: number, oy?: number) {
      if (this.destroyed) return
      const { wave } = this

      if (ox != null && oy != null) this.setWaveOrigin(ox, oy)
      else {
        const origin = this.defaultWaveOrigin()
        this.setWaveOrigin(origin.x, origin.y)
      }

      wave.progress = 0
      wave.state = 'shock'
      wave.speed = 30
      wave.strength = 5
      this.startFrame()
    }

    /**
     * Tick
     */
    tick(time) {
      const { wave } = this

      if (wave.progress < this.grid.height) {
        if (wave.state !== 'paused') {
          wave.progress += wave.speed
        }
      } else if (wave.state === 'shock') {
        wave.state = 'paused'
      }

      this.movePoints(time)
      this.drawLines()
    }
  }

  /* ClientRouter 下模块脚本只执行一次：每次换页对新 DOM 重建，先收旧实例 */
  const mountCTA = () => {
    const prev = (window as any).__sCTA
    try {
      prev?.destroy?.()
    } catch (e) {}
    ;(window as any).__sCTA = document.querySelector('.s-cta')
      ? new Section()
      : null
  }

  document.addEventListener('astro:page-load', mountCTA)
  document.addEventListener('astro:before-swap', () => {
    try {
      ;(window as any).__sCTA?.destroy?.()
    } catch (e) {}
    ;(window as any).__sCTA = null
  })
</script>

