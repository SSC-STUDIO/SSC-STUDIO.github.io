---
/**
 * ClassMotion — 班级空间三页共用的动效层
 *
 * 班级页的内容全部由 React 岛在取数之后插入，服务端渲染时 DOM 里空无一物，
 * 所以入场只能交给 CSS：元素一挂载动画就跑，`backwards` 只回填起始帧，
 * 动画不跑时元素仍是常态可读的——不会重演当年 clip-path 的白屏。
 *
 * 用在 class 索引、画廊与同学档案三页；画廊自身的灯箱手势留在页面里。
 */
import PageAura from './PageAura.astro'
---

<PageAura />

<style lang="scss" is:global>
  /* ── 入场：数据取回后逐块落定 ── */

  .p-class__metric {
    --lift: 0px;

    position: relative;

    animation: class-settle 620ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    transform: perspective(900px) translate3d(0, var(--lift), 0)
      rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s ease;
  }

  .p-class__metric:nth-child(2) {
    animation-delay: 90ms;
  }

  .p-class__metric:nth-child(3) {
    animation-delay: 180ms;
  }

  .p-class__metric:hover {
    --lift: -3px;
    box-shadow: 0 0.4rem 0 color-mix(in srgb, #{color(accent)} 70%, transparent);
  }

  /* 计数卡受光：与文章卡同一道浅墨扫过 */
  .p-class__metric::after {
    position: absolute;
    inset: 0;
    z-index: 1;

    background: linear-gradient(
      108deg,
      transparent 38%,
      color-mix(in srgb, #{color(primary)} 26%, transparent) 50%,
      transparent 62%
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: translateX(-16%);
    transition:
      opacity 380ms ease,
      transform 640ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-class__metric:hover::after,
  .p-class__metric:focus-within::after {
    opacity: 1;
    transform: translateX(16%);
  }

  /* 数字：自纸面浮起半格，像刚落的墨迹收干 */
  .p-class__metric dd:not(.p-class__metric-sub) {
    animation: class-count-rise 720ms cubic-bezier(0.16, 1, 0.3, 1) 120ms
      backwards;
  }

  .p-class__profile {
    animation: class-settle 620ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  /* 档案卡受光：悬停时一道浅墨光扫过，角标仍用 ::before */
  .p-class__profile::after {
    position: absolute;
    inset: 0;
    z-index: 1;

    background: linear-gradient(
      108deg,
      transparent 38%,
      color-mix(in srgb, #{color(primary)} 26%, transparent) 50%,
      transparent 62%
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: translateX(-16%);
    transition:
      opacity 380ms ease,
      transform 640ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-class__profile:hover::after,
  .p-class__profile:focus-visible::after {
    opacity: 1;
    transform: translateX(16%);
  }

  .p-class__profile:nth-child(3n + 2) {
    animation-delay: 80ms;
  }

  .p-class__profile:nth-child(3n) {
    animation-delay: 160ms;
  }

  .p-class-boards__panel,
  .p-class-profile__panel {
    position: relative;
    overflow: hidden;

    animation: class-settle 620ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .p-class-boards__panel:last-child,
  .p-class-profile__panel:nth-child(2) {
    animation-delay: 110ms;
  }

  .p-class-profile__panel:nth-child(n + 3) {
    animation-delay: 200ms;
  }

  /* 留言墙 / 档案栏：笺面受光，不挡里头的字 */
  .p-class-boards__panel::after,
  .p-class-profile__panel::after {
    position: absolute;
    inset: 0;
    z-index: 1;

    background: linear-gradient(
      108deg,
      transparent 40%,
      color-mix(in srgb, #{color(primary)} 22%, transparent) 50%,
      transparent 60%
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: translateX(-14%);
    transition:
      opacity 420ms ease,
      transform 720ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-class-boards__panel:hover::after,
  .p-class-profile__panel:hover::after {
    opacity: 1;
    transform: translateX(14%);
  }

  /* 留言逐条落纸；第五条起并作一档，长列表不必久等 */
  .p-class-comments__item {
    animation: class-settle 520ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .p-class-comments__item:nth-child(2) {
    animation-delay: 60ms;
  }

  .p-class-comments__item:nth-child(3) {
    animation-delay: 120ms;
  }

  .p-class-comments__item:nth-child(4) {
    animation-delay: 180ms;
  }

  .p-class-comments__item:nth-child(n + 5) {
    animation-delay: 240ms;
  }

  /* 回复展开时自留言下方推开 */
  .p-class-comments__reply {
    animation: class-settle 420ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  /* 点赞落朱砂时心口轻轻一顿 */
  .p-class-comments__like.is-liked {
    animation: class-like-press 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* 锁与花名册提示：落纸 + 半透明大字水印 */
  .p-class .p-lock,
  .p-class-gallery .p-lock,
  .p-class-profile .p-lock,
  .p-class__student {
    position: relative;
    overflow: hidden;

    animation: class-settle 620ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .p-class .p-lock::before,
  .p-class-gallery .p-lock::before,
  .p-class-profile .p-lock::before,
  .p-class__student::before {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 0;

    color: color(secondary);
    font: 700 7.5rem / 1 font-family(bigger);
    content: '锁';
    opacity: 0.05;
    pointer-events: none;
    transform: translate(-50%, -50%);
    user-select: none;

    animation: class-empty-breathe 8s ease-in-out infinite;
  }

  .p-class__student::before {
    content: '禁';
  }

  .p-class .p-lock > *,
  .p-class-gallery .p-lock > *,
  .p-class-profile .p-lock > *,
  .p-class__student > * {
    position: relative;
    z-index: 1;
  }

  /* 空态：沿用全站 p-empty，水印改读 data-mark，呼吸更轻 */
  .p-class-empty {
    padding: 2.4rem 1.25rem;

    animation: class-settle 560ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .p-class-empty::before {
    font-size: 5.4rem;
    content: attr(data-mark);
    opacity: 0.055;

    animation: class-empty-breathe 7.5s ease-in-out infinite;
  }

  .p-class-empty .p-empty__message {
    margin-bottom: 0;
  }

  .p-class-empty .p-card__actions {
    justify-content: center;
    margin-top: 1rem;
  }

  .p-class-profile__head {
    animation: class-settle 620ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  .p-class-profile__name {
    animation: class-count-rise 720ms cubic-bezier(0.16, 1, 0.3, 1) 80ms
      backwards;
  }

  .p-class-gallery__count {
    animation: class-settle 480ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  @keyframes class-settle {
    from {
      opacity: 0;
      transform: translate3d(0, 0.85rem, 0);
    }
  }

  @keyframes class-count-rise {
    from {
      filter: blur(4px);
      opacity: 0;
      transform: translate3d(0, 0.35em, 0);
    }
  }

  @keyframes class-like-press {
    50% {
      transform: scale(1.08);
    }
  }

  @keyframes class-empty-breathe {
    0%,
    100% {
      opacity: 0.045;
      transform: translate(-50%, -50%) scale(1);
    }

    50% {
      opacity: 0.08;
      transform: translate(-50%, -50%) scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p-class__metric,
    .p-class__metric dd:not(.p-class__metric-sub),
    .p-class__profile,
    .p-class-boards__panel,
    .p-class-profile__panel,
    .p-class-comments__item,
    .p-class-comments__reply,
    .p-class-comments__like.is-liked,
    .p-class .p-lock,
    .p-class-gallery .p-lock,
    .p-class-profile .p-lock,
    .p-class__student,
    .p-class-empty,
    .p-class-empty::before,
    .p-class .p-lock::before,
    .p-class-gallery .p-lock::before,
    .p-class-profile .p-lock::before,
    .p-class__student::before,
    .p-class-profile__head,
    .p-class-profile__name,
    .p-class-gallery__count {
      animation: none;
    }

    .p-class__metric,
    .p-class__metric:hover {
      transform: none;
      transition: none;
    }

    .p-class__metric::after,
    .p-class__profile::after,
    .p-class-boards__panel::after,
    .p-class-profile__panel::after {
      opacity: 0;
      transform: none;
      transition: none;
    }
  }
</style>
