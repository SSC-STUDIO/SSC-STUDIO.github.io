---
/**
 * ProjectDetailMotion — 八个项目详情页共用的装帧与动效
 *
 * 一处收齐：卷底墨圈环境层、面包屑与相邻项目牌的样式、
 * 封面画框的册页翻页、窗框开合与游走高光、正文逐段落墨、
 * 元信息与标签的错峰入场、去向链接的落印手感。
 * 详情页只需把它放进 <main class="p-page p-detail"> 末尾。
 *
 * 分工照 PageHero 的路子：脚本只判断「谁该落墨了」，
 * 具体怎么动一律交给下面的样式。内容默认可读、动效只是增强——
 * 脚本缺席时八页照常成立。
 */
import PageAura from './PageAura.astro'
---

<PageAura />

<style lang="scss" is:global>
  /* ══════════════════════════════════════════════════════
     面包屑 —— 一行细字压顶，去处随悬停亮起朱丝
     ══════════════════════════════════════════════════════ */

  .p-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;

    margin: 0 0 1.35rem;

    color: color-mix(in srgb, #{color(secondary)} 55%, transparent);
    font: 700 10px / 1 font-family(fraktion);
    letter-spacing: 0.16em;
    text-transform: none;

    a {
      position: relative;

      color: inherit;
      text-decoration: none;
      transition: color 0.2s ease;

      /* 朱丝自左描出，与全站的下划线扫入同一条缓动 */
      &::after {
        position: absolute;
        bottom: -3px;
        left: 0;

        width: 100%;
        height: 1.5px;

        background: color(accent);

        content: '';
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 320ms ease(out-quint);
      }

      &:hover,
      &:focus-visible {
        color: color(accent);

        &::after {
          transform: scaleX(1);
        }
      }
    }

    [aria-current='page'] {
      color: color(secondary);
    }

    &__sep {
      color: color-mix(in srgb, #{color(accent)} 70%, transparent);
    }
  }

  /* ══════════════════════════════════════════════════════
     相邻项目牌 —— 邻卷封面探出边口，名字朝去处递一步
     ══════════════════════════════════════════════════════ */

  .p-projnav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 0.75rem;

    margin-top: 2.5rem;
    padding-top: 1.5rem;

    border-top: 1.5px dashed
      color-mix(in srgb, #{color(accent)} 45%, transparent);

    /* 三块去向牌错峰落下 */
    --flow-step: 88ms;

    &__link {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;

      overflow: hidden;
      padding: 0.7rem 0.8rem;

      border: 1px solid color-mix(in srgb, #{color(secondary)} 35%, transparent);

      text-decoration: none;

      transition:
        transform 0.45s ease(out-quint),
        border-color 0.2s ease,
        background 0.2s ease;

      &:hover,
      &:focus-visible {
        border-color: color(accent);
        background: color-mix(in srgb, #{color(accent)} 7%, transparent);
        transform: translateY(-2px);
      }

      &:focus-visible {
        outline: 2px solid color(accent);
        outline-offset: 2px;
      }

      /* 落印：朝各自的去处压半步，盖过 data-seal 的垂直位移 */
      &.is-pressed {
        transform: translate3d(-5px, 1px, 0);
        transition-duration: 90ms;
      }
    }

    &__link--next {
      flex-direction: row-reverse;
      text-align: right;
      align-items: center;

      &.is-pressed {
        transform: translate3d(5px, 1px, 0);
      }
    }

    &__link--index {
      align-self: center;
      justify-content: center;

      padding: 0.6rem 0.9rem;

      border: 0;

      color: color-mix(in srgb, #{color(secondary)} 65%, transparent);
      font: 700 10px / 1 font-family(fraktion);
      letter-spacing: 0.14em;

      &:hover,
      &:focus-visible {
        background: transparent;
        color: color(accent);
        transform: none;
      }

      &.is-pressed {
        transform: translate3d(0, 1px, 0);
      }
    }

    /* 邻卷封面：比牌略大一圈，默认朝来处藏一点，悬停时推入窗心 */
    &__thumb {
      position: relative;
      flex-shrink: 0;
      overflow: hidden;

      width: 4.7rem;
      aspect-ratio: 16 / 9;

      border: 1px solid color-mix(in srgb, #{color(secondary)} 32%, transparent);

      &::after {
        position: absolute;
        inset: 0;
        z-index: 1;

        box-shadow: inset 0 0 0.7rem
          color-mix(in srgb, #{color(secondary)} 16%, transparent);

        content: '';
        pointer-events: none;
      }

      img {
        display: block;

        width: 124%;
        height: 124%;
        margin: -10% 0 0 -8%;

        object-fit: cover;

        transform: translate3d(6%, 0, 0) scale(1.02);
        transition:
          transform 0.55s ease(out-quint),
          filter 0.4s ease;
      }
    }

    &__link--next &__thumb img {
      margin-left: -16%;
      transform: translate3d(-6%, 0, 0) scale(1.02);
    }

    &__slip {
      position: absolute;
      right: 0.18rem;
      bottom: 0.14rem;
      z-index: 2;

      padding: 0.14em 0.28em;

      background: color-mix(in srgb, #{color(paper-warm)} 92%, transparent);
      box-shadow: inset 0 0 0 1px
        color-mix(in srgb, #{color(secondary)} 40%, transparent);

      color: color(secondary);
      font: 700 8px / 1 font-family(fraktion);
      letter-spacing: 0.08em;

      pointer-events: none;
    }

    &__copy {
      display: flex;
      flex-direction: column;
      gap: 0.38rem;
      min-width: 0;
    }

    &__dir {
      color: color-mix(in srgb, #{color(secondary)} 55%, transparent);
      font: 700 9px / 1 font-family(fraktion);
      letter-spacing: 0.18em;
      text-transform: none;

      transition: color 0.2s ease;
    }

    &__name {
      display: inline-block;

      color: color(secondary);
      font: 400 0.95rem / 1.35 font-family(editorial);

      transition: transform 320ms ease(out-quint);
    }

    /* 名字朝各自的去处挪半步：上一个往左，下一个往右 */
    &__link:hover &__dir,
    &__link:focus-visible &__dir {
      color: color(accent);
    }

    &__link:hover &__name,
    &__link:focus-visible &__name {
      transform: translateX(-4px);
    }

    &__link--next:hover &__name,
    &__link--next:focus-visible &__name {
      transform: translateX(4px);
    }

    &__link:hover &__thumb img,
    &__link:focus-visible &__thumb img {
      transform: translate3d(0, 0, 0) scale(1.08);
      filter: sepia(0.18) saturate(1.05) contrast(1.02);
    }

    @include mq(phone) {
      grid-template-columns: 1fr;

      &__link--next {
        flex-direction: row;
        text-align: left;
      }

      &__link--next &__thumb img {
        margin-left: -8%;
        transform: translate3d(6%, 0, 0) scale(1.02);
      }

      &__link--index {
        order: 3;
        justify-self: center;
      }
    }
  }

  /* ══════════════════════════════════════════════════════
     封面画框 —— 册页翻页 + 窗框开合 + 一道随指针游走的高光
     [data-leaf] 已在全局样式里备好基础 transform 与 --leaf-* 变量，
     这里只写「怎么受光、怎么隔窗看画、怎么骑缝」。
     ══════════════════════════════════════════════════════ */

  .p-detail .p-detail-figure {
    /* 翻页时中缝一侧微微抬起，投影跟着偏 */
    transition:
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 420ms ease;

    &.is-leaf-live {
      box-shadow: 0 10px 26px -14px
        color-mix(in srgb, #{color(secondary)} 40%, transparent);
    }

    figcaption {
      flex-wrap: wrap;
      gap: 0.35rem 0.75rem;

      transition: color 320ms ease;

      &::after {
        margin-left: auto;
      }
    }

    &.is-leaf-live figcaption {
      color: color-mix(in srgb, #{color(secondary)} 78%, transparent);
    }
  }

  /* 书脊：左侧一道苔纹界栏，像册页装进函套的中缝 */
  .p-detail .p-detail-figure__spine {
    position: absolute;
    top: 14%;
    bottom: 22%;
    left: 0;
    z-index: 3;

    width: 7px;

    background-image:
      linear-gradient(
        color-mix(in srgb, #{color(secondary)} 46%, transparent),
        color-mix(in srgb, #{color(secondary)} 46%, transparent)
      ),
      repeating-linear-gradient(
        180deg,
        color-mix(in srgb, #{color(accent)} 28%, transparent) 0 2px,
        transparent 2px 7px
      );
    background-repeat: no-repeat, repeat;
    background-size:
      1.5px 100%,
      5px 100%;
    background-position:
      center,
      1px 0;

    pointer-events: none;
  }

  /* 骑缝签条：绢色竖题，骑在画框右上角 */
  .p-detail .p-detail-figure__slip {
    position: absolute;
    top: -0.45rem;
    right: 1.15rem;
    z-index: 4;

    display: block;

    pointer-events: none;
  }

  .p-detail .p-detail-figure__slip-text {
    display: block;
    padding: 0.62em 0.24em;

    writing-mode: vertical-rl;

    background: linear-gradient(
      180deg,
      color(paper-warm),
      color-mix(in srgb, #{color(paper-warm)} 88%, #000)
    );
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, #{color(secondary)} 55%, transparent),
      inset 0 0 0 2.5px color(paper-warm),
      1px 1.5px 4px rgba(12, 10, 8, 0.28);

    color: color(secondary);
    font: 600 10.5px / 1.15 font-family(editorial);
    letter-spacing: 0.32em;

    white-space: nowrap;
  }

  /* 画心：一格自带裁切的窗，封面在窗内游移。
     默认两侧略收——像作品卷的开卷遮罩；指针拂过时窗框张开。 */
  .p-detail .p-detail-figure__plate {
    position: relative;
    display: block;
    overflow: hidden;

    border: 1px solid color-mix(in srgb, #{color(secondary)} 45%, transparent);

    clip-path: inset(0 0.38rem);
    transition: clip-path 480ms ease(out-quint);

    /* 窗内纵深：四缘一圈极淡内影 */
    &::before {
      position: absolute;
      inset: 0;
      z-index: 2;

      box-shadow: inset 0 0 1.5rem
        color-mix(in srgb, #{color(secondary)} 13%, transparent);

      content: '';
      pointer-events: none;
    }

    /* 游走高光：一道斜切薄光，横向位置由 --leaf-sheen 决定
       （0 = 指针在右，1 = 指针在左，故取其补数） */
    &::after {
      position: absolute;
      top: -25%;
      bottom: -25%;
      left: -17%;
      z-index: 3;

      width: 34%;

      background: linear-gradient(
        100deg,
        transparent,
        color-mix(in srgb, #{color(paper-warm)} 40%, transparent) 48%,
        color-mix(in srgb, #{color(accent)} 8%, transparent) 66%,
        transparent
      );

      content: '';
      opacity: 0;
      pointer-events: none;

      transform: translate3d(calc((1 - var(--leaf-sheen, 0.5)) * 294%), 0, 0)
        skewX(-9deg);
      transition: opacity 340ms ease;
    }
  }

  .p-detail .p-detail-figure.is-leaf-live .p-detail-figure__plate {
    clip-path: inset(0);
  }

  .p-detail .p-detail-figure.is-leaf-live .p-detail-figure__plate::after {
    opacity: 0.5;
  }

  /* 封面本体：height 属性会把 SVG 拉变形，交还给原比例；
     略放大一档留出余量，好让滚动与指针带着画面在窗内反向游移。
     --scroll-shift 写在 plate（[data-handscroll]）上，子元素继承。 */
  .p-detail .p-detail-figure .p-detail-cover {
    --cover-pan: 0px;

    display: block;

    width: 100%;
    height: auto;

    border: 0;
    aspect-ratio: 8 / 5;
    object-fit: cover;

    transform: translate3d(
        var(--cover-pan),
        calc(-4% + var(--scroll-shift, 0vh)),
        0
      )
      scale(1.08);
    transform-origin: center;
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-detail .p-detail-figure.is-leaf-live .p-detail-cover {
    --cover-pan: calc((var(--leaf-sheen, 0.5) - 0.5) * -18px);

    transition: transform 120ms linear;
  }

  @include mq(phone) {
    .p-detail .p-detail-figure__slip {
      top: -0.32rem;
      right: 0.7rem;
    }

    .p-detail .p-detail-figure__slip-text {
      font-size: 9px;
    }

    .p-detail .p-detail-figure figcaption {
      letter-spacing: 0.1em;
    }
  }

  /* ══════════════════════════════════════════════════════
     元信息行 —— 三格 spec 依次落定，朱砂徽记如落印钤下
     ══════════════════════════════════════════════════════ */

  .p-detail .p-detail-meta {
    --flow-step: 74ms;
  }

  .p-detail .p-detail-meta.is-in-view .p-detail-meta__badge {
    animation: p-detail-stamp 640ms cubic-bezier(0.2, 1.35, 0.32, 1) backwards;
  }

  @keyframes p-detail-stamp {
    0% {
      opacity: 0;
      transform: rotate(-9deg) scale(1.75);
    }

    58% {
      opacity: 1;
      transform: rotate(-1.5deg) scale(0.95);
    }

    100% {
      opacity: 1;
      transform: none;
    }
  }

  /* ══════════════════════════════════════════════════════
     正文 —— 逐段落墨（由 <project-detail-motion> 逐个点名），
     章题朱丝随整段入屏自左描出
     ══════════════════════════════════════════════════════ */

  /* 段序供朱丝错峰取用；顺便让默认态就是落定态 */
  @for $i from 1 through 14 {
    .p-detail .p-prose > :nth-child(#{$i}) {
      --prose-i: #{$i - 1};
    }
  }

  html.js .p-detail .p-prose > .is-prose-in {
    animation: p-detail-rise 620ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: var(--prose-delay, 0ms);
  }

  /* 条列不整块抬起，交给每一条自己落墨 */
  html.js .p-detail .p-prose > ul.is-prose-in,
  html.js .p-detail .p-prose > ol.is-prose-in {
    animation: none;
  }

  html.js .p-detail .p-prose > ul.is-prose-in > li,
  html.js .p-detail .p-prose > ol.is-prose-in > li {
    animation: p-detail-rise 560ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  @for $i from 1 through 10 {
    html.js .p-detail .p-prose > ul.is-prose-in > li:nth-child(#{$i}),
    html.js .p-detail .p-prose > ol.is-prose-in > li:nth-child(#{$i}) {
      animation-delay: calc(var(--prose-delay, 0ms) + #{($i - 1) * 66}ms);
    }
  }

  @keyframes p-detail-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 0.85rem, 0);
    }
  }

  /* 条列序号取朱砂，与章次同色 */
  .p-detail .p-prose li::marker {
    color: color(accent);
    font-family: font-family(fraktion);
  }

  /* 章题压脚的朱丝：整段入屏后自左描出（纯 CSS，不依赖本组件脚本） */
  .p-detail .p-prose h2::after {
    transform-origin: left center;
  }

  html.js .p-detail .p-prose h2::after {
    transform: scaleX(0);
    transition: transform 640ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  html.js .p-detail .p-prose.is-in-view h2::after {
    transform: scaleX(1);
    transition-delay: calc(var(--prose-i, 0) * 66ms + 180ms);
  }

  /* 正文链接：悬停时朱砂加深、下划线沉一档 */
  .p-detail .p-prose a {
    transition:
      color 220ms ease,
      text-decoration-color 220ms ease,
      text-underline-offset 220ms ease;

    &:hover,
    &:focus-visible {
      color: color(accent-strong);
      text-decoration-color: color(accent-strong);
      text-underline-offset: 0.32em;
    }
  }

  /* ══════════════════════════════════════════════════════
     标签与去向 —— 逐枚落定，按下如落印
     ══════════════════════════════════════════════════════ */

  .p-detail .p-chips {
    --flow-step: 50ms;
  }

  .p-detail .p-chips .p-card__tag {
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 260ms ease;

    &:hover {
      transform: translate3d(0, -2px, 0);
      box-shadow: 0 2px 0 color-mix(in srgb, #{color(secondary)} 42%, transparent);
    }
  }

  .p-detail .p-card__actions {
    --flow-step: 62ms;
  }

  /* data-seal 会给链接补一层 overflow:hidden 好裁住涟漪，
     下划线因此得挪进盒内，否则会被一并裁掉。 */
  .p-detail .p-card__actions .p-card__link::after {
    bottom: 0;
  }

  /* ══════════════════════════════════════════════════════
     减弱动效 —— 一律落定为静态可读
     ══════════════════════════════════════════════════════ */

  @media (prefers-reduced-motion: reduce) {
    .p-crumbs a::after,
    .p-projnav__name,
    .p-projnav__thumb img,
    .p-detail .p-detail-figure,
    .p-detail .p-detail-figure .p-detail-cover,
    .p-detail .p-detail-figure__plate,
    .p-detail .p-chips .p-card__tag,
    .p-detail .p-prose a {
      transition: none;
    }

    .p-crumbs a:hover::after,
    .p-crumbs a:focus-visible::after {
      transform: scaleX(1);
    }

    .p-projnav__link:hover,
    .p-projnav__link:focus-visible,
    .p-projnav__link.is-pressed,
    .p-projnav__link--next.is-pressed,
    .p-projnav__link--index.is-pressed,
    .p-projnav__link:hover .p-projnav__name,
    .p-projnav__link:focus-visible .p-projnav__name,
    .p-projnav__link--next:hover .p-projnav__name,
    .p-projnav__link--next:focus-visible .p-projnav__name,
    .p-detail .p-chips .p-card__tag:hover {
      transform: none;
    }

    .p-projnav__thumb img,
    .p-projnav__link--next .p-projnav__thumb img,
    .p-projnav__link:hover .p-projnav__thumb img,
    .p-projnav__link:focus-visible .p-projnav__thumb img {
      transform: none;
      filter: none;
    }

    .p-detail .p-detail-figure .p-detail-cover {
      transform: none;
    }

    .p-detail .p-detail-figure__plate {
      clip-path: none;
    }

    .p-detail .p-detail-figure__plate::after {
      display: none;
    }

    .p-detail .p-detail-meta.is-in-view .p-detail-meta__badge,
    html.js .p-detail .p-prose > .is-prose-in,
    html.js .p-detail .p-prose > ul.is-prose-in > li,
    html.js .p-detail .p-prose > ol.is-prose-in > li {
      animation: none;
    }

    html.js .p-detail .p-prose h2::after {
      transform: scaleX(1);
      transition: none;
    }
  }
</style>

<script>
  import { prefersReducedMotion } from '../../motion/core'

  /** 同一批入屏的段落之间的落墨间隔（毫秒） */
  const STEP = 82

  /**
   * 正文逐段落墨
   *
   * 全站的 data-flow 是「容器入屏，子项一次编排完」：正文动辄两三屏，
   * 后面的段落会在屏幕外自己演完。这里改为逐段观察，读到哪一段那一段才落墨；
   * 同一批进屏的彼此错峰，单独滚进来的立刻落定。
   *
   * 只加类、不藏内容：段落默认就是落定态，脚本缺席也照常可读。
   * ClientRouter：astro:page-load 重挂、astro:before-swap 拆掉观察者。
   */
  let observer: IntersectionObserver | null = null

  function destroy() {
    observer?.disconnect()
    observer = null
  }

  function mount() {
    destroy()

    if (prefersReducedMotion()) return
    if (typeof IntersectionObserver !== 'function') return
    if (document.visibilityState === 'hidden') return

    const prose = document.querySelector('.p-detail .p-prose')
    if (!prose) return

    const blocks = Array.from(prose.children) as HTMLElement[]
    if (!blocks.length) return

    observer = new IntersectionObserver(
      (entries, current) => {
        let batch = 0

        entries.forEach((entry) => {
          if (!entry.isIntersecting) return

          const block = entry.target as HTMLElement

          block.style.setProperty('--prose-delay', `${batch++ * STEP}ms`)
          block.classList.add('is-prose-in')

          current.unobserve(block)
        })
      },
      { threshold: 0.04, rootMargin: '0px 0px -7% 0px' }
    )

    blocks.forEach((block) => observer?.observe(block))
  }

  document.addEventListener('astro:page-load', mount)
  document.addEventListener('astro:before-swap', destroy)
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') destroy()
    else mount()
  })
</script>
