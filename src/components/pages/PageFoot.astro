---
import ASeparator from '../ASeparator.astro'
import SealMark from '../SealMark.astro'

interface Props {
  /** href of the current section, marks the matching eco link */
  current?: string
}

const { current } = Astro.props

const links = [
  { href: '/', label: '首页' },
  { href: '/projects', label: '项目' },
  { href: '/articles', label: '文章' },
  { href: '/about', label: '关于' },
  { href: '/honors', label: '荣誉' },
  { href: '/sponsor', label: '赞助' },
  { href: '/leaderboard', label: '排行榜' },
  { href: '/benchmarks', label: '反应力' },
  { href: '/class', label: '班级空间' },
  { href: '/guestbook', label: '留言簿' },
  { href: '/contact', label: '联系' },
]
---

<ASeparator style="secondary" />

<nav class="p-eco" aria-label="站点导航">
  <p class="p-eco__label">继续逛</p>
  <div class="p-eco__grid">
    {
      links.map((link) => (
        <a
          class:list={['p-eco__link', { 'is-current': link.href === current }]}
          href={link.href}
        >
          {link.href === current && <SealMark variant="dot" />}
          {link.label}
        </a>
      ))
    }
  </div>
</nav>
