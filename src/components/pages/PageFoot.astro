---
/**
 * PageFoot — 内页卷末的「继续逛」导航
 *
 * 导航格自身在入屏时逐格落墨。全站动效增强包只挂在 BaseLayout。
 */
import InkRail from '../InkRail.astro'
import SealMark from '../SealMark.astro'
import { navLinks } from '@/data/nav'

interface Props {
  /** href of the current section, marks the matching eco link */
  current?: string
}

const { current } = Astro.props

const links = navLinks
---

<InkRail style="secondary" />

<nav class="p-eco" aria-label="站点导航" data-intersect>
  <p class="p-eco__label">继续逛</p>
  <div class="p-eco__grid">
    {
      links.map((link, index) => (
        <a
          class:list={['p-eco__link', { 'is-current': link.href === current }]}
          href={link.href}
          data-seal
          style={`--eco-i:${index}`}
        >
          {link.href === current && <SealMark variant="dot" />}
          {link.label}
        </a>
      ))
    }
  </div>
</nav>
