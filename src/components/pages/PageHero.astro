---
import ASeparator from '../ASeparator.astro'
import SealMark from '../SealMark.astro'
import InkMountains from '../InkMountains.astro'
import InkMeander from '../InkMeander.astro'

interface Props {
  kicker: string
  title: string
  summary: string
}

const { kicker, title, summary } = Astro.props
---

<header class="p-hero" data-intersect>
  <InkMountains compact />
  <div class="p-hero__side" aria-hidden="true">
    <span class="p-hero__motto">格物 · 致知 · 日新</span>
  </div>
  <p class="p-hero__kicker">{kicker}</p>
  <h1 class="p-hero__title">{title}</h1>
  <p class="p-hero__summary">{summary}</p>
  <SealMark variant="watermark" />
  <InkMeander height={8} width="46%" class="p-hero__meander" />
</header>

<ASeparator style="accent" />
