---
/**
 * ContactLetter — 联系页专用信笺
 *
 * 对照首页卷尾点空白激起纸面震波：点笺面（避开表单与链接）洇一滴墨。
 * 合作方向可点一下钤勾。脚本缺席时正文与表单照常可读。
 */
---

<contact-letter class="p-contact-letter">
  <slot />
</contact-letter>

<script>
  import { prefersReducedMotion, type Cleanup } from '../../motion/core'

  const SKIP =
    'a,button,input,textarea,select,label,summary,[role="button"],ink-seal3d,.js-stamp,.p-card__link,.p-form'
  const MAX_BLOTS = 8

  class ContactLetter extends HTMLElement {
    stops: Cleanup[] = []
    timers: number[] = []
    layer: HTMLElement | null = null

    connectedCallback() {
      this.classList.add('is-live')

      const layer = document.createElement('span')
      layer.className = 'p-contact-blots'
      layer.setAttribute('aria-hidden', 'true')
      this.appendChild(layer)
      this.layer = layer

      const spawnBlot = (event: PointerEvent) => {
        if (!this.layer || prefersReducedMotion()) return

        const rect = this.getBoundingClientRect()
        const blot = document.createElement('i')
        blot.className = 'p-contact-blot'
        blot.style.left = `${event.clientX - rect.left}px`
        blot.style.top = `${event.clientY - rect.top}px`
        this.layer.appendChild(blot)

        while (this.layer.childElementCount > MAX_BLOTS) {
          this.layer.firstElementChild?.remove()
        }

        const done = () => blot.remove()
        blot.addEventListener('animationend', done, { once: true })
        const timer = window.setTimeout(done, 1400)
        this.timers.push(timer)
      }

      const onPointerDown = (event: PointerEvent) => {
        if (event.button !== 0) return
        const target = event.target as Element | null
        if (!target) return

        const item = target.closest('.p-contact-letter li')
        if (item instanceof HTMLElement && this.contains(item)) {
          item.classList.toggle('is-ticked')
          return
        }

        if (target.closest(SKIP)) return
        spawnBlot(event)
      }

      const onKeyDown = (event: KeyboardEvent) => {
        if (event.key !== 'Enter' && event.key !== ' ') return
        const item = event.target
        if (!(item instanceof HTMLElement)) return
        if (item.tagName !== 'LI' || !this.contains(item)) return
        event.preventDefault()
        item.classList.toggle('is-ticked')
      }

      this.addEventListener('pointerdown', onPointerDown)
      this.addEventListener('keydown', onKeyDown)
      this.stops.push(() => this.removeEventListener('pointerdown', onPointerDown))
      this.stops.push(() => this.removeEventListener('keydown', onKeyDown))
    }

    disconnectedCallback() {
      this.timers.forEach((id) => clearTimeout(id))
      this.timers = []
      this.stops.forEach((stop) => stop())
      this.stops = []
      this.layer?.remove()
      this.layer = null
    }
  }

  if (!customElements.get('contact-letter')) {
    customElements.define('contact-letter', ContactLetter)
  }
</script>
