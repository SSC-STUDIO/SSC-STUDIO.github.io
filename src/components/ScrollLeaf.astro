---
/**
 * ScrollLeaf — 卷·册页条目（作品长卷里的一叶）
 *
 * 装裱语言：松墨底、四角朱砂碰头、右上骑缝绢色签条（竖排卷号）。
 * 对外协议：父级（作品长卷）通过 progress 属性驱动横移，
 * 组件把它落成 --progress 变量并按可见性开合 content-visibility。
 */
const { cssClass, href, img, title, summary, stack = [], key } = Astro.props
---

<scroll-leaf class={cssClass}>
  <div class="leaf__inner">
    <a href={href}>
      <img
        class="leaf__image js-image"
        src={img}
        alt={title}
        width="1082"
        height="636"
        loading="lazy"
        decoding="async"
      />

      <div class="leaf__caption">
        <div class="leaf__caption__text">
          <span class="leaf__caption__title">{title}</span>
          <span class="leaf__caption__summary">{summary}</span>
          <span class="leaf__caption__stack">
            {stack.map((tag) => <span class="leaf__caption__tag">{tag}</span>)}
          </span>
        </div><!-- .leaf__caption__text -->

        <div class="leaf__caption__key">
          {key}
        </div><!-- .leaf__caption__key -->
      </div><!-- .leaf__caption -->

      <span class="leaf__slip" aria-hidden="true">
        <span class="leaf__slip__text">{key}</span>
      </span>
    </a>
  </div><!-- .leaf__inner -->
</scroll-leaf>

<script>
  class ScrollLeaf extends HTMLElement {
    static observedAttributes = ['progress']

    link: HTMLAnchorElement

    connectedCallback() {
      this.link = this.querySelector('a')
      this.link.addEventListener('click', this.onClick.bind(this))
    }

    /** progress ∈ [-1, 1]：0 在画心，±1 出画外（出画即关渲染） */
    attributeChangedCallback(name: string, _old: string, value: string) {
      if (name !== 'progress') return

      this.style.setProperty('--progress', value)

      if (value === '1' || value === '-1') {
        this.classList.remove('is-inview')
      } else {
        this.classList.add('is-inview')
      }
    }

    /** 占位链接（#）不跳页 */
    onClick(event: MouseEvent) {
      if (this.link.href.includes('#')) {
        event.preventDefault()
        return false
      }
    }
  }

  if (!customElements.get('scroll-leaf')) {
    customElements.define('scroll-leaf', ScrollLeaf)
  }
</script>

<style lang="scss">
  scroll-leaf {
    position: relative;
    top: 0;
    left: 0;

    display: block;
    margin: 0;
    padding: 0.5rem 0.5rem 0;

    background: color(surface);
    content-visibility: hidden;

    /* 四角朱砂碰头：册页装裱式的角饰 */
    @include ink-corner-marks($len: 13px, $w: 1.5px, $inset: -2px, $softness: 0.9);

    transform-style: preserve-3d;

    will-change: transform;

    @include mq(phone) {
      padding: 0.25rem;
    }

    a {
      display: block;

      text-decoration: none;
    }

    .leaf__inner {
      display: block;
      margin: 0;
      padding: 0;
    }

    .leaf__image {
      display: block;

      width: auto;
      max-width: min(50vw, 42rem);
      height: auto;
      max-height: 50vh;

      object-fit: cover;

      transition: filter 0.5s ease;

      @include mq(phone) {
        max-width: 80vw;
        max-height: 80vh;
      }
    }

    /* 悬停时泛起陈年宣纸的旧色 */
    a:hover .leaf__image,
    a:focus-visible .leaf__image {
      filter: sepia(0.22) saturate(1.06) contrast(1.02) brightness(0.99);
    }

    .leaf__caption {
      @include flex(row, flex-start, space-between);

      gap: 1rem;
      padding: 0.65rem 0.5rem 0.5rem;

      color: color(on-surface);
      font: 700 12px / 1.2 font-family(editorial);
      letter-spacing: 0.08em;
      text-transform: none;
    }

    .leaf__caption__text {
      @include flex(column, flex-start, flex-start);

      gap: 0.35rem;
      max-width: 28rem;
    }

    .leaf__caption__summary {
      color: color-mix(in srgb, var(--color-on-surface) 82%, transparent);
      font: 400 10px / 1.45 font-family(editorial);
      letter-spacing: 0.02em;
      text-transform: none;
    }

    .leaf__caption__stack {
      @include flex(row, center, flex-start);

      flex-wrap: wrap;
      gap: 0.25rem;
    }

    .leaf__caption__tag {
      padding: 0.18rem 0.42rem;

      border: 1px solid
        color-mix(in srgb, var(--color-on-surface) 34%, transparent);
      @include ink-pill;

      color: color-mix(in srgb, var(--color-on-surface) 86%, transparent);
      font-size: 9px;
      letter-spacing: 0.05em;
    }

    .leaf__caption__key {
      flex-shrink: 0;
      align-self: center;
      padding: 0.22rem 0.5rem;

      background: color-mix(in srgb, var(--color-accent) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-accent) 62%, transparent);
      @include ink-pill;

      color: color(accent-strong);
      font-family: font-family(editorial);
      letter-spacing: 0.16em;

      white-space: nowrap;
    }

    /* 签条 —— 骑缝在册页右上角的绢色题签 */
    .leaf__slip {
      position: absolute;
      top: -0.55rem;
      right: 1.1rem;
      z-index: 3;

      display: block;

      pointer-events: none;
    }

    .leaf__slip__text {
      display: block;
      padding: 0.7em 0.26em;

      writing-mode: vertical-rl;

      background: linear-gradient(
        180deg,
        color(paper-warm),
        color-mix(in srgb, color(paper-warm) 88%, #000)
      );
      box-shadow:
        inset 0 0 0 1px
          color-mix(in srgb, color(secondary) 55%, transparent),
        inset 0 0 0 2.5px color(paper-warm),
        1px 1.5px 4px rgba(12, 10, 8, 0.28);

      color: color(secondary);
      font: 600 10.5px / 1.15 font-family(editorial);
      letter-spacing: 0.32em;

      white-space: nowrap;
    }

    @include mq(phone) {
      .leaf__slip {
        top: -0.4rem;
        right: 0.6rem;
      }

      .leaf__slip__text {
        font-size: 9px;
      }
    }

    &.is-inview {
      content-visibility: visible;
    }
  }
</style>
