---
import SealMark from './SealMark.astro'
import SenMark from './SenMark.astro'
import InkMeander from './InkMeander.astro'
import InkCloud from './InkCloud.astro'
import InkKnot from './InkKnot.astro'
import { getSolarTerm } from '../utils/solar-terms'

// 构建时的节气作为无 JS 兜底；客户端脚本会用实时日期覆写
const term = getSolarTerm()
---

<footer class="site-foot">
  <div class="site-foot__logo">
    <a href="/">
      <SenMark size={48} />

      <span class="u-sr-only">陈润森</span>
    </a>
    <SealMark variant="footer" />
  </div><!-- .site-foot__logo -->

  <p class="site-foot__band" aria-hidden="true">
    <InkMeander height={9} width="100%" />
  </p>

  <p class="site-foot__cloud" aria-hidden="true">
    <InkCloud height={13} width="min(24rem, 78vw)" class="ink-cloud--drift" />
  </p>

  <p class="site-foot__knot" aria-hidden="true">
    <InkKnot size={36} class="ink-knot--drift" />
  </p>

  <p class="site-foot__term" data-solar-term data-season={term.season}>
    <span class="site-foot__term-badge" data-term-name>今值{term.name}</span>
    <span class="site-foot__term-line" data-term-line>{term.line}</span>
  </p>

  <p class="site-foot__credit">
    © 2026 陈润森 · Chen Runsen<br />
    动效骨架参考 Antoine Wodniack / wodniack.dev（CC BY-NC 4.0），身份、文案与版式为重新设计。
    <a href="https://github.com/SSC-STUDIO" target="_blank" rel="noopener noreferrer"
      >@SSC-STUDIO</a
    >
    ·
    <a href="mailto:3992237161@qq.com" data-copy-email>3992237161@qq.com</a>
    ·
    <a href="https://wodniack.dev/" target="_blank" rel="noopener noreferrer"
      >wodniack.dev</a
    >
  </p>
</footer>

<script>
  import { getSolarTerm } from '../utils/solar-terms'

  // 用实时日期覆写构建时的节气兜底
  const root = document.querySelector('[data-solar-term]')

  if (root) {
    const term = getSolarTerm()
    const name = root.querySelector('[data-term-name]')
    const line = root.querySelector('[data-term-line]')

    root.setAttribute('data-season', term.season)

    if (name) name.textContent = `今值${term.name}`
    if (line) line.textContent = term.line
  }
</script>

<style lang="scss">
  .site-foot {
    @include flex(column, center, center);

    position: relative;
    z-index: 3;

    padding: 1.5rem;
    gap: 1rem;

    @include ink-rule(top);

    &::before {
      position: absolute;
      inset: 0;
      z-index: 0;

      @include ink-leiwen($cell: 20px, $strength: 0.055);

      content: '';
      pointer-events: none;
    }

    @include mq(phone) {
      padding: 1rem;
    }

    &__logo {
      display: flex;
      align-items: center;
      gap: 0.75rem;

      svg {
        display: block;
        width: 3rem;
        height: 3rem;

        color: color(secondary);

        @include mq(phone) {
          width: 1.875rem;
          height: 1.875rem;
        }
      }
    }

    &__band {
      width: min(19rem, 62vw);
      margin: 0;

      opacity: 0.5;
    }

    &__cloud {
      margin: -0.35rem 0 0;

      opacity: 0.6;
    }

    /* 盘长徽记：绳结系住云脚，淡紫入韵 */
    &__knot {
      margin: 0;
    }

    /* 节气信笺：今值某节气 + 物候短句，四季换徽 */
    &__term {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: center;
      gap: 0.4rem 0.65rem;

      margin: 0;

      opacity: 0.85;
    }

    &__term-badge {
      padding: 0.18rem 0.5rem;

      background: color-mix(in srgb, #{color(accent)} 82%, #{color(primary)});
      @include ink-pill;

      color: color(primary);
      font: 700 10px / 1.5 font-family(bigger);
      letter-spacing: 0.14em;
    }

    &__term-line {
      color: color-mix(in srgb, #{color(secondary)} 62%, transparent);
      font: 400 0.8rem / 1.5 font-family(bigger);
      letter-spacing: 0.08em;
    }

    .site-foot__term[data-season='春'] .site-foot__term-badge {
      background: color-mix(in srgb, #{color(mist)} 58%, #{color(secondary)});
    }

    .site-foot__term[data-season='夏'] .site-foot__term-badge {
      background: color-mix(in srgb, #{color(indigo)} 72%, #{color(secondary)});
    }

    .site-foot__term[data-season='秋'] .site-foot__term-badge {
      background: color-mix(in srgb, #{color(accent-strong)} 78%, #{color(secondary)});
    }

    &__credit {
      margin: 0;
      max-width: 36rem;

      font-size: 0.75rem;
      line-height: 1.6;
      text-align: center;

      opacity: 0.85;

      a {
        color: inherit;
        text-decoration: none;

        &:hover {
          text-decoration: underline;
          text-decoration-color: color(accent);
          text-underline-offset: 0.2em;
        }
      }
    }
  }
</style>
