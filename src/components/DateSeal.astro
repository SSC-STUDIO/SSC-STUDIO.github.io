---
/**
 * DateSeal — 朱砂日戳
 * 「今日」的一方印：中文数字纪年 + 农历式月日 + 当期节气。
 * 与右上角 StudioClock 成对角呼应，构成 Hero 的时间坐标系。
 * 构建时渲染兜底值，客户端脚本再用实时日期覆写。
 */
import { getSolarTerm } from '../utils/solar-terms'
import { formatSealDate } from '../utils/seal-date'

interface Props {
  class?: string
}

const { class: className } = Astro.props
const now = new Date()
const stamp = formatSealDate(now)
const term = getSolarTerm(now)
---

<div
  class:list={['date-seal', className]}
  data-date-seal
  aria-label={`今日 ${stamp.year}${stamp.day} ${stamp.week} ${term.name}`}
>
  <span class="date-seal__label">今日</span>
  <time class="date-seal__when" datetime={stamp.iso}>
    <span class="date-seal__year" data-seal-year>{stamp.year}</span>
    <span class="date-seal__day" data-seal-day>{stamp.day}</span>
  </time>
  <span class="date-seal__week" data-seal-week>{stamp.week}</span>
  <span class="date-seal__term" data-seal-term>{term.name}</span>
</div>

<script>
  import { getSolarTerm } from '../utils/solar-terms'
  import { formatSealDate } from '../utils/seal-date'

  /* 每次换页重取元素重写：ClientRouter 下模块只执行一次，
     否则 SPA 回来的日戳会停在构建期兜底文案上 */
  function stampDateSeal() {
    const root = document.querySelector('[data-date-seal]')
    if (!root) return

    const now = new Date()
    const stamp = formatSealDate(now)
    const term = getSolarTerm(now)

    const set = (key: string, text: string) => {
      const el = root.querySelector(`[data-seal-${key}]`)
      if (el) el.textContent = text
    }

    set('year', stamp.year)
    set('day', stamp.day)
    set('week', stamp.week)
    set('term', term.name)

    const when = root.querySelector('time')
    if (when) when.setAttribute('datetime', stamp.iso)
    root.setAttribute(
      'aria-label',
      `今日 ${stamp.year}${stamp.day} ${stamp.week} ${term.name}`
    )
  }

  stampDateSeal()
  document.addEventListener('astro:page-load', stampDateSeal)
</script>

<style lang="scss">
  .date-seal {
    @include flex(column, center, center);

    position: absolute;
    top: 84px;
    left: clamp(16px, 4vw, 48px);
    z-index: 6;

    width: 3.4rem;
    padding: 0.5rem 0.25rem 0.4rem;

    @include ink-hairline;
    @include ink-pill;

    background: color-mix(in srgb, #{color(primary)} 62%, transparent);
    backdrop-filter: blur(6px);

    color: color(secondary);

    /* 印章略斜，如随手钤下 */
    transform: rotate(-3deg);
    transform-origin: center;

    &__label {
      color: color-mix(in srgb, #{color(secondary)} 55%, transparent);
      font: 700 8px / 1 font-family(fraktion);
      letter-spacing: 0.24em;
    }

    &__when {
      display: contents;
    }

    &__year {
      margin-top: 0.3rem;

      font: 400 0.6rem / 1.2 font-family(bigger);
      letter-spacing: 0.06em;
    }

    &__day {
      margin-top: 0.15rem;

      color: color(accent);
      font: 700 0.95rem / 1.2 font-family(bigger);
      letter-spacing: 0.02em;
      writing-mode: horizontal-tb;
    }

    &__week {
      margin-top: 0.2rem;

      color: color-mix(in srgb, #{color(secondary)} 62%, transparent);
      font: 400 0.55rem / 1.2 font-family(editorial);
    }

    &__term {
      margin-top: 0.35rem;

      padding: 0.1rem 0.3rem;

      background: color(accent);
      @include ink-pill;

      color: color(primary);
      font: 700 8px / 1.5 font-family(bigger);
      letter-spacing: 0.1em;
    }
  }

  @include mq(phone) {
    .date-seal {
      top: 64px;
      left: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .date-seal {
      transform: none;
    }
  }
</style>
