---
/**
 * StudioCard — 「工作室名片」浮卡
 * hero 右侧的个人名片：照片 + 值班状态，桌面端专属。
 */
---

<aside class="studio-card" aria-label="工作室名片">
  <figure>
    <div class="studio-card__photo">
      <img
        src="/legacy-assets/personal/chen-sm.webp"
        alt="陈润森"
        width="300"
        height="300"
        loading="lazy"
        decoding="async"
      />
    </div>
    <figcaption class="studio-card__meta">
      <strong class="js-studio-duty">陈润森 · 值班中</strong>
      <span>工作室 · 上海</span>
    </figcaption>
  </figure>
  <span class="studio-card__no" aria-hidden="true">ID.019</span>
</aside>

<script>
  import { DAYPART_DUTY, resolveDaypartKey, startDaypartTicker } from '../utils/daypart'

  let observer: MutationObserver | null = null

  function paintDuty() {
    const duty = document.querySelector('.js-studio-duty')
    if (!duty) return
    duty.textContent = DAYPART_DUTY[resolveDaypartKey()]
  }

  function bindDuty() {
    paintDuty()
    if (observer) return
    observer = new MutationObserver(paintDuty)
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-daypart'],
    })
  }

  startDaypartTicker(paintDuty)
  bindDuty()
  document.addEventListener('astro:page-load', paintDuty)
</script>
