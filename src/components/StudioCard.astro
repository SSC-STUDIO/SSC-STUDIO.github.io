---
/**
 * StudioCard — 「工作室名片」浮卡
 * hero 右侧的个人名片：照片 + 印章 + 值班状态，桌面端专属。
 */
import SealMark from './SealMark.astro'
---

<aside class="studio-card" aria-label="工作室名片">
  <figure class="studio-card__photo">
    <img
      src="/legacy-assets/personal/chen-sm.webp"
      alt="陈润森"
      width="300"
      height="300"
      loading="lazy"
      decoding="async"
    />
    <span class="studio-card__seal">
      <SealMark variant="dot" />
    </span>
  </figure>
  <figcaption class="studio-card__meta">
    <strong class="js-studio-duty">陈润森 · 值班中</strong>
    <span>STUDIO / SHANGHAI</span>
  </figcaption>
</aside>

<script>
  // 值班文案随时段变化（与 StudioClock 的 data-daypart 同步）
  ;(function () {
    var duty = document.querySelector('.js-studio-duty')
    if (!duty) return
    var DUTIES = {
      dawn: '陈润森 · 晨光值守',
      day: '陈润森 · 白昼在线',
      dusk: '陈润森 · 暮色在班',
      night: '陈润森 · 夜灯值守',
    }
    function sync() {
      var part = document.documentElement.getAttribute('data-daypart') || 'night'
      duty.textContent = DUTIES[part] || DUTIES.night
    }
    sync()
    new MutationObserver(sync).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-daypart'],
    })
  })()
</script>
