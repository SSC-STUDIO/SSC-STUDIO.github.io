---
/**
 * InkKnot - 原创「盘长纹」徽记（中国结简化线稿）
 * 三叠菱环相扣，四出结耳；回环不断、周而复始之意。
 * currentColor 取色；hover 由使用方接管。
 */
type Props = {
  size?: number
  class?: string
}

const { size = 40, class: className } = Astro.props
---

<svg
  class:list={['ink-knot', className]}
  style={`width:${size}px;height:${size}px`}
  viewBox="0 0 64 64"
  aria-hidden="true"
>
  <g
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <!-- 外环菱：绳路主架 -->
    <path d="M32 10 54 32 32 54 10 32Z"></path>
    <!-- 中环菱：回环相扣 -->
    <path d="M32 18 46 32 32 46 18 32Z"></path>
    <!-- 内环菱：心结收拢 -->
    <path d="M32 25 39 32 32 39 25 32Z"></path>
    <!-- 四出结耳：绳头回卷 -->
    <path d="M32 10c-2-3-2-5 0-7 2 2 2 4 0 7Z"></path>
    <path d="M54 32c3-2 5-2 7 0-2 2-4 2-7 0Z"></path>
    <path d="M32 54c2 3 2 5 0 7-2-2-2-4 0-7Z"></path>
    <path d="M10 32c-3 2-5 2-7 0 2-2 4-2 7 0Z"></path>
  </g>
</svg>

<style>
  .ink-knot {
    display: block;

    color: var(--color-mist, var(--color-secondary));
    opacity: 0.85;
  }

  /* 缓摆：盘长微曳，静而不僵 */
  .ink-knot--drift {
    animation: knotDrift 12s ease-in-out infinite;
  }

  @keyframes knotDrift {
    0%,
    100% {
      transform: rotate(-2deg);
    }
    50% {
      transform: rotate(2deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-knot--drift {
      animation: none;
    }
  }
</style>
