---
import InkMountains from './InkMountains.astro'
import InkBloom from './InkBloom.astro'
import InkBubbles from './InkBubbles.astro'
import SenMark from './SenMark.astro'
import InkSen3D from './InkSen3D.astro'

const frames = [
  {
    src: '/legacy-assets/personal/chen.jpg',
    caption: '陈润森 · 主照片<br/>About · 2024',
  },
  {
    src: '/legacy-assets/personal/chen.webp',
    caption: '个人照 · 01<br/>Portrait',
  },
  {
    src: '/legacy-assets/personal/chen_1.webp',
    caption: '个人照 · 02<br/>Portrait',
  },
  {
    src: '/legacy-assets/personal/chen_2.webp',
    caption: '个人照 · 03<br/>Portrait',
  },
  {
    src: '/legacy-assets/personal/chen_3.webp',
    caption: '个人照 · 04<br/>Portrait',
  },
  {
    src: '/legacy-assets/personal/chen_4.webp',
    caption: '个人照 · 05<br/>Portrait',
  },
  {
    src: '/legacy-assets/personal/chen_5.webp',
    caption: '个人照 · 06<br/>Portrait',
  },
  {
    src: '/legacy-assets/prize/prize_0.jpg',
    caption: '奖状 · 原件 01<br/>Honors · Prize',
  },
  ...Array.from({ length: 13 }, (_, i) => ({
    src: `/legacy-assets/prize/prize_${i + 1}.jpg`,
    caption: `奖状 · 原件 ${String(i + 2).padStart(2, '0')}<br/>Honors`,
  })),
  ...Array.from({ length: 4 }, (_, i) => ({
    src: `/legacy-assets/step/step_${i}.jpg`,
    caption: `成长轨迹 · ${String(i + 1).padStart(2, '0')}<br/>Step · Journey`,
  })),
]

const ecosystem = [
  {
    href: '/projects',
    name: 'Projects',
    summary: '每个项目都留下来路：想法、技术、演示和最终抵达的结果。',
  },
  {
    href: '/articles',
    name: 'Articles',
    summary: '把灵感写慢，把问题写透，让笔记成为下一次出发的地图。',
  },
  {
    href: '/about',
    name: 'About',
    summary: '照片、方向和自我介绍，拼成一个正在变化的人。',
  },
  {
    href: '/honors',
    name: 'Honors & Growth',
    summary: '奖项与节点像路标，记录努力被看见的那些瞬间。',
  },
  {
    href: '/sponsor',
    name: 'Sponsor',
    summary:
      'Support page with a polished funding narrative and actionable next steps.',
  },
  {
    href: '/games',
    name: 'Games',
    summary: '把规则、反应和手感做成小游戏，让想象可以被试玩。',
  },
  {
    href: '/leaderboard',
    name: 'Leaderboard',
    summary: 'Competitive scoreboards for experiments and game-linked rankings.',
  },
  {
    href: '/benchmarks',
    name: 'Benchmarks',
    summary:
      'Human benchmark suite with score submission, stats, and progression views.',
  },
  {
    href: '/class',
    name: 'Class Space',
    summary: '一处给同学的记忆房间，保存那些只属于我们这一班的片段。',
  },
  {
    href: '/mini-love/',
    name: '给诗菡的信',
    summary: '军训最后一天的合唱，后来有了回声。',
    standalone: true,
  },
]

// 行脚序号：壹至拾
const cnNum = ['壹', '贰', '叁', '肆', '伍', '陆', '柒', '捌', '玖', '拾']
---

<section id="my-way" class="s-my-way" data-intersect>
  <InkMountains compact dimensional />
  <InkBloom class="s__bloom" size={260} />
  <InkBubbles class="s__bubbles" />
  <div class="s__sen3d">
    <InkSen3D />
  </div>
  <div class="s__smiley js-smiley" aria-hidden="true">
    <span class="s__smiley__ring"></span>
    <span class="s__smiley__cardinals">
      <b>北</b>
      <b>东</b>
      <b>南</b>
      <b>西</b>
    </span>
    <span class="s__smiley__needle"></span>
    <span class="s__smiley__pips">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
    </span>
    <SenMark size={72} />
  </div>

  <div class="s__objects js-objects">
    {
      frames.map((frame) => (
        <div class="a-object a-object--frame">
          <figure class="a__inner">
            <img
              loading="lazy"
              draggable="false"
              class="a__img"
              src={frame.src}
              alt={frame.caption}
            />

            <figcaption class="a__caption" set:html={frame.caption} />
          </figure>

          <div class="a__side a__side--vertical" />
          <div class="a__side a__side--horizontal" />
        </div>
      ))
    }

    {
      Array(10)
        .fill(0)
        .map(() => (
          <div class="a-object a-object--star">
            <div class="a__side a__side--top-left" />
            <div class="a__side a__side--top-right" />
            <div class="a__side a__side--bottom-left" />
            <div class="a__side a__side--bottom-right" />
          </div>
        ))
    }

    {
      ecosystem.map((item, index) => (
        <div class="a-object a-object--ecosystem">
          <a
            href={item.href}
            class="a__inner"
            data-astro-reload={item.standalone ? '' : undefined}
          >
            <span class="a__badge">{cnNum[index] ?? index + 1}</span>
            <span class="a__name">{item.name}</span>
            <span class="a__summary">{item.summary}</span>
          </a>

          <div class="a__side a__side--vertical" />
          <div class="a__side a__side--horizontal" />
        </div>
      ))
    }

    <div class="s__ruler js-ruler"></div>
  </div><!-- .s__objects -->

  <div class="s__ecosystem-label">
    <h2 class="s__ecosystem__title">
      <span class="s__ecosystem__rule"></span>
      拾遗录
      <span class="s__ecosystem__rule s__ecosystem__rule--tail"></span>
    </h2>
  </div>

  <div class="s__catcher">
    <div class="s__catcher__distorted-wrapper">
      <div class="s__catcher__distorted">
        <div class="s__catcher__text s__catcher__text--distorted"><span class="s__catcher__line s__catcher__line--cn">我的路</span><br /><span class="s__catcher__line s__catcher__line--my">My</span><br /><span class="s__catcher__line s__catcher__line--way">Way</span><br /><span class="s__catcher__line">·</span></div>
      </div><!-- .s__catcher__distorted -->
    </div><!-- .s__catcher__distorted-wrapper -->

    <div class="s__catcher__normal-wrapper">
      <div class="s__catcher__normal">
        <div class="s__catcher__text s__catcher__text--normal"><span class="s__catcher__line s__catcher__line--cn">我的路</span><br /><span class="s__catcher__line s__catcher__line--my">My</span><br /><span class="s__catcher__line s__catcher__line--way">Way</span><br /><span class="s__catcher__line">·</span></div>
      </div><!-- .s__catcher__normal -->
    </div><!-- .s__catcher__normal-wrapper -->
  </div><!-- .s__catcher -->

  <canvas class="s__field js-field" aria-hidden="true"></canvas>

  <svg class="s__svg js-svg">
    <path class="s__svg__circular-path js-lines-circular-path" d=""></path>
  </svg>

  <p class="s__colophon" aria-hidden="true">
    <span class="s__colophon__text">润森 行脚至此 · 记</span>
    <svg
      class="s__colophon__seal"
      width="26"
      height="26"
      viewBox="0 0 26 26"
      aria-hidden="true"
    >
      <rect x="1" y="1" width="24" height="24" rx="3.5" fill="#c23a2b"></rect>
      <text
        x="13"
        y="14.5"
        text-anchor="middle"
        dominant-baseline="central"
        fill="#f4ead8"
        font-size="12"
        font-weight="700"
        font-family="'Noto Serif SC','SimSun',serif">记</text
      >
    </svg>
  </p>
</section>

<script>
  import {
    whenReady,
    onFrame,
    onResize,
    onScroll,
    onPointer,
    frameDelta,
    prefersReducedMotion,
    type Cleanup,
  } from '../motion/core'
  import { createField, type Field2D } from '../motion/field'

  class Section {
    el: HTMLElement
    svg: HTMLElement
    fieldCanvas: HTMLCanvasElement
    fieldCtx: CanvasRenderingContext2D | null
    field: Field2D
    dots: { x: number; y: number; ox: number; oy: number; p: number }[]
    objectsWrapper: HTMLElement
    ruler: HTMLElement

    objects: any[]
    ecosystemObjects: any[]
    canThrow: boolean
    lastThrow: number
    throwDelay: number
    thrownObjects: any[]
    draggedObject: any
    inspectedObject: any
    ecosystemLaunched: boolean

    smiley: {
      el: HTMLElement
      bounding: DOMRect
      rel: {
        x: number
        y: number
      }
    }

    lines: {
      circularPath: HTMLElement
      lines: any[]
    }

    bounding: {
      left: number
      top: number
      width: number
      height: number
    }

    scroll: {
      p: number
      sp: number
    }

    mouse: {
      x: number
      y: number
      oy: number
      sx: number
      sy: number
      d: number
      set: boolean
    }

    lastTouch: number
    lastDragEnd: number

    isPaused: boolean
    stops: Cleanup[] = []
    unframe: Cleanup | null = null
    destroyed = false
    reduced = false
    ripples: { x: number; y: number; born: number }[] = []
    compassDeg = 0
    compassAim = 0
    compassKick = 0
    paperPress = 0
    catcherRx = 0
    catcherRy = 0
    catcherPulse = 0
    pulseTimers: number[] = []
    onObjectDragStart = (e: Event) => this.objectDragStart(e)
    onObjectDragEnd = (e: Event) => this.objectDragEnd(e)
    onTouchMoveBound = (e: Event) => this.onTouchMove(e)
    onIntersectBound = (e: Event) => this.onIntersect(e)
    onBlankClickBound = (e: Event) => this.onBlankClick(e)

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-my-way')
      this.svg = this.el.querySelector('.js-svg')
      this.fieldCanvas = this.el.querySelector('.js-field')
      this.fieldCtx = this.fieldCanvas ? this.fieldCanvas.getContext('2d') : null
      this.field = createField(7.13)
      this.dots = []
      this.objectsWrapper = this.el.querySelector('.js-objects')
      this.ruler = this.el.querySelector('.js-ruler')

      // Properties
      this.objects = []
      this.ecosystemObjects = []
      Array.from(this.objectsWrapper.children).forEach((el) => {
        if (!(el instanceof HTMLElement) || el.classList.contains('js-ruler'))
          return

        const object = new Object(el, this)

        if (el.classList.contains('a-object--ecosystem')) {
          this.ecosystemObjects.push(object)
        } else {
          this.objects.push(object)
        }
      })

      this.canThrow = false
      this.lastThrow = 0
      this.throwDelay = 2000
      this.thrownObjects = []
      this.draggedObject = null
      this.inspectedObject = null
      this.ecosystemLaunched = false

      this.smiley = {
        el: this.el.querySelector('.js-smiley'),
        bounding: null,
        rel: {
          x: 0,
          y: 0,
        },
      }

      this.lines = {
        circularPath: this.el.querySelector('.js-lines-circular-path'),
        lines: [],
      }

      this.mouse = {
        x: 0,
        y: 0,
        oy: 0,
        sx: 0,
        sy: 0,
        d: 0,
        set: false,
      }

      this.isPaused = true
      this.reduced = prefersReducedMotion()
      this.lastTouch = 0
      this.lastDragEnd = 0

      whenReady(() => this.init())
    }

    /**
     * Init
     */
    init() {
      if (this.destroyed || !this.el) return

      this.setSize()
      this.setScroll()
      this.setLines()
      this.setDots()

      this.bindEvents()

      this.firstObjects()
      this.syncVisibility()
    }

    /**
     * SPA 换页收尾：摘掉帧循环与指针/视口/滚动订阅
     */
    destroy() {
      this.destroyed = true
      this.unframe?.()
      this.unframe = null
      this.stops.forEach((stop) => stop())
      this.stops = []

      this.objects.forEach((object) => {
        object.el.removeEventListener('mousedown', this.onObjectDragStart)
        object.el.removeEventListener('touchstart', this.onObjectDragStart)
      })
      this.ecosystemObjects.forEach((object) => {
        object.el.removeEventListener('mousedown', this.onObjectDragStart)
        object.el.removeEventListener('touchstart', this.onObjectDragStart)
      })
      this.thrownObjects?.forEach((object) => {
        object.el.removeEventListener('mousedown', this.onObjectDragStart)
        object.el.removeEventListener('touchstart', this.onObjectDragStart)
      })
      window.removeEventListener('pointerup', this.onObjectDragEnd)
      window.removeEventListener('pointercancel', this.onObjectDragEnd)
      this.objectsWrapper?.removeEventListener(
        'touchmove',
        this.onTouchMoveBound
      )
      this.el?.removeEventListener('intersect', this.onIntersectBound)
      this.el?.removeEventListener('click', this.onBlankClickBound)
      this.pulseTimers.forEach((id) => clearTimeout(id))
      this.pulseTimers = []
      this.ripples = []
    }

    /**
     * Bind events
     */
    bindEvents() {
      this.stops.push(onPointer(({ x, y }) => this.onMouseMove(x, y)))
      this.stops.push(onResize(() => this.onResize()))
      this.stops.push(onScroll((scrollY) => this.onScroll(scrollY)))
      this.startFrame()

      this.objects.forEach((object) => {
        object.el.addEventListener('mousedown', this.onObjectDragStart)
        object.el.addEventListener('touchstart', this.onObjectDragStart)
      })
      this.ecosystemObjects.forEach((object) => {
        object.el.addEventListener('mousedown', this.onObjectDragStart)
        object.el.addEventListener('touchstart', this.onObjectDragStart)
      })
      window.addEventListener('pointerup', this.onObjectDragEnd)
      window.addEventListener('pointercancel', this.onObjectDragEnd)
      this.stops.push(() => {
        window.removeEventListener('pointerup', this.onObjectDragEnd)
        window.removeEventListener('pointercancel', this.onObjectDragEnd)
      })

      // Esc 关闭正在细看的物件
      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Escape' && this.inspectedObject) this.dismissInspected()
      }
      window.addEventListener('keydown', onKey)
      this.stops.push(() => window.removeEventListener('keydown', onKey))

      this.objectsWrapper.addEventListener('touchmove', this.onTouchMoveBound)

      this.el.addEventListener('intersect', this.onIntersectBound, {
        passive: true,
      })

      // 点空白：不抢飞来物的「轻点细看」，只给纸面一记微感
      this.el.addEventListener('click', this.onBlankClickBound)
    }

    startFrame() {
      if (this.unframe) return
      this.unframe = onFrame((time) => this.tick(time))
    }

    /**
     * Intersect handler
     */
    onIntersect(e) {
      this.applyVisibility(!!e.detail.isIntersecting)
    }

    syncVisibility() {
      const rect = this.el.getBoundingClientRect()
      const visible =
        this.el.classList.contains('is-in-view') ||
        (rect.bottom > 80 && rect.top < window.innerHeight - 40)
      this.applyVisibility(visible)
    }

    applyVisibility(visible: boolean) {
      this.isPaused = !visible
      this.canThrow = visible

      if (!visible) return

      this.setSize()

      this.thrownObjects.forEach((object) => {
        object.isWaiting = false
        object.el.classList.remove('is-waiting')
      })

      if (this.scroll.p > 0.58) {
        this.launchEcosystemCards()
      }
    }

    viewportSize() {
      return {
        w: window.safeWidth || window.innerWidth,
        h: window.safeHeight || window.innerHeight,
      }
    }

    liveRect() {
      const rect = this.el.getBoundingClientRect()
      if (this.bounding) {
        this.bounding.left = rect.left
        this.bounding.top = rect.top
        this.bounding.width = rect.width
        this.bounding.height = rect.height
      }
      return rect
    }

    objectOrigin() {
      return {
        x: (this.bounding?.width || 0) / 2,
        y: (this.bounding?.height || 0) / 2,
      }
    }

    clientToObject(clientX: number, clientY: number) {
      const rect = this.liveRect()
      const origin = this.objectOrigin()
      return {
        x: clientX - rect.left - origin.x,
        y: clientY - rect.top - origin.y,
      }
    }

    /**
     * Mouse handler
     */
    onMouseMove(x, y) {
      this.updateMousePosition(x, y)
    }

    /**
     * Touch handler
     */
    onTouchMove(e) {
      if (this.draggedObject?.isDragging) e.preventDefault()

      const delta = performance.now() - this.lastTouch
      if (delta < frameDelta()) return

      const touch = e.touches[0]
      this.updateMousePosition(touch.clientX, touch.clientY)

      this.lastTouch = performance.now()
    }

    /**
     * Update mouse position
     */
    updateMousePosition(x, y) {
      const { mouse } = this

      mouse.x = x - this.bounding.left
      mouse.y = y - mouse.oy + window.scrollY

      if (!mouse.set) {
        mouse.sx = mouse.x
        mouse.sy = mouse.y

        mouse.set = true
      }
    }

    /**
     * Resize handler
     */
    onResize() {
      this.setSize()
      this.setScroll()
      this.setLines()
      this.setDots()
    }

    /**
     * Scroll handler
     */
    onScroll(_scrollY?: number) {
      const { scroll } = this

      // 行程一律用实时几何：load 后字体与懒加载图片会继续撑高上方内容，
      // init 时缓存的 start/end 会陈旧，导致行程未滚先满、
      // 卷底大字「我的路」的涌出动效直接定格在终点（看起来不会动了）
      const rect = this.el.getBoundingClientRect()
      const total = rect.height + window.safeHeight

      scroll.p = Math.min(
        1,
        Math.max(0, (window.safeHeight - rect.top) / total)
      )

      // 顺带刷新指针坐标换算的锚点，防止布局漂移后拖拽/细看落点偏移
      if (this.bounding) {
        this.bounding.left = rect.left
        this.bounding.top = rect.top
      }
      if (this.mouse) {
        this.mouse.oy = rect.top + window.scrollY
      }

      if (scroll.p > 0.58 && !this.ecosystemLaunched && this.canThrow) {
        this.launchEcosystemCards()
      }
    }

    /**
     * Set size
     */
    setSize() {
      const bounding = this.el.getBoundingClientRect()

      this.bounding = {
        left: bounding.left,
        top: bounding.top,
        width: bounding.width,
        height: bounding.height,
      }

      this.svg.style.width = this.bounding.width + 'px'
      this.svg.style.height = this.bounding.height + 'px'

      if (this.fieldCanvas && this.fieldCtx) {
        const dpr = Math.min(window.devicePixelRatio || 1, 2)
        this.fieldCanvas.width = Math.round(this.bounding.width * dpr)
        this.fieldCanvas.height = Math.round(this.bounding.height * dpr)
        this.fieldCtx.setTransform(dpr, 0, 0, dpr, 0, 0)
      }

      this.smiley.bounding = this.smiley.el.getBoundingClientRect()
      this.smiley.rel.x =
        this.smiley.bounding.left -
        this.bounding.left +
        this.smiley.bounding.width / 2
      this.smiley.rel.y =
        this.smiley.bounding.top -
        this.bounding.top +
        this.smiley.bounding.height / 2

      this.mouse.oy = this.bounding.top + window.scrollY

      // Safari hack :(
      const pOriginY = this.ruler.clientHeight
      this.objectsWrapper.style.perspectiveOrigin = `50% ${pOriginY}px `
    }

    /**
     * Set scroll
     */
    setScroll() {
      this.scroll = { p: 0, sp: 0 }

      this.onScroll()
      this.scroll.sp = this.scroll.p
    }

    /**
     * Set lines
     */
    setLines() {
      const { lines, smiley, bounding } = this

      // Lines
      lines.lines = []

      const vLines = window.safeWidth > 767 ? 10 : 6
      const gapX = bounding.width / vLines

      for (let i = 0; i <= vLines; i++) {
        // Top lines
        lines.lines.push({
          p1: { x: gapX * i, y: 0 },
          p2: { x: smiley.rel.x, y: smiley.rel.y },
        })

        // Bottom lines
        lines.lines.push({
          p1: { x: gapX * i, y: bounding.height },
          p2: { x: smiley.rel.x, y: smiley.rel.y },
        })
      }

      // Calculate angle
      const dx = bounding.width
      const dy = (bounding.height - smiley.rel.y) / 2

      this.el.style.setProperty(
        '--distortion',
        String(Math.hypot(dx, dy) * 0.14)
      )

      // Side lines
      const hLines = vLines
      const gapY = bounding.height / hLines
      const offsetY = (bounding.height - gapY * hLines) / 2

      for (let i = 1; i < hLines; i++) {
        // Left lines
        lines.lines.push({
          p1: { x: 0, y: offsetY + gapY * i },
          p2: { x: smiley.rel.x, y: smiley.rel.y },
        })

        // Right lines
        lines.lines.push({
          p1: { x: bounding.width, y: offsetY + gapY * i },
          p2: { x: smiley.rel.x, y: smiley.rel.y },
        })
      }

      this.drawLines()
    }

    /**
     * Draw lines
     */
    drawLines() {
      const { lines, bounding } = this

      let d = `M 0 ${bounding.height} L ${bounding.width} ${bounding.height}`

      lines.lines.forEach((line) => {
        d += `M ${line.p1.x} ${line.p1.y} L ${line.p2.x} ${line.p2.y} `
      })

      lines.circularPath.setAttribute('d', d)
    }

    /**
     * 背景点阵：垫在辐射线后面，指针近处微微让开
     */
    setDots() {
      const { bounding } = this
      if (!bounding?.width || !bounding.height) return

      const gap = bounding.width < 720 ? 42 : 32
      const cols = Math.ceil(bounding.width / gap) + 1
      const rows = Math.ceil(bounding.height / gap) + 1
      this.dots = []

      for (let i = 0; i <= cols; i++) {
        for (let j = 0; j <= rows; j++) {
          const ox = (i + (j % 2) * 0.5) * gap
          const oy = j * gap
          this.dots.push({
            x: ox,
            y: oy,
            ox,
            oy,
            p: (i * 13 + j * 7) * 0.017,
          })
        }
      }

      this.drawDots(performance.now())
    }

    drawDots(time: number) {
      const ctx = this.fieldCtx
      const { bounding, mouse, field, smiley } = this
      if (!ctx || !bounding?.width) return

      ctx.clearRect(0, 0, bounding.width, bounding.height)

      const mx = mouse.set ? mouse.sx : smiley.rel.x
      const my = mouse.set ? mouse.sy : smiley.rel.y
      const t = this.reduced ? 0 : time * 0.00018
      ctx.fillStyle =
        getComputedStyle(this.el).getPropertyValue('--color-secondary').trim() ||
        '#1c2a22'

      for (const dot of this.dots) {
        const n = this.reduced ? 0 : field.sample(dot.ox * 0.004 + t, dot.oy * 0.0035)
        let x = dot.ox + n * 6
        let y = dot.oy + n * 4
        const dx = x - mx
        const dy = y - my
        const d = Math.hypot(dx, dy)
        if (!this.reduced && d < 140 && d > 0.001) {
          const push = (1 - d / 140) ** 2 * 18
          x += (dx / d) * push
          y += (dy / d) * push
        }

        for (const ripple of this.ripples) {
          const t = (time - ripple.born) / 720
          if (t < 0 || t > 1) continue
          const waveR = 10 + t * 92
          const dd = Math.hypot(x - ripple.x, y - ripple.y)
          const band = Math.abs(dd - waveR)
          if (band < 28 && dd > 0.001) {
            const push = (1 - band / 28) * (1 - t) * 11
            x += ((x - ripple.x) / dd) * push
            y += ((y - ripple.y) / dd) * push
          }
        }

        const near = Math.max(0, 1 - d / 220)
        ctx.globalAlpha = 0.12 + near * 0.28
        ctx.beginPath()
        ctx.arc(x, y, 1.05 + near * 0.7, 0, Math.PI * 2)
        ctx.fill()
      }

      const accent =
        getComputedStyle(this.el).getPropertyValue('--color-accent').trim() ||
        '#c23a2b'
      ctx.strokeStyle = accent
      for (let i = this.ripples.length - 1; i >= 0; i--) {
        const ripple = this.ripples[i]
        const t = (time - ripple.born) / 720
        if (t >= 1) {
          this.ripples.splice(i, 1)
          continue
        }
        ctx.globalAlpha = (1 - t) * 0.3
        ctx.lineWidth = 1.15
        ctx.beginPath()
        ctx.arc(ripple.x, ripple.y, 10 + t * 92, 0, Math.PI * 2)
        ctx.stroke()
      }
      ctx.globalAlpha = 1
    }

    /**
     * Throw object
     */
    throwObject() {
      const pool =
        this.scroll.p > 0.58 && this.ecosystemObjects.length > 0
          ? this.ecosystemObjects
          : this.objects

      if (pool.length === 0) return

      const object = pool.splice(Math.floor(Math.random() * pool.length), 1)[0]

      object.set()

      this.thrownObjects.push(object)

      this.lastThrow = performance.now()

      const rate = window.safeWidth > 767 ? 1 : 2
      this.throwDelay = (500 + Math.random() * 500) * rate
    }

    /**
     * Launch ecosystem cards
     */
    launchEcosystemCards() {
      if (this.ecosystemLaunched || this.ecosystemObjects.length === 0) return

      this.ecosystemLaunched = true
      if (this.reduced) return

      const objects = [...this.ecosystemObjects]
      this.ecosystemObjects = []

      objects.forEach((object, index) => {
        const timer = window.setTimeout(() => {
          if (this.destroyed) return
          object.set()
          this.thrownObjects.push(object)
        }, index * 320)
        this.stops.push(() => clearTimeout(timer))
      })

      this.lastThrow = performance.now() + objects.length * 320
      this.throwDelay = 1800
    }

    /**
     * Initial objects
     */
    firstObjects() {
      if (this.reduced) {
        // 减弱动效仍要能细看：静静摆几帧在画面里，不飞、不自动抛
        const n = Math.min(3, this.objects.length)
        const gap = Math.min(220, window.safeWidth * 0.22)

        for (let i = 0; i < n; i++) {
          const object = this.objects.splice(
            Math.floor(Math.random() * this.objects.length),
            1
          )[0]

          object.set(false)
          object.isWaiting = false
          object.el.classList.remove('is-waiting')
          object.s = 1
          object.x = (i - (n - 1) / 2) * gap
          object.y = 36
          object.z = 120
          object.rx = 0
          object.ry = 0
          object.rz = 0
          object.vx = 0
          object.vy = 0
          object.vz = 0
          object.vrx = 0
          object.vry = 0
          this.thrownObjects.push(object)
          object.move(performance.now())
        }

        return
      }

      const totalObjects = Math.max(
        Math.min(Math.round(window.safeWidth * 0.025), 5),
        2
      )

      for (let i = 0; i < totalObjects; i++) {
        const object = this.objects.splice(
          Math.floor(Math.random() * this.objects.length),
          1
        )[0]

        object.set(false)

        this.thrownObjects.push(object)
      }
    }

    /**
     * 点空白纸面：墨圈破泡 / 远山近推由子组件自己听；
     * 这里只做本卷微感——点阵涟漪、罗盘一指、大字洇一下、纸雕近压。
     * 点在飞来物上不触发，以免抢走「轻点放大细看」。
     */
    onBlankClick(e: Event) {
      if (this.destroyed || this.reduced || !this.bounding) return

      const target = e.target as Element | null
      if (!target) return
      if (target.closest('.a-object, a, button, [role="button"], ink-sen3d')) return

      const ev = e as PointerEvent
      const rect = this.liveRect()
      const x = ev.clientX - rect.left
      const y = ev.clientY - rect.top

      this.ripples.push({ x, y, born: performance.now() })
      if (this.ripples.length > 5) this.ripples.shift()

      this.paperPress = 1
      this.catcherPulse = 1
      this.compassKick = 1
      this.el.classList.add('is-blank-pulse')

      if (target.closest('.js-smiley')) {
        this.compassAim = 0
      } else if (this.smiley.el) {
        const smile = this.smiley.el.getBoundingClientRect()
        const sx = smile.left + smile.width / 2
        const sy = smile.top + smile.height / 2
        this.compassAim =
          Math.atan2(ev.clientX - sx, -(ev.clientY - sy)) * (180 / Math.PI)
      }

      const tid = window.setTimeout(() => {
        if (this.destroyed) return
        this.el.classList.remove('is-blank-pulse')
      }, 520)
      this.pulseTimers.push(tid)
    }

    /**
     * 罗盘指向、大字倾侧、纸雕近压：每帧轻轻跟上
     */
    updateFeel() {
      const { mouse, smiley, el } = this

      if (this.inspectedObject?.el && smiley.el) {
        const o = this.inspectedObject.el.getBoundingClientRect()
        const s = smiley.el.getBoundingClientRect()
        const ox = o.left + o.width / 2
        const oy = o.top + o.height / 2
        const sx = s.left + s.width / 2
        const sy = s.top + s.height / 2
        const d = Math.hypot(ox - sx, oy - sy)
        if (d > 40) {
          this.compassAim = Math.atan2(ox - sx, -(oy - sy)) * (180 / Math.PI)
        }
      } else if (this.compassKick <= 0.02 && mouse.set && smiley.el && this.bounding) {
        const s = smiley.el.getBoundingClientRect()
        const sx = s.left + s.width / 2
        const sy = s.top + s.height / 2
        const mx = this.bounding.left + mouse.sx
        const my = this.bounding.top + mouse.sy
        this.compassAim = Math.atan2(mx - sx, -(my - sy)) * (180 / Math.PI)
      }

      let delta = this.compassAim - this.compassDeg
      delta = ((delta + 540) % 360) - 180
      const follow = this.compassKick > 0.02 ? 0.22 : 0.08
      this.compassDeg += delta * follow
      this.compassKick += (0 - this.compassKick) * 0.08
      smiley.el?.style.setProperty('--needle', this.compassDeg.toFixed(2) + 'deg')

      if (mouse.set && this.bounding?.width) {
        const nx = mouse.sx / this.bounding.width - 0.5
        const ny = mouse.sy / this.bounding.height - 0.5
        this.catcherRy += (nx * 9 - this.catcherRy) * 0.06
        this.catcherRx += (-ny * 4.4 - this.catcherRx) * 0.06
      }

      this.paperPress += (0 - this.paperPress) * 0.08
      this.catcherPulse += (0 - this.catcherPulse) * 0.1

      el.style.setProperty('--paper-press', this.paperPress.toFixed(3))
      el.style.setProperty('--catcher-pulse', this.catcherPulse.toFixed(3))
      el.style.setProperty('--catcher-rx', this.catcherRx.toFixed(3) + 'deg')
      el.style.setProperty('--catcher-ry', this.catcherRy.toFixed(3) + 'deg')
    }

    /**
     * Object move end
     */
    objectMoveEnd(object) {
      this.thrownObjects.splice(this.thrownObjects.indexOf(object), 1)

      if (object.el.classList.contains('a-object--ecosystem')) {
        this.ecosystemObjects.push(object)
      } else {
        this.objects.push(object)
      }

      // 减弱动效下细看后退场，再静静补一帧，保证还能点开
      if (
        this.reduced &&
        this.thrownObjects.length < 2 &&
        this.objects.length > 0
      ) {
        const next = this.objects.splice(
          Math.floor(Math.random() * this.objects.length),
          1
        )[0]
        next.set(false)
        next.isWaiting = false
        next.el.classList.remove('is-waiting')
        next.s = 1
        next.x = (Math.random() - 0.5) * Math.min(240, window.safeWidth * 0.3)
        next.y = 28
        next.z = 120
        next.rx = 0
        next.ry = 0
        next.rz = 0
        next.vx = 0
        next.vy = 0
        next.vz = 0
        next.vrx = 0
        next.vry = 0
        this.thrownObjects.push(next)
        next.move(performance.now())
      }
    }

    /**
     * Object drag start
     */
    objectDragStart(e) {
      if (e instanceof MouseEvent) e.preventDefault()

      this.lastTouch = performance.now()

      const startX = e.clientX ?? e.touches?.[0]?.clientX ?? 0
      const startY = e.clientY ?? e.touches?.[0]?.clientY ?? 0
      this.updateMousePosition(startX, startY)
      this.mouse.sx = this.mouse.x
      this.mouse.sy = this.mouse.y

      const el = e.currentTarget
      const object = this.thrownObjects.find((o) => o.el === el)

      if (!object || object.isDragging || object.isVanishing || object.dragPending)
        return

      this.draggedObject = object
      object.dragPending = true
      object.dragStartX = startX
      object.dragStartY = startY
    }

    /**
     * Object drag end
     */
    objectDragEnd(e) {
      const now = performance.now()
      if (now - this.lastDragEnd < 40) return
      this.lastDragEnd = now

      const object = this.draggedObject

      if (!object) {
        if (this.inspectedObject) this.dismissInspected()
        return
      }

      const endX =
        e.clientX ?? e.changedTouches?.[0]?.clientX ?? object.dragStartX
      const endY =
        e.clientY ?? e.changedTouches?.[0]?.clientY ?? object.dragStartY
      const dragDistance = Math.hypot(
        endX - object.dragStartX,
        endY - object.dragStartY
      )
      const isEcosystem = object.el.classList.contains('a-object--ecosystem')
      const wasDragging = object.isDragging

      object.dragPending = false
      object.isDragging = false
      object.el.classList.remove('is-dragging')
      this.draggedObject = null

      if (!wasDragging && dragDistance < 10) {
        if (isEcosystem) {
          const link = object.el.querySelector('a[href]')
          if (link instanceof HTMLAnchorElement) link.click()
          return
        }

        if (object.isInspecting) {
          this.dismissInspected()
        } else {
          if (this.inspectedObject) this.dismissInspected()
          this.inspectObject(object)
        }
        return
      }

      if (isEcosystem) return

      if (wasDragging) this.vanishObject(object)
    }

    /**
     * 细看：把物件请到画面中央放大端正呈现
     */
    inspectObject(object) {
      const { w: viewW, h: viewH } = this.viewportSize()

      // 放大倍率按视口归一：宽高双约束取小者（竖构图照片本体就很高，
      // 只按宽放大会溢出视口）。超高帧允许缩到完整可见。
      const baseW = object.el.offsetWidth || 500
      const baseH = object.el.offsetHeight || baseW
      const scale = Math.min(
        1.28,
        Math.max(
          0.52,
          Math.min((viewW * 0.46) / baseW, (viewH * 0.72) / baseH)
        )
      )

      // 细看用平面 scale，不再靠 translateZ 放大——透视拉近会把竖构图
      // 和梅花飞星撑出视口，bounding box 也无法预测。
      object.inspectScale = scale
      object.inspectZ = 48

      const world = this.clientToObject(viewW * 0.5, viewH * 0.5)
      const lim = Math.max(this.bounding.width, this.bounding.height) * 0.55
      object.inspectX = Math.max(-lim, Math.min(lim, world.x))
      object.inspectY = Math.max(-lim, Math.min(lim, world.y))
      object.isInspecting = true
      object.el.classList.add('is-inspecting')

      this.inspectedObject = object
    }

    /**
     * 结束细看：轻柔地以墨点消散送走
     */
    dismissInspected() {
      const object = this.inspectedObject
      if (!object) return

      this.inspectedObject = null
      object.isInspecting = false
      object.el.classList.remove('is-inspecting')

      this.vanishObject(object, true)
    }

    /**
     * 墨点消散退场；gentle 时只轻轻飘落，不加大旋转
     */
    vanishObject(object, gentle = false) {
      if (object.isInspecting || this.inspectedObject === object) {
        this.inspectedObject = null
        object.isInspecting = false
        object.el.classList.remove('is-inspecting')
      }

      object.isVanishing = true
      object.el.classList.add('is-vanishing')

      if (this.reduced) {
        object.vx = 0
        object.vy = 0
        object.vrx = 0
        object.vry = 0
        object.vanishDelay = 360
        object.vanishStart = performance.now()
        return
      }

      if (gentle) {
        object.vx *= 0.3
        object.vy = Math.min(object.vy * 0.3, 0) - 0.4
        object.vrx = 0.2 + Math.random() * 0.3
        object.vry = 0.2 + Math.random() * 0.3
      } else {
        // 甩出：松手瞬间继承甩动速度 + 加大旋转，形成抛物线飞出
        const flick = Math.hypot(object.flickVx, object.flickVy)
        if (flick > 1.5) {
          const boost = Math.min(2.2, 24 / flick)
          object.vx = object.flickVx * boost
          object.vy = object.flickVy * boost - 2
        }
        object.vrx = 1.5 + Math.random() * 2.5
        object.vry = 1.5 + Math.random() * 2.5
      }

      object.vanishStart = performance.now()
    }

    /**
     * Tick
     */
    tick(time) {
      const { scroll, el, mouse } = this

      if (this.reduced) {
        mouse.sx = mouse.x
        mouse.sy = mouse.y
        scroll.sp = scroll.p
        el.style.setProperty('--scroll-progress', String(scroll.sp))
        this.thrownObjects.forEach((object) => {
          object.move(time)
        })
        if (!this.isPaused) this.drawDots(time)
        return
      }

      // Smooth mouse movement
      mouse.sx += (mouse.x - mouse.sx) * 0.1
      mouse.sy += (mouse.y - mouse.sy) * 0.1

      const dx = mouse.x - mouse.sx
      const dy = mouse.y - mouse.sy
      mouse.d = Math.hypot(dx, dy)

      // Smooth scroll
      scroll.sp += (scroll.p - scroll.sp) * 0.1

      el.style.setProperty('--scroll-progress', String(scroll.sp))

      this.updateFeel()

      // Move objects
      this.thrownObjects.forEach((object) => {
        object.move(time)
      })

      if (!this.isPaused) this.drawDots(time)

      if (this.isPaused) return

      if (
        this.canThrow &&
        !this.inspectedObject &&
        !this.draggedObject &&
        time - this.lastThrow > this.throwDelay
      ) {
        this.throwObject()
      }
    }
  }

  class Object {
    el: HTMLElement
    parent: Section

    index: number
    delay: number
    throwTimeout: number
    vanishStart: number
    vanishDelay: number

    s: number
    x: number
    y: number
    z: number

    rx: number
    ry: number
    rz: number

    vx: number
    vy: number
    vz: number
    vrx: number
    vry: number

    isPaused: boolean
    isWaiting: boolean
    isDragging: boolean
    isVanishing: boolean
    isInspecting: boolean
    inspectX: number
    inspectY: number
    inspectZ: number
    inspectScale: number
    dragPending: boolean
    dragStartX: number
    dragStartY: number
    flickVx: number
    flickVy: number
    prevX: number | null
    prevY: number | null

    /**
     * Constructor
     */
    constructor(el, parent) {
      this.parent = parent
      this.el = el

      this.index = Array.from(this.el.parentNode.children).indexOf(this.el)
    }

    /**
     * Set position
     */
    set(fromScratch = true) {
      this.el.style.setProperty('--size', String(0.5 + Math.random() * 0.5))

      this.s = 0

      this.x = 0
      this.y = 0
      this.z = -20000

      this.rx = 90
      this.ry = Math.random() * 2 - 1
      this.rz = 0

      this.vz = 22 + Math.random() * 8
      this.vx =
        Math.random() * window.safeWidth * 0.0025 * (this.index % 2 ? -1 : 1)
      this.vy =
        Math.random() * window.safeHeight * 0.0025 * (this.index % 3 ? -1 : 1)
      this.vrx = 0.18 + Math.random() * 0.6
      this.vry = 0.18 + Math.random() * 0.6

      // Ecosystem cards drift in a tighter, more readable formation
      if (this.el.classList.contains('a-object--ecosystem')) {
        const spread = (this.index % 6) - 2.5

        this.vx = spread * window.safeWidth * 0.0018
        this.vy =
          window.safeHeight * 0.0015 +
          Math.random() * window.safeHeight * 0.001
        this.vz = 20 + Math.random() * 5
        this.vrx = 0.12 + Math.random() * 0.25
        this.vry = 0.12 + Math.random() * 0.25
      }

      this.isWaiting = false
      this.isDragging = false
      this.isVanishing = false
      this.isInspecting = false
      this.inspectX = 0
      this.inspectY = 0
      this.inspectZ = 0
      this.inspectScale = 1
      this.dragPending = false
      this.dragStartX = 0
      this.dragStartY = 0
      this.flickVx = 0
      this.flickVy = 0
      this.prevX = null
      this.prevY = null

      this.el.classList.remove('is-waiting')
      this.el.classList.remove('is-dragging')
      this.el.classList.remove('is-vanishing')
      this.el.classList.remove('is-inspecting')

      this.vanishStart = 0
      this.vanishDelay = 900

      if (!fromScratch) {
        this.isWaiting = true

        this.s = 1

        this.x = this.vx * Math.random() * 200
        this.y = this.vy * Math.random() * 200

        this.rx = Math.random() * 360
        this.ry = Math.random() * 360

        this.z = Math.random() * -20000
      }

      this.el.style.setProperty('--s', String(this.s))
    }

    /**
     * Tick
     */
    move(time) {
      if (this.isWaiting) return

      if (this.dragPending && this.parent.draggedObject === this) {
        const startX = this.dragStartX - this.parent.bounding.left
        const startY = this.dragStartY - this.parent.bounding.top
        const dist = Math.hypot(
          this.parent.mouse.x - startX,
          this.parent.mouse.y - startY
        )
        if (dist > 10) {
          this.dragPending = false
          if (this.isInspecting) {
            this.isInspecting = false
            this.el.classList.remove('is-inspecting')
            if (this.parent.inspectedObject === this) {
              this.parent.inspectedObject = null
            }
          }
          this.isDragging = true
          this.el.classList.add('is-dragging')
        }
      }

      if (this.isDragging) {
        const origin = this.parent.objectOrigin()
        const x = this.parent.mouse.x - origin.x
        const y = this.parent.mouse.y - origin.y

        this.vx += (x - this.x) * 0.075
        this.vy += (y - this.y) * 0.075
        this.vz += (0 - this.z) * 0.3

        this.ry = this.vx * 0.15
        this.rx = this.vy * -0.15
        this.rz = this.ry + this.rx

        this.vx *= 0.9
        this.vy *= 0.9
        this.vz *= 0.75

        // 记录甩动速度（松手时作为初速度飞出）
        this.prevX ??= this.x
        this.prevY ??= this.y
        this.flickVx = this.flickVx * 0.6 + (this.x - this.prevX) * 0.4
        this.flickVy = this.flickVy * 0.6 + (this.y - this.prevY) * 0.4
        this.prevX = this.x
        this.prevY = this.y

        this.x += this.vx * 0.5
        this.y += this.vy * 0.5
        this.z += this.vz * 0.25

        this.z = Math.min(this.z, 500)

        this.s += (1 - this.s) * 0.5
      } else if (this.isInspecting) {
        // 细看：弹簧飞至画面中央，端正放大，轻微呼吸浮动
        if (this.parent.reduced) {
          this.x = this.inspectX
          this.y = this.inspectY
          this.z = this.inspectZ
          this.rx = Math.round(this.rx / 360) * 360
          this.ry = Math.round(this.ry / 360) * 360
          this.rz = 0
          this.s = this.inspectScale || 1
        } else {
          this.x += (this.inspectX - this.x) * 0.14
          this.y +=
            (this.inspectY - this.y) * 0.14 + Math.sin(time * 0.0016) * 0.35
          this.z += (this.inspectZ - this.z) * 0.18
          this.z = Math.min(this.z, 160)
          this.vx *= 0.7
          this.vy *= 0.7
          this.vz = 0

          // 转回正面（就近归零，不多转圈）
          this.rx += (Math.round(this.rx / 360) * 360 - this.rx) * 0.16
          this.ry += (Math.round(this.ry / 360) * 360 - this.ry) * 0.16
          this.rz += (0 - this.rz) * 0.16

          this.s += ((this.inspectScale || 1) - this.s) * 0.22
        }
      } else if (this.isVanishing) {
        if (this.parent.reduced) {
          this.s += (0 - this.s) * 0.22
          if (time - this.vanishStart > this.vanishDelay) {
            this.isWaiting = true
            this.el.classList.add('is-waiting')
            this.parent.objectMoveEnd(this)
          }
        } else {
          this.vy += 0.5

          this.x += this.vx
          this.y += this.vy

          this.rx += this.vrx
          this.ry += this.vry

          if (time - this.vanishStart > this.vanishDelay) {
            this.isWaiting = true
