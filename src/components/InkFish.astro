---
/**
 * InkFish — 水墨游鱼（两条，一浓一淡）
 * 「鱼戏莲叶间」意象：浓墨点身、飞白尾鳍，缓游时尾鳍轻摆。
 * 纯 transform/opacity 动画，不用 filter；currentColor 取色。
 */
type Props = {
  size?: number
  class?: string
}

const { size = 180, class: className } = Astro.props
---

<div
  class:list={['ink-fish', className]}
  style={`width:${size}px;height:${size * 0.62}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 200 124">
    {/* 远鱼：淡墨，小 */}
    <g class="ink-fish__one ink-fish__one--far">
      <path
        class="ink-fish__body"
        d="M28 62 C44 42 78 34 104 40 C126 45 140 56 146 62 C140 68 126 79 104 84 C78 90 44 82 28 62 Z"
      ></path>
      <path
        class="ink-fish__tail"
        d="M28 62 C18 54 10 48 2 44 C8 56 8 68 2 80 C10 76 18 70 28 62 Z"></path>
      <path class="ink-fish__fin" d="M96 40 Q104 30 118 28 Q110 38 108 42"></path>
      <circle class="ink-fish__eye" cx="140" cy="58" r="1.9"></circle>
    </g>

    {/* 近鱼：浓墨，大 */}
    <g class="ink-fish__one ink-fish__one--near">
      <path
        class="ink-fish__body"
        d="M46 92 C64 70 102 60 132 68 C156 74 172 86 180 92 C172 99 156 111 132 117 C102 124 64 114 46 92 Z"
      ></path>
      <path
        class="ink-fish__tail"
        d="M46 92 C34 83 24 76 14 71 C21 85 21 99 14 113 C24 108 34 101 46 92 Z"></path>
      <path class="ink-fish__fin" d="M122 68 Q132 56 148 54 Q138 66 136 71"></path>
      <circle class="ink-fish__eye" cx="172" cy="87" r="2.2"></circle>
      <path class="ink-fish__whisker" d="M178 96 Q188 100 194 108"></path>
    </g>
  </svg>
</div>

<style lang="scss">
  .ink-fish {
    position: absolute;
    pointer-events: none;

    svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
    }
  }

  .ink-fish__one {
    transform-box: fill-box;
    transform-origin: center;

    animation: fishDrift 18s ease-in-out infinite;
  }

  .ink-fish__one--near {
    animation-duration: 23s;
    animation-delay: -6s;
  }

  .ink-fish__body {
    fill: color(secondary);
    opacity: 0.22;
  }

  .ink-fish__tail {
    fill: color(secondary);
    opacity: 0.14;

    transform-box: fill-box;
    transform-origin: right center;

    animation: fishTail 2.6s ease-in-out infinite;
  }

  .ink-fish__one--near {
    .ink-fish__body {
      opacity: 0.3;
    }

    .ink-fish__tail {
      opacity: 0.2;
      animation-duration: 3.2s;
    }

    .ink-fish__fin {
      opacity: 0.24;
    }
  }

  .ink-fish__fin {
    fill: color(secondary);
    opacity: 0.16;
  }

  .ink-fish__eye {
    fill: color(accent);
    opacity: 0.7;
  }

  .ink-fish__whisker {
    fill: none;
    stroke: color(secondary);
    stroke-width: 1.2;
    stroke-linecap: round;
    opacity: 0.2;
  }

  @keyframes fishDrift {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(-26px, -8px, 0);
    }
  }

  @keyframes fishTail {
    0%,
    100% {
      transform: rotate(-7deg);
    }
    50% {
      transform: rotate(7deg);
    }
  }

  :global(.theme-contrasted) {
    .ink-fish__body {
      opacity: 0.34;
    }

    .ink-fish__tail,
    .ink-fish__fin {
      opacity: 0.24;
    }

    .ink-fish__one--near {
      .ink-fish__body {
        opacity: 0.42;
      }

      .ink-fish__tail {
        opacity: 0.3;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-fish__one,
    .ink-fish__tail {
      animation: none;
    }
  }
</style>
