---
import InkMountains from './InkMountains.astro'
import InkBamboo from './InkBamboo.astro'
import SenMark from './SenMark.astro'

// Awards are nice, but they’re not the goal.
// Focus on building quality projects, enjoying the process, and staying curious—that’s what really matters.
// Some amazing builders never win anything, while lucky ones sometimes do. Awards are a niche, not a universal measure of value.
// Stay sharp, stay honest, and keep having fun.
const awards = {
  counters: {
    informatics: {
      name: '信息学',
      counters: ['CSP-J 贰等', 'NOC 一等奖'],
    },
    maker: {
      name: '创客',
      counters: ['智造三等奖', '车辆模型二等奖'],
    },
    school: {
      name: '全国',
      counters: ['希望颂一等奖', 'NOC 三等奖'],
    },
  },
  texts: {
    informaticsLead: '2024<br/>CSP-J 入门级贰等<br/>中国计算机学会',
    schoolTech: '2024<br/>AI 算法设计二等奖<br/>Python 初中组',
    schoolEnglish: '2025<br/>希望颂书画一等奖<br/>软笔书法初中组',
    makerZhizao: '2024<br/>创客新星<br/>三等奖<br/>趣味智造初中组',
    makerVehicle: '2024<br/>车辆模型二等奖<br/>四驱车拼装竞速中学组',
  },
}

const skills = ['AI', 'TypeScript', 'Games', 'Python', 'Web']
---

<section id="about" class="s-about" data-intersect>
  <InkMountains compact />
  <InkBamboo class="s__bamboo" size={300} />
  <div class="s__inner js-inner">
    <span class="s__cord s__cord--left" aria-hidden="true"></span>
    <span class="s__cord s__cord--right" aria-hidden="true"></span>
    <div class="s__rod s__rod--sky" aria-hidden="true"></div>

    <div class="s__block s__block--about">
      <h2 class="s__title">关于</h2>

      <div class="s__content">
        <p>正在探索 AI、交互与游戏开发的初中生。把少年时的好奇，写进可运行的光里。</p>

        <p>
          个人空间收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。
        </p>

        <p>
          从 Python 到 TypeScript
          全栈，从本地脚本到可部署的产品——每一步都追求能展示、能维护、能迭代。
        </p>

        <p>
          这个站点是长期作品：作品集、文章、实验游戏与班级空间，全部跑在同一套
          monorepo 里。
        </p>

        <p class="s__now">
          正在把 AI 实验、交互练习和班级记忆整理成一条更清晰的河流。
        </p>

        <ul class="s__skills">
          {skills.map((skill) => <li class="s__skill">{skill}</li>)}
        </ul>
      </div><!-- .s__content -->
    </div><!-- .s__block -->

    <div class="s__block s__block--awards">
      <h2 class="s__title">荣誉</h2>

      <ul class="s__awards">
        {
          Object.entries(awards.counters).map(([award, data]) => (
            <li
              class={`s__award s__award--counter s__award--${award} js-award`}
            >
              <span class="s__award__inner">
                <span class="s__award__name">{data.name}</span>
                {data.counters.map((counter) => (
                  <span class="s__award__counter">({counter})</span>
                ))}
              </span>

              <span class="s__award__mask" />
            </li>
          ))
        }

        {
          Object.entries(awards.texts).map(([award, text]) => (
            <li class={`s__award s__award--text s__award--${award} js-award`}>
              <span class="s__award__inner">
                <span class="s__award__text" set:html={text} />
              </span>

              <span class="s__award__mask" />
            </li>
          ))
        }

        <li class="s__award s__award--blank">
            <span class="s__blank__inner" aria-hidden="true">
              <SenMark size={54} />
              <i class="s__blank__note">虚位以待<br />下一件作品</i>
            </span>
          </li>

      </ul><!-- .s__content -->

      <a class="s__awards-more" href="/honors">
        <span class="s__awards-more__label">奖状原件与完整记录</span>
        <span class="s__awards-more__arrow" aria-hidden="true">荣誉页 →</span>
      </a>
    </div><!-- .s__block -->

    <div class="s__rod s__rod--earth" aria-hidden="true"></div>
  </div><!-- .s__inner -->

  <svg class="s__grid js-grid">
    <path class="js-path" d=""></path>
  </svg>

  <canvas class="s__canvas js-canvas" aria-hidden="true"></canvas>
</section>

<script>
  import {
    whenReady,
    onFrame,
    onResize,
    onScroll,
    onPointer,
    prefersReducedMotion,
    type Cleanup,
  } from '../motion/core'
  import {
    loadCharmImages,
    spawnCharmBurst,
    stepCharm,
    drawCharm,
    isContrastedTheme,
    type CharmBody,
    type CharmImages,
  } from '../motion/charms'

  class Section {
    el: HTMLElement
    inner: HTMLElement
    svg: HTMLElement
    path: HTMLElement
    canvas: HTMLCanvasElement
    ctx: CanvasRenderingContext2D
    awards: NodeListOf<HTMLElement>

    bounding: {
      left: number
      top: number
      width: number
      height: number
      innerWidth: number
      innerHeight: number
      offsetY: number
    }

    scroll: {
      start: number
      end: number
      p: number
      sp: number
    }

    lines: any[]
    charms: CharmBody[]
    charmImages: CharmImages
    reduced: boolean

    /** 指针视差：归一化目标 / 平滑值（视口中心为 0） */
    par = { x: 0, y: 0, sx: 0, sy: 0, active: false }
    hotAward: HTMLElement | null = null

    isPaused: boolean
    isForced: boolean
    lastWidth: number
    stops: Cleanup[] = []
    unframe: Cleanup | null = null
    observer: IntersectionObserver | null = null
    destroyed = false
    awardCleanups: Cleanup[] = []
    awardTimers: number[] = []
    heightObserver: ResizeObserver | null = null
    revealRaf = 0

    /**
     * Constructor
     */
    constructor() {
      // Elements
      this.el = document.querySelector('.s-about')

      if (!this.el) {
        return
      }

      this.inner = this.el.querySelector('.js-inner')
      this.svg = this.el.querySelector('.js-grid')
      this.path = this.el.querySelector('.js-path')
      this.canvas = this.el.querySelector('.js-canvas')
      this.ctx = this.canvas ? this.canvas.getContext('2d') : null
      this.awards = this.el.querySelectorAll('.js-award')

      // Properties
      this.lines = []
      this.charms = []
      this.charmImages = loadCharmImages()
      this.reduced = prefersReducedMotion()

      this.isPaused = true
      this.isForced = false
      this.lastWidth = window.innerWidth

      whenReady(() => this.init())
    }

    viewWidth() {
      return window.safeWidth || window.innerWidth || 0
    }

    viewHeight() {
      return window.safeHeight || window.innerHeight || 0
    }

    axisRange() {
      return this.viewWidth() > 767 ? 400 : 200
    }

    isSectionVisible() {
      if (!this.el) return false
      if (this.el.classList.contains('is-in-view')) return true
      const rect = this.el.getBoundingClientRect()
      const vh = this.viewHeight()
      return rect.bottom > 0 && rect.top < vh
    }

    /**
     * 立轴位移：先写 CSS 变量再画网格，避免首帧 offsetY=0 再跳变。
     * safeHeight 未就绪时回退 innerHeight，杜绝 --offset-y: NaNpx。
     */
    syncAxis(immediate = false) {
      if (!this.el || !this.bounding) return

      if (this.reduced) {
        this.bounding.offsetY = 0
        this.el.style.removeProperty('--offset-y')
        this.el.style.removeProperty('--par-x')
        this.el.style.removeProperty('--par-y')
        return
      }

      if (immediate) this.scroll.sp = this.scroll.p
      const next = this.axisRange() * (this.scroll.sp * 2 - 1)
      this.bounding.offsetY = Number.isFinite(next) ? next : 0
      this.el.style.setProperty('--offset-y', `${this.bounding.offsetY}px`)
    }

    applyReduced(on: boolean) {
      this.reduced = on
      if (!this.el) return

      if (on) {
        this.el.classList.remove('is-armed')
        this.awards?.forEach((award) => award.classList.add('is-revealed'))
        this.charms = []
        this.par.x = this.par.y = this.par.sx = this.par.sy = 0
        this.par.active = false
        if (this.bounding) this.bounding.offsetY = 0
        this.el.style.removeProperty('--offset-y')
        this.el.style.removeProperty('--par-x')
        this.el.style.removeProperty('--par-y')
        if (this.ctx && this.bounding) {
          this.ctx.clearRect(0, 0, this.bounding.width, this.bounding.height)
        }
        this.setLines()
        this.stopFrame()
        return
      }

      this.el.classList.add('is-armed')
      this.setScroll()
      this.syncAxis(true)
      this.isForced = true
      if (!this.isPaused) this.startFrame()
    }

    revealVisibleAwards() {
      if (this.destroyed || !this.awards) return
      const vh = this.viewHeight()
      this.awards.forEach((award) => {
        const box = award.getBoundingClientRect()
        if (box.top < vh && box.bottom > 0) {
          award.classList.add('is-revealed')
          this.throwCharms(award, true)
        }
      })
    }

    /**
     * Init
     */
    init() {
      if (this.destroyed || !this.el) return

      try {
        this.setSize()
        this.setScroll()
        this.syncAxis(true)
        this.setLines()

        this.bindEvents()

        /* 观察者就位后再武装遮罩：绑失败时荣誉格仍保持默认可读 */
        if (this.reduced) {
          this.awards?.forEach((award) => award.classList.add('is-revealed'))
        } else {
          this.el.classList.add('is-armed')
        }

        if (this.isSectionVisible() && this.isPaused) {
          this.isPaused = false
          if (!this.reduced) this.startFrame()
        }

        this.revealRaf = requestAnimationFrame(() => {
          this.revealRaf = 0
          if (this.destroyed) return
          this.revealVisibleAwards()
        })

        /* 已入视却没被观察者揭开的格子：2.8s 后强制显影，防荣誉格白屏 */
        this.awardTimers.push(
          window.setTimeout(() => {
            if (this.destroyed) return
            this.revealVisibleAwards()
          }, 2800)
        )
      } catch (error) {
        this.el.classList.remove('is-armed')
        this.awards?.forEach((award) => award.classList.add('is-revealed'))
        console.error('[s-about] init failed:', error)
      }
    }

    /**
     * Bind events
     */
    bindEvents() {
      if (this.destroyed || !this.el) return

      this.stops.push(
        onResize(({ width }) => {
          if (this.destroyed) return
          const widthChanged = width !== this.lastWidth
          this.lastWidth = width
          this.onResize(widthChanged)
        })
      )
      this.stops.push(
        onScroll(() => {
          if (this.destroyed) return
          this.onScroll()
        })
      )
      this.stops.push(
        onPointer(({ x, y }) => {
          if (this.destroyed || this.reduced) return
          this.par.x = (x / window.innerWidth) * 2 - 1
          this.par.y = (y / window.innerHeight) * 2 - 1
          this.par.active = true

          if (this.hotAward) {
            const box = this.hotAward.getBoundingClientRect()
            if (box.width > 0) {
              const sheen = Math.min(1, Math.max(0, (x - box.left) / box.width))
              this.hotAward.style.setProperty('--award-sheen', sheen.toFixed(3))
            }
          }

          if (!this.isPaused && !this.unframe) this.startFrame()
        })
      )

      const mq = window.matchMedia('(prefers-reduced-motion: reduce)')
      const onMq = () => this.applyReduced(mq.matches)
      if (typeof mq.addEventListener === 'function') {
        mq.addEventListener('change', onMq)
        this.stops.push(() => mq.removeEventListener('change', onMq))
      } else {
        mq.addListener(onMq)
        this.stops.push(() => mq.removeListener(onMq))
      }

      const observer = (this.observer = new IntersectionObserver(
        (entries) => {
          if (this.destroyed) return
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const award = entry.target as HTMLElement
              award.classList.add('is-revealed')
              this.throwCharms(award, true)
              observer.unobserve(award)
            }
          })
        },
        {
          threshold: 0.08,
          rootMargin: '0px 0px -4% 0px',
        }
      ))

      this.awards.forEach((award) => {
        observer.observe(award)

        const onEnter = () => {
          this.hotAward = award
          this.onAwardInteraction(award)
        }
        const onLeave = () => {
          if (this.hotAward === award) this.hotAward = null
          award.style.removeProperty('--award-sheen')
        }
        award.addEventListener('pointerenter', onEnter, { passive: true })
        award.addEventListener('pointerleave', onLeave, { passive: true })
        this.awardCleanups.push(() => {
          award.removeEventListener('pointerenter', onEnter)
          award.removeEventListener('pointerleave', onLeave)
          award.style.removeProperty('--award-sheen')
        })
      })

      this.el.addEventListener('intersect', this.onIntersect, {
        passive: true,
      })
      this.stops.push(() =>
        this.el.removeEventListener('intersect', this.onIntersect)
      )

      if (typeof ResizeObserver === 'function') {
        this.heightObserver = new ResizeObserver(() => {
          if (this.destroyed) return
          this.setSize()
          this.setScroll()
          this.syncAxis(true)
          this.isForced = true
          if (this.reduced) this.setLines()
          else if (!this.isPaused) this.startFrame()
        })
        this.heightObserver.observe(this.el)
        this.stops.push(() => this.heightObserver?.disconnect())
      }
    }

    startFrame() {
      if (this.destroyed || this.unframe) return
      this.unframe = onFrame(() => this.tick())
    }

    stopFrame() {
      this.unframe?.()
      this.unframe = null
    }

    /**
     * SPA 换页收尾：帧循环、信号订阅、观察者全部摘除，
     * 否则旧实例会永远在已销毁的 DOM 上空转
     */
    destroy() {
      this.destroyed = true
      this.stopFrame()
      if (this.revealRaf) {
        cancelAnimationFrame(this.revealRaf)
        this.revealRaf = 0
      }
      this.stops.forEach((stop) => {
        try {
          stop()
        } catch (e) {}
      })
      this.stops = []
      this.awardCleanups.forEach((stop) => {
        try {
          stop()
        } catch (e) {}
      })
      this.awardCleanups = []
      this.awardTimers.forEach((id) => clearTimeout(id))
      this.awardTimers = []
      this.observer?.disconnect()
      this.observer = null
      this.heightObserver?.disconnect()
      this.heightObserver = null
      this.hotAward = null
      this.charms = []
      this.par.x = this.par.y = this.par.sx = this.par.sy = 0
      this.par.active = false
      this.el?.classList.remove('is-armed')
      this.el?.style.removeProperty('--offset-y')
      this.el?.style.removeProperty('--par-x')
      this.el?.style.removeProperty('--par-y')
      this.awards?.forEach((award) => {
        award.style.removeProperty('--award-sheen')
        award.classList.remove('is-active')
      })
      this.path?.setAttribute('d', '')
      if (this.ctx && this.bounding) {
        this.ctx.clearRect(0, 0, this.bounding.width, this.bounding.height)
      }
    }

    /**
     * Resize handler
     */
    onResize(widthChanged: boolean) {
      if (!widthChanged) return
      this.setSize()
      this.setScroll()
      this.syncAxis(true)
      this.isForced = true
      if (this.reduced) this.setLines()
      else if (!this.isPaused) this.startFrame()
    }

    /**
     * Scroll handler
     */
    onScroll(_scrollY?: number) {
      const { scroll } = this
      if (!this.el || !scroll) return

      const rect = this.el.getBoundingClientRect()
      const vh = this.viewHeight()
      const total = rect.height + vh
      if (!(total > 0)) {
        scroll.p = 0
        return
      }

      const next = (vh - rect.top) / total
      scroll.p = Math.min(1, Math.max(0, Number.isFinite(next) ? next : 0))
    }

    /**
     * Intersect handler —— 只管帧循环，不一次揭开全部荣誉格
     */
    onIntersect = (e: CustomEvent) => {
      if (this.destroyed) return
      this.isPaused = !e.detail.isIntersecting

      if (e.detail.isIntersecting) {
        this.setScroll()
        this.syncAxis(true)
        this.isForced = true
        if (!this.reduced) this.startFrame()
      }

      if (this.isPaused && !this.charms.length) this.stopFrame()
      else if (!this.reduced) this.startFrame()
    }

    /**
     * Award interaction handler
     */
    onAwardInteraction(award: HTMLElement) {
      if (this.destroyed || this.reduced) return
      award.classList.add('is-active')

      this.throwCharms(award, false)

      const timer = window.setTimeout(() => {
        this.awardTimers = this.awardTimers.filter((id) => id !== timer)
        if (this.destroyed) return
        award.classList.remove('is-active')
      }, 180)
      this.awardTimers.push(timer)
    }

    /**
     * 抛彩头：笑脸为主，混入铜钱 / 梅花 / 朱砂印 / 墨星
     */
    throwCharms(award: HTMLElement, once = false) {
      const { el, charms, bounding } = this
      if (this.destroyed || !this.ctx || this.reduced || !el) return
      if (once) {
        if (award.dataset.charmBurst === '1') return
        award.dataset.charmBurst = '1'
      } else {
        const now = performance.now()
        const last = Number(award.dataset.charmAt || 0)
        if (now - last < 480) return
        award.dataset.charmAt = String(now)
      }

      const elBounding = el.getBoundingClientRect()
      const awardBounding = award.getBoundingClientRect()

      const x = awardBounding.left + awardBounding.width * 0.5 - elBounding.left
      const y = awardBounding.top + awardBounding.height * 0.35 - elBounding.top
      const floor = awardBounding.bottom - elBounding.top + 8
      const wide = this.viewWidth() > 767
      const count = once ? (wide ? 8 : 5) : wide ? 6 : 4
      const cap = 26
      if (charms.length + count > cap) {
        charms.splice(0, charms.length + count - cap)
      }
      const fallback = bounding?.height ? bounding.height * 0.7 : 240

      charms.push(...spawnCharmBurst(x, y, count, floor || fallback))
      this.startFrame()
    }
    /**
     * Set size
     */
    setSize() {
      const { canvas, ctx, svg } = this
      if (!this.el || !this.inner) return

      const bounding = this.el.getBoundingClientRect()

      this.bounding = {
        left: bounding.left,
        top: bounding.top,
        width: this.el.clientWidth,
        height: this.el.clientHeight,
        innerWidth: this.inner.clientWidth,
        innerHeight: this.inner.clientHeight,
        offsetY: this.bounding?.offsetY ?? 0,
      }

      if (svg) {
        svg.style.width = `${this.bounding.width}px`
        svg.style.height = `${this.bounding.height}px`
      }

      if (canvas && ctx) {
        const dpr = Math.min(window.devicePixelRatio || 1, 2)
        canvas.width = Math.round(this.bounding.width * dpr)
        canvas.height = Math.round(this.bounding.height * dpr)
        canvas.style.width = `${this.bounding.width}px`
        canvas.style.height = `${this.bounding.height}px`
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      }
    }

    /**
     * Set scroll — 行程用实时几何（对齐 SMyWay），避免字体/懒图撑高后陈旧
     */
    setScroll() {
      this.scroll = { start: 0, end: 0, p: 0, sp: 0 }
      this.onScroll(window.scrollY)
      this.scroll.sp = this.scroll.p
    }

    /**
     * Set lines
     */
    setLines() {
      const { bounding } = this
      if (!bounding || !this.el || !this.inner) return

      this.lines = []

      if (!(bounding.width > 0) || !(bounding.height > 0)) return

      /* 按立轴实绘位置取样，与 translate/rotate 对齐，不再另加一套 lean */
      const elBox = this.el.getBoundingClientRect()
      const innerBox = this.inner.getBoundingClientRect()
      let innerX = innerBox.left - elBox.left
      let innerY = innerBox.top - elBox.top
      let innerW = innerBox.width
      let innerH = innerBox.height

      if (innerW < 8 || innerH < 8) {
        const leanX = this.reduced ? 0 : this.par.sx * 12
        innerX = (bounding.width - bounding.innerWidth) / 2 + leanX
        innerY =
          (bounding.height - bounding.innerHeight) / 2 + (bounding.offsetY || 0)
        innerW = bounding.innerWidth
        innerH = bounding.innerHeight
      }

      const vLines = this.viewWidth() > 767 ? 12 : 8
      const hLines = 4

      const outerGapX = bounding.width / vLines
      const outerGapY = bounding.height / vLines
      const innerGapX = innerW / vLines
      const innerGapY = innerH / vLines
      const hGap = 1 / hLines

      // Corner lines
      const outer = {
        x1: 0,
        x2: bounding.width,
        y1: 0,
        y2: bounding.height,
      }
      const inner = {
        x1: innerX,
        x2: innerX + innerW,
        y1: innerY,
        y2: innerY + innerH,
      }
      const corners = []

      // Top left
      corners.push([
        { x: outer.x1, y: outer.y1 },
        { x: inner.x1, y: inner.y1 },
      ])

      // Top right
      corners.push([
        { x: outer.x2, y: outer.y1 },
        { x: inner.x2, y: inner.y1 },
      ])

      // Bottom right
      corners.push([
        { x: outer.x2, y: outer.y2 },
        { x: inner.x2, y: inner.y2 },
      ])

      // Bottom left
      corners.push([
        { x: outer.x1, y: outer.y2 },
        { x: inner.x1, y: inner.y2 },
      ])

      // Top & bottom lines, vertical
      for (let i = 1; i < vLines; i++) {
        this.lines.push([
          { x: outerGapX * i, y: outer.y1 },
          { x: innerX + innerGapX * i, y: inner.y1 },
        ])

        this.lines.push([
          { x: outerGapX * i, y: outer.y2 },
          { x: innerX + innerGapX * i, y: inner.y2 },
        ])
      }

      // Top lines, horizontal
      for (let i = 1; i < hLines; i++) {
        const index = 1 - Math.pow(1 - hGap * i, 2)

        const l1 = corners[0]
        const l2 = corners[1]

        // Get a point at i * hGap
        const p1 = {
          x: l1[0].x + (l1[1].x - l1[0].x) * index,
          y: l1[0].y + (l1[1].y - l1[0].y) * index,
        }

        const p2 = {
          x: l2[0].x + (l2[1].x - l2[0].x) * index,
          y: l2[0].y + (l2[1].y - l2[0].y) * index,
        }

        this.lines.push([p1, p2])
      }

      // Bottom lines, horizontal
      for (let i = 1; i < hLines; i++) {
        const index = 1 - Math.pow(1 - hGap * i, 2)

        const l1 = corners[3]
        const l2 = corners[2]

        // Get a point at i * hGap
        const p1 = {
          x: l1[0].x + (l1[1].x - l1[0].x) * index,
          y: l1[0].y + (l1[1].y - l1[0].y) * index,
        }

        const p2 = {
          x: l2[0].x + (l2[1].x - l2[0].x) * index,
          y: l2[0].y + (l2[1].y - l2[0].y) * index,
        }

        this.lines.push([p1, p2])
      }

      // Right & left lines, vertical
      for (let i = 0; i <= vLines; i++) {
        this.lines.push([
          { x: outer.x1, y: outerGapY * i },
          { x: inner.x1, y: innerY + innerGapY * i },
        ])

        this.lines.push([
          { x: outer.x2, y: outerGapY * i },
          { x: inner.x2, y: innerY + innerGapY * i },
        ])
      }

      // Right lines, horizontal
      for (let i = 1; i < hLines; i++) {
        const index = 1 - Math.pow(1 - hGap * i, 2)

        const l1 = corners[1]
        const l2 = corners[2]

        // Get a point at i * hGap
        const p1 = {
          x: l1[0].x + (l1[1].x - l1[0].x) * index,
          y: l1[0].y + (l1[1].y - l1[0].y) * index,
        }

        const p2 = {
          x: l2[0].x + (l2[1].x - l2[0].x) * index,
          y: l2[0].y + (l2[1].y - l2[0].y) * index,
        }

        this.lines.push([p1, p2])
      }

      // Left lines, horizontal
      for (let i = 1; i < hLines; i++) {
        const index = 1 - Math.pow(1 - hGap * i, 2)

        const l1 = corners[0]
        const l2 = corners[3]

        // Get a point at i * hGap
        const p1 = {
          x: l1[0].x + (l1[1].x - l1[0].x) * index,
          y: l1[0].y + (l1[1].y - l1[0].y) * index,
        }

        const p2 = {
          x: l2[0].x + (l2[1].x - l2[0].x) * index,
          y: l2[0].y + (l2[1].y - l2[0].y) * index,
        }

        this.lines.push([p1, p2])
      }

      this.drawLines()
    }

    /**
     * Draw lines
     */
    drawLines() {
      if (!this.path) return

      let d = ''

      this.lines.forEach((points) => {
        let p1 = points[0]
        let p2 = points[1]

        d += 'M ' + p1.x + ' ' + p1.y + ' L ' + p2.x + ' ' + p2.y + ' '
      })

      this.path.setAttribute('d', d)
    }

    /**
     * Move 彩头
     */
    moveCharms() {
      const { charms } = this

      for (let i = charms.length - 1; i >= 0; i--) {
        if (!stepCharm(charms[i])) charms.splice(i, 1)
      }
    }

    /**
     * Draw canvas
     */
    drawCanvas() {
      const { bounding, ctx, charms, charmImages } = this
      if (!ctx || !bounding) return

      ctx.clearRect(0, 0, bounding.width, bounding.height)

      const contrasted = isContrastedTheme()
      charms.forEach((charm) => {
        drawCharm(ctx, charm, charmImages, contrasted)
      })
    }

    /**
     * Tick
     */
    tick() {
      const { bounding, el, scroll, par } = this
      if (this.destroyed || !el || !bounding || !scroll) return

      if (this.reduced) {
        if (this.charms.length) {
          this.moveCharms()
          this.drawCanvas()
        } else {
          this.stopFrame()
        }
        return
      }

      // Smooth scroll
      scroll.sp += (scroll.p - scroll.sp) * 0.2
      const sd = Math.round((scroll.p - scroll.sp) * 1000) / 1000

      this.syncAxis()

      if (par.active) {
        par.sx += (par.x - par.sx) * 0.06
        par.sy += (par.y - par.sy) * 0.06
        el.style.setProperty('--par-x', par.sx.toFixed(4))
        el.style.setProperty('--par-y', par.sy.toFixed(4))
      }

      const pd = Math.abs(par.x - par.sx) + Math.abs(par.y - par.sy)

      // Lines
      if (sd !== 0 || pd > 0.001 || this.isForced) {
        this.setLines()
      }

      // 彩头
      if (this.charms.length) {
        this.moveCharms()
        this.drawCanvas()
      } else if (this.isPaused) {
        this.stopFrame()
      }

      this.isForced = false
    }
  }

  /* ClientRouter 下模块脚本只执行一次：
     必须在每次 astro:page-load 时对新 DOM 重建实例，并先收掉旧实例 */
  const mountAbout = () => {
    const prev = (window as any).__sAbout
    const hasAbout = !!document.querySelector('.s-about')
    try {
      prev?.destroy?.()
    } catch (e) {}
    ;(window as any).__sAbout = hasAbout ? new Section() : null
  }

  const unmountAbout = () => {
    try {
      ;(window as any).__sAbout?.destroy?.()
    } catch (e) {}
    ;(window as any).__sAbout = null
  }

  document.addEventListener('astro:page-load', mountAbout)
  document.addEventListener('astro:before-swap', unmountAbout)
</script>

