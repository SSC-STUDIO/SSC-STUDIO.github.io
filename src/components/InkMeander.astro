---
/**
 * InkMeander — 原创「回纹」纹样条
 * 单元为一笔向内收拢的方形螺旋（回字），pattern 平铺成边饰带。
 * currentColor 取色，随主题（宣纸松墨 / 松夜）自动适配。
 */
type Props = {
  height?: number
  width?: string
  class?: string
}

import { uid } from '../utils/uid'

const { height = 10, width = '100%', class: className } = Astro.props

const patternId = uid('ink-meander')
const scale = height / 24
---

<svg
  class:list={['ink-meander', className]}
  style={`height:${height}px;width:${width}`}
  aria-hidden="true"
>
  <defs>
    <pattern
      id={patternId}
      width="24"
      height="24"
      patternUnits="userSpaceOnUse"
      patternTransform={`scale(${scale})`}
    >
      <path
        d="M2 22H22V6H8V16H16V11H12"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
      ></path>
    </pattern>
  </defs>

  <rect width="100%" height="100%" fill={`url(#${patternId})`}></rect>
</svg>

<style>
  .ink-meander {
    display: block;
    width: 100%;

    color: var(--color-accent);
    opacity: 0.82;
  }
</style>
