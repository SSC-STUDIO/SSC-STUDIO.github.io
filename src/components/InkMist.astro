---
/**
 * InkMist — 水墨雾霭
 * 横卷薄雾用不规则墨晕，不要几何椭圆叠层。
 * 纯 transform/opacity，离屏由使用方停；currentColor 随主题走。
 */
type Props = {
  class?: string
}

const { class: className } = Astro.props
---

<div class:list={['ink-mist', className]} aria-hidden="true">
  <svg viewBox="0 0 1440 260" preserveAspectRatio="xMidYMid slice">
    <path
      class="ink-mist__layer ink-mist__layer--far"
      d="M-80 128 C140 86 360 124 560 104 C780 82 1000 128 1200 110 C1360 98 1520 132 1600 148 C1600 228 1180 248 780 236 C380 250 40 220 -80 210 Z"
    ></path>
    <path
      class="ink-mist__layer ink-mist__layer--mid"
      d="M-40 96 C180 58 420 108 680 78 C920 52 1140 102 1380 84 C1500 74 1580 100 1620 118 C1600 198 1240 220 860 206 C480 222 80 176 -40 168 Z"
    ></path>
    <path
      class="ink-mist__layer ink-mist__layer--near"
      d="M-60 176 C200 148 460 186 740 160 C1000 138 1220 180 1480 166 C1560 160 1620 176 1660 188 C1640 250 1180 268 740 258 C300 270 20 230 -60 224 Z"
    ></path>
  </svg>
</div>

<style lang="scss">
  .ink-mist {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;

    height: min(30vh, 15rem);

    overflow: hidden;
    pointer-events: none;

    color: color(secondary);

    svg {
      display: block;
      width: 100%;
      height: 100%;
    }
  }

  .ink-mist__layer {
    fill: currentColor;
    transform-origin: center;
    animation: mistDrift 24s ease-in-out infinite;

    &--far {
      opacity: 0.045;
    }

    &--mid {
      opacity: 0.065;

      animation-duration: 30s;
      animation-delay: -9s;
    }

    &--near {
      opacity: 0.085;

      animation-duration: 36s;
      animation-delay: -17s;
    }
  }

  @keyframes mistDrift {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(-28px, -5px, 0) scale(1.04);
    }
  }

  :global(.theme-contrasted) {
    .ink-mist {
      color: color-mix(in srgb, #{color(indigo)} 62%, #{color(secondary)});
    }

    .ink-mist__layer {
      &--far {
        opacity: 0.08;
      }

      &--mid {
        opacity: 0.11;
      }

      &--near {
        opacity: 0.14;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-mist__layer {
      animation: none;
    }
  }
</style>
