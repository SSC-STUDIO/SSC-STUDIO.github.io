---
/**
 * InkBloom — 梅枝绽放（斜出梅枝 + 五瓣梅花开合）
 * 「疏影横斜水清浅，暗香浮动月黄昏」意象：花苞点缀枝头，花朵缓舒缓合。
 * 枝干淡墨、花瓣浓墨、梅蕊点朱砂。currentColor 取色，低透明度装饰。
 */
type Props = {
  size?: number
  flip?: boolean
  class?: string
}

const { size = 220, flip = false, class: className } = Astro.props
---

<div
  class:list={['ink-bloom', flip && 'ink-bloom--flip', className]}
  style={`width:${size * 0.67}px;height:${size}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 160 240">
    {/* 主枝：自左下斜出 */}
    <path class="ink-bloom__branch" d="M18 240 C44 196 58 168 70 132 C80 102 96 70 128 44" fill="none"></path>
    {/* 侧枝 */}
    <path class="ink-bloom__twig" d="M70 132 Q88 124 104 128 M70 132 Q60 116 58 100" fill="none"></path>

    {/* 盛放梅花开 */}
    <g class="ink-bloom__flower" transform="translate(104 128)">
      <g class="ink-bloom__petals">
        <ellipse cx="0" cy="-7" rx="4.6" ry="6.4"></ellipse>
        <ellipse cx="0" cy="-7" rx="4.6" ry="6.4" transform="rotate(72)"></ellipse>
        <ellipse cx="0" cy="-7" rx="4.6" ry="6.4" transform="rotate(144)"></ellipse>
        <ellipse cx="0" cy="-7" rx="4.6" ry="6.4" transform="rotate(216)"></ellipse>
        <ellipse cx="0" cy="-7" rx="4.6" ry="6.4" transform="rotate(288)"></ellipse>
      </g>
      <g class="ink-bloom__stamens">
        <circle cx="0" cy="-2.6" r="1"></circle>
        <circle cx="2.4" cy="1" r="1"></circle>
        <circle cx="-2.4" cy="1" r="1"></circle>
        <circle cx="0" cy="0" r="0.9"></circle>
      </g>
    </g>

    {/* 含苞半开 */}
    <g class="ink-bloom__flower ink-bloom__flower--half" transform="translate(58 100)">
      <g class="ink-bloom__petals">
        <ellipse cx="0" cy="-5.4" rx="3.4" ry="4.8"></ellipse>
        <ellipse cx="0" cy="-5.4" rx="3.4" ry="4.8" transform="rotate(100)"></ellipse>
        <ellipse cx="0" cy="-5.4" rx="3.4" ry="4.8" transform="rotate(220)"></ellipse>
      </g>
      <circle class="ink-bloom__stamens" cx="0" cy="0" r="1.1"></circle>
    </g>

    {/* 花苞 */}
    <circle class="ink-bloom__bud" cx="128" cy="44" r="2.6"></circle>
    <circle class="ink-bloom__bud" cx="112" cy="56" r="2"></circle>
  </svg>
</div>

<style lang="scss">
  .ink-bloom {
    position: absolute;
    pointer-events: none;

    svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
    }
  }

  .ink-bloom--flip {
    transform: scaleX(-1);
  }

  .ink-bloom__branch {
    stroke: color(secondary);
    stroke-width: 2.6;
    stroke-linecap: round;
    opacity: 0.3;
  }

  .ink-bloom__twig {
    stroke: color(secondary);
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.24;
  }

  .ink-bloom__flower {
    transform-box: fill-box;
    transform-origin: center;

    animation: bloomBreathe 9s ease-in-out infinite;
  }

  .ink-bloom__flower--half {
    animation-delay: -4s;
    animation-duration: 11s;
  }

  .ink-bloom__petals {
    fill: color(secondary);
    opacity: 0.34;
  }

  .ink-bloom__stamens {
    fill: color(accent);
    opacity: 0.6;
  }

  .ink-bloom__bud {
    fill: none;
    stroke: color(accent);
    stroke-width: 1.4;
    opacity: 0.55;
  }

  @keyframes bloomBreathe {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.08);
    }
  }

  :global(.theme-contrasted) {
    .ink-bloom__branch {
      opacity: 0.44;
    }

    .ink-bloom__twig {
      opacity: 0.36;
    }

    .ink-bloom__petals {
      opacity: 0.48;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-bloom__flower {
      animation: none;
    }
  }
</style>
