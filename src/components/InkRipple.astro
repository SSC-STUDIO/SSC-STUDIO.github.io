---
/**
 * InkRipple — 水波涟漪（三圈同心椭圆 + 点苔圆心）
 * 「风乍起，吹皱一池春水」意象：涟漪自中心缓缓散开、渐淡。
 * currentColor 取色。
 */
type Props = {
  size?: number
  class?: string
}

const { size = 120, class: className } = Astro.props
---

<div
  class:list={['ink-ripple', className]}
  style={`width:${size}px;height:${size}px`}
  aria-hidden="true"
>
  <svg viewBox="0 0 120 120">
    <circle class="ink-ripple__moss" cx="60" cy="60" r="2.4"></circle>
    <ellipse class="ink-ripple__ring ink-ripple__ring--1" cx="60" cy="60" rx="22" ry="8"></ellipse>
    <ellipse class="ink-ripple__ring ink-ripple__ring--2" cx="60" cy="60" rx="34" ry="12"></ellipse>
    <ellipse class="ink-ripple__ring ink-ripple__ring--3" cx="60" cy="60" rx="46" ry="16"></ellipse>
  </svg>
</div>

<style lang="scss">
  .ink-ripple {
    position: absolute;
    pointer-events: none;

    svg {
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
    }
  }

  .ink-ripple__moss {
    fill: color(secondary);
    opacity: 0.4;
  }

  .ink-ripple__ring {
    fill: none;
    stroke: color(secondary);
    stroke-width: 1;
    opacity: 0;

    transform-origin: 60px 60px;
    transform-box: view-box;

    animation: rippleSpread 6s ease-out infinite;
  }

  .ink-ripple__ring--2 {
    animation-delay: 2s;
  }

  .ink-ripple__ring--3 {
    animation-delay: 4s;
  }

  @keyframes rippleSpread {
    0% {
      opacity: 0;
      transform: scale(0.55);
    }
    12% {
      opacity: 0.28;
    }
    100% {
      opacity: 0;
      transform: scale(1.15);
    }
  }

  :global(.theme-contrasted) .ink-ripple__ring {
    stroke: color(primary);
  }

  :global(.theme-contrasted) .ink-ripple__moss {
    fill: color(primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .ink-ripple__ring {
      animation: none;
      opacity: 0.12;
      transform: scale(1);
    }
  }
</style>
