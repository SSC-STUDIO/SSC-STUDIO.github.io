---
const { cssClass, href, img, title, summary, stack = [], key } = Astro.props
---

<sen-work class={cssClass}>
  <div class="a__inner">
    <a href={href}>
      <img
        class="a__image js-image"
        src={img}
        alt={title}
        width="1082"
        height="636"
        loading="lazy"
        decoding="async"
      />

      <div class="a__caption">
        <div class="a__caption__text">
          <span class="a__caption__title">{title}</span>
          <span class="a__caption__summary">{summary}</span>
          <span class="a__caption__stack">
            {stack.map((tag) => <span class="a__caption__tag">{tag}</span>)}
          </span>
        </div><!-- .a__caption__text -->

        <div class="a__caption__key">
          {key}
        </div><!-- .a__caption__key -->
      </div><!-- .a__caption -->

      <span class="a__slip" aria-hidden="true">
        <span class="a__slip__text">{key}</span>
      </span>
    </a>
  </div><!-- .a__inner -->
</sen-work>

<script>
  class AWork extends HTMLElement {
    static observedAttributes = ['progress']

    link: HTMLAnchorElement

    /**
     * Init
     */
    connectedCallback() {
      // Elements
      this.link = this.querySelector('a')

      // Events
      this.link.addEventListener('click', this.onClick.bind(this))
    }

    /**
     * Attribute changed
     */
    attributeChangedCallback(name, oldValue, newValue) {
      if (name === 'progress') {
        this.style.setProperty('--progress', newValue)

        if (newValue === '1' || newValue === '-1') {
          this.classList.remove('is-inview')
        } else {
          this.classList.add('is-inview')
        }
      }
    }

    /**
     * On click
     */
    onClick(event: MouseEvent) {
      if (this.link.href.includes('#')) {
        event.preventDefault()
        return false
      }
    }
  }

  if (!customElements.get('sen-work')) {
    customElements.define('sen-work', AWork)
  }
</script>

<style lang="scss">
  sen-work {
    position: relative;
    top: 0;
    left: 0;

    display: block;
    margin: 0;
    padding: 0.5rem 0.5rem 0;

    background: color(surface);
    content-visibility: hidden;

    /* 四角朱砂碰头：册页装裱式的角饰 */
    @include ink-corner-marks($len: 13px, $w: 1.5px, $inset: -2px, $softness: 0.9);

    transform-style: preserve-3d;

    will-change: transform;

    @include mq(phone) {
      padding: 0.25rem;
    }

    a {
      display: block;

      text-decoration: none;
    }

    .a__inner {
      display: block;
      margin: 0;
      padding: 0;
    }

    .a__image {
      display: block;

      width: auto;
      max-width: min(50vw, 42rem);
      height: auto;
      max-height: 50vh;

      object-fit: cover;

      transition: filter 0.5s ease;

      @include mq(phone) {
        max-width: 80vw;
        max-height: 80vh;
      }
    }

    /* 悬停时泛起陈年宣纸的旧色 */
    a:hover .a__image,
    a:focus-visible .a__image {
      filter: sepia(0.22) saturate(1.06) contrast(1.02) brightness(0.99);
    }

    .a__caption {
      @include flex(row, flex-start, space-between);

      gap: 1rem;
      padding: 0.65rem 0.5rem 0.5rem;

      color: color(on-surface);
      font: 700 12px / 1.2 font-family(editorial);
      letter-spacing: 0.08em;
      text-transform: none;
    }

    .a__caption__text {
      @include flex(column, flex-start, flex-start);

      gap: 0.35rem;
      max-width: 28rem;
    }

    .a__caption__summary {
      color: color-mix(in srgb, var(--color-on-surface) 82%, transparent);
      font: 400 10px / 1.45 font-family(editorial);
      letter-spacing: 0.02em;
      text-transform: none;
    }

    .a__caption__stack {
      @include flex(row, center, flex-start);

      flex-wrap: wrap;
      gap: 0.25rem;
    }

    .a__caption__tag {
      padding: 0.18rem 0.42rem;

      border: 1px solid
        color-mix(in srgb, var(--color-on-surface) 34%, transparent);
      @include ink-pill;

      color: color-mix(in srgb, var(--color-on-surface) 86%, transparent);
      font-size: 9px;
      letter-spacing: 0.05em;
    }

    .a__caption__key {
      flex-shrink: 0;
      align-self: center;
      padding: 0.22rem 0.5rem;

      background: color-mix(in srgb, var(--color-accent) 12%, transparent);
      border: 1px solid color-mix(in srgb, var(--color-accent) 62%, transparent);
      @include ink-pill;

      color: color(accent-strong);
      font-family: font-family(editorial);
      letter-spacing: 0.16em;

      white-space: nowrap;
    }

    /* 签条 —— 骑缝在册页右上角的绢色题签 */
    .a__slip {
      position: absolute;
      top: -0.55rem;
      right: 1.1rem;
      z-index: 3;

      display: block;

      pointer-events: none;
    }

    .a__slip__text {
      display: block;
      padding: 0.7em 0.26em;

      writing-mode: vertical-rl;

      background: linear-gradient(
        180deg,
        color(paper-warm),
        color-mix(in srgb, color(paper-warm) 88%, #000)
      );
      box-shadow:
        inset 0 0 0 1px
          color-mix(in srgb, color(secondary) 55%, transparent),
        inset 0 0 0 2.5px color(paper-warm),
        1px 1.5px 4px rgba(12, 10, 8, 0.28);

      color: color(secondary);
      font: 600 10.5px / 1.15 font-family(editorial);
      letter-spacing: 0.32em;

      white-space: nowrap;
    }

    @include mq(phone) {
      .a__slip {
        top: -0.4rem;
        right: 0.6rem;
      }

      .a__slip__text {
        font-size: 9px;
      }
    }

    &.is-inview {
      content-visibility: visible;
    }
  }
</style>
