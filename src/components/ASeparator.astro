---
const {
  class: className,
  style = 'primary',
  strings = ['木', '林', '森', '光'],
} = Astro.props
---

<sen-rail class:list={['style--' + style, className]} data-intersect>
  <span class="a__node" aria-hidden="true"></span>

  <span class="a__glyphs">
    {
      strings.map((glyph) => (
        <>
          <span class="a__glyph js-glyph">{glyph}</span>
          <span class="a__rule" aria-hidden="true" />
        </>
      ))
    }
  </span>

  <span class="a__node" aria-hidden="true"></span>
</sen-rail>

<script>
  import Emitter from '../utils/Emitter'

  class ASeparator extends HTMLElement {
    glyphs: NodeListOf<HTMLElement>
    isPaused: boolean

    connectedCallback() {
      this.glyphs = this.querySelectorAll('.js-glyph')
      this.isPaused = true
      this.bindEvents()
    }

    bindEvents() {
      this.addEventListener('intersect', this.onIntersect.bind(this), {
        passive: true,
      })
    }

    onIntersect(e) {
      this.isPaused = !e.detail.isIntersecting

      if (this.isPaused) {
        Emitter.off('tick', this.tick, this)
      } else {
        Emitter.on('tick', this.tick, this)
      }
    }

    tick() {
      this.glyphs.forEach((glyph) => {
        if (Math.random() > 0.012) return
        glyph.classList.add('is-ink')
        window.setTimeout(() => glyph.classList.remove('is-ink'), 280)
      })
    }
  }

  if (!customElements.get('sen-rail')) {
    customElements.define('sen-rail', ASeparator)
  }
</script>

<style lang="scss">
  sen-rail {
    @include flex(row, center, space-between);

    position: relative;

    padding: 0 1.15rem;
    width: 100%;
    height: 2.35rem;

    @include ink-rule(top);
    box-shadow:
      inset 0 1.5px 0 color-mix(in srgb, var(--color-secondary) 48%, transparent),
      inset 0 4px 0 color-mix(in srgb, var(--color-accent) 58%, transparent),
      inset 0 -1.5px 0 color-mix(in srgb, var(--color-secondary) 48%, transparent),
      inset 0 -4px 0 color-mix(in srgb, var(--color-accent) 58%, transparent);

    font: 700 13px / 1 font-family(editorial);
    letter-spacing: 0.28em;

    .a__node {
      flex-shrink: 0;

      width: 1.5px;
      height: 0.85rem;

      background: color-mix(in srgb, #{color(secondary)} 55%, transparent);
    }

    .a__glyphs {
      @include flex(row, center, space-between);

      flex: 1 1 auto;
      min-width: 0;
      padding: 0 0.85rem;
    }

    .a__glyph {
      position: relative;

      flex: 0 0 auto;

      color: color(secondary);
      transition:
        opacity 0.28s ease,
        transform 0.28s ease,
        color 0.28s ease;

      &.is-ink {
        color: color(accent);
        transform: translateY(-1px);
      }
    }

    .a__rule {
      flex: 1 1 auto;

      height: 5px;
      margin: 0 0.65rem;
      min-width: 1.25rem;

      background-image:
        radial-gradient(
          circle,
          color-mix(in srgb, #{color(accent)} 70%, transparent) 0.7px,
          transparent 0.85px
        ),
        radial-gradient(
          circle,
          color-mix(in srgb, #{color(secondary)} 45%, transparent) 0.45px,
          transparent 0.6px
        ),
        linear-gradient(
          color-mix(in srgb, #{color(accent)} 55%, transparent),
          color-mix(in srgb, #{color(accent)} 55%, transparent)
        );
      background-repeat: repeat-x, repeat-x, repeat-x;
      background-size: 7px 5px, 11px 5px, 100% 1.2px;
      background-position: 0 50%, 4px 1px, 0 50%;
      opacity: 0.9;

      &:last-child {
        display: none;
      }

      @include mq(phone) {
        &:nth-child(2n) {
          min-width: 0.5rem;
          margin: 0 0.35rem;
        }
      }
    }

    &.style--secondary {
      background: color(secondary);

      color: color(primary);

      .a__node {
        background: color(primary);
      }

      .a__glyph {
        color: color(primary);

        &.is-ink {
          color: color(accent);
        }
      }

      .a__rule {
        background-image:
          radial-gradient(circle, color-mix(in srgb, #{color(primary)} 70%, transparent) 0.7px, transparent 0.85px),
          radial-gradient(circle, color-mix(in srgb, #{color(accent)} 50%, transparent) 0.45px, transparent 0.6px),
          linear-gradient(color-mix(in srgb, #{color(primary)} 55%, transparent), color-mix(in srgb, #{color(primary)} 55%, transparent));
      }
    }

    &.style--accent {
      background: color(accent-muted);

      .a__glyph.is-ink {
        color: color(accent-strong);
      }
    }
  }
</style>
