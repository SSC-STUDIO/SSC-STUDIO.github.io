---
/**
 * InkLattice - 原创「冰裂窗棂」纹（方折系）
 * 模拟宋瓷冰裂纹 / 花窗棂格：不规则折线网络，作角隅水印或卡纸暗纹。
 * currentColor 取色；建议低透明度使用。
 */
type Props = {
  size?: number
  class?: string
}

import { uid } from '../utils/uid'

const { size = 96, class: className } = Astro.props

const patternId = uid('ink-lattice')
---

<svg
  class:list={['ink-lattice', className]}
  style={`width:${size}px;height:${size}px`}
  viewBox="0 0 60 60"
  aria-hidden="true"
>
  <defs>
    <pattern
      id={patternId}
      width="60"
      height="60"
      patternUnits="userSpaceOnUse"
    >
      <g
        fill="none"
        stroke="currentColor"
        stroke-width="1.1"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <!-- 主裂径 -->
        <path d="M8 0 14.5 12 10 24 16.5 38 12 52 18 60"></path>
        <path d="M14.5 12 30 8 44 14"></path>
        <path d="M10 24 26 30 42 24"></path>
        <path d="M16.5 38 34 42 48 36"></path>
        <path d="M34 42 30 60"></path>
        <!-- 支裂 -->
        <path d="M44 14 50 28"></path>
        <path d="M42 24 58 20 M48 36 60 33"></path>
        <path d="M26 30 22 44 M30 8 28 0"></path>
      </g>
    </pattern>
  </defs>

  <rect width="100%" height="100%" fill={`url(#${patternId})`}></rect>
</svg>

<style>
  .ink-lattice {
    display: block;

    color: var(--color-secondary);
    opacity: 0.14;
  }
</style>