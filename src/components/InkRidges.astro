---
/**
 * InkRidges — 水墨远山 + 满幅丝缕
 *
 * 上半幅是竖直的丝缕场（值噪声扭出的雨丝/等高线），下半幅是四叠远山。
 * 指针如风拂过：丝缕横向让开、脊线被轻轻托起。点按激起一圈山风。
 * 显影由 SHero 的 introend 触发：丝缕先落、山自雾底升起。
 */
const { class: className } = Astro.props
---

<ink-ridges class:list={className} data-intersect>
  <canvas class="js-canvas" aria-hidden="true"></canvas>
</ink-ridges><!-- .ink-ridges -->

<script>
  import {
    onFrame,
    onResize,
    onPointer,
    onThemeFlip,
    prefersReducedMotion,
    type Cleanup,
  } from '../motion/core'
  import { createField, type Field2D } from '../motion/field'

  /**
   * 山层（远 → 近）
   * base = 山脚基线；amp = 峰高；scale = 横向山团密度
   */
  const LAYERS = [
    { base: 0.4, amp: 0.16, scale: 1.8, drift: 0.32, alpha: 0.14, line: 1 },
    { base: 0.54, amp: 0.18, scale: 2.3, drift: 0.5, alpha: 0.22, line: 1.15 },
    { base: 0.7, amp: 0.2, scale: 2.9, drift: 0.75, alpha: 0.32, line: 1.3 },
    { base: 0.88, amp: 0.22, scale: 3.6, drift: 1.05, alpha: 0.46, line: 1.45 },
  ]

  const STEP = 7
  const THREAD_GAP = 16
  const THREAD_STEP_Y = 12
  const SPRING = 0.045
  const DAMPING = 0.9
  const MAX_DISP = 46
  const REVEAL_MS = 1500

  type RGB = { r: number; g: number; b: number }

  function hexToRgb(hex: string): RGB | null {
    const m = /^#?([0-9a-f]{6})$/i.exec(hex.trim())
    if (!m) return null

    const n = parseInt(m[1], 16)
    return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 }
  }

  function easeOutCubic(t: number): number {
    return 1 - Math.pow(1 - t, 3)
  }

  class InkRidges extends HTMLElement {
    canvas: HTMLCanvasElement
    ctx: CanvasRenderingContext2D
    field: Field2D

    width = 0
    height = 0
    cols = 0
    threadCount = 0
    threadRows = 0

    disp: Float32Array[] = []
    vel: Float32Array[] = []
    threadDisp = new Float32Array(0)
    threadVel = new Float32Array(0)

    ink: RGB = { r: 28, g: 42, b: 34 }
    paper: RGB = { r: 244, g: 234, b: 216 }
    accent: RGB = { r: 194, g: 58, b: 43 }
    boost = 1

    reduced = false
    paused = true
    revealing = false
    reveal = 0
    revealStart = 0
    lastTime = 0

    pointer = { x: -9999, y: -9999, lx: -9999, ly: -9999, px: -9999, py: 0 }

    stops: Cleanup[] = []
    stopFrame: Cleanup | null = null
    revealFallback = 0

    connectedCallback() {
      this.canvas = this.querySelector('.js-canvas')
      const ctx = this.canvas?.getContext('2d')

      if (!this.canvas || !ctx) return

      this.ctx = ctx
      this.field = createField(Math.random())
      this.reduced = prefersReducedMotion()

      this.sampleColors()
      this.resize()

      const ro = new ResizeObserver(() => this.resize())
      ro.observe(this)
      this.stops.push(() => ro.disconnect())

      this.stops.push(onResize(() => this.resize()))
      this.stops.push(
        onThemeFlip(() => {
          this.sampleColors()
          if (!this.stopFrame) this.paint(performance.now())
        })
      )

      if (!this.reduced) {
        this.stops.push(onPointer(({ x, y }) => this.stir(x, y)))
        this.addEventListener('pointerdown', this.onTap, { passive: true })
      }

      this.addEventListener('intersect', this.onIntersect as EventListener, {
        passive: true,
      })
      this.addEventListener('introend', this.onIntroEnd, { once: true })

      this.revealFallback = window.setTimeout(() => this.beginReveal(), 4000)

      try {
        if (sessionStorage.getItem('site-intro-seen') === '1') {
          this.beginReveal()
        }
      } catch {
        /* ignore */
      }

      this.paint(performance.now())
    }

    disconnectedCallback() {
      window.clearTimeout(this.revealFallback)
      this.suspend()
      this.stops.forEach((stop) => stop())
      this.stops = []
    }

    onIntroEnd = () => {
      this.beginReveal()
    }

    onIntersect = (e: CustomEvent) => {
      this.paused = !e.detail?.isIntersecting

      if (this.paused) this.suspend()
      else this.resume()
    }

    onTap = (e: PointerEvent) => {
      const rect = this.getBoundingClientRect()
      this.poke(e.clientX - rect.left, e.clientY - rect.top, 8.5, 170)
    }

    beginReveal() {
      if (this.revealing || this.reveal >= 1) return

      window.clearTimeout(this.revealFallback)
      this.revealing = true
      this.revealStart = performance.now()
      this.classList.add('is-interactive')

      if (this.reduced) {
        this.reveal = 1
        this.paint(performance.now())
        return
      }

      this.resume()
    }

    resume() {
      if (this.stopFrame || this.reduced) return
      this.stopFrame = onFrame((time) => this.paint(time))
    }

    suspend() {
      this.stopFrame?.()
      this.stopFrame = null
    }

    resize() {
      const width = this.clientWidth
      const height = this.clientHeight

      if (!width || !height) return

      const dpr = Math.min(window.devicePixelRatio || 1, 2)

      this.canvas.width = Math.round(width * dpr)
      this.canvas.height = Math.round(height * dpr)
      this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0)

      this.width = width
      this.height = height
      this.cols = Math.ceil(width / STEP) + 2
      this.threadCount = Math.ceil(width / THREAD_GAP) + 2
      this.threadRows = Math.ceil(height / THREAD_STEP_Y) + 2

      this.disp = LAYERS.map(() => new Float32Array(this.cols))
      this.vel = LAYERS.map(() => new Float32Array(this.cols))
      this.threadDisp = new Float32Array(this.threadCount)
      this.threadVel = new Float32Array(this.threadCount)

      if (!this.stopFrame) this.paint(performance.now())
    }

    sampleColors() {
      const css = getComputedStyle(this)
      this.ink =
        hexToRgb(css.getPropertyValue('--color-secondary')) ?? this.ink
      this.paper =
        hexToRgb(css.getPropertyValue('--color-primary')) ?? this.paper
      this.accent =
        hexToRgb(css.getPropertyValue('--color-accent')) ?? this.accent
      this.boost = document.documentElement.classList.contains(
        'theme-contrasted'
      )
        ? 1.45
        : 1
    }

    ridgeY(layerIndex: number, x: number, time: number): number {
      const layer = LAYERS[layerIndex]
      const nx =
        (x / Math.max(this.width, 1)) * layer.scale +
        time * layer.drift * 0.00002
      const v = this.field.fbm(nx, layerIndex * 7.3 + 2.17, 3)

      return (
        this.height * layer.base -
        (0.5 + 0.5 * v) * layer.amp * this.height
      )
    }

    threadX(i: number, y: number, time: number): number {
      const nx = i * 0.31 + time * 0.000038
      const ny = y * 0.0031 + i * 0.08
      const n = this.field.fbm(nx, ny, 3)

      return i * THREAD_GAP - THREAD_GAP + n * 28 + this.threadDisp[i]
    }

    stir(clientX: number, clientY: number) {
      const rect = this.getBoundingClientRect()
      const x = clientX - rect.left
      const y = clientY - rect.top
      const p = this.pointer

      const hadLast = p.lx > -9000
      const dx = hadLast ? x - p.lx : 0
      const dy = hadLast ? y - p.ly : 0

      p.lx = x
      p.ly = y
      p.x = x
      p.y = y

      if (x < -80 || x > this.width + 80 || y < -80 || y > this.height + 80) {
        return
      }

      const speed = Math.min(Math.hypot(dx, dy), 42)
      if (speed < 0.6) return

      this.poke(x, y, speed * 0.14, 110)
    }

    poke(x: number, y: number, force: number, radius: number) {
      if (this.reduced || !this.cols) return

      const sigmaX = radius * 0.55
      const sigmaY = 78

      const colFrom = Math.max(0, Math.floor((x - radius) / STEP))
      const colTo = Math.min(this.cols - 1, Math.ceil((x + radius) / STEP))

      for (let li = 0; li < LAYERS.length; li++) {
        const disp = this.disp[li]
        const vel = this.vel[li]

        for (let col = colFrom; col <= colTo; col++) {
          const cx = col * STEP
          const ry = this.ridgeY(li, cx, this.lastTime) + disp[col]

          const gx = Math.exp(-((cx - x) ** 2) / (2 * sigmaX * sigmaX))
          const gy = Math.exp(-((ry - y) ** 2) / (2 * sigmaY * sigmaY))
          const dir = ry > y ? 1 : -1

          vel[col] += dir * force * gx * gy
        }
      }

      const tFrom = Math.max(0, Math.floor((x - radius) / THREAD_GAP))
      const tTo = Math.min(
        this.threadCount - 1,
        Math.ceil((x + radius) / THREAD_GAP)
      )

      for (let i = tFrom; i <= tTo; i++) {
        const cx = i * THREAD_GAP
        const gx = Math.exp(-((cx - x) ** 2) / (2 * sigmaX * sigmaX))
        const dir = cx < x ? -1 : 1
        this.threadVel[i] += dir * force * 0.7 * gx
      }
    }

    paint(time: number) {
      const { ctx, width, height } = this
      if (!width || !height) return

      this.lastTime = time

      if (this.revealing && this.reveal < 1) {
        this.reveal = Math.min((time - this.revealStart) / REVEAL_MS, 1)
      }
      const eased = easeOutCubic(this.reveal)
      const rise = (1 - eased) * 38

      ctx.clearRect(0, 0, width, height)

      const { r, g, b } = this.ink
      const accent = this.accent

      if (!this.reduced) {
        for (let i = 0; i < this.threadCount; i++) {
          this.threadVel[i] += -SPRING * this.threadDisp[i]
          this.threadVel[i] *= DAMPING
          this.threadDisp[i] += this.threadVel[i]
          if (this.threadDisp[i] > MAX_DISP) this.threadDisp[i] = MAX_DISP
          else if (this.threadDisp[i] < -MAX_DISP) this.threadDisp[i] = -MAX_DISP
        }
      }

      const px = this.pointer.px > -9000 ? this.pointer.px : -9999
      const py = this.pointer.py
      const highlightR = 130

      for (let i = 0; i < this.threadCount; i++) {
        ctx.beginPath()

        let near = 0
        for (let row = 0; row < this.threadRows; row++) {
          const y = Math.min(row * THREAD_STEP_Y, height)
          const x = this.threadX(i, y, time)

          if (row === 0) ctx.moveTo(x, y)
          else ctx.lineTo(x, y)

          if (px > -9000) {
            const d = Math.hypot(x - px, y - py)
            if (d < highlightR) near = Math.max(near, 1 - d / highlightR)
          }
        }

        const moss = i % 3 === 0
        const alpha = (moss ? 0.2 : 0.32) * this.boost * eased
        const lit = near > 0.12

        if (lit) {
          ctx.strokeStyle = `rgba(${accent.r}, ${accent.g}, ${accent.b}, ${0.45 + near * 0.4})`
          ctx.lineWidth = moss ? 2.2 : 1.6
        } else {
          ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`
          ctx.lineWidth = moss ? 2.4 : 1.15
        }

        ctx.stroke()
      }

      for (let li = 0; li < LAYERS.length; li++) {
        const layer = LAYERS[li]
        const disp = this.disp[li]
        const vel = this.vel[li]

        if (!this.reduced) {
          for (let col = 0; col < this.cols; col++) {
            vel[col] += -SPRING * disp[col]
            vel[col] *= DAMPING
            disp[col] += vel[col]

            if (disp[col] > MAX_DISP) disp[col] = MAX_DISP
            else if (disp[col] < -MAX_DISP) disp[col] = -MAX_DISP
          }
        }

        ctx.beginPath()

        for (let col = 0; col < this.cols; col++) {
          const x = Math.min(col * STEP, width)
          const y = this.ridgeY(li, x, time) + disp[col] + rise

          if (col === 0) ctx.moveTo(x, y)
          else ctx.lineTo(x, y)
        }

        const fill = Math.min(layer.alpha * this.boost, 0.6) * eased

        ctx.lineTo(width, height)
        ctx.lineTo(0, height)
        ctx.closePath()
        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${fill * 0.5})`
        ctx.fill()

        ctx.beginPath()

        for (let col = 0; col < this.cols; col++) {
          const x = Math.min(col * STEP, width)
          const y = this.ridgeY(li, x, time) + disp[col] + rise

          if (col === 0) ctx.moveTo(x, y)
          else ctx.lineTo(x, y)
        }

        ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, ${Math.min(fill + 0.16, 0.62)})`
        ctx.lineWidth = layer.line
        ctx.stroke()
      }

      const mist = ctx.createLinearGradient(0, height * 0.72, 0, height)
      const paper = this.paper
      mist.addColorStop(0, `rgba(${paper.r}, ${paper.g}, ${paper.b}, 0)`)
      mist.addColorStop(
        1,
        `rgba(${paper.r}, ${paper.g}, ${paper.b}, ${0.42 * eased})`
      )
      ctx.fillStyle = mist
      ctx.fillRect(0, height * 0.72, width, height * 0.28)

      const p = this.pointer
      if (p.x > -9000) {
        if (p.px < -9000) {
          p.px = p.x
          p.py = p.y
        } else {
          p.px += (p.x - p.px) * 0.16
          p.py += (p.y - p.py) * 0.16
        }

        this.style.setProperty('--x', `${p.px}px`)
        this.style.setProperty('--y', `${p.py}px`)
      }
    }
  }

  if (!customElements.get('ink-ridges')) {
    customElements.define('ink-ridges', InkRidges)
  }
</script>

<style lang="scss">
  ink-ridges {
    --x: -10rem;
    --y: 50%;

    position: relative;

    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;

    overflow: hidden;

    canvas {
      position: absolute;
      inset: 0;

      display: block;

      width: 100%;
      height: 100%;
    }

    &::before {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 1;

      width: 0.6rem;
      height: 0.42rem;

      background: var(--daypart-lamp, #{color(accent)});
      border-radius: 55% 45% 60% 40% / 55% 50% 50% 45%;
      box-shadow: 0 0 0 0.22rem
        color-mix(in srgb, var(--daypart-lamp, var(--color-accent)) 26%, transparent);

      transform: translate3d(calc(var(--x) - 50%), calc(var(--y) - 50%), 0);
      opacity: 0;

      transition: opacity 0.35s ease;

      content: '';
      pointer-events: none;
      will-change: transform;
    }

    &.is-interactive::before {
      opacity: 1;
    }

    @media (prefers-reduced-motion: reduce) {
      &::before {
        display: none;
      }
    }
  }
</style>
