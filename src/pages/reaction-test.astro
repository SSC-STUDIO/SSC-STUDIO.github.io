---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import ReactionTest from '@/islands/ReactionTest'
---

<BaseLayout
  title="Reaction Test · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
>
  <PageHero
    kicker="experiment"
    title="Reaction Test"
    summary="等待方块变绿立即点击 — 记录毫秒级视觉反应延迟。"
  />

  <main class="p-page">
    <div class="p-prose">
      <p>
        点击开始，等待区域变绿后立即点击。太早点击会失败，多试几次取最佳成绩。
      </p>
    </div>
    <div style="margin-top: 2rem;">
      <ReactionTest client:load />
    </div>
  </main>

  <PageFoot />
</BaseLayout>
