---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import PageCard from '@/components/pages/PageCard.astro'
import PageAura from '@/components/pages/PageAura.astro'
import ContactLetter from '@/components/pages/ContactLetter.astro'
import InkSeal3D from '@/components/InkSeal3D.astro'
import ContactForm from '@/islands/ContactForm'
---

<BaseLayout
  title="联系 · 陈润森"
  description="合作、交流和反馈都可以写到这里。信息清楚、克制，不堆无关隐私。"
>
  <PageHero
    kicker="信笺"
    title="联系"
    summary="合作、交流和反馈都可以写到这里。信息清楚、克制，不堆无关隐私。"
  />

  <main class="p-page p-page--wide p-contact">
    <PageAura />
    <div class="p-detail-meta p-detail-meta--bar" data-reveal data-lift>
      <span>3992237161@qq.com</span>
      <span>通常 48 小时内回复</span>
    </div>
    <ContactLetter>
      <div class="p-stack p-stack--2col">
        <PageCard kicker="合作" title="可以一起做的事">
          <p>适合交流的方向：</p>
          <ul data-flow data-intersect>
            <li tabindex="0">网页与交互</li>
            <li tabindex="0">开源实验</li>
          </ul>
          <div class="p-card__actions">
            <a
              class="p-card__link"
              href="mailto:3992237161@qq.com"
              data-copy-email
              data-seal>邮件 3992237161@qq.com</a
            >
            <a
              class="p-card__link p-card__link--ghost"
              href="https://github.com/SSC-STUDIO"
              target="_blank"
              rel="noopener"
              data-seal
            >
              GitHub
            </a>
          </div>
        </PageCard>
        <PageCard kicker="留言" title="写一封信" class="p-contact__letter-card">
          <ContactForm client:load />
        </PageCard>
      </div>
    </ContactLetter>
    <aside class="p-contact__colophon" aria-label="落款">
      <InkSeal3D />
    </aside>
  </main>

  <PageFoot current="/contact" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 联系页：信笺落墨与印玺落款（仅本页） ── */

  .p-contact {
    --flow-step: 88ms;
  }

  .p-contact-letter {
    position: relative;
    isolation: isolate;

    display: block;
  }

  /* 点墨层压在信笺卡之上，卡片 transform 不会把墨滴压到后面 */
  .p-contact-blots {
    position: absolute;
    inset: 0;
    z-index: 6;

    overflow: hidden;
    pointer-events: none;
  }

  /* 点笺面洇开的墨滴：脚本写入，缺席时没有，不影响阅读 */
  .p-contact-blot {
    position: absolute;

    width: 6.2rem;
    height: 6.2rem;
    margin: -3.1rem 0 0 -3.1rem;

    border: 1px solid color-mix(in srgb, #{color(accent)} 42%, transparent);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, #{color(accent)} 40%, transparent) 0 26%,
      color-mix(in srgb, #{color(secondary)} 18%, transparent) 46%,
      transparent 74%
    );
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, #{color(accent)} 16%, transparent);
    pointer-events: none;

    animation: contact-blot 1.15s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes contact-blot {
    0% {
      opacity: 0.95;
      transform: scale(0.52);
    }

    38% {
      opacity: 0.82;
      transform: scale(1.12);
    }

    100% {
      opacity: 0;
      transform: scale(2.15);
    }
  }

  /* 消息字数提示：不足 10 字时的柔和提醒，区别于红色错误 */
  .p-contact .p-form__field-hint {
    margin: 0.25rem 0 0;

    color: color-mix(in srgb, #{color(secondary)} 60%, transparent);
    font: 700 10px / 1.4 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: none;

    &.is-near {
      color: color-mix(in srgb, #{color(accent-strong)} 78%, #{color(secondary)});
    }

    &.is-full {
      color: color(accent-strong);
    }
  }

  /* 墨量：随字数在笺底铺一道朱砂，上限仍是 2000 */
  .p-contact .p-form__ink {
    display: block;

    height: 3px;
    margin-top: 0.45rem;

    background: color-mix(in srgb, #{color(secondary)} 16%, transparent);
    overflow: hidden;
  }

  .p-contact .p-form__ink > i {
    display: block;

    height: 100%;

    background: color(accent);
    transform-origin: 0 50%;

    transition:
      width 280ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 280ms ease;
  }

  .p-contact .p-form__ink.is-near > i,
  .p-contact .p-form__ink.is-full > i {
    background: color(accent-strong);
  }

  /* 信笺卡：暗格纸纹 + 折角，像摊开的一页信 */
  .p-contact__letter-card {
    position: relative;

    background-image:
      repeating-linear-gradient(
        180deg,
        transparent 0 1.55rem,
        color-mix(in srgb, #{color(secondary)} 9%, transparent) 1.55rem 1.6rem
      );
    background-attachment: local;

    &::before {
      position: absolute;
      top: 0;
      right: 0;
      z-index: 1;

      width: 1.6rem;
      height: 1.6rem;

      background: linear-gradient(
        225deg,
        color-mix(in srgb, #{color(accent)} 22%, #{color(primary)}) 50%,
        transparent 51%
      );
      content: '';
      pointer-events: none;
    }
  }

  /* 卡内题识随整卡落墨依次抬起 */
  .p-contact .p-card.is-inked {
    .p-card__head {
      animation: contact-rise 460ms ease backwards;
      animation-delay: calc(var(--reveal-delay, 0ms) + 160ms);
    }

    .p-card__title {
      animation: contact-rise 540ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
      animation-delay: calc(var(--reveal-delay, 0ms) + 230ms);
    }

    .p-card__body {
      animation: contact-rise 540ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
      animation-delay: calc(var(--reveal-delay, 0ms) + 310ms);
    }
  }

  @keyframes contact-tick {
    0% {
      opacity: 0;
      transform: rotate(-12deg) scale(1.6);
    }

    62% {
      opacity: 1;
      transform: rotate(-2deg) scale(0.94);
    }

    100% {
      opacity: 1;
      transform: rotate(-4deg) scale(1);
    }
  }

  @keyframes contact-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 0.55rem, 0);
    }
  }

  /* 合作方向：朱砂点，悬停推近；点一下钤勾 */
  .p-contact .p-card__body li {
    position: relative;

    cursor: pointer;
    transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);

    &:hover {
      transform: translateX(3px);
    }

    &::marker {
      color: color(accent);
    }

    &.is-ticked {
      color: color(secondary);

      &::after {
        position: absolute;
        top: 0.05em;
        right: 0;

        display: grid;
        place-items: center;

        width: 1.15rem;
        height: 1.15rem;

        border: 1.5px solid color(accent-strong);
        border-radius: 0.08rem;

        color: color(accent-strong);
        font: 700 0.58rem / 1 font-family(editorial);

        content: '可';
        pointer-events: none;

        animation: contact-tick 640ms cubic-bezier(0.2, 1.35, 0.32, 1) both;
      }
    }
  }

  /* 表单字段错峰落定：只在卡片已显影后播。
     无 JS 或显影管线未接管时字段保持落定可读，绝不预先藏字。 */
  html.js .p-contact .p-card.is-inked .p-form > * {
    animation: contact-rise 480ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(280ms + var(--field-i, 0) * 68ms);
  }

  @for $i from 1 through 6 {
    .p-contact .p-form > :nth-child(#{$i}) {
      --field-i: #{$i - 1};
    }
  }

  /* 落笔时笺面微微受光 */
  .p-contact .p-form input,
  .p-contact .p-form textarea {
    transition:
      border-color 280ms ease,
      box-shadow 280ms ease,
      background-color 280ms ease;

    &:focus {
      background-color: color-mix(
        in srgb,
        var(--daypart-lamp) 7%,
        #{color(primary)}
      );
      box-shadow: 0 0 0 3px color-mix(in srgb, #{color(accent)} 12%, transparent);
    }
  }

  /* 写到消息栏时，信笺折角染一点朱砂 */
  .p-contact__letter-card:focus-within::before {
    background: linear-gradient(
      225deg,
      color-mix(in srgb, #{color(accent)} 55%, #{color(primary)}) 50%,
      transparent 51%
    );
  }

  /* 发送键：进行中一道墨色自左洗过 */
  .p-contact .p-form button[type='submit'] {
    position: relative;
    overflow: hidden;

    &:disabled::after {
      position: absolute;
      inset: 0;

      background: linear-gradient(
        90deg,
        transparent,
        color-mix(in srgb, #{color(accent)} 55%, transparent),
        transparent
      );

      content: '';
      pointer-events: none;

      animation: contact-ink-run 1.2s linear infinite;
    }
  }

  @keyframes contact-ink-run {
    from {
      transform: translateX(-100%);
    }

    to {
      transform: translateX(100%);
    }
  }

  /* 发送中：状态行用朱砂淡记，不和成功「收」印抢 */
  .p-contact .p-form__status.is-pending {
    color: color-mix(in srgb, #{color(secondary)} 72%, transparent);
  }

  /* 成信：状态行旁钤一记「收」印 */
  .p-contact .p-form__status.is-ok {
    position: relative;
    padding-right: 3.4rem;
  }

  .p-contact .p-form__status.is-ok::after {
    position: absolute;
    top: 50%;
    right: 0;

    display: grid;
    place-items: center;

    width: 1.85rem;
    height: 1.85rem;

    border: 1.5px solid color(accent-strong);
    border-radius: 0.12rem;

    color: color(accent-strong);
    font: 700 0.72rem / 1 font-family(editorial);

    content: '收';
    pointer-events: none;

    animation: contact-stamp 720ms cubic-bezier(0.2, 1.35, 0.32, 1) backwards;
    transform: translateY(-50%);
  }

  @keyframes contact-stamp {
    0% {
      opacity: 0;
      transform: translateY(-50%) rotate(-12deg) scale(1.7);
    }

    62% {
      opacity: 1;
      transform: translateY(-50%) rotate(-2deg) scale(0.94);
    }

    100% {
      opacity: 1;
      transform: translateY(-50%) rotate(-4deg) scale(1);
    }
  }

  /* 顶栏：像信头日期印，悬停时朱砂托起 */
  .p-contact .p-detail-meta--bar {
    transition: border-color 280ms ease, box-shadow 280ms ease;

    &:hover {
      border-color: color-mix(in srgb, #{color(accent)} 45%, transparent);
      box-shadow: 0 0.28rem 0 color-mix(in srgb, #{color(accent)} 40%, transparent);
    }
  }

  /* 落款印玺：信末右下，略小于首页卷尾那枚 */
  .p-contact__colophon {
    display: flex;
    justify-content: flex-end;

    margin-top: 2.25rem;

    .ink-seal3d {
      --body-w: 3.6rem;
      --body-h: 2.7rem;
      --knob-w: 1.5rem;
      --knob-h: 1.55rem;
      --hover-gap: 2.6rem;

      width: 8.6rem;
    }

    .ink-seal3d .scene {
      height: 10.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p-contact .p-card.is-inked .p-card__head,
    .p-contact .p-card.is-inked .p-card__title,
    .p-contact .p-card.is-inked .p-card__body,
    html.js .p-contact .p-card.is-inked .p-form > *,
    .p-contact .p-form button[type='submit']:disabled::after,
    .p-contact .p-form__status.is-ok::after,
    .p-contact .p-card__body li.is-ticked::after,
    .p-contact-blot {
      animation: none;
    }

    .p-contact .p-card__body li,
    .p-contact .p-form input,
    .p-contact .p-form textarea,
    .p-contact .p-detail-meta--bar,
    .p-contact .p-form__ink > i {
      transition: none;
    }

    .p-contact .p-card__body li:hover {
      transform: none;
    }
  }
</style>
