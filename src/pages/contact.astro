---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import PageCard from '@/components/pages/PageCard.astro'
import ContactForm from '@/islands/ContactForm'
---

<BaseLayout
  title="联系 · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
>
  <PageHero
    kicker="写信"
    title="联系"
    summary="合作、交流和反馈都可以写到这里。信息清楚、克制，不堆无关隐私。"
  />

  <main class="p-page p-page--wide">
    <div class="p-detail-meta p-detail-meta--bar" data-reveal>
      <span>3992237161@qq.com</span>
      <span>通常 48 小时内回复</span>
    </div>
    <div class="p-stack p-stack--2col" data-reveal>
      <PageCard kicker="合作" title="可以一起做的事">
        <p>适合交流的方向：</p>
        <ul>
          <li>网页与交互</li>
          <li>开源实验</li>
        </ul>
        <div class="p-card__actions">
          <a class="p-card__link" href="mailto:3992237161@qq.com"
             data-copy-email>邮件 3992237161@qq.com</a
          >
          <a
            class="p-card__link p-card__link--ghost"
            href="https://github.com/SSC-STUDIO"
            target="_blank"
            rel="noopener"
          >
            GitHub
          </a>
        </div>
      </PageCard>
      <PageCard kicker="留言" title="写一封信">
        <ContactForm client:load />
      </PageCard>
    </div>
  </main>

  <PageFoot current="/contact" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 联系页打磨(仅本页) ── */

  /* 消息字数提示:不足 10 字时的柔和提醒,区别于红色错误 */
  .p-form__field-hint {
    margin: 0.25rem 0 0;

    color: color-mix(in srgb, #{color(secondary)} 60%, transparent);
    font: 700 10px / 1.4 font-family(fraktion);
    letter-spacing: 0.08em;
    text-transform: none;
  }
</style>
