---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import ArticleMotion from '@/components/pages/ArticleMotion.astro'
import { articlePage } from './_view'

const { article, newer, minutes } = articlePage('ai-prototype-loop')
---

<BaseLayout
  title={`${article.title} · 陈润森`}
  description="从想法到可点击 demo 的四步循环：定义小问题、做最小交互、记录 tradeoff、复盘归档，速度优先但不牺牲可读性。"
>
  <PageHero kicker="article" title={article.title} summary={article.summary} />

  <main class="p-page p-article">
    <ArticleMotion />
    <div class="p-detail-meta" data-reveal>
      <span>发布于 {article.date}</span>
      <span>全文约 {article.words} 字 · {minutes} 分钟读完</span>
    </div>
    <div class="p-prose" data-reveal>
      <h2>循环</h2>
      <ol data-flow data-intersect>
        <li>
          <strong>定义一个问题</strong> — 足够小，能在 2 小时内验证。
        </li>
        <li>
          <strong>做最小交互</strong> — 一个输入、一个输出、一个失败路径。
        </li>
        <li>
          <strong>记录 tradeoff</strong> — 为什么选这个模型 / 框架 / UI 结构。
        </li>
        <li>
          <strong>复盘并归档</strong> — 写成文章或项目条目，避免经验蒸发。
        </li>
      </ol>
      <h2>原则</h2>
      <p>速度优先，但不牺牲可读的代码与文档。</p>
    </div>
    <div class="p-article-end" data-intersect>
      <button type="button" class="p-article-end__seal" aria-label="结章印，完">
        完
      </button>
    </div>
    <div class="p-chips" data-flow data-intersect>
      {article.tags.map((tag) => <span class="p-chip">{tag}</span>)}
    </div>
    {
      newer && (
        <nav class="p-article-nav" data-reveal aria-label="前后篇导航">
          <a class="p-article-nav__link" href={newer.href} data-seal data-leaf>
            <span class="p-article-nav__label">上一篇 · 更新</span>
            <span class="p-article-nav__title">← {newer.title}</span>
          </a>
        </nav>
      )
    }
    <p class="p-back" data-reveal>
      <a class="p-card__link p-card__link--ghost" href="/articles" data-seal
        >← 全部文章</a
      >
    </p>
  </main>

  <PageFoot current="/articles" />
</BaseLayout>
