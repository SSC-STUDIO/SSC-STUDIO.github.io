---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
---

<BaseLayout
  title="AI 原型的快速迭代循环 · 陈润森"
  description="从想法到可点击 demo 的四步循环：定义小问题、做最小交互、记录 tradeoff、复盘归档，速度优先但不牺牲可读性。"
>
  <PageHero
    kicker="article"
    title="AI 原型的快速迭代循环"
    summary="从想法到可点击 demo，我使用的四步循环。"
  />

  <main class="p-page p-article">
    <div class="p-detail-meta" data-reveal>
      <span>发布于 2026年2月15日</span>
      <span>全文约 200 字 · 1 分钟读完</span>
    </div>
    <div class="p-prose" data-reveal>
      <h2>循环</h2>
      <ol>
        <li>
          <strong>定义一个问题</strong> — 足够小，能在 2 小时内验证。
        </li>
        <li>
          <strong>做最小交互</strong> — 一个输入、一个输出、一个失败路径。
        </li>
        <li>
          <strong>记录 tradeoff</strong> — 为什么选这个模型 / 框架 / UI 结构。
        </li>
        <li>
          <strong>复盘并归档</strong> — 写成文章或项目条目，避免经验蒸发。
        </li>
      </ol>
      <h2>原则</h2>
      <p>速度优先，但不牺牲可读的代码与文档。</p>
    </div>
    <div class="p-article-end" data-reveal aria-hidden="true">
      <span class="p-article-end__seal">完</span>
    </div>
    <div class="p-chips" data-reveal>
      <span class="p-chip">ai</span>
      <span class="p-chip">engineering</span>
    </div>
    <nav class="p-article-nav" data-reveal aria-label="前后篇导航">
      <a class="p-article-nav__link" href="/articles/why-build-personal-site">
        <span class="p-article-nav__label">上一篇 · 更新</span>
        <span class="p-article-nav__title">← 为什么还在做个人网站</span>
      </a>
    </nav>
    <p class="p-back" data-reveal>
      <a class="p-card__link p-card__link--ghost" href="/articles">← 全部文章</a>
    </p>
  </main>

  <PageFoot current="/articles" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 文章页结章与前后篇（仅作用于 .p-article）── */

  /* 文末结章：一枚「完」字小印，朱丝双线相夹，如卷终钤记 */
  .p-article .p-article-end {
    display: flex;
    align-items: center;
    gap: 1rem;

    margin-top: 2.25rem;

    &::before,
    &::after {
      content: '';
      flex: 1;
      height: 1.5px;
      background: linear-gradient(
        90deg,
        transparent,
        color-mix(in srgb, #{color(accent)} 55%, transparent)
      );
    }

    &::after {
      background: linear-gradient(
        90deg,
        color-mix(in srgb, #{color(accent)} 55%, transparent),
        transparent
      );
    }

    &__seal {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      width: 2.1rem;
      height: 2.1rem;

      border: 1.5px solid color(accent);

      color: color(accent);
      font: 700 1rem / 1 font-family(bigger);

      transform: rotate(-4deg);
    }
  }

  /* 前后篇导航：一枚横陈的去向牌 */
  .p-article .p-article-nav {
    margin-top: 1.75rem;

    &__link {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;

      padding: 0.9rem 1.1rem;

      border: 1px solid color-mix(in srgb, #{color(secondary)} 35%, transparent);
      background: color(primary);

      text-decoration: none;

      transition:
        transform 0.3s ease(out-quint),
        border-color 0.2s ease,
        background 0.2s ease;

      &:hover,
      &:focus-visible {
        border-color: color(accent);
        background: color-mix(in srgb, #{color(accent)} 8%, transparent);
        transform: translateY(-2px);
      }

      &:focus-visible {
        outline: 2px solid color(accent);
        outline-offset: 2px;
      }

      @media (prefers-reduced-motion: reduce) {
        &:hover,
        &:focus-visible {
          transform: none;
        }
      }
    }

    &__label {
      color: color-mix(in srgb, #{color(secondary)} 60%, transparent);
      font: 700 9px / 1 font-family(fraktion);
      letter-spacing: 0.16em;
    }

    &__title {
      color: color(secondary);
      font: 700 1.05rem / 1.35 font-family(bigger);
    }
  }
</style>
