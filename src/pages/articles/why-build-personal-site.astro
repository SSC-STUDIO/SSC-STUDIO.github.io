---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
---

<BaseLayout
  title="为什么还在做个人网站 · 陈润森"
  description="在模板和社交平台之间，个人站仍然值得投入：叙事控制权、实验场与长期资产，三个坚持自建站点的理由。"
>
  <PageHero
    kicker="article"
    title="为什么还在做个人网站"
    summary="在模板和社交平台之间，个人站仍然值得投入。"
  />

  <main class="p-page p-article">
    <div class="p-detail-meta" data-reveal>
      <span>发布于 2026年3月1日</span>
      <span>全文约 260 字 · 1 分钟读完</span>
      <span class="p-detail-meta__badge">Featured</span>
    </div>
    <div class="p-prose" data-reveal>
      <h2>问题</h2>
      <p>
        当 GitHub README 和 Notion
        页面已经能展示作品时，为什么还要维护一个独立的个人网站？
      </p>
      <h2>我的答案</h2>
      <ol>
        <li>
          <strong>叙事控制权</strong> —
          你可以决定第一帧看到什么，而不是被平台模板限制。
        </li>
        <li>
          <strong>实验场</strong> —
          网站本身就是作品，动效、交互、工程架构都可以被展示。
        </li>
        <li>
          <strong>长期资产</strong> —
          文章、项目、荣誉放在同一套系统里，形成可检索的个人历史。
        </li>
      </ol>
      <h2>下一步</h2>
      <p>继续把 AI 实验、班级记忆和工程复盘写进同一条时间线。</p>
    </div>
    <div class="p-article-end" data-reveal aria-hidden="true">
      <span class="p-article-end__seal">完</span>
    </div>
    <div class="p-chips" data-reveal>
      <span class="p-chip">meta</span>
      <span class="p-chip">writing</span>
    </div>
    <nav class="p-article-nav" data-reveal aria-label="前后篇导航">
      <a class="p-article-nav__link" href="/articles/ai-prototype-loop">
        <span class="p-article-nav__label">下一篇 · 更早</span>
        <span class="p-article-nav__title">AI 原型的快速迭代循环 →</span>
      </a>
    </nav>
    <p class="p-back" data-reveal>
      <a class="p-card__link p-card__link--ghost" href="/articles">← 全部文章</a>
    </p>
  </main>

  <PageFoot current="/articles" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 文章页结章与前后篇（仅作用于 .p-article）── */

  /* 文末结章：一枚「完」字小印，朱丝双线相夹，如卷终钤记 */
  .p-article .p-article-end {
    display: flex;
    align-items: center;
    gap: 1rem;

    margin-top: 2.25rem;

    &::before,
    &::after {
      content: '';
      flex: 1;
      height: 1.5px;
      background: linear-gradient(
        90deg,
        transparent,
        color-mix(in srgb, #{color(accent)} 55%, transparent)
      );
    }

    &::after {
      background: linear-gradient(
        90deg,
        color-mix(in srgb, #{color(accent)} 55%, transparent),
        transparent
      );
    }

    &__seal {
      display: inline-flex;
      align-items: center;
      justify-content: center;

      width: 2.1rem;
      height: 2.1rem;

      border: 1.5px solid color(accent);

      color: color(accent);
      font: 700 1rem / 1 font-family(bigger);

      transform: rotate(-4deg);
    }
  }

  /* 前后篇导航：一枚横陈的去向牌 */
  .p-article .p-article-nav {
    margin-top: 1.75rem;

    &__link {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;

      padding: 0.9rem 1.1rem;

      border: 1px solid color-mix(in srgb, #{color(secondary)} 35%, transparent);
      background: color(primary);

      text-decoration: none;

      transition:
        transform 0.3s ease(out-quint),
        border-color 0.2s ease,
        background 0.2s ease;

      &:hover,
      &:focus-visible {
        border-color: color(accent);
        background: color-mix(in srgb, #{color(accent)} 8%, transparent);
        transform: translateY(-2px);
      }

      &:focus-visible {
        outline: 2px solid color(accent);
        outline-offset: 2px;
      }

      @media (prefers-reduced-motion: reduce) {
        &:hover,
        &:focus-visible {
          transform: none;
        }
      }
    }

    &__label {
      color: color-mix(in srgb, #{color(secondary)} 60%, transparent);
      font: 700 9px / 1 font-family(fraktion);
      letter-spacing: 0.16em;
    }

    &__title {
      color: color(secondary);
      font: 700 1.05rem / 1.35 font-family(bigger);
    }
  }
</style>
