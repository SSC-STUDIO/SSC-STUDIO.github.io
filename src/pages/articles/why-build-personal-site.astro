---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import ArticleMotion from '@/components/pages/ArticleMotion.astro'
---

<BaseLayout
  title="为什么还在做个人网站 · 陈润森"
  description="在模板和社交平台之间，个人站仍然值得投入：叙事控制权、实验场与长期资产，三个坚持自建站点的理由。"
>
  <PageHero
    kicker="article"
    title="为什么还在做个人网站"
    summary="在模板和社交平台之间，个人站仍然值得投入。"
  />

  <main class="p-page p-article">
    <ArticleMotion />
    <div class="p-detail-meta" data-reveal>
      <span>发布于 2026年3月1日</span>
      <span>全文约 260 字 · 1 分钟读完</span>
      <span class="p-detail-meta__badge">Featured</span>
    </div>
    <div class="p-prose" data-reveal>
      <h2>问题</h2>
      <p>
        当 GitHub README 和 Notion
        页面已经能展示作品时，为什么还要维护一个独立的个人网站？
      </p>
      <h2>我的答案</h2>
      <ol data-flow data-intersect>
        <li>
          <strong>叙事控制权</strong> —
          你可以决定第一帧看到什么，而不是被平台模板限制。
        </li>
        <li>
          <strong>实验场</strong> —
          网站本身就是作品，动效、交互、工程架构都可以被展示。
        </li>
        <li>
          <strong>长期资产</strong> —
          文章、项目、荣誉放在同一套系统里，形成可检索的个人历史。
        </li>
      </ol>
      <h2>下一步</h2>
      <p>继续把 AI 实验、班级记忆和工程复盘写进同一条时间线。</p>
    </div>
    <div class="p-article-end" data-intersect>
      <button type="button" class="p-article-end__seal" aria-label="结章印，完">
        完
      </button>
    </div>
    <div class="p-chips" data-flow data-intersect>
      <span class="p-chip">meta</span>
      <span class="p-chip">writing</span>
    </div>
    <nav class="p-article-nav" data-reveal aria-label="前后篇导航">
      <a
        class="p-article-nav__link"
        href="/articles/ai-prototype-loop"
        data-seal
        data-leaf
      >
        <span class="p-article-nav__label">下一篇 · 更早</span>
        <span class="p-article-nav__title">AI 原型的快速迭代循环 →</span>
      </a>
    </nav>
    <p class="p-back" data-reveal>
      <a class="p-card__link p-card__link--ghost" href="/articles" data-seal
        >← 全部文章</a
      >
    </p>
  </main>

  <PageFoot current="/articles" />
</BaseLayout>
