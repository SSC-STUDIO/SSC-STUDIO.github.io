---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import PageCard from '@/components/pages/PageCard.astro'
import PageAura from '@/components/pages/PageAura.astro'
import { articles } from '@/data/articles'
import { readingGauge, readingMinutes } from './_view'

const total = articles.length
const pad = (n: number) => String(n).padStart(2, '0')
---

<BaseLayout
  title="Articles · 陈润森"
  description="文章目录：工程复盘、AI 实验笔记与关于个人网站的长期思考，把灵感写慢、把问题写透。"
>
  <PageHero
    kicker="content"
    title="Articles"
    summary="把灵感写慢，把问题写透，让笔记成为下一次出发的地图。"
  />

  <main class="p-page p-page--wide p-articles">
    <PageAura />
    <span class="p-articles__glyph" aria-hidden="true">文</span>
    <p class="p-articles-count" data-reveal>
      卷内共 <ink-tally class="p-articles-count__n" data-to={total}>{total}</ink-tally
      > 篇 · 依时间倒序陈列
    </p>
    <article-index-feel class="p-stack p-stack--cards">
      {
        articles.map((article, index) => (
          <PageCard
            href={article.href}
            kicker={article.kicker}
            id={`#ART-${pad(index + 1)}/${pad(total)}`}
            title={article.title}
            class={article.kicker === 'featured' ? 'p-articles__lead' : undefined}
            fold
          >
            {article.kicker === 'featured' && (
              <span class="p-articles__first" aria-hidden="true">
                首
              </span>
            )}
            <p>{article.summary}</p>
            <p class="p-card__meta">
              {article.date} · 约 {readingMinutes(article.words)} 分钟读完
            </p>
            <span
              class="p-articles__gauge"
              aria-hidden="true"
              style={`--gauge:${readingGauge(article.words)}`}
            />
            <div class="p-card__tags">
              {article.tags.map((tag) => (
                <span class="p-card__tag">{tag}</span>
              ))}
            </div>
          </PageCard>
        ))
      }
    </article-index-feel>
  </main>

  <PageFoot current="/articles" />
</BaseLayout>

<script>
  import { prefersReducedMotion } from '@/motion/core'

  /**
   * ink-tally —— 数目自零点起，如算珠一颗颗拨过去。
   * 服务端已经把最终数写在标签里：脚本缺席也读得到正确的数。
   */
  class InkTally extends HTMLElement {
    observer: IntersectionObserver | null = null
    raf = 0

    connectedCallback() {
      const to = Number(this.dataset.to || this.textContent || 0)
      if (!to) return

      if (prefersReducedMotion()) {
        this.textContent = String(to)
        return
      }

      const start = () => {
        this.observer?.disconnect()
        this.observer = null
        this.run(to)
      }

      const rect = this.getBoundingClientRect()
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        start()
        return
      }

      this.observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return
          start()
        },
        { threshold: 0.2 }
      )

      this.observer.observe(this)
    }

    disconnectedCallback() {
      this.observer?.disconnect()
      this.observer = null
      cancelAnimationFrame(this.raf)
    }

    run(to: number) {
      const start = performance.now()
      const span = 360 + to * 40

      const step = (now: number) => {
        const t = Math.min((now - start) / span, 1)
        const eased = 1 - Math.pow(1 - t, 3)
        this.textContent = String(Math.round(eased * to))

        if (t < 1) this.raf = requestAnimationFrame(step)
        else this.classList.add('is-tallied')
      }

      this.raf = requestAnimationFrame(step)
    }
  }

  if (!customElements.get('ink-tally')) {
    customElements.define('ink-tally', InkTally)
  }

  /**
   * 目录卡受光：指针在卡面上走，高光跟着横移（写法同荣誉奖状）。
   * 触屏 / reduced-motion 不跟指针，悬停扫光仍由 CSS 兜底。
   */
  class ArticleIndexFeel extends HTMLElement {
    onMove: ((event: PointerEvent) => void) | null = null
    onLeave: (() => void) | null = null

    connectedCallback() {
      if (prefersReducedMotion()) return
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        return
      }

      this.onMove = (event) => {
        const card = (event.target as Element | null)?.closest<HTMLElement>('.p-card')
        this.querySelectorAll<HTMLElement>('.p-card.is-sheen-live').forEach((el) => {
          if (el !== card) el.classList.remove('is-sheen-live')
        })
        if (!card || !this.contains(card)) return

        const rect = card.getBoundingClientRect()
        const x = (event.clientX - rect.left) / Math.max(1, rect.width) - 0.5
        card.style.setProperty('--leaf-sheen', (0.5 - x).toFixed(3))
        card.classList.add('is-sheen-live')
      }

      this.onLeave = () => {
        this.querySelectorAll<HTMLElement>('.p-card.is-sheen-live').forEach((el) => {
          el.classList.remove('is-sheen-live')
        })
      }

      this.addEventListener('pointermove', this.onMove, { passive: true })
      this.addEventListener('pointerleave', this.onLeave)
    }

    disconnectedCallback() {
      if (this.onMove) this.removeEventListener('pointermove', this.onMove)
      if (this.onLeave) this.removeEventListener('pointerleave', this.onLeave)
      this.onMove = null
      this.onLeave = null
    }
  }

  if (!customElements.get('article-index-feel')) {
    customElements.define('article-index-feel', ArticleIndexFeel)
  }
</script>

<style lang="scss" is:global>
  /* 卷底题字：替短目录垫一层纵深，不抢卡片 */
  .p-articles__glyph {
    position: absolute;
    top: 0.35rem;
    right: clamp(1rem, 4vw, 2.5rem);
    z-index: -1;

    color: color(secondary);
    font: 700 clamp(5rem, 16vw, 9rem) / 1 font-family(bigger);

    opacity: 0.05;
    pointer-events: none;
    user-select: none;
  }

  /* 卷首计数：如册页题记，一行小字压在卡片群之上 */
  .p-articles-count {
    margin: 0 0 1.25rem;

    color: color-mix(in srgb, #{color(secondary)} 60%, transparent);
    font: 400 0.85rem / 1.4 font-family(editorial);
    letter-spacing: 0.08em;

    strong,
    .p-articles-count__n {
      color: color(accent);
      font-family: font-family(fraktion);
      font-weight: 700;
    }

    .p-articles-count__n {
      display: inline-block;
      min-width: 1ch;

      text-align: center;
    }

    .p-articles-count__n.is-tallied {
      animation: p-tally-land 460ms cubic-bezier(0.34, 1.56, 0.64, 1);
    }
  }

  @keyframes p-tally-land {
    0% {
      transform: translateY(0) scale(1);
    }
    45% {
      transform: translateY(-0.18em) scale(1.22);
    }
    100% {
      transform: translateY(0) scale(1);
    }
  }

  /* 篇幅尺：默认可读，长短即阅读时长；入墨后再自左量出 */
  .p-articles .p-articles__gauge {
    position: relative;

    display: block;

    height: 2px;
    margin: 0.55rem 0 0;

    background: color-mix(in srgb, #{color(secondary)} 14%, transparent);

    &::after {
      position: absolute;
      inset: 0;

      background: linear-gradient(90deg, color(accent), color(accent-strong));
      box-shadow: 0 0 8px color-mix(in srgb, #{color(accent)} 28%, transparent);

      content: '';
      transform: scaleX(var(--gauge, 0.3));
      transform-origin: left center;
      transition:
        transform 620ms cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 280ms ease;
    }
  }

  html.js .p-articles .p-card:not(.is-inked) .p-articles__gauge::after {
    transform: scaleX(0);
  }

  .p-articles .p-card:hover .p-articles__gauge::after,
  .p-articles .p-card:focus-visible .p-articles__gauge::after {
    box-shadow: 0 0 12px color-mix(in srgb, #{color(accent)} 55%, transparent);
  }

  /* 头篇：右上钤一枚「首」印，对照首页落章 */
  .p-articles .p-articles__lead {
    position: relative;
  }

  .p-articles__first {
    position: absolute;
    top: 0.85rem;
    right: 0.95rem;
    z-index: 3;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 1.7rem;
    height: 1.7rem;

    border: 1.5px solid color(accent-strong);
    background: color(primary);
    box-shadow:
      inset 0 0 0 2px color-mix(in srgb, #{color(accent)} 40%, transparent),
      0 6px 14px color-mix(in srgb, #{color(accent)} 26%, transparent);

    color: color(accent-strong);
    font: 700 0.72rem / 1 font-family(bigger);

    pointer-events: none;
    transform: rotate(-8deg);

    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  html.js .p-articles .p-articles__lead.is-inked .p-articles__first {
    animation: p-articles-stamp 720ms cubic-bezier(0.2, 1.35, 0.32, 1) backwards;
  }

  .p-articles .p-articles__lead:hover .p-articles__first,
  .p-articles .p-articles__lead:focus-visible .p-articles__first {
    transform: rotate(-3deg) scale(1.08);
  }

  @keyframes p-articles-stamp {
    0% {
      opacity: 0;
      transform: translateY(-10px) scale(2.3) rotate(-18deg);
    }

    55% {
      opacity: 1;
      transform: translateY(0) scale(0.92) rotate(-4deg);
    }

    78% {
      transform: scale(1.06) rotate(-7deg);
    }

    100% {
      opacity: 1;
      transform: scale(1) rotate(-8deg);
    }
  }

  /* 卡面受光：默认一道浅扫，指针精细时改跟 --leaf-sheen */
  .p-articles .p-card {
    --leaf-sheen: 0.5;
  }

  .p-articles .p-card::after {
    position: absolute;
    inset: 0;
    z-index: 2;

    background: linear-gradient(
      100deg,
      transparent calc(var(--leaf-sheen, 0.5) * 100% - 22%),
      color-mix(in srgb, #{color(primary)} 30%, transparent)
        calc(var(--leaf-sheen, 0.5) * 100%),
      transparent calc(var(--leaf-sheen, 0.5) * 100% + 22%)
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: translateX(-18%);
    transition:
      opacity 0.4s ease(out-quint),
      transform 720ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-articles .p-card.is-sheen-live::after {
    transform: none;
    transition: opacity 0.4s ease(out-quint);
  }

  .p-articles .p-card:hover::after,
  .p-articles .p-card:focus-visible::after {
    opacity: 1;
    transform: translateX(18%);
  }

  .p-articles .p-card.is-sheen-live:hover::after,
  .p-articles .p-card.is-sheen-live:focus-visible::after {
    transform: none;
  }

  /* 悬停托底、按下回弹，对照荣誉奖状 */
  .p-articles .p-card:hover,
  .p-articles .p-card:focus-visible {
    border-color: color(accent);
    box-shadow: 0 0.45rem 0 color-mix(in srgb, #{color(accent)} 65%, transparent);
  }

  .p-articles .p-card:active {
    --card-lift: 1px;

    box-shadow: 0 0.2rem 0 color-mix(in srgb, #{color(accent)} 50%, transparent);
  }

  /* 卷号签：悬停时像被指尖掀了一下 */
  .p-articles .p-card__id {
    display: inline-block;

    transition: transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .p-articles .p-card:hover .p-card__id {
    transform: rotate(-2.5deg) translateY(-1px);
  }

  .p-articles .p-card__tag {
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 260ms ease;
  }

  .p-articles .p-card:hover .p-card__tag {
    transform: translate3d(0, -1px, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .p-articles .p-articles__gauge::after {
      transform: scaleX(var(--gauge, 0.3));
      transition: none;
    }

    html.js .p-articles .p-card:not(.is-inked) .p-articles__gauge::after {
      transform: scaleX(var(--gauge, 0.3));
    }

    .p-articles .p-card__id,
    .p-articles-count__n.is-tallied,
    .p-articles .p-card::after,
    .p-articles .p-card__tag,
    .p-articles__first {
      transform: none;
      transition: none;
      animation: none;
    }

    .p-articles .p-card:hover,
    .p-articles .p-card:focus-visible,
    .p-articles .p-card:active {
      transform: none;
    }

    .p-articles .p-card::after,
    .p-articles .p-card:hover::after {
      opacity: 0;
    }

    html.js .p-articles .p-articles__lead.is-inked .p-articles__first,
    .p-articles .p-articles__lead:hover .p-articles__first {
      animation: none;
      transform: rotate(-8deg);
    }
  }
</style>
