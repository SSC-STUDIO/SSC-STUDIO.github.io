---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
---

<BaseLayout
  title="Admin · 陈润森"
  description="管理后台尚未开放。"
  robots="noindex, nofollow"
>
  <PageHero
    kicker="ADMIN · 管理"
    title="管理后台"
    summary="后台尚未上线，这里没有可操作的控制台。"
  />

  <main class="p-page">
    <div class="p-lock p-admin__lock" data-reveal>
      <p class="p-lock__badge">迁移中</p>
      <p class="p-lock__message">
        管理后台尚未完成，当前没有可操作的控制台。
      </p>
      <p class="p-admin__note">
        本页不对搜索引擎收录。需要账号时请从首页进入登录。
      </p>
      <div class="p-card__actions">
        <a class="p-card__link" href="/account?returnTo=/admin"> 账号登录 </a>
        <a class="p-card__link p-card__link--ghost" href="/"> 返回首页 </a>
      </div>
    </div>
  </main>

  <PageFoot />
</BaseLayout>

<style lang="scss" is:global>
  .p-admin__lock {
    max-width: 36rem;
    margin-inline: auto;
  }

  .p-admin__note {
    margin: 0 0 1.25rem;
    color: color-mix(in srgb, #{color(secondary)} 60%, transparent);
    font: 400 0.85rem / 1.6 font-family(editorial);
  }
</style>
