---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
---

<BaseLayout
  title="Admin · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
>
  <PageHero
    kicker="admin"
    title="Admin"
    summary="管理员控制台：内容、用户与站点运营。"
  />

  <main class="p-page">
    <div class="p-lock">
      <p class="p-lock__badge">迁移中</p>
      <p class="p-lock__message">
        管理后台需要管理员权限，完整 CRUD 控制台仍在迁移中。
      </p>
      <div class="p-card__actions">
        <a class="p-card__link" href="/account"> 账号登录 </a>
        <a class="p-card__link p-card__link--ghost" href="/"> 返回首页 </a>
      </div>
    </div>
  </main>

  <PageFoot />
</BaseLayout>
