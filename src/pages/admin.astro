---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
---

<BaseLayout
  title="Admin · 陈润森"
  description="管理后台：内容、用户与站点运营的控制台（迁移中）。"
>
  <PageHero
    kicker="ADMIN · 管理"
    title="管理后台"
    summary="管理员控制台：内容、用户与站点运营。"
  />

  <main class="p-page">
    <div class="p-lock p-admin__lock" data-reveal>
      <p class="p-lock__badge">迁移中</p>
      <p class="p-lock__message">
        管理后台需要管理员权限，完整 CRUD 控制台仍在迁移中。
      </p>
      <p class="p-admin__note">
        控制台上线后，这里会提供内容、用户与站点运营的管理入口。
      </p>
      <div class="p-card__actions">
        <a class="p-card__link" href="/account?returnTo=/admin"> 账号登录 </a>
        <a class="p-card__link p-card__link--ghost" href="/"> 返回首页 </a>
      </div>
    </div>
  </main>

  <PageFoot />
</BaseLayout>

<style lang="scss" is:global>
  .p-admin__lock {
    max-width: 36rem;
    margin-inline: auto;
  }

  .p-admin__note {
    margin: 0 0 1.25rem;
    color: color-mix(in srgb, #{color(secondary)} 60%, transparent);
    font: 400 0.85rem / 1.6 font-family(editorial);
  }
</style>
