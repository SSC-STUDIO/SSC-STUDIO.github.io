---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import PageCard from '@/components/pages/PageCard.astro'
---

<BaseLayout
  title="Games · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
>
  <PageHero
    kicker="experiment"
    title="Games"
    summary="游戏区是可玩的实验场：规则、反应和手感做成小游戏，统一入口连接排行榜与试玩。"
  />

  <main class="p-page p-page--wide">
    <div class="p-grid">
      <PageCard
        href="/benchmarks"
        kicker="web"
        id="#GME-01/03"
        title="Human Benchmark"
      >
        <p>反应与记忆挑战合集，支持分数提交。</p>
        <div class="p-card__actions">
          <span class="p-card__tag">available</span>
        </div>
      </PageCard>
      <PageCard
        href="/reaction-test"
        kicker="web"
        id="#GME-02/03"
        title="Reaction Test"
      >
        <p>快速反应挑战，精简版体验入口。</p>
        <div class="p-card__actions">
          <span class="p-card__tag">available</span>
        </div>
      </PageCard>
      <PageCard
        href="/class/gallery"
        kicker="media"
        id="#GME-03/03"
        title="Class Media Experience"
      >
        <p>班级相册与视频浏览体验。</p>
        <div class="p-card__actions">
          <span class="p-card__tag">available</span>
        </div>
      </PageCard>
    </div>
  </main>

  <PageFoot current="/games" />
</BaseLayout>
