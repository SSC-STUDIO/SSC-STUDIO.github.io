---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import ProjectCover from '@/components/pages/ProjectCover.astro'
import ProjectNav from '@/components/pages/ProjectNav.astro'
import ProjectDetailMotion from '@/components/pages/ProjectDetailMotion.astro'
---

<BaseLayout
  title="Honors & Growth · 陈润森"
  description="Honors & Growth：创客、竞赛与成长节点——努力被看见的那些瞬间。"
>
  <PageHero
    kicker="project · 2024"
    title="Honors & Growth"
    summary="创客、竞赛与成长节点 — 努力被看见的那些瞬间。"
  />

  <main class="p-page p-detail">
    <nav class="p-crumbs" data-reveal aria-label="所在位置">
      <a href="/">首页</a>
      <span class="p-crumbs__sep">/</span>
      <a href="/projects">项目</a>
      <span class="p-crumbs__sep">/</span>
      <span aria-current="page">Honors & Growth</span>
    </nav>
    <div class="p-detail-meta" data-flow data-intersect>
      <span class="p-detail-meta__badge">active</span>
      <span>2024 起 · 持续收录</span>
      <span>project 08 / 08</span>
    </div>
    <ProjectCover slug="honors" />
    <div class="p-prose" data-intersect>
      <h2>荣誉墙</h2>
      <p>
        奖项不是终点，是一些被照亮的路标：信息学竞赛（CSP-J、NOC）、
        创客与车辆模型、书法与综合素养。每一张奖状背后都对应一段具体的
        准备过程——它们都被扫描存档，收进同一面<a href="/honors">荣誉墙</a>。
      </p>
      <h2>成长河流</h2>
      <p>
        奖项之外，成长更像一条河：从小学毕业到初中毕业，再到如今这个
        长期项目。荣誉页里的「成长河流」时间线，把这些节点连成了可以
        顺流而下的形状。
      </p>
    </div>
    <div class="p-chips" data-flow data-intersect>
      <span class="p-card__tag">Scratch</span>
      <span class="p-card__tag">创客</span>
      <span class="p-card__tag">信息学</span>
    </div>
    <div class="p-card__actions" data-flow data-intersect>
      <a class="p-card__link" href="/honors" data-seal> 荣誉墙与成长河流 </a>
      <a class="p-card__link" href="/about" data-seal> 关于我 </a>
    </div>
    <ProjectNav slug="honors" />

    <ProjectDetailMotion />
  </main>

  <PageFoot current="/projects" />
</BaseLayout>
