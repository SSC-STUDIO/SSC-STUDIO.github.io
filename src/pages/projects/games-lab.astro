---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
---

<BaseLayout
  title="Games Lab · 陈润森"
  description="Games Lab：把棋盘规则、弹幕生存与 Godot 竞技场做成可试玩的游戏集合。"
>
  <PageHero
    kicker="project · 2025"
    title="Games Lab"
    summary="把棋盘规则、弹幕生存与 Godot 竞技场做成可试玩的游戏集合。"
  />

  <main class="p-page">
    <nav class="p-crumbs" data-reveal aria-label="所在位置">
      <a href="/">首页</a>
      <span class="p-crumbs__sep">/</span>
      <a href="/projects">项目</a>
      <span class="p-crumbs__sep">/</span>
      <span aria-current="page">Games Lab</span>
    </nav>
    <div class="p-detail-meta" data-reveal>
      <span class="p-detail-meta__badge">active</span>
      <span>2025 · 持续迭代</span>
      <span>project 04 / 08</span>
    </div>
    <figure class="p-detail-figure" data-reveal>
      <img
        class="p-detail-cover"
        src="/images/work-covers/games.svg"
        alt="Games Lab"
        width="1082"
        height="636"
        loading="lazy"
      />
      <figcaption>FIG.01 · Games Lab</figcaption>
    </figure>
    <div class="p-prose" data-reveal>
      <p>游戏是最喜欢的实验田：规则要硬，手感要软。</p>
      <h2>收进来的三类尝试</h2>
      <ul>
        <li>浏览器里的经典棋盘变体——多棋类合集，规则、对局与复盘一页搞定；</li>
        <li>Vampire Survivors 式的弹幕生存 Roguelite；</li>
        <li>
          Godot 引擎里的竞技场原型——升级、构筑、诅咒词条一应俱全。
        </li>
      </ul>
      <h2>试玩与源码</h2>
      <p>
        一部分作品直接内置在本站的<a href="/benchmarks">反应力实验室</a
        >，即点即玩；完整源码都在 GitHub
        上开放，欢迎翻进仓库看实现细节。
      </p>
    </div>
    <div class="p-chips" data-reveal>
      <span class="p-card__tag">JavaScript</span>
      <span class="p-card__tag">GDScript</span>
      <span class="p-card__tag">Godot</span>
    </div>
    <div class="p-card__actions" data-reveal>
      <a class="p-card__link" href="/benchmarks"> 站内试玩 </a>
      <a
        class="p-card__link"
        href="https://github.com/SSC-STUDIO/Multi-Board-Game-Collection"
        target="_blank"
        rel="noopener noreferrer"
      >
        Multi-Board-Game-Collection
      </a>
      <a
        class="p-card__link"
        href="https://github.com/SSC-STUDIO/GreedySnake-2026"
        target="_blank"
        rel="noopener noreferrer"
      >
        GreedySnake-2026
      </a>
    </div>
    <nav class="p-projnav" data-reveal aria-label="相邻项目">
      <a class="p-projnav__link" href="/projects/interactive-game-kit">
        <span class="p-projnav__dir">← 上一个</span>
        <span class="p-projnav__name">Interactive Game Kit</span>
      </a>
      <a class="p-projnav__link p-projnav__link--index" href="/projects">
        全部项目
      </a>
      <a class="p-projnav__link p-projnav__link--next" href="/projects/benchmarks">
        <span class="p-projnav__dir">下一个 →</span>
        <span class="p-projnav__name">Human Benchmarks</span>
      </a>
    </nav>
  </main>

  <PageFoot current="/projects" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 详情页公共小件（面包屑 + 相邻项目导航）──
   * 注：8 个项目详情页各自内联一份，待共享层开放后应上移到 _pages.scss。
   */

  .p-crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;

    margin: 0 0 1.35rem;

    color: color-mix(in srgb, #{color(secondary)} 55%, transparent);
    font: 700 10px / 1 font-family(fraktion);
    letter-spacing: 0.16em;
    text-transform: none;

    a {
      color: inherit;
      text-decoration: none;
      transition: color 0.2s ease;

      &:hover,
      &:focus-visible {
        color: color(accent);
      }
    }

    [aria-current='page'] {
      color: color(secondary);
    }

    &__sep {
      color: color-mix(in srgb, #{color(accent)} 70%, transparent);
    }
  }

  .p-projnav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 0.75rem;

    margin-top: 2.5rem;
    padding-top: 1.5rem;

    border-top: 1.5px dashed color-mix(in srgb, #{color(accent)} 45%, transparent);

    &__link {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;

      padding: 0.9rem 1rem;

      border: 1px solid color-mix(in srgb, #{color(secondary)} 35%, transparent);

      text-decoration: none;

      transition:
        transform 0.45s ease(out-quint),
        border-color 0.2s ease;

      &:hover,
      &:focus-visible {
        border-color: color(accent);
        transform: translateY(-2px);
      }

      &:focus-visible {
        outline: 2px solid color(accent);
        outline-offset: 2px;
      }

      @media (prefers-reduced-motion: reduce) {
        &:hover,
        &:focus-visible {
          transform: none;
        }
      }
    }

    &__link--next {
      text-align: right;
      align-items: flex-end;
    }

    &__link--index {
      align-self: center;

      padding: 0.6rem 0.9rem;

      border: 0;

      color: color-mix(in srgb, #{color(secondary)} 65%, transparent);
      font: 700 10px / 1 font-family(fraktion);
      letter-spacing: 0.14em;

      &:hover,
      &:focus-visible {
        color: color(accent);
      }
    }

    &__dir {
      color: color-mix(in srgb, #{color(secondary)} 55%, transparent);
      font: 700 9px / 1 font-family(fraktion);
      letter-spacing: 0.18em;
      text-transform: none;
    }

    &__name {
      color: color(secondary);
      font: 400 0.95rem / 1.35 font-family(editorial);
    }

    @include mq(phone) {
      grid-template-columns: 1fr;

      &__link--next {
        text-align: left;
        align-items: flex-start;
      }

      &__link--index {
        order: 3;
        justify-self: center;
      }
    }
  }
</style>
