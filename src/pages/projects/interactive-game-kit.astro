---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import ProjectDetailMotion from '@/components/pages/ProjectDetailMotion.astro'
---

<BaseLayout
  title="Interactive Game Kit · 陈润森"
  description="Interactive Game Kit：浏览器棋类、弹幕 Roguelite 与 Godot 竞技场原型——手感、反馈与排行榜一体。"
>
  <PageHero
    kicker="project · 2025"
    title="Interactive Game Kit"
    summary="浏览器棋类、Roguelite 与 Godot 原型 — 手感、反馈与排行榜一体。"
  />

  <main class="p-page p-detail">
    <nav class="p-crumbs" data-reveal aria-label="所在位置">
      <a href="/">首页</a>
      <span class="p-crumbs__sep">/</span>
      <a href="/projects">项目</a>
      <span class="p-crumbs__sep">/</span>
      <span aria-current="page">Interactive Game Kit</span>
    </nav>
    <div class="p-detail-meta" data-flow data-intersect>
      <span class="p-detail-meta__badge">active</span>
      <span>2025 · 持续迭代</span>
      <span>project 03 / 08</span>
    </div>
    <figure class="p-detail-figure" data-reveal data-leaf>
      <span class="p-detail-figure__plate">
        <img
          class="p-detail-cover"
          src="/images/work-covers/game-kit.svg"
          alt="Interactive Game Kit"
          width="1082"
          height="636"
          loading="lazy"
        />
      </span>
      <figcaption>FIG.01 · Interactive Game Kit</figcaption>
    </figure>
    <div class="p-prose" data-intersect>
      <p>把「好玩」拆成三件事：规则、手感、反馈——每条产品线各攻一件。</p>
      <h2>三条产品线</h2>
      <ul>
        <li>
          <strong>Multi-Board-Game-Collection</strong> —
          浏览器里的多款棋类合集，把规则、对局与复盘做进一个随手可开的页面；
        </li>
        <li>
          <strong>Survivor-Arena</strong> — Vampire Survivors
          式的弹幕生存 Roguelite，主攻手感与波次节奏；
        </li>
        <li>
          <strong>GreedySnake-2026</strong> — Godot 4.6 的 Roguelite
          竞技场生存贪吃蛇：5 种模式、24 项升级、10 套流派构筑、4
          种诅咒变体与 29 个成就，中英双语。
        </li>
      </ul>
      <h2>与本站的关系</h2>
      <p>
        一部分作品直接内置在<a href="/benchmarks">反应力实验室</a
        >即点即玩，成绩进入统一的<a href="/leaderboard">排行榜</a
        >；完整源码都在 GitHub 上开放。
      </p>
    </div>
    <div class="p-chips" data-flow data-intersect>
      <span class="p-card__tag">JavaScript</span>
      <span class="p-card__tag">Godot</span>
      <span class="p-card__tag">GDScript</span>
      <span class="p-card__tag">TypeScript</span>
      <span class="p-card__tag">Canvas</span>
    </div>
    <div class="p-card__actions" data-flow data-intersect>
      <a class="p-card__link" href="/benchmarks" data-seal> 站内试玩 </a>
      <a class="p-card__link" href="/leaderboard" data-seal> 查看排行榜 </a>
      <a
        class="p-card__link"
        href="https://github.com/SSC-STUDIO/Multi-Board-Game-Collection"
        target="_blank"
        rel="noopener noreferrer"
        data-seal
      >
        Multi-Board-Game-Collection
      </a>
      <a
        class="p-card__link"
        href="https://github.com/SSC-STUDIO/GreedySnake-2026"
        target="_blank"
        rel="noopener noreferrer"
        data-seal
      >
        GreedySnake-2026
      </a>
    </div>
    <nav class="p-projnav" data-flow data-intersect aria-label="相邻项目">
      <a class="p-projnav__link" href="/projects/ai-lab-notes" data-seal>
        <span class="p-projnav__dir">← 上一个</span>
        <span class="p-projnav__name">AI Lab Notes</span>
      </a>
      <a
        class="p-projnav__link p-projnav__link--index"
        href="/projects"
        data-seal
      >
        全部项目
      </a>
      <a
        class="p-projnav__link p-projnav__link--next"
        href="/projects/games-lab"
        data-seal
      >
        <span class="p-projnav__dir">下一个 →</span>
        <span class="p-projnav__name">Games Lab</span>
      </a>
    </nav>

    <ProjectDetailMotion />
  </main>

  <PageFoot current="/projects" />
</BaseLayout>
