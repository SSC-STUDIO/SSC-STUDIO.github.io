---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import PageCard from '@/components/pages/PageCard.astro'
import reposData from '@/data/github-repos.json'

/** GitHub 数据由 `npm run sync:repos` 生成（构建期静态，不占用运行时配额） */
const repos = reposData.repos

const projects = [
  {
    href: '/projects/my-website',
    kicker: 'active · 2026',
    id: '#CRS-001/08',
    title: 'MyWebsite 个人站',
    cover: '/images/work-covers/my-website.svg',
    summary:
      'Chen Runsen 的个人站 monorepo：作品集、文章、Human Benchmark 与班级空间。',
    tags: ['Astro', 'TypeScript', 'Fastify', 'Prisma', 'PostgreSQL'],
  },
  {
    href: '/projects/ai-lab-notes',
    kicker: 'active · 2026',
    id: '#CRS-002/08',
    title: 'AI Lab Notes',
    cover: '/images/work-covers/ai-lab.svg',
    summary:
      '自托管 LLM 网关与 CV 实验：模型路由、故障回退、遥测，以及可复现的训练笔记。',
    tags: ['Go', 'Python', 'PyTorch', 'LLM Ops', 'OpenAI API'],
  },
  {
    href: '/projects/interactive-game-kit',
    kicker: 'active · 2025',
    id: '#CRS-003/08',
    title: 'Interactive Game Kit',
    cover: '/images/work-covers/game-kit.svg',
    summary: '浏览器棋类、Roguelite 与 Godot 原型 — 手感、反馈与排行榜一体。',
    tags: ['JavaScript', 'Godot', 'GDScript', 'TypeScript', 'Canvas'],
  },
  {
    href: '/projects/games-lab',
    kicker: 'active · 2025',
    id: '#CRS-004/08',
    title: 'Games Lab',
    cover: '/images/work-covers/games.svg',
    summary: '把棋盘规则、弹幕生存与 Godot 竞技场做成可试玩的游戏集合。',
    tags: ['JavaScript', 'GDScript', 'Godot'],
  },
  {
    href: '/projects/benchmarks',
    kicker: 'active · 2025',
    id: '#CRS-005/08',
    title: 'Human Benchmarks',
    cover: '/images/work-covers/benchmarks.svg',
    summary: '反应、记忆、序列挑战 — 内置在 MyWebsite，分数可提交、可排行。',
    tags: ['TypeScript', 'Fastify', 'Canvas'],
  },
  {
    href: '/projects/class-space',
    kicker: 'active · 2025',
    id: '#CRS-006/08',
    title: 'Class Space',
    cover: '/images/work-covers/class.svg',
    summary: '班级记忆现场：相册、同学档案与只属于我们这一班的片段。',
    tags: ['Astro', 'TypeScript', 'Fastify'],
  },
  {
    href: '/projects/articles',
    kicker: 'active · 2025',
    id: '#CRS-007/08',
    title: 'Articles & Notes',
    cover: '/images/work-covers/articles.svg',
    summary: '把灵感写慢，把问题写透 — LLM 网关、CV 实验与工程复盘的文字记录。',
    tags: ['Markdown', 'TypeScript'],
  },
  {
    href: '/projects/honors',
    kicker: 'active · 2024',
    id: '#CRS-008/08',
    title: 'Honors & Growth',
    cover: '/images/work-covers/honors.svg',
    summary: '创客、竞赛与成长节点 — 努力被看见的那些瞬间。',
    tags: ['Scratch', '创客', '信息学'],
  },
]
---

<BaseLayout
  title="Projects · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
>
  <PageHero
    kicker="content"
    title="Projects"
    summary="把真实作品放到台前：从 AI 实验、游戏原型到长期工程系统，每个项目都要能说明目标、取舍和结果。"
  />

  <main class="p-page p-page--wide">
    <div class="p-grid p-grid--stagger">
      {
        projects.map((project) => (
          <PageCard
            href={project.href}
            kicker={project.kicker}
            id={project.id}
            title={project.title}
          >
            <img
              class="p-detail-cover"
              src={project.cover}
              alt=""
              width="540"
              height="318"
              loading="lazy"
            />
            <p>{project.summary}</p>
            <div class="p-card__tags">
              {project.tags.map((tag) => (
                <span class="p-card__tag">{tag}</span>
              ))}
            </div>
          </PageCard>
        ))
      }
    </div>
  </main>

  <main class="p-page p-page--wide">
    <section class="p-gh" data-reveal>
      <div class="p-gh__head">
        <span class="p-gh__kicker">open source · 开源</span>
        <h2 class="p-gh__title">GitHub 仓库</h2>
        <p class="p-gh__summary">
          {reposData.count} 个公开仓库，来自
          <a
            href={`https://github.com/${reposData.user}`}
            target="_blank"
            rel="noopener noreferrer">@{reposData.user}</a
          >；数据由构建期同步，最后更新 {reposData.generatedAt.slice(0, 10)}。
        </p>
      </div>

      <div class="p-grid p-grid--stagger">
        {
          repos.map((repo) => (
            <PageCard
              href={repo.url}
              external
              kicker={repo.archived ? 'archived · 已归档' : 'github'}
              id={`★ ${repo.stars}`}
              title={repo.title}
            >
              <p class="p-gh__name">{repo.fullName}</p>
              <p>{repo.summary}</p>
              <p class="p-gh__meta">
                {repo.language && <span>{repo.language}</span>}
                <span>更新于 {repo.pushedAt}</span>
                {repo.license && <span>{repo.license}</span>}
              </p>
              {repo.homepage && (
                <a
                  class="p-gh__home"
                  href={repo.homepage}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  项目主页 ↗
                </a>
              )}
              <div class="p-card__tags">
                {repo.tags.map((tag) => (
                  <span class="p-card__tag">{tag}</span>
                ))}
              </div>
            </PageCard>
          ))
        }
      </div>
    </section>
  </main>

  <PageFoot current="/projects" />
</BaseLayout>
