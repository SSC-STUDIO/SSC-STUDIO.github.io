---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import ClassMotion from '@/components/pages/ClassMotion.astro'
import ClassGallery from '@/islands/ClassGallery'
---

<BaseLayout
  title="Class Gallery · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
  robots="noindex, nofollow"
>
  <PageHero
    kicker="class-space"
    title="班级画廊"
    summary="这一班的照片与视频——登录后通过受保护接口浏览。"
  />

  <main class="p-page p-page--wide">
    <ClassMotion />
    <ClassGallery client:load />
  </main>

  <PageFoot current="/class" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 画廊打磨:缩略图骨架占位与灯箱加载态(仅本页) ── */

  /* 未加载完成的格子:宣纸底上浮一层墨色轻纱,缓慢呼吸 */
  .p-class-gallery__item::after {
    position: absolute;
    inset: 0;
    z-index: 1;

    background: color-mix(in srgb, #{color(secondary)} 10%, transparent);
    content: '';
    opacity: 1;
    pointer-events: none;

    animation: class-gallery-skeleton 1.8s ease-in-out infinite;
    transition: opacity 0.5s ease(out-quint);
  }

  .p-class-gallery__item.is-loaded::after {
    animation: none;
    opacity: 0;
  }

  /* 缩略图本体:解码完成后淡入(保留共享层的 hover 缩放) */
  .p-class-gallery__thumb {
    opacity: 0;
    transition:
      opacity 0.45s ease(out-quint),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-class-gallery__item.is-loaded .p-class-gallery__thumb {
    opacity: 1;
  }

  @keyframes class-gallery-skeleton {
    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.45;
    }
  }

  /* 灯箱:大图加载期间墨圈旋转,媒体就绪后淡入 */
  .p-class-lightbox__figure {
    position: relative;
  }

  .p-class-lightbox__figure.is-loading {
    min-height: min(48vh, 24rem);
  }

  .p-class-lightbox__figure.is-loading::before {
    position: absolute;
    top: 50%;
    left: 50%;

    width: 2.25rem;
    height: 2.25rem;
    margin: -1.125rem 0 0 -1.125rem;

    border: 2px solid color-mix(in srgb, #{color(secondary)} 25%, transparent);
    border-top-color: color(accent);
    border-radius: 50%;
    content: '';

    animation: class-lightbox-spin 0.8s linear infinite;
  }

  .p-class-lightbox__media {
    opacity: 1;
    transition: opacity 0.35s ease(out-quint);
  }

  .p-class-lightbox__figure.is-loading .p-class-lightbox__media {
    opacity: 0;
  }

  @keyframes class-lightbox-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 格子解码完成即落墨入位。图片本就陆续到齐，
     天然形成一片自上而下的错落，不必再排延迟。 */
  .p-class-gallery__item.is-loaded {
    animation: class-gallery-settle 560ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
  }

  @keyframes class-gallery-settle {
    from {
      opacity: 0.35;
      transform: translate3d(0, 0.7rem, 0) scale(0.985);
    }
  }

  /* 格子受光：文章卡那一道浅墨，压在编号与角标之下 */
  .p-class-gallery__sheen {
    position: absolute;
    inset: 0;
    z-index: 1;

    background: linear-gradient(
      108deg,
      transparent 36%,
      color-mix(in srgb, #{color(primary)} 30%, transparent) 50%,
      transparent 64%
    );
    opacity: 0;
    pointer-events: none;
    transform: translateX(-18%);
    transition:
      opacity 420ms ease,
      transform 720ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-class-gallery__item:hover .p-class-gallery__sheen,
  .p-class-gallery__item:focus-visible .p-class-gallery__sheen {
    opacity: 1;
    transform: translateX(18%);
  }

  /* 灯箱开合：册页摊开 / 合上，关箱由 .is-closing 接手 */
  .p-class-lightbox {
    animation: class-lightbox-open 380ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .p-class-lightbox__panel {
    animation: class-lightbox-panel-in 420ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .p-class-lightbox.is-closing {
    animation: class-lightbox-close 240ms ease both;
    pointer-events: none;
  }

  .p-class-lightbox.is-closing .p-class-lightbox__panel {
    animation: class-lightbox-panel-out 240ms ease both;
  }

  @keyframes class-lightbox-open {
    from {
      opacity: 0;
    }
  }

  @keyframes class-lightbox-close {
    to {
      opacity: 0;
    }
  }

  @keyframes class-lightbox-panel-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.7rem, 0) scale(0.975);
    }
  }

  @keyframes class-lightbox-panel-out {
    to {
      opacity: 0;
      transform: translate3d(0, 0.45rem, 0) scale(0.98);
    }
  }

  /* ── 灯箱翻页：新帧自来处滑入，如册页翻过一叶 ── */

  .p-class-lightbox__figure {
    cursor: grab;
    touch-action: pan-y;

    /* 松手后回位；拖拽中跟手，不加过渡 */
    transform: translate3d(calc(var(--drag-x, 0px) * 0.32), 0, 0);
    transition: transform 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-class-lightbox__figure.is-dragging {
    cursor: grabbing;
    transition: none;
  }

  .p-class-lightbox__figure .p-class-lightbox__media {
    animation: class-lightbox-turn-next 420ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-class-lightbox__figure[data-dir='prev'] .p-class-lightbox__media {
    animation-name: class-lightbox-turn-prev;
  }

  @keyframes class-lightbox-turn-next {
    from {
      opacity: 0;
      transform: translate3d(3.5%, 0, 0) scale(0.985);
    }
  }

  @keyframes class-lightbox-turn-prev {
    from {
      opacity: 0;
      transform: translate3d(-3.5%, 0, 0) scale(0.985);
    }
  }

  /* 左右按钮：悬停时朝去向递一步。
     基准 transform 要留给 translateY(-50%) 居中，这里改用独立的 translate。 */
  .p-class-lightbox__nav {
    transition:
      translate 260ms cubic-bezier(0.16, 1, 0.3, 1),
      background 0.2s ease,
      color 0.2s ease;
  }

  .p-class-lightbox__nav--prev:hover {
    translate: -3px 0;
  }

  .p-class-lightbox__nav--next:hover {
    translate: 3px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .p-class-gallery__item::after,
    .p-class-gallery__item.is-loaded,
    .p-class-lightbox__figure .p-class-lightbox__media,
    .p-class-lightbox,
    .p-class-lightbox__panel,
    .p-class-lightbox.is-closing,
    .p-class-lightbox.is-closing .p-class-lightbox__panel {
      animation: none;
    }

    .p-class-gallery__thumb,
    .p-class-lightbox__media,
    .p-class-gallery__sheen {
      transition: none;
      opacity: 1;
    }

    .p-class-gallery__sheen {
      opacity: 0;
      transform: none;
    }

    .p-class-lightbox__figure {
      transform: none;
      transition: none;
    }

    .p-class-lightbox__nav {
      transition: none;
    }

    .p-class-lightbox__nav--prev:hover,
    .p-class-lightbox__nav--next:hover {
      translate: none;
    }

    .p-class-lightbox__figure.is-loading::before {
      animation: none;
    }
  }
</style>
