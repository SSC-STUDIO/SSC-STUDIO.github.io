---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
---

<BaseLayout
  title="Class Gallery · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
>
  <PageHero
    kicker="class-space"
    title="Class Gallery"
    summary="受保护的班级相册与视频浏览 — 元数据、预览与筛选。"
  />

  <main class="p-page">
    <div class="p-lock">
      <p class="p-lock__badge">迁移中</p>
      <p class="p-lock__message">
        画廊浏览需要成员登录，交互式相册模块正在迁移中。
      </p>
      <div class="p-card__actions">
        <a class="p-card__link" href="/account"> 前往账号 </a>
        <a class="p-card__link p-card__link--ghost" href="/class"> 班级空间 </a>
      </div>
    </div>
  </main>

  <PageFoot current="/class" />
</BaseLayout>
