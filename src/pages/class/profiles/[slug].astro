---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import ClassMotion from '@/components/pages/ClassMotion.astro'
import ClassProfile from '@/islands/ClassProfile'

// Profile slugs live behind the authenticated class API, so they cannot be
// enumerated at build time — getStaticPaths() emits the slugs known from
// the API source (featured profiles in apps/api/src/routes/class.ts).
// The page itself is fully generic: it only hands `Astro.params.slug` to
// the island, which fetches `/api/class/profiles/:slug` client-side and
// renders login / not-found states for anything else. New profiles need
// their slug added here (or an SSR adapter) to get a reachable URL.
export function getStaticPaths() {
  return [
    { params: { slug: '19-陈润森' } },
    { params: { slug: 'T01-夏雅萍' } },
    { params: { slug: 'T02-张箐' } },
  ]
}

const { slug = '' } = Astro.params
---

<BaseLayout
  title="Class Profile · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
  robots="noindex, nofollow"
>
  <PageHero
    kicker="class-profile"
    title="同学档案"
    summary="班级空间里的个人档案——简介、留言与到访记录，登录后可见。静态预渲染目前只有三份已登记档案；其余同学需登录后由接口打开，没有单独的静态页。"
  />

  <main class="p-page p-page--wide">
    <ClassMotion />
    <ClassProfile client:load slug={slug} />
  </main>

  <PageFoot current="/class" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 同学档案打磨(仅本页) ── */

  /* 留言文本:信笺语气——朱砂左栏线 + 首行缩进 */
  .p-class-profile__panel--message .p-class-profile__copy p {
    padding-left: 0.85rem;

    border-left: 2px solid color-mix(in srgb, #{color(accent)} 70%, transparent);

    text-indent: 2em;
  }

  /* 留言 composer 接近上限时的剩余字数提示(与班级空间同款) */
  .p-class-comments__count {
    margin: -0.5rem 0 0;

    color: color-mix(in srgb, #{color(secondary)} 60%, transparent);
    font: 700 10px / 1.4 font-family(fraktion);
    letter-spacing: 0.1em;
    text-align: right;
    text-transform: none;
  }

  /* 离线卡中的重试按钮与相邻链接基线对齐 */
  .p-lock .p-class__retry {
    margin-top: 0;
  }

  /* 栏内空态：去掉第二层厚框，只留浅虚线笺 */
  .p-class-profile__copy.is-empty .p-class-empty {
    border-color: color-mix(in srgb, #{color(secondary)} 28%, transparent);
    background: transparent;
  }

  /* 标签：悬停时轻提并翻墨，像关于页的技能签 */
  .p-class-profile__tag {
    display: inline-block;

    transition:
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.28s ease,
      color 0.28s ease;
  }

  .p-class-profile__tag:hover {
    transform: translateY(-2px);

    background: color(secondary);

    color: color(primary);
  }

  /* 到访数字：落纸时自模糊中收干 */
  .p-class-profile__facts dd {
    animation: class-count-rise 640ms cubic-bezier(0.16, 1, 0.3, 1) 140ms
      backwards;
  }

  @media (prefers-reduced-motion: reduce) {
    .p-class-profile__tag,
    .p-class-profile__tag:hover,
    .p-class-profile__facts dd {
      animation: none;
      transform: none;
      transition: none;
    }
  }
</style>
