---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import PageCard from '@/components/pages/PageCard.astro'
---

<BaseLayout
  title="Class Space · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
>
  <PageHero
    kicker="class-space"
    title="Class Space"
    summary="一处给同学的记忆房间，保存那些只属于我们这一班的片段。"
  />

  <main class="p-page p-page--wide">
    <div class="p-stack p-stack--2col">
      <PageCard kicker="41 classmates" title="班级记忆现场">
        <p>相册、同学档案与班级片段 — 需要登录后访问完整内容。</p>
        <div class="p-card__actions">
          <a class="p-card__link" href="/class/gallery">进入画廊</a>
          <a class="p-card__link p-card__link--ghost" href="/account"
            >登录 / 账号</a
          >
        </div>
      </PageCard>
      <div class="p-lock">
        <p class="p-lock__badge">迁移中</p>
        <p class="p-lock__message">
          班级空间为成员专属区域，请先登录账号或联系管理员获取访问权限。
        </p>
        <div class="p-card__actions">
          <a class="p-card__link" href="/account"> 登录账号 </a>
          <a class="p-card__link p-card__link--ghost" href="/contact"> 联系我 </a>
        </div>
      </div>
    </div>
  </main>

  <PageFoot current="/class" />
</BaseLayout>
