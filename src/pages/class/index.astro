---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import ClassMotion from '@/components/pages/ClassMotion.astro'
import ClassSpace from '@/islands/ClassSpace'
---

<BaseLayout
  title="Class Space · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
  robots="noindex, nofollow"
>
  <PageHero
    kicker="class-space"
    title="班级空间"
    summary="一处给同学的记忆房间，保存那些只属于我们这一班的片段——相册、档案与留言，登录后完整开放。"
  />

  <main class="p-page p-page--wide">
    <ClassMotion />
    <ClassSpace client:load />
  </main>

  <PageFoot current="/class" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 班级空间打磨(仅本页) ── */

  /* 留言接近上限时的剩余字数提示 */
  .p-class-comments__count {
    margin: -0.5rem 0 0;

    color: color-mix(in srgb, #{color(secondary)} 60%, transparent);
    font: 700 10px / 1.4 font-family(fraktion);
    letter-spacing: 0.1em;
    text-align: right;
    text-transform: none;
  }

  /* 离线卡中的重试按钮与相邻链接基线对齐 */
  .p-lock .p-class__retry {
    margin-top: 0;
  }
</style>
