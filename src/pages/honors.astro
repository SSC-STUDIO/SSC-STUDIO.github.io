---

<BaseLayout
  title="荣誉 · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
>
  <div class="p-honors-head">
    <HonorCoins />
    <PageHero
      kicker="growth"
      title="荣誉"
      summary="奖项与节点像路标，记录努力被看见的那些瞬间。"
    />
  </div>

  <main class="p-page p-page--wide p-honors">
    <PageAura />
    <span class="p-honors__glyph" aria-hidden="true">荣</span>

    <div class="p-detail-meta" data-reveal>
      <span>5 个成长节点</span>
      <span>11 条奖项记录</span>
    </div>

    <div class="p-honor-counters" data-flow data-intersect>
      {
        counters.map((counter) => (
          <div class="p-honor-counter" data-lift>
            <p class="p-honor-counter__label">{counter.label}</p>
            {counter.lines.map((line) => (
              <p class="p-honor-counter__line">{line}</p>
            ))}
          </div>
        ))
      }
    </div>

    <div class="p-grid">
      {
        milestones.map((milestone) => (
          <PageCard kicker="honor" id={milestone.id} title={milestone.year}>
            <p>
              {milestone.lines.map((line, index) => (
                <>
                  {line}
                  {index < milestone.lines.length - 1 && <br />}
                </>
              ))}
            </p>
          </PageCard>
        ))
      }
    </div>

    <Timeline client:load />

    <section class="p-honor-certs" data-reveal>
      <h2 class="p-honor-certs__title">奖状存档</h2>
      <div class="p-honor-certs__grid" data-flow data-intersect>
        {
          certs.map((cert) => (
            <article class="p-honor-cert" data-leaf>
              <img
                class="p-honor-cert__image"
                src={cert.image}
                alt={cert.alt}
                loading="lazy"
                width="640"
                height="480"
              />
              <div class="p-honor-cert__body">
                <span class="p-honor-cert__year">{cert.year}</span>
                <strong class="p-honor-cert__name">{cert.name}</strong>
                <p class="p-honor-cert__issuer">{cert.issuer}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>
    <honor-feel hidden aria-hidden="true"></honor-feel>
  </main>

  <PageFoot current="/honors" />
</BaseLayout>

<script>
  import { prefersReducedMotion } from '../motion/core'

  const SHEEN_SEL =
    '.p-honor-counter, .p-honor-cert, .p-card, .tl__card:not(.tl__card--skeleton)'

  /**
   * 计数卡 / 节点 / 奖状 / 河流卡：指针精细时受光跟手横移。
   * 触屏与降动效只走 CSS 扫光；换页 disconnect 时摘监听、清 --leaf-sheen。
   */
  class HonorFeel extends HTMLElement {
    page: HTMLElement | null = null
    live: HTMLElement | null = null
    reduced = false
    listening = false

    connectedCallback() {
      this.teardown()
      this.page = this.closest('.p-honors')
      if (!this.page) return

      this.reduced = prefersReducedMotion()
      const mq = window.matchMedia('(prefers-reduced-motion: reduce)')
      mq.addEventListener?.('change', this.onMotion)
      document.addEventListener('astro:before-swap', this.onSwap)
      this.listen()
    }

    disconnectedCallback() {
      this.teardown()
    }

    onSwap = () => this.teardown()

    onMotion = (event: MediaQueryListEvent) => {
      this.reduced = event.matches
      if (this.reduced) {
        this.unlisten()
        this.dropAll()
        return
      }
      this.listen()
    }

    listen() {
      if (this.listening || this.reduced || !this.page) return
      if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        return
      }
      this.page.addEventListener('pointermove', this.onMove, { passive: true })
      this.page.addEventListener('pointerleave', this.onLeave)
      this.listening = true
    }

    unlisten() {
      if (!this.listening) return
      this.page?.removeEventListener('pointermove', this.onMove)
      this.page?.removeEventListener('pointerleave', this.onLeave)
      this.listening = false
    }

    onMove = (event: PointerEvent) => {
      if (this.reduced || !this.page) return

      const card = (event.target as Element | null)?.closest<HTMLElement>(
        SHEEN_SEL
      )
      if (this.live && this.live !== card) this.drop(this.live)

      if (!card || !this.page.contains(card)) {
        this.live = null
        return
      }

      const rect = card.getBoundingClientRect()
      const x = (event.clientX - rect.left) / Math.max(1, rect.width) - 0.5
      card.style.setProperty('--leaf-sheen', (0.5 - x).toFixed(3))
      card.classList.add('is-sheen-live')
      this.live = card
    }

    onLeave = () => this.dropAll()

    drop(el: HTMLElement) {
      el.classList.remove('is-sheen-live')
      el.style.removeProperty('--leaf-sheen')
    }

    dropAll() {
      this.page?.querySelectorAll<HTMLElement>('.is-sheen-live').forEach((el) => {
        this.drop(el)
      })
      if (this.live) this.drop(this.live)
      this.live = null
    }

    teardown() {
      document.removeEventListener('astro:before-swap', this.onSwap)
      const mq = window.matchMedia('(prefers-reduced-motion: reduce)')
      mq.removeEventListener?.('change', this.onMotion)
      this.unlisten()
      this.dropAll()
      this.page = null
    }
  }

  if (!customElements.get('honor-feel')) {
    customElements.define('honor-feel', HonorFeel)
  }
</script>

<style lang="scss" is:global>
  /* ── 荣誉页动效（仅本页） ──
     彩头交给 HonorCoins；这里补卷首朱砂、卷底题字、
     计数/节点受光与奖状年份落印。默认态即落定态。 */

  /* 卷首彩头：题识一抹更浓的朱砂，像喜笺上的签条 */
  .p-honors-head .p-hero__kicker {
    background: color-mix(in srgb, #{color(accent)} 22%, transparent);
    border-color: color-mix(in srgb, #{color(accent-strong)} 78%, transparent);
  }

  /* 卷底题字：替奖状长卷垫一层纵深 */
  .p-honors__glyph {
    position: absolute;
    top: 0.35rem;
    right: clamp(1rem, 4vw, 2.5rem);
    z-index: -1;

    color: color(secondary);
    font: 700 clamp(5rem, 16vw, 9rem) / 1 font-family(bigger);

    opacity: 0.05;
    pointer-events: none;
    user-select: none;
  }

  /* 节点卡按栅格顺序落墨；ink-reveal 写的是行内延迟，需压过它 */
  @for $i from 1 through 8 {
    .p-honors .p-grid > :nth-child(#{$i}) {
      --reveal-delay: #{($i - 1) * 62}ms !important;
    }
  }

  /* 节点卡受光：默认一道浅扫，指针精细时改跟 --leaf-sheen */
  .p-honors .p-card {
    --leaf-sheen: 0.5;

    overflow: hidden;
  }

  .p-honors .p-card::after {
    position: absolute;
    inset: 0;
    z-index: 2;

    background: linear-gradient(
      100deg,
      transparent calc(var(--leaf-sheen, 0.5) * 100% - 22%),
      color-mix(in srgb, #{color(primary)} 28%, transparent)
        calc(var(--leaf-sheen, 0.5) * 100%),
      transparent calc(var(--leaf-sheen, 0.5) * 100% + 22%)
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: translateX(-18%);
    transition:
      opacity 420ms ease,
      transform 720ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-honors .p-card.is-sheen-live::after {
    transform: none;
    transition: opacity 420ms ease;
  }

  .p-honors .p-card:hover::after,
  .p-honors .p-card:focus-visible::after {
    opacity: 1;
    transform: translateX(18%);
  }

  .p-honors .p-card.is-sheen-live:hover::after,
  .p-honors .p-card.is-sheen-live:focus-visible::after {
    transform: none;
  }

  .p-honors .p-card__id {
    display: inline-block;
    transition: transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .p-honors .p-card:hover .p-card__id {
    transform: rotate(-2.5deg) translateY(-1px);
  }

  /* 奖状：随指针沿中缝轻翻，同时提起半格——
     data-leaf 与 data-lift 抢同一条 transform，故在此合成一条。 */
  .p-honor-cert[data-leaf] {
    --lift: 0px;

    position: relative;
    overflow: hidden;

    transform: perspective(60rem) rotateX(var(--leaf-rx))
      rotateY(var(--leaf-ry)) translate3d(0, var(--lift), 0);

    transition:
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 320ms ease,
      border-color 320ms ease;

    &:hover,
    &:focus-within {
      --lift: -4px;

      border-color: color(accent);
      box-shadow: 0 0.45rem 0 color-mix(in srgb, #{color(accent)} 65%, transparent);
    }

    &.is-leaf-live {
      transition:
        transform 120ms linear,
        box-shadow 320ms ease,
        border-color 320ms ease;
    }
  }

  /* 相纸受光：只扫过奖状图面，不洗掉题名；位置跟 --leaf-sheen */
  .p-honor-cert {
    --leaf-sheen: 0.5;
  }

  .p-honor-cert__image {
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-honor-cert:hover .p-honor-cert__image,
  .p-honor-cert:focus-within .p-honor-cert__image {
    transform: scale(1.045);
  }

  .p-honor-cert::after {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    z-index: 2;

    width: 100%;
    aspect-ratio: 4 / 3;

    background: linear-gradient(
      100deg,
      transparent calc(var(--leaf-sheen, 0.5) * 100% - 22%),
      color-mix(in srgb, #{color(primary)} 30%, transparent)
        calc(var(--leaf-sheen, 0.5) * 100%),
      transparent calc(var(--leaf-sheen, 0.5) * 100% + 22%)
    );
    content: '';
    opacity: 0;
    pointer-events: none;

    transition: opacity 0.4s ease(out-quint);
  }

  .p-honor-cert:hover::after,
  .p-honor-cert:focus-within::after {
    opacity: 1;
  }

  /* 年份钤在左上角，悬停时朱砂托起 */
  .p-honor-cert__year {
    transition:
      color 0.3s ease,
      letter-spacing 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-honor-cert:hover .p-honor-cert__year,
  .p-honor-cert:focus-within .p-honor-cert__year {
    color: color(accent-strong);
    letter-spacing: 0.2em;
  }

  /* 计数卡悬停：朱砂托底，并走一道受光 */
  .p-honor-counter[data-lift] {
    --leaf-sheen: 0.5;

    position: relative;
    overflow: hidden;

    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 260ms ease,
      border-color 260ms ease;

    &:hover,
    &:focus-within {
      border-color: color(accent);
      box-shadow: 0 0.4rem 0 color-mix(in srgb, #{color(accent)} 60%, transparent);
    }

    &::after {
      position: absolute;
      inset: 0;
      z-index: 1;

      background: linear-gradient(
        108deg,
        transparent calc(var(--leaf-sheen, 0.5) * 100% - 18%),
        color-mix(in srgb, #{color(primary)} 30%, transparent)
          calc(var(--leaf-sheen, 0.5) * 100%),
        transparent calc(var(--leaf-sheen, 0.5) * 100% + 18%)
      );
      content: '';
      opacity: 0;
      pointer-events: none;
      transform: translateX(-16%);
      transition:
        opacity 380ms ease,
        transform 640ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    &.is-sheen-live::after {
      transform: none;
      transition: opacity 380ms ease;
    }

    &:hover::after,
    &:focus-within::after {
      opacity: 1;
      transform: translateX(16%);
    }

    &.is-sheen-live:hover::after,
    &.is-sheen-live:focus-within::after {
      transform: none;
    }
  }

  .p-honor-counter__label {
    position: relative;
    z-index: 2;
    display: inline-block;

    transition:
      color 260ms ease,
      transform 340ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .p-honor-counter:hover .p-honor-counter__label {
    color: color(accent-strong);
    transform: rotate(-3deg) translateY(-1px);
  }

  .p-honor-counter__line {
    position: relative;
    z-index: 2;
  }

  /* 成长河流卡：与节点卡同一道受光，骨架卡不跟 */
  .p-honors .tl__card:not(.tl__card--skeleton) {
    --leaf-sheen: 0.5;

    position: relative;
    overflow: hidden;

    transition:
      border-color 280ms ease,
      box-shadow 280ms ease;

    &::after {
      position: absolute;
      inset: 0;
      z-index: 2;

      background: linear-gradient(
        100deg,
        transparent calc(var(--leaf-sheen, 0.5) * 100% - 22%),
        color-mix(in srgb, #{color(primary)} 28%, transparent)
          calc(var(--leaf-sheen, 0.5) * 100%),
        transparent calc(var(--leaf-sheen, 0.5) * 100% + 22%)
      );
      content: '';
      opacity: 0;
      pointer-events: none;
      transform: translateX(-18%);
      transition:
        opacity 420ms ease,
        transform 720ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    &.is-sheen-live::after {
      transform: none;
      transition: opacity 420ms ease;
    }

    &:hover,
    &:focus-within {
      border-color: color(accent);
      box-shadow: 0 0.4rem 0 color-mix(in srgb, #{color(accent)} 60%, transparent);
    }

    &:hover::after,
    &:focus-within::after {
      opacity: 1;
      transform: translateX(18%);
    }

    &.is-sheen-live:hover::after,
    &.is-sheen-live:focus-within::after {
      transform: none;
    }
  }

  /* 奖状年份：存档入屏后如一枚小印钤下 */
  .p-honor-certs.is-inked .p-honor-cert__year {
    animation: honor-year-stamp 640ms cubic-bezier(0.2, 1.35, 0.32, 1) backwards;
    animation-delay: calc(var(--cert-i, 0) * 70ms);
  }

  @for $i from 1 through 12 {
    .p-honor-certs .p-honor-cert:nth-child(#{$i}) {
      --cert-i: #{$i - 1};
    }
  }

  @keyframes honor-year-stamp {
    from {
      opacity: 0;
      transform: scale(1.55) rotate(-8deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p-honor-certs.is-inked .p-honor-cert__year {
      animation: none;
    }

    .p-honors .p-card::after,
    .p-honors .p-card__id,
    .p-honor-counter[data-lift]::after,
    .p-honor-counter__label,
    .p-honors .tl__card::after {
      transition: none;
    }

    .p-honors .p-card::after,
    .p-honor-counter[data-lift]::after,
    .p-honor-cert::after,
    .p-honors .tl__card::after {
      opacity: 0;
    }

    .p-honors .p-card:hover .p-card__id,
    .p-honor-counter:hover .p-honor-counter__label {
      transform: none;
    }

    .p-honor-cert[data-leaf],
    .p-honor-cert[data-leaf].is-leaf-live,
    .p-honor-cert__image,
    .p-honor-cert::after,
    .p-honor-cert__year,
    .p-honor-counter[data-lift],
    .p-honors .tl__card:not(.tl__card--skeleton) {
      transition: none;
    }

    .p-honor-cert[data-leaf] {
      transform: none;
    }

    .p-honor-cert:hover .p-honor-cert__image {
      transform: none;
    }

    .p-honor-cert:hover .p-honor-cert__year {
      letter-spacing: 0.12em;
    }
  }
</style>
