---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import PageCard from '@/components/pages/PageCard.astro'
import PageAura from '@/components/pages/PageAura.astro'
import Timeline from '@/islands/Timeline'
import HonorCoins from '@/components/HonorCoins.astro'

const counters = [
  { label: '信息学', lines: ['CSP-J 贰等', 'NOC 一等奖'] },
  { label: '创客', lines: ['智造三等奖', '车辆模型二等奖'] },
  { label: '全国', lines: ['希望颂一等奖', 'NOC 三等奖'] },
]

const milestones = [
  { id: '#HON-01', year: '2024', lines: ['2024', 'CSP-J 入门级贰等', '中国计算机学会'] },
  { id: '#HON-02', year: '2024', lines: ['2024', 'AI 算法设计二等奖', 'Python 初中组'] },
  { id: '#HON-03', year: '2025', lines: ['2025', '希望颂书画一等奖', '软笔书法初中组'] },
  { id: '#HON-04', year: '2024', lines: ['2024', '创客新星', '三等奖', '趣味智造初中组'] },
  { id: '#HON-05', year: '2024', lines: ['2024', '车辆模型二等奖', '四驱车拼装竞速中学组'] },
]

const certs = [
  {
    image: '/legacy-assets/prize/prize_4.jpg',
    alt: 'CCF CSP-J/S 入门级贰等 奖状',
    year: '2024',
    name: 'CCF CSP-J/S 入门级贰等',
    issuer: '中国计算机学会',
  },
  {
    image: '/legacy-assets/prize/prize_3.jpg',
    alt: '人工智能算法设计二等奖 奖状',
    year: '2024',
    name: '人工智能算法设计二等奖',
    issuer: '上海市中小学生人工智能算法设计活动 · Python 初中组',
  },
  {
    image: '/legacy-assets/prize/prize_1.jpg',
    alt: '希望颂书画艺术大展一等奖 奖状',
    year: '2025',
    name: '希望颂书画艺术大展一等奖',
    issuer: '中国国际书画艺术研究会 · 软笔书法初中组',
  },
  {
    image: '/legacy-assets/prize/prize_0.jpg',
    alt: '创客新星大赛三等奖 奖状',
    year: '2024',
    name: '创客新星大赛三等奖',
    issuer: '第十届上海创客新星大赛浦东区赛 · 趣味智造初中组',
  },
  {
    image: '/legacy-assets/prize/prize_6.jpg',
    alt: '车辆模型竞赛二等奖 奖状',
    year: '2024',
    name: '车辆模型竞赛二等奖',
    issuer: '驾驭未来全国青少年车辆模型教育竞赛 · 四驱车拼装竞速中学组',
  },
  {
    image: '/legacy-assets/prize/prize_12.jpg',
    alt: 'NOC 全向思维智趣编程一等奖 奖状',
    year: '2023',
    name: 'NOC 全向思维智趣编程一等奖',
    issuer: '全国中小学信息技术创新与实践大赛 · 复赛初中组',
  },
  {
    image: '/legacy-assets/prize/prize_9.jpg',
    alt: 'NOC 全向思维智趣编程三等奖 奖状',
    year: '2023',
    name: 'NOC 全向思维智趣编程三等奖',
    issuer: '全国中小学信息技术创新与实践大赛 · 决赛初中组',
  },
  {
    image: '/legacy-assets/prize/prize_8.jpg',
    alt: 'AI+程序算法竞赛二等奖 奖状',
    year: '2024',
    name: 'AI+程序算法竞赛二等奖',
    issuer: '第四届全国青少年科技教育成果展示大赛 · 省级区域赛',
  },
  {
    image: '/legacy-assets/prize/prize_11.jpg',
    alt: '信息素养大赛三等奖 奖状',
    year: '2024',
    name: '信息素养大赛三等奖',
    issuer: '2024 全国青少年信息素养大赛华东赛区（上海）· 算法创意实践挑战赛',
  },
  {
    image: '/legacy-assets/prize/prize_10.jpg',
    alt: '信息素养大赛二等奖 奖状',
    year: '2023',
    name: '信息素养大赛二等奖',
    issuer: '2023 全国青少年信息素养大赛华东赛区（上海）· Python 编程挑战赛',
  },
  {
    image: '/legacy-assets/prize/prize_7.jpg',
    alt: '航天创新大赛二等奖 奖状',
    year: '2023',
    name: '航天创新大赛二等奖',
    issuer: '全国青少年航天创新大赛区域赛（上海）· 航天创意比赛',
  },
]
---

<BaseLayout
  title="荣誉 · 陈润森"
  description="个人空间：收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。"
>
  <HonorCoins />

  <PageHero
    kicker="growth"
    title="荣誉"
    summary="奖项与节点像路标，记录努力被看见的那些瞬间。"
  />

  <main class="p-page p-page--wide p-honors">
    <PageAura />

    <div class="p-detail-meta" data-reveal>
      <span>5 个成长节点</span>
      <span>11 条奖项记录</span>
    </div>

    <div class="p-honor-counters" data-flow data-intersect>
      {
        counters.map((counter) => (
          <div class="p-honor-counter" data-lift>
            <p class="p-honor-counter__label">{counter.label}</p>
            {counter.lines.map((line) => (
              <p class="p-honor-counter__line">{line}</p>
            ))}
          </div>
        ))
      }
    </div>

    <div class="p-grid">
      {
        milestones.map((milestone) => (
          <PageCard kicker="honor" id={milestone.id} title={milestone.year}>
            <p>
              {milestone.lines.map((line, index) => (
                <>
                  {line}
                  {index < milestone.lines.length - 1 && <br />}
                </>
              ))}
            </p>
          </PageCard>
        ))
      }
    </div>

    <Timeline client:load />

    <section class="p-honor-certs" data-reveal>
      <h2 class="p-honor-certs__title">奖状存档</h2>
      <div class="p-honor-certs__grid" data-flow data-intersect>
        {
          certs.map((cert) => (
            <article class="p-honor-cert" data-leaf>
              <img
                class="p-honor-cert__image"
                src={cert.image}
                alt={cert.alt}
                loading="lazy"
                width="640"
                height="480"
              />
              <div class="p-honor-cert__body">
                <span class="p-honor-cert__year">{cert.year}</span>
                <strong class="p-honor-cert__name">{cert.name}</strong>
                <p class="p-honor-cert__issuer">{cert.issuer}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </main>

  <PageFoot current="/honors" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 荣誉页动效（仅本页） ── */

  /* 节点卡按栅格顺序落墨；ink-reveal 写的是行内延迟，需压过它 */
  @for $i from 1 through 8 {
    .p-honors .p-grid > :nth-child(#{$i}) {
      --reveal-delay: #{($i - 1) * 62}ms !important;
    }
  }

  /* 奖状：随指针沿中缝轻翻，同时提起半格——
     data-leaf 与 data-lift 抢同一条 transform，故在此合成一条。 */
  .p-honor-cert[data-leaf] {
    --lift: 0px;

    position: relative;
    overflow: hidden;

    transform: perspective(60rem) rotateX(var(--leaf-rx))
      rotateY(var(--leaf-ry)) translate3d(0, var(--lift), 0);

    transition:
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 320ms ease,
      border-color 320ms ease;

    &:hover,
    &:focus-within {
      --lift: -4px;

      border-color: color(accent);
      box-shadow: 0 0.45rem 0 color-mix(in srgb, #{color(accent)} 65%, transparent);
    }

    &.is-leaf-live {
      transition:
        transform 120ms linear,
        box-shadow 320ms ease,
        border-color 320ms ease;
    }
  }

  /* 相纸受光：一道随指针横移的浅光掠过奖状 */
  .p-honor-cert__image {
    transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-honor-cert:hover .p-honor-cert__image {
    transform: scale(1.045);
  }

  .p-honor-cert::after {
    position: absolute;
    z-index: 2;
    inset: 0;

    background: linear-gradient(
      100deg,
      transparent calc(var(--leaf-sheen, 0.5) * 100% - 22%),
      color-mix(in srgb, #{color(primary)} 30%, transparent)
        calc(var(--leaf-sheen, 0.5) * 100%),
      transparent calc(var(--leaf-sheen, 0.5) * 100% + 22%)
    );
    content: '';
    opacity: 0;
    pointer-events: none;

    transition: opacity 0.4s ease(out-quint);
  }

  .p-honor-cert:hover::after {
    opacity: 1;
  }

  /* 年份钤在左上角，悬停时朱砂托起 */
  .p-honor-cert__year {
    transition:
      color 0.3s ease,
      letter-spacing 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .p-honor-cert:hover .p-honor-cert__year {
    color: color(accent-strong);
    letter-spacing: 0.2em;
  }

  /* 计数卡悬停：朱砂托底 */
  .p-honor-counter[data-lift] {
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 260ms ease,
      border-color 260ms ease;

    &:hover {
      border-color: color(accent);
      box-shadow: 0 0.4rem 0 color-mix(in srgb, #{color(accent)} 60%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p-honor-cert[data-leaf],
    .p-honor-cert[data-leaf].is-leaf-live,
    .p-honor-cert__image,
    .p-honor-cert::after,
    .p-honor-cert__year,
    .p-honor-counter[data-lift] {
      transition: none;
    }

    .p-honor-cert[data-leaf] {
      transform: none;
    }

    .p-honor-cert:hover .p-honor-cert__image {
      transform: none;
    }

    .p-honor-cert:hover .p-honor-cert__year {
      letter-spacing: 0.12em;
    }
  }
</style>
