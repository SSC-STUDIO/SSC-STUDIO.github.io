---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import PageCard from '@/components/pages/PageCard.astro'
import PageAura from '@/components/pages/PageAura.astro'
---

<BaseLayout
  title="Sponsor · 陈润森"
  description="支持陈润森的长期创作：GitHub Star、邮件交流与分享传播——被看见，就是最好的赞助。"
>
  <PageHero
    kicker="support"
    title="Sponsor"
    summary="如果这个站点对你有启发，欢迎用合适的方式支持长期创作与实验。"
  />

  <main class="p-page p-page--wide p-sponsor">
    <PageAura />
    <span class="p-sponsor__glyph" aria-hidden="true">资</span>
    <div class="p-stack p-stack--cards">
      <PageCard kicker="why" title="为什么支持">
        <p>
          个人站是长期作品：动效、交互、工程与内容都在同一套系统里迭代。
          你的支持能帮助我继续投入 AI 实验、游戏原型和班级记忆整理。
        </p>
      </PageCard>
      <PageCard kicker="how" title="如何支持">
        <p>目前可通过以下方式表达支持：</p>
        <ul data-flow data-intersect>
          <li>
            GitHub Star 与关注 —
            <a
              href="https://github.com/SSC-STUDIO"
              target="_blank"
              rel="noopener noreferrer"
            >@SSC-STUDIO</a>
          </li>
          <li>
            邮件交流优质合作机会 —
            <a href="mailto:3992237161@qq.com" data-copy-email
              >3992237161@qq.com</a>
          </li>
          <li>
            把站点分享给同样需要灵感的朋友 —
            <button type="button" class="p-sponsor__text-btn" data-copy-site data-seal>
              复制链接
            </button>
          </li>
        </ul>
        <div class="p-card__actions" data-flow data-intersect>
          <a
            class="p-card__link"
            href="https://github.com/SSC-STUDIO"
            target="_blank"
            rel="noopener noreferrer"
            data-seal
          >
            GitHub
          </a>
          <a class="p-card__link p-card__link--ghost"
            href="mailto:3992237161@qq.com"
           data-copy-email data-seal>
            邮件联系
          </a>
          <button
            type="button"
            class="p-card__link p-card__link--ghost"
            data-copy-site
            data-seal
          >
            复制站点链接
          </button>
        </div>
      </PageCard>
      <PageCard kicker="trust" title="边界说明">
        <p>
          支持不代表定制开发承诺，也不绑定任何排他合作。所有实验与内容保持开源友好的节奏，
          重要决策仍通过邮件或联系页沟通确认。
        </p>
      </PageCard>
      <div class="p-sponsor-qr" data-reveal data-leaf>
        <span class="p-sponsor-qr__sheen" aria-hidden="true"></span>
        <span class="p-sponsor-qr__stamp" aria-hidden="true">谢</span>
        <img
          src="/images/qr-code.svg"
          alt="陈润森个人网站二维码"
          width="120"
          height="120"
          data-sponsor-qr
        />
        <p class="p-sponsor-qr__fallback" hidden>
          二维码暂时无法显示 — 请改用上方的 GitHub、邮件或复制链接。
        </p>
        <p>
          扫码把这个站点带走，或写信到
          <a href="mailto:3992237161@qq.com" data-copy-email>3992237161@qq.com</a>
        </p>
        <p class="p-sponsor-qr__thanks">谢谢你走到这一页 — 被看见，就是最好的赞助。</p>
      </div>
    </div>
  </main>

  <PageFoot current="/sponsor" />
</BaseLayout>

<script>
  const FALLBACK_URL = 'https://chenrunsen.cn/'

  function siteUrl() {
    return location.origin ? `${location.origin}/` : FALLBACK_URL
  }

  let toastTimer = 0

  function showCopied(anchor: HTMLElement) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let toast = document.querySelector('.copy-toast')
    if (!(toast instanceof HTMLElement)) {
      toast = document.createElement('span')
      toast.className = 'copy-toast'
      toast.setAttribute('role', 'status')
      document.body.appendChild(toast)
    }
    toast.textContent = '已复制到剪贴板'
    const rect = anchor.getBoundingClientRect()
    toast.style.left = `${Math.max(8, rect.left + rect.width / 2)}px`
    toast.style.top = `${Math.max(8, rect.top - 10)}px`
    toast.classList.remove('is-visible')
    void toast.offsetWidth
    toast.classList.add('is-visible')
    window.clearTimeout(toastTimer)
    toastTimer = window.setTimeout(
      () => toast.classList.remove('is-visible'),
      reduced ? 2400 : 1500
    )
  }

  function copyText(value: string, anchor: HTMLElement) {
    const done = () => showCopied(anchor)
    const fallback = () => {
      const ta = document.createElement('textarea')
      ta.value = value
      ta.style.position = 'fixed'
      ta.style.opacity = '0'
      document.body.appendChild(ta)
      ta.select()
      try {
        document.execCommand('copy')
      } catch {
        /* 剪贴板不可用时仍给反馈，避免按钮像坏掉 */
      }
      ta.remove()
      done()
    }

    if (navigator.clipboard?.writeText) {
      navigator.clipboard.writeText(value).then(done, fallback)
    } else {
      fallback()
    }
  }

  function onDocClick(event: Event) {
    const target = event.target
    if (!(target instanceof Element)) return
    const btn = target.closest('[data-copy-site]')
    if (!(btn instanceof HTMLElement)) return
    event.preventDefault()
    copyText(siteUrl(), btn)
  }

  function bindQrFallback() {
    const img = document.querySelector('[data-sponsor-qr]')
    if (!(img instanceof HTMLImageElement)) return

    const box = img.closest('.p-sponsor-qr')
    const fallback = box?.querySelector('.p-sponsor-qr__fallback')

    const fail = () => {
      img.hidden = true
      box?.classList.add('is-empty')
      if (fallback instanceof HTMLElement) fallback.hidden = false
    }

    if (img.dataset.qrBound === '1') return
    img.dataset.qrBound = '1'

    if (img.complete && img.naturalWidth === 0 && img.getAttribute('src')) {
      fail()
      return
    }

    img.addEventListener('error', fail, { once: true })
  }

  let bound = false

  function mount() {
    if (!bound) {
      bound = true
      document.addEventListener('click', onDocClick)
    }
    bindQrFallback()
  }

  document.addEventListener('astro:page-load', mount)
  mount()
</script>

<style lang="scss" is:global>
  /* ── 赞助页专属：卡内链接与收尾谢语 ── */

  /* 卡片正文里的行内链接：朱砂下划线，与 p-prose 一致 */
  .p-sponsor .p-card__body a:not(.p-card__link) {
    color: color(secondary);
    text-decoration: underline;
    text-decoration-color: color(accent);
    text-underline-offset: 0.2em;

    &:hover,
    &:focus-visible {
      color: color(accent);
    }
  }

  /* 行内「复制链接」：看起来像旁边那条朱砂下划线 */
  .p-sponsor__text-btn {
    appearance: none;
    padding: 0;
    border: 0;
    background: none;

    color: color(secondary);
    font: inherit;
    text-decoration: underline;
    text-decoration-color: color(accent);
    text-underline-offset: 0.2em;
    cursor: pointer;

    &:hover,
    &:focus-visible {
      color: color(accent);
    }

    &:focus-visible {
      outline: 2px solid color(accent);
      outline-offset: 3px;
    }
  }

  .p-sponsor button.p-card__link {
    cursor: pointer;
  }

  /* 双列时第三张卡单独占一行，避免右侧空一格 */
  @media (min-width: 1080px) and (max-width: 1399.98px) {
    .p-sponsor .p-stack--cards > .p-card:last-of-type {
      grid-column: 1 / -1;
    }
  }

  /* 收尾谢语：小字一行，如卷末跋语 */
  .p-sponsor .p-sponsor-qr__thanks {
    position: relative;
    z-index: 2;

    margin-top: 0.65rem;

    color: color-mix(in srgb, #{color(secondary)} 60%, transparent);
    font: 400 0.85rem / 1.5 font-family(editorial);
    letter-spacing: 0.06em;

    transition: color 320ms ease;
  }

  /* 卷底题字 */
  .p-sponsor__glyph {
    position: absolute;
    top: 0.35rem;
    right: clamp(1rem, 4vw, 2.5rem);
    z-index: -1;

    color: color(secondary);
    font: 700 clamp(5rem, 16vw, 9rem) / 1 font-family(bigger);

    opacity: 0.05;
    pointer-events: none;
    user-select: none;
  }

  /* 卡面受光 */
  .p-sponsor .p-card::after {
    position: absolute;
    inset: 0;
    z-index: 2;

    background: linear-gradient(
      105deg,
      transparent 36%,
      color-mix(in srgb, #{color(primary)} 28%, transparent) 50%,
      transparent 64%
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: translateX(-18%);
    transition:
      opacity 420ms ease,
      transform 720ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* ══════════════════════════════════════════════════════
     赞助页动效：卡片错峰落墨、卡内题识依次落定、
     二维码如一页装裱好的册页随指针轻翻。
     入场默认态即落定态，fill-mode 一律 backwards。
     ══════════════════════════════════════════════════════ */

  /* 卡内三段依次落定。延迟接在 --reveal-delay 之后 ——
     那是洇墨显影按卡片次序写下的错峰量，内层跟着它走，
     整叠卡片便有了先后翻页的节奏。 */
  .p-sponsor .p-card.is-inked {
    .p-card__head {
      animation: sp-rise 460ms ease backwards;
      animation-delay: calc(var(--reveal-delay, 0ms) + 180ms);
    }

    .p-card__title {
      animation: sp-rise 540ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
      animation-delay: calc(var(--reveal-delay, 0ms) + 250ms);
    }

    .p-card__body {
      animation: sp-rise 540ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
      animation-delay: calc(var(--reveal-delay, 0ms) + 330ms);
    }
  }

  @keyframes sp-rise {
    from {
      opacity: 0;
      transform: translate3d(0, 0.55rem, 0);
    }
  }

  /* 支持方式列表：每条前多一枚朱砂点 */
  .p-sponsor .p-card__body li {
    transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);

    &::marker {
      color: color(accent);
    }
  }

  /* ── 二维码册页 ──
     [data-leaf] 会写入 --leaf-rx / --leaf-ry / --leaf-sheen，
     这里把悬停的提起量并进同一条 transform，
     免得两者各写各的、后来者把前者整条抹掉。 */
  .p-sponsor .p-sponsor-qr {
    --qr-lift: 0px;

    position: relative;
    overflow: hidden;

    transform: perspective(60rem) translate3d(0, var(--qr-lift), 0)
      rotateX(var(--leaf-rx, 0deg)) rotateY(var(--leaf-ry, 0deg));

    transition:
      transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 320ms ease,
      border-color 320ms ease;

    &.is-leaf-live {
      transition:
        transform 120ms linear,
        box-shadow 320ms ease,
        border-color 320ms ease;
    }

    &:focus-within {
      outline: 2px solid color-mix(in srgb, #{color(accent)} 55%, transparent);
      outline-offset: 3px;
    }

    img {
      transition:
        transform 420ms cubic-bezier(0.16, 1, 0.3, 1),
        filter 420ms ease;
    }
  }

  /* 二维码加载失败：收起图，露出空态说明 */
  .p-sponsor .p-sponsor-qr.is-empty img {
    display: none;
  }

  .p-sponsor .p-sponsor-qr__fallback[hidden] {
    display: none !important;
  }

  .p-sponsor .p-sponsor-qr__fallback {
    position: relative;
    z-index: 2;

    margin: 0.35rem 0 0.85rem;
    padding: 0.85rem 1rem;

    border: 1.5px dashed color-mix(in srgb, #{color(secondary)} 36%, transparent);

    color: color-mix(in srgb, #{color(secondary)} 68%, transparent);
    font: 400 0.9rem / 1.5 font-family(editorial);
  }

  /* 受光：一道随指针左右游走的纸面反光 */
  .p-sponsor .p-sponsor-qr__sheen {
    position: absolute;
    inset: 0;
    z-index: 1;

    background: linear-gradient(
      105deg,
      transparent calc(var(--leaf-sheen, 0.5) * 100% - 26%),
      color-mix(in srgb, var(--daypart-lamp) 26%, transparent)
        calc(var(--leaf-sheen, 0.5) * 100%),
      transparent calc(var(--leaf-sheen, 0.5) * 100% + 26%)
    );

    opacity: 0;
    pointer-events: none;

    transition: opacity 320ms ease;
  }

  .p-sponsor .p-sponsor-qr img,
  .p-sponsor .p-sponsor-qr > p {
    position: relative;
    z-index: 2;
  }

  /* 册页右上钤「谢」：悬停或聚焦时落印 */
  .p-sponsor .p-sponsor-qr__stamp {
    position: absolute;
    top: 0.7rem;
    right: 0.75rem;
    z-index: 3;

    display: grid;
    place-items: center;

    width: 1.7rem;
    height: 1.7rem;

    border: 1.5px solid color-mix(in srgb, #{color(accent-strong)} 70%, transparent);

    color: color(accent-strong);
    font: 700 0.72rem / 1 font-family(editorial);

    opacity: 0;
    pointer-events: none;
    transform: scale(1.4) rotate(-10deg);
    transition:
      opacity 420ms cubic-bezier(0.2, 1.35, 0.32, 1),
      transform 420ms cubic-bezier(0.2, 1.35, 0.32, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .p-sponsor .p-card:hover::after,
    .p-sponsor .p-card:focus-within::after {
      opacity: 1;
      transform: translateX(18%);
    }

    .p-sponsor .p-card__body li:hover {
      transform: translateX(3px);
    }

    .p-sponsor .p-sponsor-qr:hover,
    .p-sponsor .p-sponsor-qr:focus-within {
      --qr-lift: -5px;

      border-color: color-mix(in srgb, #{color(secondary)} 68%, transparent);
      box-shadow:
        0 16px 34px -14px color-mix(in srgb, var(--color-shadow) 45%, transparent),
        0 3px 0 color-mix(in srgb, #{color(accent)} 85%, transparent);
    }

    .p-sponsor .p-sponsor-qr:hover img {
      transform: scale(1.04);
    }

    .p-sponsor .p-sponsor-qr:hover .p-sponsor-qr__sheen,
    .p-sponsor .p-sponsor-qr:focus-within .p-sponsor-qr__sheen {
      opacity: 1;
    }

    .p-sponsor .p-sponsor-qr:hover .p-sponsor-qr__thanks,
    .p-sponsor .p-sponsor-qr:focus-within .p-sponsor-qr__thanks {
      color: color-mix(in srgb, #{color(accent-strong)} 72%, #{color(secondary)});
    }

    .p-sponsor .p-sponsor-qr:hover .p-sponsor-qr__stamp,
    .p-sponsor .p-sponsor-qr:focus-within .p-sponsor-qr__stamp {
      opacity: 0.88;
      transform: scale(1) rotate(-6deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p-sponsor .p-card.is-inked .p-card__head,
    .p-sponsor .p-card.is-inked .p-card__title,
    .p-sponsor .p-card.is-inked .p-card__body {
      animation: none;
    }

    .p-sponsor .p-card::after,
    .p-sponsor .p-card__body li,
    .p-sponsor .p-sponsor-qr,
    .p-sponsor .p-sponsor-qr img,
    .p-sponsor .p-sponsor-qr__sheen,
    .p-sponsor .p-sponsor-qr__thanks,
    .p-sponsor .p-sponsor-qr__stamp {
      transition: none;
    }

    .p-sponsor .p-card::after {
      opacity: 0;
    }

    .p-sponsor .p-sponsor-qr__stamp {
      opacity: 0.72;
      transform: rotate(-6deg);
    }

    .p-sponsor .p-card__body li:hover,
    .p-sponsor .p-sponsor-qr:hover img {
      transform: none;
    }

    .p-sponsor .p-sponsor-qr {
      transform: none;
    }

    .p-sponsor .p-sponsor-qr__sheen {
      display: none;
    }
  }
</style>
