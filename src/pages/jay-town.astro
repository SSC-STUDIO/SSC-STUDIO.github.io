---
import { songs } from '../features/jay-town/songs'

const stops = [
  { name: '樱花街口', mood: '把第一首歌，留给春天。' },
  { name: '唱片小巷', mood: '旧唱片转动，晚风也有了节拍。' },
  { name: '晴天广场', mood: '阳光落在屋檐和路面之间。' },
  { name: '花海车站', mood: '下一班列车，开往花开的地方。' },
  { name: '七里香河堤', mood: '沿着水声，再听一遍夏天。' },
] as const
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#dcece7" />
    <meta name="description" content="沿着樱花街口、唱片小巷与七里香河堤，走进一座装着周杰伦歌曲的小镇。" />
    <meta property="og:title" content="周杰伦的樱花小镇" />
    <meta property="og:description" content="一座可以散步、看花、听歌的小镇。" />
    <title>周杰伦的樱花小镇</title>
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#song-drawer-open">跳到歌单按钮</a>
    <main class="town" id="town" aria-labelledby="town-title">
      <div class="town-poster" aria-hidden="true"></div>
      <canvas class="town-canvas" id="town-canvas" aria-hidden="true"></canvas>
      <div class="town-shade" aria-hidden="true"></div>

      <header class="town-header">
        <div class="identity">
          <div class="identity__labels"><span>SAKURA</span><span>FM 2000—</span></div>
          <h1 id="town-title">周杰伦的<span>樱花小镇</span></h1>
          <p>沿着花落的方向，把歌听成一段散步。</p>
        </div>
        <div class="header-tools" role="group" aria-label="小镇工具">
          <a class="home-link" href="/" title="返回陈润森的网站" aria-label="返回陈润森的网站">← <span>返回</span></a>
          <button class="tool-button day-toggle" id="day-toggle" type="button" aria-label="切换到夜晚" title="切换到夜晚" aria-pressed="false"><span aria-hidden="true">☾</span></button>
          <button class="tool-button" id="help-open" type="button" aria-label="帮助与来源" title="帮助与来源"><span aria-hidden="true">?</span></button>
          <button class="hide-button" id="ui-hide" type="button" aria-label="隐藏界面" title="隐藏界面">隐藏界面</button>
        </div>
      </header>

      <button class="ui-restore" id="ui-restore" type="button" hidden>显示界面</button>

      <div class="scene-status" id="scene-status" role="status" aria-live="polite">小镇正在亮起…</div>
      <div class="scene-failure" id="scene-failure" hidden>
        <p>3D 场景暂时无法显示，歌单仍可查看。</p>
        <button class="scene-failure__action" id="failure-songs" type="button">打开歌单</button>
      </div>

      <div class="place-stamp" aria-live="polite" aria-atomic="true">
        <span class="place-stamp__index" id="place-index">01 / 05</span>
        <strong id="place-name">樱花街口</strong>
        <span id="place-mood">把第一首歌，留给春天。</span>
      </div>

      <nav class="town-route" aria-label="小镇五站">
        {stops.map((stop, index) => (
          <button
            class:list={['town-route__stop', index === 0 && 'is-active']}
            type="button"
            data-zone={index}
            aria-label={`第 ${index + 1} 站：${stop.name}`}
            aria-current={index === 0 ? 'location' : undefined}
          >
            <span class="town-route__marker" aria-hidden="true"></span>
            <span class="town-route__number">{String(index + 1).padStart(2, '0')}</span>
            <strong>{stop.name}</strong>
          </button>
        ))}
      </nav>

      <div class="player-bar" role="group" aria-label="歌曲播放器">
        <button class="player-bar__record" id="song-drawer-open" type="button" aria-label="打开歌单" title="打开歌单" aria-controls="song-drawer" aria-expanded="false"><span aria-hidden="true">♫</span></button>
        <div class="player-bar__info" aria-live="polite" aria-atomic="true">
          <strong id="current-song">{songs[0]?.title ?? '小镇歌单'}</strong>
          <span id="current-status">未打开</span>
        </div>
        <button class="player-bar__control" id="previous-song" type="button" aria-label="上一首" title="上一首" disabled={songs.length === 0}><span aria-hidden="true">‹</span></button>
        <button class="player-bar__control player-bar__control--primary" id="listen-song" type="button" aria-label="打开当前歌曲" title="打开当前歌曲" disabled={songs.length === 0}><span aria-hidden="true">▶</span></button>
        <button class="player-bar__control" id="next-song" type="button" aria-label="下一首" title="下一首" disabled={songs.length === 0}><span aria-hidden="true">›</span></button>
      </div>

      <div class="move-pad" id="move-pad" role="group" aria-label="移动方向">
        <button class="move-pad__up" type="button" data-move-x="0" data-move-z="-1" aria-label="向前走" title="向前走">↑</button>
        <button class="move-pad__left" type="button" data-move-x="-1" data-move-z="0" aria-label="向左走" title="向左走">←</button>
        <span class="move-pad__center" aria-hidden="true">✳</span>
        <button class="move-pad__right" type="button" data-move-x="1" data-move-z="0" aria-label="向右走" title="向右走">→</button>
        <button class="move-pad__down" type="button" data-move-x="0" data-move-z="1" aria-label="向后走" title="向后走">↓</button>
      </div>

      <aside class="song-drawer" id="song-drawer" aria-labelledby="song-drawer-title" hidden>
        <div class="drawer-head">
          <div><span class="drawer-kicker">SAKURA / MUSIC ARCHIVE</span><h2 id="song-drawer-title">小镇歌单</h2></div>
          <button class="panel-icon" id="song-drawer-close" type="button" aria-label="关闭歌单" title="关闭歌单">×</button>
        </div>
        <div class="song-filters">
          <label class="search-field"><span class="sr-only">搜索歌曲或专辑</span><span aria-hidden="true">⌕</span><input id="song-search" type="search" placeholder="搜索歌曲或专辑" autocomplete="off" /></label>
          <label class="zone-field"><span class="sr-only">按场景筛选歌曲</span><select id="song-zone-filter"><option value="all">全部场景</option>{stops.map((stop, index) => <option value={index}>{stop.name}</option>)}</select></label>
          <button class="favorites-filter" id="favorites-filter" type="button" aria-pressed="false" title="只看收藏">☆ <span>收藏</span></button>
        </div>
        <p class="song-count" id="song-count">{songs.length} 首歌曲</p>
        <ol class="song-list" id="song-list">
          {songs.map((song, index) => (
            <li class="song-row" data-song-id={song.id}>
              <span class="song-row__number">{String(index + 1).padStart(2, '0')}</span>
              <span class="song-row__art" style={`--song-color: ${song.color}`} aria-hidden="true">♫</span>
              <span class="song-row__body"><strong>{song.title}</strong><small>{song.album} · {song.year} · {stops[song.zone]?.name}</small></span>
              <span class="song-row__actions">
                <button class="song-row__open" type="button" data-open-song={song.id} aria-label={`打开《${song.title}》MV`} title={`打开《${song.title}》MV`}>▶</button>
                <button class="song-row__favorite" type="button" data-favorite-song={song.id} aria-label={`收藏《${song.title}》`} aria-pressed="false" title={`收藏《${song.title}》`}>☆</button>
                <a href={song.sourceUrl} target="_blank" rel="noopener noreferrer" aria-label={`在${song.sourceLabel}打开《${song.title}》`} title={`在${song.sourceLabel}打开《${song.title}》`}>↗</a>
              </span>
            </li>
          ))}
        </ol>
        <p class="song-empty" id="song-empty" hidden>这里没有匹配的歌曲。</p>
      </aside>

      <section class="video-panel" id="video-panel" aria-labelledby="video-title" hidden>
        <div class="video-panel__head">
          <div><span class="drawer-kicker">NOW OPEN / 原站播放</span><h2 id="video-title">歌曲 MV</h2></div>
          <div class="video-panel__actions">
            <button class="panel-icon" id="video-minimize" type="button" aria-label="收起 MV 小窗，继续保留播放" title="收起小窗，继续保留播放">−</button>
            <button class="panel-icon" id="video-close" type="button" aria-label="关闭 MV 并停止播放" title="关闭 MV 并停止播放">×</button>
          </div>
        </div>
        <div class="video-frame" id="video-frame"></div>
        <div class="video-panel__foot"><span id="video-source-label">播放由原站控制</span><span class="video-panel__links"><a id="video-source" href="https://www.bilibili.com/" target="_blank" rel="noopener noreferrer">前往原站 ↗</a><a id="video-youtube" href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer">官方 MV ↗</a></span></div>
      </section>

      <dialog class="help-dialog" id="help-dialog" aria-labelledby="help-title">
        <div class="help-dialog__head"><span class="drawer-kicker">A LITTLE GUIDE</span><button class="panel-icon" id="help-close" type="button" aria-label="关闭帮助" title="关闭帮助">×</button></div>
        <h2 id="help-title">小镇漫游</h2>
        <p>沿五站路线走走，挑一首想听的歌。电脑上可用方向键或 WASD 行走，拖动画面转头；手机上使用方向键。</p>
        <p>MV 从原站嵌入。收起小窗会保留播放器，关闭则停止；能否播放由原站决定。</p>
        <div class="help-dialog__links"><a href="https://www.bilibili.com/video/BV1Ziac6JEUc/" target="_blank" rel="noopener noreferrer">视觉参考视频 ↗</a><a href="/">返回网站 ↗</a></div>
        <small>非官方歌迷作品。歌曲与影像版权归原权利人。</small>
      </dialog>

      <noscript>
        <div class="nojs-catalog">
          <h2>周杰伦的樱花小镇</h2>
          <p>3D 小镇与站内播放器需要 JavaScript。仍可从原站打开歌曲：</p>
          <ol>{songs.map((song) => <li><a href={song.sourceUrl} target="_blank" rel="noopener noreferrer">{song.title} · {song.sourceLabel} ↗</a></li>)}</ol>
        </div>
      </noscript>
    </main>

    <script>
      import { songs } from '../features/jay-town/songs'
      import { mountTownScene } from '../features/jay-town/scene'

      type Song = (typeof songs)[number]
      const town = document.querySelector('#town') as HTMLElement
      const canvas = document.querySelector('#town-canvas') as HTMLCanvasElement
      const routeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-zone]')]
      const stationNames = ['樱花街口', '唱片小巷', '晴天广场', '花海车站', '七里香河堤']
      const stationMoods = ['把第一首歌，留给春天。', '旧唱片转动，晚风也有了节拍。', '阳光落在屋檐和路面之间。', '下一班列车，开往花开的地方。', '沿着水声，再听一遍夏天。']
      const sceneStatus = document.querySelector('#scene-status') as HTMLElement
      const sceneFailure = document.querySelector('#scene-failure') as HTMLElement
      const drawer = document.querySelector('#song-drawer') as HTMLElement
      const drawerOpen = document.querySelector('#song-drawer-open') as HTMLButtonElement
      const drawerClose = document.querySelector('#song-drawer-close') as HTMLButtonElement
      const search = document.querySelector('#song-search') as HTMLInputElement
      const zoneFilter = document.querySelector('#song-zone-filter') as HTMLSelectElement
      const favoritesFilter = document.querySelector('#favorites-filter') as HTMLButtonElement
      const songCount = document.querySelector('#song-count') as HTMLElement
      const songEmpty = document.querySelector('#song-empty') as HTMLElement
      const playerTitle = document.querySelector('#current-song') as HTMLElement
      const playerStatus = document.querySelector('#current-status') as HTMLElement
      const listenButton = document.querySelector('#listen-song') as HTMLButtonElement
      const videoPanel = document.querySelector('#video-panel') as HTMLElement
      const videoFrame = document.querySelector('#video-frame') as HTMLElement
      const videoTitle = document.querySelector('#video-title') as HTMLElement
      const videoSource = document.querySelector('#video-source') as HTMLAnchorElement
      const videoYoutube = document.querySelector('#video-youtube') as HTMLAnchorElement
      const videoSourceLabel = document.querySelector('#video-source-label') as HTMLElement
      const rows = [...document.querySelectorAll<HTMLElement>('[data-song-id]')]
      const favoriteKey = 'jay-town:favorites:v1'

      let currentZone = 0
      let currentSongId = songs[0]?.id ?? ''
      let openSongId = ''
      let night = false
      let favoriteOnly = false
      let favorites = new Set<string>()
      try {
        const saved = JSON.parse(localStorage.getItem(favoriteKey) || '[]')
        if (Array.isArray(saved)) favorites = new Set(saved.filter((value): value is string => typeof value === 'string'))
      } catch {}

      const findSong = (id: string): Song | undefined => songs.find((song) => song.id === id)
      const currentSong = (): Song | undefined => findSong(currentSongId)

      function updateZone(index: number) {
        if (!Number.isInteger(index) || index < 0 || index >= stationNames.length || currentZone === index) return
        currentZone = index
        ;(document.querySelector('#place-index') as HTMLElement).textContent = `${String(index + 1).padStart(2, '0')} / 05`
        ;(document.querySelector('#place-name') as HTMLElement).textContent = stationNames[index]
        ;(document.querySelector('#place-mood') as HTMLElement).textContent = stationMoods[index]
        routeButtons.forEach((button, buttonIndex) => {
          const active = buttonIndex === index
          button.classList.toggle('is-active', active)
          if (active) button.setAttribute('aria-current', 'location')
          else button.removeAttribute('aria-current')
        })
      }

      let scene: ReturnType<typeof mountTownScene> | null = null
      try {
        scene = mountTownScene(canvas, {
          onReady() {
            town.classList.add('scene-ready')
            town.classList.remove('scene-error')
            sceneStatus.hidden = true
            sceneFailure.hidden = true
          },
          onError() {
            town.classList.add('scene-error')
            town.classList.remove('scene-ready')
            sceneStatus.hidden = true
            sceneFailure.hidden = false
          },
          onZoneChange: updateZone,
        })
      } catch (error) {
        console.error('Unable to start sakura town', error)
        town.classList.add('scene-error')
        sceneStatus.hidden = true
        sceneFailure.hidden = false
      }

      routeButtons.forEach((button) => button.addEventListener('click', () => {
        const index = Number(button.dataset.zone)
        if (!Number.isInteger(index)) return
        scene?.goTo(index)
      }))

      const dayButton = document.querySelector('#day-toggle') as HTMLButtonElement
      dayButton.addEventListener('click', () => {
        night = !night
        scene?.setNight(night)
        town.classList.toggle('is-night', night)
        dayButton.setAttribute('aria-pressed', String(night))
        dayButton.setAttribute('aria-label', night ? '切换到白天' : '切换到夜晚')
        dayButton.title = night ? '切换到白天' : '切换到夜晚'
        dayButton.firstElementChild!.textContent = night ? '☀' : '☾'
      })

      const help = document.querySelector('#help-dialog') as HTMLDialogElement
      const helpOpen = document.querySelector('#help-open') as HTMLButtonElement
      helpOpen.addEventListener('click', () => help.showModal())
      ;(document.querySelector('#help-close') as HTMLButtonElement).addEventListener('click', () => help.close())
      help.addEventListener('click', (event) => { if (event.target === help) help.close() })

      const restoreButton = document.querySelector('#ui-restore') as HTMLButtonElement
      ;(document.querySelector('#ui-hide') as HTMLButtonElement).addEventListener('click', () => {
        clearMovement()
        town.classList.add('ui-hidden')
        restoreButton.hidden = false
        restoreButton.focus()
      })
      restoreButton.addEventListener('click', () => {
        town.classList.remove('ui-hidden')
        restoreButton.hidden = true
        ;(document.querySelector('#ui-hide') as HTMLButtonElement).focus()
      })

      function setDrawer(open: boolean) {
        drawer.hidden = !open
        drawerOpen.setAttribute('aria-expanded', String(open))
        if (open) search.focus()
        else if (drawer.contains(document.activeElement)) drawerOpen.focus()
      }
      drawerOpen.addEventListener('click', () => setDrawer(drawer.hidden))
      drawerClose.addEventListener('click', () => setDrawer(false))
      ;(document.querySelector('#failure-songs') as HTMLButtonElement).addEventListener('click', () => setDrawer(true))

      function updatePlayer() {
        const song = currentSong()
        playerTitle.textContent = song?.title ?? '小镇歌单'
        playerStatus.textContent = song && openSongId === song.id ? 'MV 已打开' : '选择一首，开始散步'
        listenButton.firstElementChild!.textContent = song && openSongId === song.id ? '↗' : '▶'
        listenButton.setAttribute('aria-label', song && openSongId === song.id ? '展开当前 MV 小窗' : song ? `打开《${song.title}》MV` : '打开当前歌曲')
        listenButton.title = listenButton.getAttribute('aria-label') || ''
        rows.forEach((row) => row.classList.toggle('is-current', row.dataset.songId === currentSongId))
      }

      function closeVideo() {
        videoFrame.replaceChildren()
        videoPanel.hidden = true
        openSongId = ''
        updatePlayer()
      }

      function openSong(song: Song) {
        currentSongId = song.id
        const frame = document.createElement('iframe')
        frame.src = song.embedUrl
        frame.title = `《${song.title}》MV · ${song.sourceLabel}`
        frame.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture'
        frame.allowFullscreen = true
        frame.referrerPolicy = 'strict-origin-when-cross-origin'
        videoFrame.replaceChildren(frame)
        openSongId = song.id
        videoTitle.textContent = song.title
        videoSource.href = song.sourceUrl
        videoSource.textContent = `前往${song.sourceLabel} ↗`
        videoYoutube.href = song.youtubeUrl
        videoSourceLabel.textContent = '点击画面播放'
        videoPanel.hidden = false
        updatePlayer()
        if (window.matchMedia('(max-width: 720px)').matches) setDrawer(false)
      }

      function stepSong(direction: number) {
        if (!songs.length) return
        const index = Math.max(0, songs.findIndex((song) => song.id === currentSongId))
        openSong(songs[(index + direction + songs.length) % songs.length])
      }
      listenButton.addEventListener('click', () => {
        const song = currentSong()
        if (!song) return
        if (openSongId === song.id) videoPanel.hidden = false
        else openSong(song)
      })
      ;(document.querySelector('#previous-song') as HTMLButtonElement).addEventListener('click', () => stepSong(-1))
      ;(document.querySelector('#next-song') as HTMLButtonElement).addEventListener('click', () => stepSong(1))
      ;(document.querySelector('#video-minimize') as HTMLButtonElement).addEventListener('click', () => { videoPanel.hidden = true })
      ;(document.querySelector('#video-close') as HTMLButtonElement).addEventListener('click', closeVideo)

      function syncFavorites() {
        rows.forEach((row) => {
          const id = row.dataset.songId || ''
          const button = row.querySelector<HTMLButtonElement>('[data-favorite-song]')!
          const song = findSong(id)
          const active = favorites.has(id)
          button.setAttribute('aria-pressed', String(active))
          button.setAttribute('aria-label', `${active ? '取消收藏' : '收藏'}《${song?.title ?? ''}》`)
          button.title = button.getAttribute('aria-label') || ''
          button.textContent = active ? '★' : '☆'
        })
      }

      function filterSongs() {
        const query = search.value.trim().toLocaleLowerCase()
        const selectedZone = zoneFilter.value
        let visible = 0
        rows.forEach((row) => {
          const song = findSong(row.dataset.songId || '')
          if (!song) return
          const matches = (`${song.title} ${song.album} ${song.year}`).toLocaleLowerCase().includes(query)
            && (selectedZone === 'all' || String(song.zone) === selectedZone)
            && (!favoriteOnly || favorites.has(song.id))
          row.hidden = !matches
          if (matches) visible++
        })
        songCount.textContent = `${visible} / ${songs.length} 首歌曲`
        songEmpty.hidden = visible > 0
      }

      document.querySelector('#song-list')?.addEventListener('click', (event) => {
        const target = event.target as HTMLElement
        const favorite = target.closest<HTMLButtonElement>('[data-favorite-song]')
        if (favorite) {
          const id = favorite.dataset.favoriteSong || ''
          if (favorites.has(id)) favorites.delete(id)
          else favorites.add(id)
          try { localStorage.setItem(favoriteKey, JSON.stringify([...favorites])) } catch {}
          syncFavorites()
          filterSongs()
          return
        }
        const open = target.closest<HTMLButtonElement>('[data-open-song]')
        if (open) {
          const song = findSong(open.dataset.openSong || '')
          if (song) openSong(song)
        }
      })
      search.addEventListener('input', filterSongs)
      zoneFilter.addEventListener('change', filterSongs)
      favoritesFilter.addEventListener('click', () => {
        favoriteOnly = !favoriteOnly
        favoritesFilter.setAttribute('aria-pressed', String(favoriteOnly))
        favoritesFilter.classList.toggle('is-active', favoriteOnly)
        filterSongs()
      })
      syncFavorites()
      filterSongs()
      updatePlayer()

      const heldPointers = new Map<number, { x: number; z: number; button: HTMLButtonElement }>()
      function updateMovement() {
        let x = 0, z = 0
        heldPointers.forEach((direction) => { x += direction.x; z += direction.z })
        scene?.setMove(Math.sign(x), Math.sign(z))
      }
      function clearMovement() {
        heldPointers.forEach((direction) => direction.button.classList.remove('is-pressed'))
        heldPointers.clear()
        scene?.setMove(0, 0)
      }
      document.querySelectorAll<HTMLButtonElement>('[data-move-x]').forEach((button) => {
        button.addEventListener('pointerdown', (event) => {
          event.preventDefault()
          button.setPointerCapture(event.pointerId)
          heldPointers.set(event.pointerId, { x: Number(button.dataset.moveX), z: Number(button.dataset.moveZ), button })
          button.classList.add('is-pressed')
          updateMovement()
        })
        button.addEventListener('pointerup', (event) => {
          heldPointers.delete(event.pointerId)
          button.classList.remove('is-pressed')
          updateMovement()
        })
        button.addEventListener('pointercancel', clearMovement)
        button.addEventListener('lostpointercapture', (event) => {
          if (heldPointers.has(event.pointerId)) clearMovement()
        })
      })
      window.addEventListener('blur', clearMovement)
      document.addEventListener('visibilitychange', () => { if (document.hidden) clearMovement() })
      window.addEventListener('pagehide', (event) => {
        clearMovement()
        if (!event.persisted) { closeVideo(); scene?.dispose() }
      })
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return
