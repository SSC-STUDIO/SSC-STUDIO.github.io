---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import PageCard from '@/components/pages/PageCard.astro'
import PageAura from '@/components/pages/PageAura.astro'
import InkSeal3D from '@/components/InkSeal3D.astro'
---

<BaseLayout
  title="关于 · 陈润森"
  description="关于陈润森：正在探索 AI、交互与游戏开发的初中生——照片、方向、技能与自我介绍。"
>
  <PageHero
    kicker="brand"
    title="关于"
    summary="照片、方向和自我介绍，拼成一个正在变化的人。"
  />

  <main class="p-page p-page--wide p-about">
    <PageAura />

    <figure class="p-about-photo" data-reveal data-leaf>
      <img
        src="/legacy-assets/personal/chen.webp"
        srcset="/legacy-assets/personal/chen-sm.webp 320w, /legacy-assets/personal/chen.webp 640w"
        sizes="(min-width: 1080px) 23rem, calc(100vw - 3rem)"
        alt="陈润森的个人照片"
        width="640"
        height="811"
        loading="lazy"
      />
      <figcaption>
        <span class="p-about-photo__name">陈润森</span>
        <span class="p-about-photo__tag"
          >AI · 游戏 · 交互 · 长期作品</span
        >
      </figcaption>
    </figure>

    <div class="p-prose" data-flow data-intersect>
      <p>
        正在探索 AI、交互与游戏开发的初中生。把少年时的好奇，写进可运行的光里。
      </p>
      <p>
        个人空间收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。
      </p>
      <p>
        从 Python 到 TypeScript
        全栈，从本地脚本到可部署的产品——每一步都追求能展示、能维护、能迭代。
      </p>
      <p>
        这个站点是长期作品：作品集、文章、实验游戏与班级空间，全部跑在同一套
        monorepo 里。
      </p>
      <h2>此刻</h2>
      <p>正在把 AI 实验、交互练习和班级记忆整理成一条更清晰的河流。</p>
      <h2>Skills</h2>
      <div class="p-chips" data-flow data-intersect style="--flow-step: 74ms">
        <span class="p-chip p-chip--accent">AI</span>
        <span class="p-chip p-chip--accent">TypeScript</span>
        <span class="p-chip p-chip--accent">Games</span>
        <span class="p-chip p-chip--accent">Python</span>
        <span class="p-chip p-chip--accent">Web</span>
      </div>
    </div>

    <div class="p-stack p-stack--2col p-stack--spaced">
      <PageCard href="/contact" kicker="reach" title="联系">
        <p>合作、交流或反馈 → 留言或邮件 3992237161@qq.com</p>
      </PageCard>
      <PageCard href="/honors" kicker="growth" title="荣誉">
        <p>创客、竞赛与校级节点 — 努力被看见的那些瞬间。</p>
      </PageCard>
    </div>

    <aside class="p-about__colophon" aria-label="落款">
      <InkSeal3D />
    </aside>
  </main>

  <PageFoot current="/about" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 关于页动效（仅本页） ── */

  /* 立轴照片：随指针沿中缝轻翻（data-leaf 供角度），
     另铺一道随指针横移的受光，像光掠过裱好的相纸。 */
  .p-about-photo {
    position: relative;

    &::after {
      position: absolute;
      z-index: 2;
      inset: 0;

      background: linear-gradient(
        105deg,
        transparent calc(var(--leaf-sheen, 0.5) * 100% - 26%),
        color-mix(in srgb, #{color(primary)} 34%, transparent)
          calc(var(--leaf-sheen, 0.5) * 100%),
        transparent calc(var(--leaf-sheen, 0.5) * 100% + 26%)
      );
      content: '';
      opacity: 0;
      pointer-events: none;

      transition: opacity 0.4s ease(out-quint);
    }

    &:hover::after {
      opacity: 1;
    }

    /* 照片本体随之极缓地推近，纵深不靠位移全靠尺度 */
    img {
      transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    }

    &:hover img {
      transform: scale(1.035);
    }

    /* 落款处的朱砂短线：悬停时自左向右洇开 */
    &__name {
      position: relative;

      &::after {
        position: absolute;
        bottom: -0.3em;
        left: 0;

        width: 100%;
        height: 2px;

        background: color(accent);
        content: '';
        transform: scaleX(0);
        transform-origin: 0 50%;

        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
      }
    }
  }

  .p-about-photo:hover .p-about-photo__name::after {
    transform: scaleX(1);
  }

  /* 正文小标题：入屏时把既有的压脚朱丝一笔描出 */
  .p-about .p-prose h2::after {
    transform-origin: 0 50%;
  }

  .p-about .p-prose.is-in-view h2::after {
    animation: about-rule-draw 620ms cubic-bezier(0.16, 1, 0.3, 1) 220ms
      backwards;
  }

  @keyframes about-rule-draw {
    from {
      transform: scaleX(0);
    }
  }

  /* 技能签：悬停时轻提并翻墨 */
  .p-chip {
    transition:
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.28s ease,
      border-color 0.28s ease,
      color 0.28s ease;
  }

  .p-about .p-chip:hover {
    transform: translateY(-3px);

    background: color(secondary);
    border-color: color(secondary);

    color: color(primary);
  }

  .p-about .p-chip:hover::before {
    color: color(accent);
  }

  /* 落款印玺：正文收束处右下钤一枚，略小于首页卷尾 */
  .p-about__colophon {
    display: flex;
    justify-content: flex-end;

    margin-top: 2.25rem;

    .ink-seal3d {
      --body-w: 3.6rem;
      --body-h: 2.7rem;
      --knob-w: 1.5rem;
      --knob-h: 1.55rem;
      --hover-gap: 2.6rem;

      width: 8.6rem;
    }

    .ink-seal3d .scene {
      height: 10.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p-about-photo::after,
    .p-about-photo img,
    .p-about-photo__name::after,
    .p-chip {
      transition: none;
    }

    .p-about-photo:hover img,
    .p-about .p-chip:hover {
      transform: none;
    }

    .p-about .p-prose.is-in-view h2::after {
      animation: none;
    }
  }
</style>
