---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/pages/PageHero.astro'
import PageFoot from '@/components/pages/PageFoot.astro'
import PageCard from '@/components/pages/PageCard.astro'
import PageAura from '@/components/pages/PageAura.astro'
import AboutScroll from '@/components/pages/AboutScroll.astro'
import InkSeal3D from '@/components/InkSeal3D.astro'
---

<BaseLayout
  title="关于 · 陈润森"
  description="关于陈润森：正在探索 AI、交互与游戏开发的初中生——照片、方向、技能与自我介绍。"
>
  <PageHero
    kicker="立轴"
    title="关于"
    summary="照片、方向和自我介绍，拼成一个正在变化的人。"
  />

  <main class="p-page p-page--wide p-about">
    <PageAura />

    <AboutScroll />

    <div class="p-prose" data-flow data-intersect>
      <p>
        正在探索 AI、交互与游戏开发的初中生。把少年时的好奇，写进可运行的光里。
      </p>
      <p>
        个人空间收藏 AI 实验、Web 与游戏作品、文章、奖项，也保存一处属于班级的记忆现场。
      </p>
      <p>
        从 Python 到 TypeScript
        全栈，从本地脚本到可部署的产品——每一步都追求能展示、能维护、能迭代。
      </p>
      <p>
        这个站点是长期作品：作品集、文章、实验游戏与班级空间，全部跑在同一套
        monorepo 里。
      </p>
      <h2>此刻</h2>
      <p>正在把 AI 实验、交互练习和班级记忆整理成一条更清晰的河流。</p>
      <h2>Skills</h2>
      <about-chips class="p-chips" data-flow data-intersect style="--flow-step: 74ms">
        <button type="button" class="p-chip p-chip--accent" data-stamp="智">AI</button>
        <button type="button" class="p-chip p-chip--accent" data-stamp="码">TypeScript</button>
        <button type="button" class="p-chip p-chip--accent" data-stamp="戏">Games</button>
        <button type="button" class="p-chip p-chip--accent" data-stamp="蛇">Python</button>
        <button type="button" class="p-chip p-chip--accent" data-stamp="网">Web</button>
      </about-chips>
    </div>

    <div class="p-stack p-stack--2col p-stack--spaced">
      <PageCard href="/contact" kicker="reach" title="联系">
        <p>合作、交流或反馈 → 留言或邮件 3992237161@qq.com</p>
      </PageCard>
      <PageCard href="/honors" kicker="growth" title="荣誉">
        <p>创客、竞赛与校级节点 — 努力被看见的那些瞬间。</p>
      </PageCard>
    </div>

    <aside class="p-about__colophon" aria-label="落款">
      <InkSeal3D />
    </aside>
  </main>

  <PageFoot current="/about" />
</BaseLayout>

<style lang="scss" is:global>
  /* ── 关于页动效（仅本页） ── */

  /* 立轴占掉原来 figure 的格子：宽屏仍贴左栏，不改全局 .p-about 栅格语义 */
  @media (min-width: 1080px) {
    .p-about > .p-about-scroll {
      position: sticky;
      top: 5.75rem;
    }

    .p-about > .p-about__colophon {
      grid-column: 1 / -1;
    }
  }

  /* 覆盖全局 .p-about-photo 的 overflow / 边框，让天杆地杆探出绫边 */
  .p-about .p-about-photo.p-about-scroll {
    overflow: visible;
    border: 0;
    background: none;
    background-image: none;
  }

  /* 技能签改成按钮后，收掉默认按钮皮，手感仍是纸签 */
  .p-about .p-chips .p-chip {
    appearance: none;

    position: relative;
    overflow: visible;

    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;

    transition:
      transform 0.28s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.28s ease,
      border-color 0.28s ease,
      color 0.28s ease;

    &:hover {
      transform: translateY(-3px);

      background: color(secondary);
      border-color: color(secondary);

      color: color(primary);
    }

    &:hover::before {
      color: color(accent);
    }

    &:focus-visible {
      outline: 2px dashed color-mix(in srgb, #{color(accent)} 70%, transparent);
      outline-offset: 3px;
    }
  }

  /* 点签落印：朱砂字自触点弹出再淡去 */
  .p-about-chip-stamp {
    position: absolute;
    top: -0.85rem;
    right: -0.35rem;
    z-index: 2;

    display: grid;
    place-items: center;

    width: 1.35rem;
    height: 1.35rem;

    border: 1.5px solid color(accent-strong);
    border-radius: 0.08rem;

    color: color(accent-strong);
    font: 700 0.62rem / 1 font-family(editorial);
    pointer-events: none;

    animation: about-chip-stamp 880ms cubic-bezier(0.2, 1.35, 0.32, 1) both;
  }

  @keyframes about-chip-stamp {
    0% {
      opacity: 0;
      transform: rotate(-18deg) scale(1.6);
    }

    55% {
      opacity: 1;
      transform: rotate(-4deg) scale(0.94);
    }

    100% {
      opacity: 0;
      transform: rotate(-8deg) scale(1) translateY(-0.35rem);
    }
  }

  /* 正文小标题：入屏时把既有的压脚朱丝一笔描出 */
  .p-about .p-prose h2::after {
    transform-origin: 0 50%;
  }

  .p-about .p-prose.is-in-view h2::after {
    animation: about-rule-draw 620ms cubic-bezier(0.16, 1, 0.3, 1) 220ms
      backwards;
  }

  @keyframes about-rule-draw {
    from {
      transform: scaleX(0);
    }
  }

  /* 落款印玺：正文收束处右下钤一枚，略小于首页卷尾 */
  .p-about__colophon {
    display: flex;
    justify-content: flex-end;

    margin-top: 2.25rem;

    .ink-seal3d {
      --body-w: 3.6rem;
      --body-h: 2.7rem;
      --knob-w: 1.5rem;
      --knob-h: 1.55rem;
      --hover-gap: 2.6rem;

      width: 8.6rem;
    }

    .ink-seal3d .scene {
      height: 10.4rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p-about .p-chips .p-chip {
      transition: none;
    }

    .p-about .p-chips .p-chip:hover {
      transform: none;
    }

    .p-about-chip-stamp,
    .p-about .p-prose.is-in-view h2::after {
      animation: none;
    }

    .p-about-chip-stamp {
      opacity: 1;
    }
  }
</style>
